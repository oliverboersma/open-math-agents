import Mathlib.MeasureTheory.Constructions.Polish.Basic

/-!
# Analytically measurable lifting, MathOverflow 136792

We state the three numbered requirements in the body of the question. Each
standard Borel space is represented by a compatible Polish topology, which
preserves Borel and analytic sets under Borel isomorphisms. Analytic
measurability means measurability for the sigma algebra generated by all
analytic sets on the domain.
-/

namespace OMA.S_mo_136792

open MeasureTheory

abbrev analyticSigma (X : Type*) [TopologicalSpace X] : MeasurableSpace X :=
  MeasurableSpace.generateFrom {s | AnalyticSet s}

theorem main :
    ∀ (X Y Z : Type) [TopologicalSpace X] [PolishSpace X]
      [TopologicalSpace Y] [PolishSpace Y] [TopologicalSpace Z] [PolishSpace Z]
      (K : Set (X × Y)) (g : X × Y → Z) (h : X → Z),
      AnalyticSet K → @Measurable _ _ (borel (X × Y)) (borel Z) g →
      @Measurable _ _ (analyticSigma X) (borel Z) h →
      (∀ x, ∃ y, (x,y) ∈ K ∧ g (x,y) = h x) →
      ∃ f : X → Y, @Measurable _ _ (analyticSigma X) (borel Y) f ∧
        ∀ x, (x,f x) ∈ K ∧ g (x,f x) = h x := by
  sorry

end OMA.S_mo_136792
