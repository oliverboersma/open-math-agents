import Mathlib

/-!
# OEIS A243925: the rational array generated by the factor 2

Start with 1. A rational x generates x+1 and, if x is nonzero, -2/x.
The source deletes repeated rationals across rows, so the row of a rational
is the earliest generation in which it appears. Lean represents each row
as a set, since the conjecture refers to membership. The source's row 1
corresponds to index 0 below.

Source: https://oeis.org/A243925
Formalization: @senamakel
-/

namespace OMA.S_oeis_a243925

/-- All rationals produced at depth at most n. -/
def seen (d : ℚ) : ℕ → Set ℚ
  | 0 => {1}
  | n+1 => seen d n ∪ ((fun x : ℚ => x+1) '' seen d n) ∪
        ((fun x : ℚ => -d/x) '' (seen d n \ {0}))

def row (d : ℚ) (n : ℕ) : Set ℚ :=
  {x | IsLeast {k | x ∈ seen d k} n}

/-- Every rational occurs in a unique row of the array. -/
theorem main : ∀ x : ℚ, ∃! n, x ∈ row 2 n := by
  sorry

end OMA.S_oeis_a243925
