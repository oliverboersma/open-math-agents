lemma rank_correct (n : ℕ) (hn : n ≤ 65535) : rank n = n.primeCounting := by
  induction n with
  | zero => decide +kernel
  | succ n ih =>
    have tick := rank_tick_true n (by omega)
    have flag : (if smallPrime (n+1) then 1 else 0 : ℕ) = (if (n+1).Prime then 1 else 0) := by
      simp only [smallPrime_true hn]
    change (rank (n+1) == rank n + (if smallPrime (n+1) then 1 else 0)) = true at tick
    rw [beq_iff_eq] at tick
    change rank (n+1) = Nat.count Nat.Prime ((n+1)+1)
    rw [Nat.count_succ, ← flag, tick, ih (by omega)]
    rfl
