    · rintro ⟨a,b,c⟩; exact ⟨⟨b,c⟩,fun h => (Nat.not_le.mpr a) h.1⟩
  have cover (q : ℕ) (prime : q.Prime) : q ≤ 16167 ↔ q ≤ 11 ∨ q ∈ ps := by
    rw [mem]
