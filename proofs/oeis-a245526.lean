def wheelRank (r : ℕ) : ℕ := (wheelRow (r/64) >>> (9*(r%64))) % 512
def wheel (n : ℕ) : ℕ := n/2310*480 + wheelRank (n%2310)

lemma survivor_succ (n w : ℕ) :
    (survivors (n+1) w).card = (survivors n w).card + (if (n+1).Coprime w then 1 else 0) := by
  by_cases h : (n+1).Coprime w
  · rw [if_pos h]
    have eq : survivors (n+1) w = insert (n+1) (survivors n w) := by
      ext t
      simp only [mem_survivors,mem_insert]
      by_cases e : t=n+1
      · subst t; simpa using h
      · simp only [e,false_or]; omega
    rw [eq, Finset.card_insert_of_notMem]
    simp [mem_survivors]
  · simp only [if_neg h, Nat.add_zero]
    apply congrArg Finset.card
    ext t
    simp only [mem_survivors]
    by_cases e : t=n+1
    · subst t; simp [h]
    · omega

set_option maxRecDepth 12000 in
lemma wheel_rank_check : ∀ i : Fin 2309, wheelRank (i.val+1) =
    wheelRank i.val + (if (i.val+1).Coprime 2310 then 1 else 0) := by decide +kernel

lemma wheel_correct (n : ℕ) : wheel n = (survivors n 2310).card := by
  have partial_count (r : ℕ) (hr : r < 2310) : wheelRank r = (survivors r 2310).card := by
    induction r with
    | zero => decide +kernel
    | succ r ih => rw [survivor_succ, ← ih (by omega)]; exact wheel_rank_check ⟨r,by omega⟩
  have tot : Nat.totient 2310 = 480 := by decide +kernel
  rw [wheel_count,tot, ← partial_count _ (Nat.mod_lt _ (by decide))]
  rfl

/-- Number removed by a consecutive batch of sieve primes beyond a previous stage. -/
def removed (n : ℕ) (old : List ℕ) : List ℕ → ℕ
  | [] => 0
  | p::ps => removed n old ps + partialSieve wheel rank (ps++old) (n/p)

lemma batch_eq (n : ℕ) (large : 65535 < n) (old batch : List ℕ) (less : ∀ p ∈ batch, p < n) :
    partialSieve wheel rank (batch++old) n =
      partialSieve wheel rank old n - removed n old batch := by
  induction batch with
  | nil => simp [removed]
  | cons p ps ih =>
