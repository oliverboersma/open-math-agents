import OMAStatements.S_oeis_a245526
import Mathlib

-- Bjorn Poonen found this counterexample in July 2014, as recorded by Zhi-Wei Sun
-- in OEIS A245526. The Lucas congruence and the exact prime index are checked here.
-- The count uses Legendre's sieve with a 2310-wheel. When the remaining values are
-- below the square of the next possible divisor, only 1 and primes survive.

namespace LucasIndex
open OMA.S_oeis_a245526
open Matrix

def companion (p : ℕ) : Matrix (Fin 2) (Fin 2) (ZMod p) := !![1,1;1,0]

lemma rec_matrix (p : ℕ) : companion p ^ 2 = companion p + 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [companion,pow_two,Matrix.mul_apply,Fin.sum_univ_two]

lemma lucas_trace (p n : ℕ) : (lucas n : ZMod p) = Matrix.trace (companion p ^ n) := by
  induction n using Nat.twoStepInduction with
  | zero => simp [lucas,Matrix.trace]
  | one => simp [lucas,companion,Matrix.trace,Fin.sum_univ_two]
  | more n ih jh =>
    rw [lucas,Nat.cast_add,pow_add,rec_matrix,mul_add,mul_one,Matrix.trace_add,← pow_succ,← ih,← jh]

lemma fast_pow {M : Type*} [Monoid M] (a : M) (n : ℕ) : a^n = npowBinRec n a := by
  induction n with
  | zero => rw [pow_zero,npowBinRec_zero]
  | succ n h => rw [pow_succ,npowBinRec_succ,h]

theorem residue : 261399601 ∣ lucas (2*14268177) := by
  apply (ZMod.natCast_eq_zero_iff _ _).mp
  rw [lucas_trace,fast_pow]
  decide +kernel

end LucasIndex

namespace PrimeIndex

open Finset

def survivors (n m : ℕ) : Finset ℕ := (Ioc 0 n).filter (fun t => t.Coprime m)

lemma mem_survivors (n m t : ℕ) : t ∈ survivors n m ↔ 0 < t ∧ t ≤ n ∧ t.Coprime m := by
  simp [survivors,and_assoc]

lemma sieve_step (n m p : ℕ) (hp : p.Prime) (free : p.Coprime m) :
    (survivors n (p*m)).card = (survivors n m).card - (survivors (n/p) m).card := by
  let old := survivors n m
  let banned := old.filter (p ∣ ·)
  let kept := old.filter (fun t => ¬ p ∣ t)
  have kept_eq : kept = survivors n (p*m) := by
    ext t
    simp only [kept,old,mem_filter,mem_survivors,Nat.coprime_mul_iff_right,Nat.coprime_comm (n:=t) (m:=p),hp.coprime_iff_not_dvd]
    tauto
  have count : (survivors (n/p) m).card = banned.card := by
    apply Finset.card_bij (fun t _ => p*t)
    · intro t ht
      obtain ⟨pos,cap,cop⟩ := (mem_survivors _ _ _).mp ht
      have le := (Nat.le_div_iff_mul_le hp.pos).mp cap
      exact Finset.mem_filter.mpr ⟨(mem_survivors _ _ _).mpr
        ⟨Nat.mul_pos hp.pos pos,by simpa [Nat.mul_comm] using le,Nat.coprime_mul_iff_left.mpr ⟨free,cop⟩⟩,
        dvd_mul_right p t⟩
    · intro a ha b hb eq
      exact Nat.eq_of_mul_eq_mul_left hp.pos eq
    · intro t ht
      obtain ⟨mem,⟨a,rfl⟩⟩ := Finset.mem_filter.mp ht
      obtain ⟨pos,cap,cop⟩ := (mem_survivors _ _ _).mp mem
      refine ⟨a,(mem_survivors _ _ _).mpr ⟨?_,?_,(Nat.coprime_mul_iff_left.mp cop).2⟩,rfl⟩
      · exact Nat.pos_of_mul_pos_left pos
      · exact (Nat.le_div_iff_mul_le hp.pos).mpr (by simpa [Nat.mul_comm] using cap)
  have union : banned ∪ kept = old := by ext; simp [banned,kept]; tauto
  have disj : Disjoint banned kept := by
    rw [Finset.disjoint_left]; intro t ht ht'
    exact (Finset.mem_filter.mp ht').2 (Finset.mem_filter.mp ht).2
  rw [← kept_eq, count]
  have eq := Finset.card_union_of_disjoint disj
  rw [union] at eq
  change (survivors n m).card = banned.card + kept.card at eq
  omega

lemma survivors_period (n w : ℕ) :
    (survivors (n+w) w).card = (survivors n w).card + w.totient := by
  have s : survivors (n+w) w = survivors n w ∪ ((Ico (n+1) (n+1+w)).filter (fun t => w.Coprime t)) := by
    ext t
    simp only [mem_survivors,mem_union,mem_filter,mem_Ico,Nat.coprime_comm (n:=w) (m:=t)]
    by_cases h : t.Coprime w <;> simp [h]; omega
  have disj : Disjoint (survivors n w) ((Ico (n+1) (n+1+w)).filter (fun t => w.Coprime t)) := by
    rw [Finset.disjoint_left]
    intro t h h'
    have a := ((mem_survivors _ _ _).mp h).2.1
    have b := (Finset.mem_Ico.mp (Finset.mem_filter.mp h').1).1
    omega
  rw [s,Finset.card_union_of_disjoint disj,Nat.filter_coprime_Ico_eq_totient]

lemma wheel_count (n w : ℕ) :
    (survivors n w).card = (n/w)*w.totient + (survivors (n%w) w).card := by
  have periods (a k : ℕ) : (survivors (a+w*k) w).card = k*w.totient+(survivors a w).card := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Nat.mul_succ,← Nat.add_assoc,survivors_period,ih,Nat.succ_mul]
      omega
  simpa only [Nat.mod_add_div] using periods (n%w) (n/w)

/-- All prime divisors of the modulus are precisely the primes up to the cutoff. -/
def complete (m k : ℕ) : Prop := ∀ q : ℕ, q.Prime → (q ∣ m ↔ q ≤ k)

lemma singleton_count (m k n : ℕ) (spec : complete m k) (hn : n ≤ k) :
    (survivors n m).card = min n 1 := by
  by_cases zero : n=0
  · simp [zero,survivors]
  have eq : survivors n m = {1} := by
    ext t
    rw [mem_survivors, Finset.mem_singleton]
    constructor
    · rintro ⟨pos,le,cop⟩
      by_contra ne
      have prime := Nat.minFac_prime ne
      have dm := (spec _ prime).mpr ((Nat.minFac_le pos).trans (le.trans hn))
      have div := Nat.dvd_gcd (Nat.minFac_dvd t) dm
      rw [cop.gcd_eq_one] at div
      exact prime.ne_one (Nat.dvd_one.mp div)
    · rintro rfl
      exact ⟨by decide,by omega,Nat.coprime_one_left _⟩
  simp [eq, Nat.min_eq_right (by omega : 1 ≤ n)]

lemma saturated (m k n : ℕ) (spec : complete m k) (kn : k ≤ n) (hn : 0 < n)
    (cap : n < (k+1)^2) :
    (survivors n m).card = 1 + n.primeCounting - k.primeCounting := by
  have interval : survivors n m = insert 1 (n.primesLE \ k.primesLE) := by
    ext t
    simp only [mem_survivors,Finset.mem_insert,Finset.mem_sdiff,Nat.mem_primesLE]
    constructor
    · rintro ⟨pos,le,cop⟩
      by_cases one : t=1
      · exact Or.inl one
      have mf := Nat.minFac_prime one
      have no : ¬t.minFac ∣ m := by
        intro dm
        have div := Nat.dvd_gcd (Nat.minFac_dvd t) dm
        rw [cop.gcd_eq_one] at div
        exact mf.ne_one (Nat.dvd_one.mp div)
      have lower : k < t.minFac := by by_contra! h; exact no ((spec _ mf).mpr h)
      have prime : t.Prime := by
        refine Nat.prime_def_le_sqrt.mpr ⟨by omega,?_⟩
        intro v two lim dv
        have bound : t.sqrt < k+1 := Nat.sqrt_lt.mpr (by simpa only [pow_two] using le.trans_lt cap)
        have minle := Nat.minFac_le_of_dvd two dv
        omega
      have kt : k < t := lower.trans_le (Nat.minFac_le pos)
      exact Or.inr ⟨⟨le,prime⟩,fun h => (Nat.not_le.mpr kt) h.1⟩
    · rintro (rfl | h)
      · exact ⟨by decide, hn, Nat.coprime_one_left _⟩
      · obtain ⟨⟨le,prime⟩,out⟩ := h
        exact ⟨prime.pos,le,prime.coprime_iff_not_dvd.mpr (fun dm => out ⟨(spec _ prime).mp dm,prime⟩)⟩
  have incl : k.primesLE ⊆ n.primesLE := by
    intro t ht
    obtain ⟨le,prime⟩ := Nat.mem_primesLE.mp ht
    exact Nat.mem_primesLE.mpr ⟨le.trans kn,prime⟩
  have one : 1 ∉ n.primesLE \ k.primesLE := by simp [Nat.mem_primesLE,Nat.not_prime_one]
  rw [interval,Finset.card_insert_of_notMem one,Finset.card_sdiff_of_subset incl,
      Nat.primesLE_card_eq_primeCounting,Nat.primesLE_card_eq_primeCounting]
  have le := Nat.monotone_primeCounting kn
  omega

def partialSieve (wheel rank : ℕ → ℕ) : List ℕ → ℕ → ℕ
  | [], n => wheel n
  | p::ps, n => if n ≤ p then min n 1 else if n ≤ 65535 ∧ n < (p+1)^2 then
      1 + rank n - rank p else partialSieve wheel rank ps n - partialSieve wheel rank ps (n/p)

lemma base_spec : complete 2310 11 := by
  intro q prime
  have eq : 2310 = 2*3*5*7*11 := by decide
  rw [eq]
  simp only [prime.dvd_mul]
  have prime2 : Nat.Prime 2 := by decide
  have prime3 : Nat.Prime 3 := by decide
  have prime5 : Nat.Prime 5 := by decide
  have prime7 : Nat.Prime 7 := by decide
  have prime11 : Nat.Prime 11 := by decide
  simp only [Nat.prime_dvd_prime_iff_eq prime,prime2,prime3,prime5,prime7,prime11]
  constructor
  · rintro ((((h|h)|h)|h)|h) <;> omega
  · intro h
    interval_cases q <;> first | decide | norm_num at prime

lemma prime_mem (q : ℕ) (hq : q.Prime) (ps : List ℕ) (pr : ∀ p ∈ ps, p.Prime) :
    q ∣ ps.prod ↔ q ∈ ps := by
  induction ps with
  | nil => simp [hq.ne_one]
  | cons p ps ih =>
    rw [List.prod_cons,hq.dvd_mul,Nat.prime_dvd_prime_iff_eq hq (pr p List.mem_cons_self),
        ih (fun t h => pr t (List.mem_cons_of_mem _ h)),List.mem_cons]

lemma modulus_spec (ps : List ℕ) (k : ℕ) (pr : ∀ p ∈ ps, p.Prime)
    (covered : ∀ q : ℕ, q.Prime → (q ≤ k ↔ q ≤ 11 ∨ q ∈ ps)) :
    complete (2310*ps.prod) k := by
  intro q hq
  rw [hq.dvd_mul,base_spec q hq,prime_mem q hq ps pr,covered q hq]

lemma partial_correct (wheel rank : ℕ → ℕ)
    (hw : ∀ n : ℕ, wheel n = (survivors n 2310).card)
    (hr : ∀ n : ℕ, n ≤ 65535 → rank n = n.primeCounting)
    (ps : List ℕ) (desc : ps.Pairwise (· > ·))
    (pr : ∀ p ∈ ps, p.Prime ∧ 11 < p)
    (covered : ∀ p ∈ ps, ∀ q : ℕ, q.Prime → q ≤ p → q ≤ 11 ∨ q ∈ ps)
    (n : ℕ) : partialSieve wheel rank ps n = (survivors n (2310*ps.prod)).card := by
  induction ps generalizing n with
  | nil => simpa [partialSieve] using hw n
  | cons p ps ih =>
    obtain ⟨smaller,sorted⟩ := List.pairwise_cons.mp desc
    have tailpr (t : ℕ) (h : t ∈ ps) := pr t (List.mem_cons_of_mem p h)
    have tailcovered (v : ℕ) (hv : v ∈ ps) (q : ℕ) (hq : q.Prime) (le : q ≤ v) :
        q ≤ 11 ∨ q ∈ ps := by
      have vp := smaller v hv
      rcases covered v (List.mem_cons_of_mem p hv) q hq le with h | h
      · exact Or.inl h
      · rcases List.mem_cons.mp h with eq|rest
        · omega
        · exact Or.inr rest
    have piv := pr p List.mem_cons_self
    have spec : complete (2310*(p::ps).prod) p := by
      apply modulus_spec _ _ (fun v hv => (pr v hv).1)
      intro q hq
      refine ⟨covered p List.mem_cons_self q hq,?_⟩
      rintro (le|mem)
      · omega
      · rcases List.mem_cons.mp mem with eq|rest
        · omega
        · exact (smaller q rest).le
    rw [partialSieve]
    split
    · rename_i h
      exact (singleton_count _ _ _ spec h).symm
    · rename_i h
      split
      · rename_i bounds
        rw [hr n bounds.1,hr p (by omega)]
        exact (saturated _ _ _ spec (by omega) (by omega) bounds.2).symm
      · rw [ih sorted tailpr tailcovered n, ih sorted tailpr tailcovered (n/p)]
        have cop : p.Coprime (2310*ps.prod) := by
          rw [piv.1.coprime_iff_not_dvd,piv.1.dvd_mul,base_spec p piv.1,prime_mem p piv.1 ps (fun t ht => (tailpr t ht).1)]
          rintro (le|mem)
          · omega
          · exact (Nat.lt_irrefl p) (smaller p mem)
        rw [List.prod_cons,show 2310*(p*ps.prod) = p*(2310*ps.prod) by ring,sieve_step _ _ _ piv.1 cop]



