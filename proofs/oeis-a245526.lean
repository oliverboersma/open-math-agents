def rank (n : ℕ) : ℕ :=
  let row := primeRow (n/64)
  (row >>> 384) + ((row >>> (6*(n%64))) % 64)

def smallPrime (n : ℕ) : Bool :=
  if n ≤ 256 then decide n.Prime else n.gcd (Nat.factorial 256) == 1

lemma smallPrime_true {n : ℕ} (h : n ≤ 65535) : smallPrime n = true ↔ n.Prime := by
  unfold smallPrime
  split
  · simp
  · rename_i big
    simp only [beq_iff_eq]
    change n.Coprime (Nat.factorial 256) ↔ n.Prime
    constructor
    · intro free
      have cut := (Nat.coprime_factorial_iff (by omega : n ≠ 1)).mp free
      refine Nat.prime_def_le_sqrt.mpr ⟨by omega,?_⟩
      intro t ht hs dv
      have bound : n.sqrt < 257 := Nat.sqrt_lt.mpr (by omega)
      have le := Nat.minFac_le_of_dvd ht dv
      omega
    · intro hp
      exact hp.coprime_factorial_of_lt (by omega)

def rankTick (n : ℕ) : Bool :=
  rank (n+1) == rank n + (if smallPrime (n+1) then 1 else 0)

