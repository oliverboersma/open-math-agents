lemma rank_tick_true (n : ℕ) (hn : n < 65535) : rankTick n = true := by
  by_cases lt1024 : n < 1024
  · have h := rank_check_0 ⟨n-0,by omega⟩
    change rankTick (0+(n-0)) = true at h
    rwa [show 0+(n-0)=n by omega] at h
  by_cases lt2048 : n < 2048
  · have h := rank_check_1024 ⟨n-1024,by omega⟩
    change rankTick (1024+(n-1024)) = true at h
    rwa [show 1024+(n-1024)=n by omega] at h
  by_cases lt3072 : n < 3072
  · have h := rank_check_2048 ⟨n-2048,by omega⟩
    change rankTick (2048+(n-2048)) = true at h
    rwa [show 2048+(n-2048)=n by omega] at h
  by_cases lt4096 : n < 4096
  · have h := rank_check_3072 ⟨n-3072,by omega⟩
    change rankTick (3072+(n-3072)) = true at h
    rwa [show 3072+(n-3072)=n by omega] at h
  by_cases lt5120 : n < 5120
