def fast (n : ℕ) : Bool :=
  if n ≤ 2057*2057 then test 2057 P2057 n else test 20007 P20007 n

theorem sound {n : ℕ} (h : fast n = true) : Squarefree n := by
  unfold fast at h
  split at h
  · exact test_sound cert2057 h
  · exact test_sound cert20007 h

