private theorem cert2057 (q : ℕ) (hq : q ≤ 2057) (hp : q.Prime) :
    q ∣ P2057 ∧ ¬ q*q ∣ P2057 := by
  let i : Fin 17 := ⟨q/128, by omega⟩
  obtain ⟨w,hv⟩ := blocks2057 i
  have hr : q%128 ∈ List.range 128 := List.mem_range.mpr (Nat.mod_lt _ (by decide))
  have h := List.all_eq_true.mp hv _ hr
  change ok P2057 (i.val*128+q%128) _ = true at h
  have e : i.val*128+q%128 = q := by dsimp [i]; omega
  rw [e] at h
  exact ok_sound hp h

