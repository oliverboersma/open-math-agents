private def proper (xs : List ℕ) : Bool :=
  xs.all fun a => xs.all fun b => decide (a=b) || Erdos848Reflect.fast (a*b+1)

private def valid (j : ℕ) : Bool :=
  let row := rowAt j
  let t := row.length
  let start := 25*(j-t)+7
  decide (0 < t ∧ t ≤ j) &&
    (List.range (25*t)).all (fun d =>
      let a := start+d
      row.any (fun xs => xs.contains a) || Erdos848Reflect.fast (a*a+1)) &&
    row.all proper

private def chunk (c : ℕ) : Bool :=
  (List.range 25).all fun d =>
    let j := 25*c+d
    decide (j = 0 ∨ 800 < j) || valid j
