-- The generator supplies trial checkpoint values. Their only use in the
-- proof is as input to the independently verified block equations.
def Eight.mapNums (f : ℕ→ℕ) (v : Eight) : Eight :=
  ⟨f v.m1,f v.m7,f v.m11,f v.m13,f v.m17,f v.m19,f v.m23,f v.m29⟩

def trialWord (p bits pos x : UInt64) : UInt64 :=
  if ((bits >>> pos) &&& 1) = 0 then x else
    let s := x+p
    s / (s &&& (0-s))

def wordRow (b : ℕ) (m : Eight) (start : ℕ) : ℕ :=
  let a := m.m1.toUInt64
  let c := m.m7.toUInt64
  let d := m.m11.toUInt64
  let e := m.m13.toUInt64
  let f := m.m17.toUInt64
  let g := m.m19.toUInt64
  let h := m.m23.toUInt64
  let k := m.m29.toUInt64
  let step := fun (j x : UInt64) =>
    let p := 30*(b.toUInt64+j)
    let x := trialWord (p+1) a j x
    let x := trialWord (p+7) c j x
    let x := trialWord (p+11) d j x
    let x := trialWord (p+13) e j x
    let x := trialWord (p+17) f j x
    let x := trialWord (p+19) g j x
    let x := trialWord (p+23) h j x
    trialWord (p+29) k j x
  ((List.range 64).foldl (fun x j => step j.toUInt64 x) start.toUInt64).toNat


def trialSeeds : ℕ→ℕ→Eight→ℕ→(ℕ×ℕ)
  | 0,b,m,start => (start/2, wordRow b m start)
  | l+1,b,m,start =>
    let half := 64 <<< l
    let lo := trialSeeds l b (m.mapNums (fun a => a &&& ((1 <<< half)-1))) start
    let hi := trialSeeds l (b+half) (m.mapNums (fun a => a >>> half)) lo.2
    (lo.1 ||| (hi.1 <<< half),hi.2)



