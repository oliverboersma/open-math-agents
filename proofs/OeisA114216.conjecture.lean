noncomputable def specializedBad (b r : ℕ) : ℕ :=
  (List.range 79).foldl (fun a i => (templates i).foldl (fun acc v =>
    if v.1.1*v.1.1 ≤ 30*(b+width)+29 then acc ||| (v.2 >>> ((b+r*v.1.2)%v.1.1))
    else acc) a) 0

theorem specializedBad_eq (b r : ℕ) : specializedBad b r = groupComposite width b r primeChunks := by
  let fn := fun (acc : ℕ) (pv : ℕ×ℕ) => if pv.1*pv.1 ≤ 30*(b+width)+29
    then acc ||| oneMark width b r pv else acc
  have h (is : List ℕ) (hi : ∀ i∈is, i<79) (a : ℕ) :
      is.foldl (fun acc i => (templates i).foldl (fun v elem =>
        if elem.1.1*elem.1.1 ≤ 30*(b+width)+29 then v ||| (elem.2 >>> ((b+r*elem.1.2)%elem.1.1))
        else v) acc) a = (is.map primeTable).flatten.foldl fn a := by
    induction is generalizing a with
    | nil => rfl
    | cons i tl ih =>
      simp only [List.map_cons,List.flatten_cons,List.foldl_append,List.foldl_cons]
      rw [templates_eq i (hi i (by simp)),decorate,List.foldl_map]
      exact ih (fun j hj => hi j (by simp [hj])) _
  exact h (List.range 79) (fun _ hi => List.mem_range.mp hi) 0

noncomputable def specialMask (b r : ℕ) :=
  let lim := (1 <<< min width ((1579691809-r)/30+1-b))-1
  lim ^^^ (specializedBad b r &&& lim)

theorem specialMask_eq (b r : ℕ) : specialMask b r = primeMask width b r := by
  simp only [specialMask,primeMask,specializedBad_eq]


def allRawMasks (b : ℕ) (ts : List (List ((ℕ×ℕ)×ℕ))) : Eight :=
  let calculate := fun r =>
    let v := ts.foldl (fun a l => l.foldl (fun k pv =>
      if pv.1.1*pv.1.1 ≤ 30*(b+width)+29 then k ||| (pv.2 >>> ((b+r*pv.1.2)%pv.1.1))
      else k) a) 0
    let univ := (1 <<< min width ((1579691809-r)/30+1-b))-1
    univ ^^^ (v &&& univ)
  ⟨calculate 1,calculate 7,calculate 11,calculate 13,calculate 17,calculate 19,calculate 23,calculate 29⟩

def groupTrials (l : ℕ) (inputs : List (ℕ×ℕ)) : List (List ℕ) :=
  let ts := primeChunks.map decorate
  inputs.map (fun v =>
    let m := allRawMasks v.1 ts
    let z := (trialSeeds l v.1 m v.2).1
    [z,m.m1,m.m7,m.m11,m.m13,m.m17,m.m19,m.m23,m.m29])

def asEight (v : List ℕ) : Eight :=
  ⟨v.getD 1 0,v.getD 2 0,v.getD 3 0,v.getD 4 0,v.getD 5 0,v.getD 6 0,v.getD 7 0,v.getD 8 0⟩

theorem useCertificate (l b first last : ℕ) (v : List ℕ) (hw : 64*2^l=width)
    (hb : 40000<30*b) (hend : 30*(b+width)+30<2^31) (hf : first<2^64) (hl : last<2^64)
    (h1 : v.getD 1 0=specialMask b 1) (h7 : v.getD 2 0=specialMask b 7)
    (h11 : v.getD 3 0=specialMask b 11) (h13 : v.getD 4 0=specialMask b 13)
    (h17 : v.getD 5 0=specialMask b 17) (h19 : v.getD 6 0=specialMask b 19)
    (h23 : v.getD 7 0=specialMask b 23) (h29 : v.getD 8 0=specialMask b 29)
    (hz : agrees l b first last (v.getD 0 0) (asEight v))
    (hs : maskedState (30*b)=first) : maskedState (30*(b+width))=last := by
  have hm : asEight v = mats (64*2^l) b := by
    simp only [hw,asEight,mats,h1,h7,h11,h13,h17,h19,h23,h29,specialMask_eq]
  simpa only [hw] using close_group l b first last (v.getD 0 0) (asEight v) hm hb
    (by simpa only [hw] using hend) hf hl hz hs



theorem certificateAt (i j l b first last : ℕ) (v : List ℕ)
    (hi : i=30*b) (hj : j=30*(b+width)) (hw : 64*2^l=width)
    (hb : 40000<30*b) (hend : 30*(b+width)+30<2^31) (hf : first<2^64) (hl : last<2^64)
    (h1 : v.getD 1 0=specialMask b 1) (h7 : v.getD 2 0=specialMask b 7)
    (h11 : v.getD 3 0=specialMask b 11) (h13 : v.getD 4 0=specialMask b 13)
    (h17 : v.getD 5 0=specialMask b 17) (h19 : v.getD 6 0=specialMask b 19)
    (h23 : v.getD 7 0=specialMask b 23) (h29 : v.getD 8 0=specialMask b 29)
    (hz : agrees l b first last (v.getD 0 0) (asEight v)) (hs : maskedState i=first) :
    maskedState j=last := by
  subst i; subst j
  exact useCertificate l b first last v hw hb hend hf hl h1 h7 h11 h13 h17 h19 h23 h29 hz hs

theorem finishAt (i : ℕ) (hi : cap ≤ i) (h : maskedState i=1) : state 1579691810=1 := by
  change state cap = 1
  change state (min i cap) = 1 at h
  exact (congrArg state (min_eq_right hi)).symm.trans h



def trialEntry (l : ℕ) (ts : List (List ((ℕ×ℕ)×ℕ))) (entry : ℕ×ℕ) : List ℕ :=
  let m := allRawMasks entry.1 ts
  let z := (trialSeeds l entry.1 m entry.2).1
  [z,m.m1,m.m7,m.m11,m.m13,m.m17,m.m19,m.m23,m.m29]

def parallelTrials (l : ℕ) (inputs : List (ℕ×ℕ)) : List (List ℕ) :=
  let ts := primeChunks.map decorate
  let workers := inputs.map (fun v => Task.spawn (fun _ => trialEntry l ts v))
  workers.map Task.get



