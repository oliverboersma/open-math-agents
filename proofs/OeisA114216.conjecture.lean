def primeChunks := (List.range 79).map primeTable


def stencil (p : ℕ) : ℕ → ℕ
  | 0 => 1
  | k+1 => let m := stencil p k; m ||| (m <<< (p <<< k))

def template (w p : ℕ) : ℕ :=
  stencil p (((w+p)/p).log2+1) &&& ((1 <<< (w+p))-1)

def oneMark (w b r : ℕ) (pv : ℕ×ℕ) : ℕ :=
  template w pv.1 >>> ((b + r*pv.2)%pv.1)

def groupComposite (w b r : ℕ) (blocks : List (List (ℕ×ℕ))) : ℕ :=
  blocks.flatten.foldl (fun acc pv => if pv.1*pv.1 ≤ 30*(b+w)+29
    then acc ||| oneMark w b r pv else acc) 0

def primeMask (w b r : ℕ) : ℕ :=
  let num := min w ((1579691809-r)/30+1-b)
  let univ := (1 <<< num)-1
  let bad := groupComposite w b r primeChunks
  univ ^^^ (bad &&& univ)

theorem stencil_bit (p : ℕ) (hp : 0<p) (k t : ℕ) :
    (stencil p k).testBit t = decide (p ∣ t ∧ t<p*2^k) := by
  induction k generalizing t with
  | zero =>
    simp only [stencil, pow_zero,mul_one]
    by_cases hz : t=0
    · subst t; simp [hp]
    · have h : ¬(p ∣ t ∧ t<p) := by
        rintro ⟨hd, hlt⟩
        exact (Nat.le_of_dvd (by omega) hd).not_gt hlt
      simp only [h, decide_false]
      exact Nat.testBit_lt_two_pow (by have := Nat.pow_le_pow_right (by decide : 0<2) (show 1≤t by omega); omega)
  | succ k ih =>
    have hd : p ∣ p*2^k := dvd_mul_right _ _
    have hs : p <<< k = p*2^k := Nat.shiftLeft_eq _ _
    rw [stencil, Nat.testBit_or, Nat.testBit_shiftLeft, hs, ih, ih]
    by_cases he : t < p*2^k
    · have ht : t < p*2^(k+1) := by rw [pow_succ]; nlinarith
      simp [he, ht, show ¬ t≥p*2^k by omega]
    · have hle : p*2^k ≤ t := by omega
      have hd' : p ∣ t-p*2^k ↔ p ∣ t := Nat.dvd_sub_iff_left hle hd
      have hs' : t-p*2^k < p*2^k ↔ t<p*2^(k+1) := by
        rw [pow_succ, ← Nat.mul_assoc]; omega
      simp [he, hle, hd', hs']

theorem template_bit (w p t : ℕ) (hp : 0<p) (ht : t<w+p) :
    (template w p).testBit t = decide (p ∣ t) := by
  have hn : 0 < (w+p)/p := Nat.div_pos (by omega) hp
  have hq := (Nat.log2_lt hn.ne').mp (Nat.lt_succ_self ((w+p)/p).log2)
  have hb : t < p*2^(((w+p)/p).log2+1) := by
    have hd := (Nat.div_lt_iff_lt_mul hp).mp hq
    simpa [Nat.mul_comm] using lt_of_lt_of_le ht hd.le
  rw [template, show (1 : ℕ) <<< (w+p) = 2^(w+p) by rw [Nat.shiftLeft_eq,one_mul],
    Nat.and_two_pow_sub_one_eq_mod,Nat.testBit_mod_two_pow,stencil_bit _ hp]
  simp [ht,hb]

theorem mark_bit (w b r : ℕ) (pv : ℕ×ℕ) (hp : 0<pv.1)
    (hi : 30*pv.2 ≡ 1 [MOD pv.1]) (t : ℕ) (ht : t<w) :
    (oneMark w b r pv).testBit t = decide (pv.1 ∣ 30*(b+t)+r) := by
  rw [oneMark, Nat.testBit_shiftRight, template_bit]
  · congr 1
    have h0 : ((b+r*pv.2)%pv.1 + t) ≡ (b+t+r*pv.2) [MOD pv.1] := by
      simpa [add_assoc, Nat.add_comm, Nat.add_left_comm] using
        (Nat.mod_modEq (b+r*pv.2) pv.1).add_right t
    have h1 : 30*(b+t+r*pv.2) ≡ 30*(b+t)+r [MOD pv.1] := by
      convert (hi.mul_left r).add_left (30*(b+t)) using 1 <;> ring
    have h2 : (30*(b+t)+r)*pv.2 ≡ b+t+r*pv.2 [MOD pv.1] := by
      convert (hi.mul_left (b+t)).add_right (r*pv.2) using 1 <;> ring
    apply propext
    constructor
    · intro hd
      exact Nat.modEq_zero_iff_dvd.mp (h1.symm.trans
        (((h0.symm.trans (Nat.modEq_zero_iff_dvd.mpr hd)).mul_left 30).trans (by simp [Nat.ModEq])))
    · intro hd
      exact Nat.modEq_zero_iff_dvd.mp (h0.trans (h2.symm.trans
        (((Nat.modEq_zero_iff_dvd.mpr hd).mul_right pv.2).trans (by simp [Nat.ModEq]))))
  · exact hp
  · have := Nat.mod_lt (b+r*pv.2) hp
    omega


def possible (p : ℕ) : Bool :=
  decide (7≤p ∧ p≤40000) && (if p≤200 then decide p.Prime else Nat.gcd p (Nat.factorial 200) == 1)

def validTable (i : ℕ) : Bool :=
  (primeTable i).all (fun v => decide (7≤v.1 ∧ v.1≤40000 ∧ 30*v.2%v.1=1)) &&
  ((primeTable i).map Prod.fst == (List.range' (512*i) 512).filter possible)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem table_ok (i : ℕ) (hi : i<79) : validTable i = true := by
  interval_cases i <;> decide +kernel


theorem table_checks {i : ℕ} (hi : i<79) :
    ((primeTable i).all (fun v => decide (7≤v.1 ∧ v.1≤40000 ∧ 30*v.2%v.1=1))) = true ∧
    (primeTable i).map Prod.fst = (List.range' (512*i) 512).filter possible := by
  simpa [validTable] using table_ok i hi

theorem pair_valid {v : ℕ×ℕ} (hv : v ∈ primeChunks.flatten) :
    7≤v.1 ∧ v.1≤40000 ∧ 30*v.2 ≡ 1 [MOD v.1] := by
  obtain ⟨l,hl,hv⟩ := List.mem_flatten.mp hv
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hl
  obtain ⟨hlo,hhi,hinv⟩ := of_decide_eq_true ((List.all_eq_true.mp (table_checks (List.mem_range.mp hi)).1) v hv)
  exact ⟨hlo,hhi,by simpa [Nat.ModEq, Nat.mod_eq_of_lt (show 1<v.1 by omega)] using hinv⟩

theorem pair_exists {p : ℕ} (hp : p.Prime) (hlo : 7≤p) (hhi : p≤40000) :
    ∃ v∈primeChunks.flatten, v.1=p := by
  let i := p/512
  have hi : i < 79 := by dsimp [i]; omega
  have hc : possible p = true := by
    simp only [possible, hlo, hhi, and_self, decide_true, Bool.true_and]
    split <;> rename_i hx
    · simp [hp]
    · exact beq_iff_eq.mpr ((hp.coprime_factorial_of_lt (by omega)).gcd_eq_one)
  have hmem : p ∈ (primeTable i).map Prod.fst := by
    rw [(table_checks hi).2]
    apply List.mem_filter.mpr
    exact ⟨List.mem_range'.mpr ⟨p%512,by omega,by dsimp [i]; omega⟩,hc⟩
  obtain ⟨v,hv,he⟩ := List.mem_map.mp hmem
  exact ⟨v,List.mem_flatten.mpr ⟨_,List.mem_map.mpr ⟨i,List.mem_range.mpr hi,rfl⟩,hv⟩,he⟩




theorem composite_fold (w b r t : ℕ) (ht : t<w) (l : List (ℕ×ℕ)) (acc : ℕ)
    (hv : ∀ v∈l, v∈primeChunks.flatten) :
    ((l.foldl (fun acc pv => if pv.1*pv.1 ≤ 30*(b+w)+29 then acc ||| oneMark w b r pv else acc) acc).testBit t = true) ↔
    acc.testBit t = true ∨ ∃ v∈l, v.1*v.1 ≤ 30*(b+w)+29 ∧ v.1 ∣ 30*(b+t)+r := by
  induction l generalizing acc with
  | nil => simp
  | cons hd tl ih =>
    have hh := pair_valid (hv hd (by simp))
    have hv' : ∀ v∈tl, v∈primeChunks.flatten := fun v h => hv v (by simp [h])
    rw [List.foldl_cons, ih _ hv']
    by_cases hsize : hd.1*hd.1 ≤ 30*(b+w)+29
    · rw [if_pos hsize,Nat.testBit_or,mark_bit _ _ _ _ (by omega : 0<hd.1) hh.2.2 _ ht]
      simp [hsize]; tauto
    · simp [hsize]

theorem primeMask_bit (w b r t : ℕ) (ht : t<w) (hb : 40000 < 30*b)
    (hr : r<30) (hc : Nat.Coprime 30 r) :
    (primeMask w b r).testBit t =
    decide ((30*(b+t)+r).Prime ∧ 30*(b+t)+r≤1579691809) := by
  have hu : t < min w ((1579691809-r)/30+1-b) ↔ 30*(b+t)+r ≤ 1579691809 := by omega
  have huniv (j : ℕ) : ((1 <<< j)-1 : ℕ).testBit t = decide (t<j) := by
    rw [Nat.shiftLeft_eq,one_mul,Nat.testBit_two_pow_sub_one]
  let x := 30*(b+t)+r
  have hx : 40000<x := by dsimp [x]; omega
  have hcop : Nat.Coprime 30 x := by simpa [x, Nat.Coprime, Nat.gcd_mul_left_add_left] using hc
  have he : (groupComposite w b r primeChunks).testBit t = true ↔
      ∃ v∈primeChunks.flatten, v.1*v.1 ≤ 30*(b+w)+29 ∧ v.1 ∣ x := by
    simpa [groupComposite,x] using composite_fold w b r t ht primeChunks.flatten 0 (fun _ h => h)
  by_cases hlim : x≤1579691809
  · have hcomp : (groupComposite w b r primeChunks).testBit t = true ↔ ¬x.Prime := by
      rw [he]
      constructor
      · rintro ⟨v,hv,_,hd⟩ hp
        have hval := pair_valid hv
        exact (hp.eq_one_or_self_of_dvd _ hd).elim (by omega) (by omega)
      · intro hnp
        let p := x.minFac
        have hp : p.Prime := Nat.minFac_prime (by omega)
        have hd : p ∣ x := Nat.minFac_dvd x
        have hs : p^2≤x := Nat.minFac_sq_le_self (by omega) hnp
        have hpmax : p≤40000 := by nlinarith
        have hpmin : 7≤p := by
          by_contra! hh
          have hdiv : p∣30 := by interval_cases p <;> norm_num at *
          exact hp.not_dvd_one (Nat.dvd_trans (Nat.dvd_gcd hdiv hd) (by rw [hcop.gcd_eq_one]))
        obtain ⟨v,hv,heq⟩ := pair_exists hp hpmin hpmax
        refine ⟨v,hv,?_,by simpa [heq] using hd⟩
        change p^2≤30*(b+t)+r at hs
        rw [heq,←pow_two]; omega
    have hh : t < min w ((1579691809-r)/30+1-b) := hu.mpr hlim
    simp only [primeMask,Nat.testBit_xor,Nat.testBit_and,huniv,hh,decide_true,
      Bool.and_true,show 30*(b+t)+r=x from rfl,hlim,and_true]
    cases hbit : (groupComposite w b r primeChunks).testBit t <;> simp_all
  · have hh := mt hu.mp hlim
    simp [primeMask,Nat.testBit_xor,huniv,hh,show 30*(b+t)+r=x from rfl,hlim]


def gather (B t : ℕ) : ℕ → ℕ → ℕ
  | 0, s => (s >>> t) &&& 18446744073709551615
  | l+1, s =>
    let half := B <<< l
    let lo := gather B t l (s &&& ((1 <<< half)-1))
    let hi := gather B t l (s >>> half)
    lo ||| (hi <<< (64 <<< l))

def primeStep (n pos bits p x : ℕ) :=
  let flag := (bits >>> pos) &&& units n
  oddPack n (x + (p &&& (flag*4294967295)))

def residues : List ℕ := [1,7,11,13,17,19,23,29]

def rowPrime (n B b : ℕ) := pack n (fun i => 30*(b+B*i))

def tile (l B b col start : ℕ) : ℕ :=
  let n := 2^l
  let base := rowPrime n B (b+col)
  let data := residues.map (fun r => (r, gather B col l (primeMask (B*n) b r)))
  Nat.rec start (fun pos x => data.foldl
    (fun acc rd => primeStep n pos rd.2 (base + units n*(30*pos+rd.1)) acc) x) 64

def groupRun (l B b x tiles : ℕ) : ℕ :=
  Nat.rec x (fun j acc => tile l B b (64*j) acc) tiles


theorem pack_append (m n : ℕ) (f : ℕ→ℕ) :
    pack (m+n) f = pack m f + 2^(64*m) * pack n (fun j => f (m+j)) := by
  induction m generalizing f with
  | zero => simp [pack]
  | succ m ih =>
    rw [Nat.succ_add,pack,ih]
    simp only [pack,Nat.mul_succ,pow_add]
    have hf : (fun j => f (m+j+1)) = (fun j => f (m+1+j)) := by funext j; congr 1; omega
    rw [hf]; ring

theorem pack_bound (n : ℕ) (f : ℕ→ℕ) (hf : ∀ i<n, f i<2^64) :
    pack n f<2^(64*n) := by
  induction n generalizing f with
  | zero => simp [pack]
  | succ n ih =>
    have ht := ih (fun j => f (j+1)) (fun j hj => hf _ (by omega))
    have hh := hf 0 (by omega)
    rw [pack,Nat.mul_succ,pow_add]; omega

def readWord (s off : ℕ) := (s >>> off) &&& 18446744073709551615

theorem readWord_bound (s off : ℕ) : readWord s off < 2^64 :=
  lt_of_le_of_lt Nat.and_le_right (by decide)

theorem readWord_bit (s off i : ℕ) :
    (readWord s off).testBit i = (decide (i<64) && s.testBit (off+i)) := by
  unfold readWord
  change ((s >>> off) &&& (2^64-1)).testBit i = _
  rw [Nat.and_two_pow_sub_one_eq_mod,Nat.testBit_mod_two_pow,Nat.testBit_shiftRight]

theorem gather_pack (B col l s : ℕ) (hcol : col+64≤B) :
    gather B col l s = pack (2^l) (fun j => readWord s (B*j+col)) := by
  induction l generalizing s with
  | zero => simp [gather,pack,readWord]
  | succ l ih =>
    let m := 2^l
    have hB : B<<<l = B*m := by simp [m,Nat.shiftLeft_eq]
    have h64 : 64<<<l = 64*m := by simp [m,Nat.shiftLeft_eq]
    rw [gather,hB,h64,ih,ih,show 2^(l+1)=m+m by simp [m,pow_succ,Nat.mul_two]]
    rw [pack_append]
    have hlo : pack m (fun j => readWord (s &&& ((1<<<(B*m))-1)) (B*j+col))
        = pack m (fun j => readWord s (B*j+col)) := by
      apply pack_congr
      intro j hj
      apply Nat.eq_of_testBit_eq
      intro i
      rw [readWord_bit,readWord_bit]
      by_cases hh : i<64
      · have hlt : B*j+col+i<B*m := by
          have hh' := Nat.mul_le_mul_left B (Nat.succ_le_of_lt hj)
          rw [Nat.mul_succ] at hh'; omega
        rw [Nat.shiftLeft_eq,one_mul,Nat.and_two_pow_sub_one_eq_mod,Nat.testBit_mod_two_pow]
        simp [hlt,hh]
      · simp [hh]
    have hhi : pack m (fun j => readWord (s >>> (B*m)) (B*j+col))
        = pack m (fun j => readWord s (B*(m+j)+col)) := by
      apply pack_congr
      intro j _
      unfold readWord
      rw [← Nat.shiftRight_add, Nat.mul_add, Nat.add_assoc]
    change (pack m _ ||| (pack m _ <<< (64*m))) = _
    rw [hlo,hhi,Nat.shiftLeft_eq,Nat.mul_comm _ (2^_),Nat.or_comm,
      ← Nat.two_pow_add_eq_or_of_lt (pack_bound m _ (fun j _ => readWord_bound ..))]
    omega

theorem readWord_pack (n : ℕ) (f : ℕ→ℕ) (h : ∀ i<n, f i<2^64) (j : ℕ) (hj : j<n) :
    readWord (pack n f) (64*j) = f j := by
  apply Nat.eq_of_testBit_eq
  intro k
  rw [readWord_bit,pack_bit _ _ h]
  by_cases hk : k<64
  · have hd : (64*j+k)/64=j := by omega
    have hm : (64*j+k)%64=k := by omega
    simp [hk,hd,hm,hj]
  · simp [hk,Nat.testBit_lt_two_pow
      (lt_of_lt_of_le (h j hj) (Nat.pow_le_pow_right (by decide : 0<2) (by omega : 64≤k)))]


def cap := 1579691810
def admissible (x : ℕ) := Odd x ∧ x < 2^31
def advance (p x : ℕ) := if p.Prime ∧ p < cap then strip (x+p) else x
noncomputable def maskedState (p : ℕ) := state (min p cap)

theorem maskedState_succ (p : ℕ) : maskedState (p+1) = advance p (maskedState p) := by
  by_cases h : p < cap
  · simp [maskedState, advance, h, min_eq_left (by omega : p+1≤cap), min_eq_left h.le, state_succ]
  · simp [maskedState, advance, h, min_eq_right (by omega : cap≤p+1), min_eq_right (by omega : cap≤p)]

theorem advance_ok {p x : ℕ} (hp : 2<p) (hx : admissible x) : admissible (advance p x) := by
  unfold advance
  split
  · rename_i h
    obtain ⟨hpp,hpbound⟩ := h
    obtain ⟨ho,hb⟩ := hx
    have he := even_iff_two_dvd.mp (ho.add_odd (hpp.odd_of_ne_two (by omega)))
    have hv := one_le_padicValNat_of_dvd (p:=2) (n:=x+p) (by omega) he
    have ht : 2≤2^padicValNat 2 (x+p) := Nat.le_of_dvd (by positivity) (dvd_pow_self _ (by omega))
    refine ⟨strip_odd _ (by omega), ?_⟩
    unfold strip
    have := Nat.div_le_div_left (a:=x+p) ht (by decide)
    dsimp [cap] at hpbound
    omega
  · exact hx

theorem primeStep_pack (n pos : ℕ) (hpos : pos<64)
    (bits primes vals : ℕ→ℕ)
    (hbits : ∀ i<n, bits i < 2^64) (hp : ∀ i<n, primes i < 2^31)
    (hx : ∀ i<n, admissible (vals i))
    (hm : ∀ i<n, (bits i).testBit pos = decide ((primes i).Prime ∧ primes i<cap)) :
    primeStep n pos (pack n bits) (pack n primes) (pack n vals) =
    pack n (fun i => advance (primes i) (vals i)) := by
  let live := fun i => if (primes i).Prime ∧ primes i<cap then 1 else 0
  have hfl : (pack n bits >>> pos) &&& units n = pack n live := by
    have hh := pack_mask_shift n bits hbits pos 1 (by omega)
    change (pack n bits >>> pos) &&& pack n (fun _ => 1) = _
    norm_num only at hh
    refine hh.trans (pack_congr ?_)
    intro i hi
    rw [Nat.and_one_is_mod,Nat.shiftRight_eq_div_pow]
    have hh := hm i hi
    rw [Nat.testBit_eq_decide_div_mod_eq,decide_eq_decide] at hh
    have hb := Nat.mod_lt (bits i / 2^pos) (by decide : 0<2)
    by_cases h : (primes i).Prime ∧ primes i<cap
    · simp [live,h,hh.mpr h]
    · have hne := mt hh.mp h
      simp only [live,if_neg h]; omega
  let mask := fun i => live i * 4294967295
  have hmask (i : ℕ) : mask i≤4294967295 := by dsimp [mask,live]; split <;> decide
  have hpr : ∀ i<n, primes i<2^64 := fun i hi => lt_trans (hp i hi) (by decide)
  simp only [primeStep,hfl]
  rw [pack_mul]
  change oddPack n (pack n vals + (pack n primes &&& pack n mask)) = _
  rw [pack_and _ _ _ hpr (fun i _ => lt_of_le_of_lt (hmask i) (by decide)),pack_add]
  let z := fun i => vals i + (primes i &&& mask i)
  have hz (i : ℕ) (hi : i<n) : 0 < z i ∧ z i<2^32 := by
    have hv := (hx i hi).2
    have ho := (hx i hi).1
    obtain ⟨k,hk⟩ := ho
    have hh := Nat.and_le_left (n:=primes i) (m:=mask i)
    have hh' := hp i hi
    dsimp [z]; omega
  change oddPack n (pack n z) = _
  rw [oddPack_pack n z (fun i hi => (hz i hi).1) (fun i hi => (hz i hi).2)]
  refine pack_congr ?_
  intro i hi
  have h32 : primes i<2^32 := lt_trans (hp i hi) (by decide)
  by_cases h : (primes i).Prime ∧ primes i<cap
  · simp [z,mask,live,advance,h,Nat.and_two_pow_sub_one_of_lt_two_pow h32]
  · simp [z,mask,live,advance,h]
    exact strip_eq_of_odd (e:=0) (hx i hi).1 (by simp)

def walk (b len x : ℕ) : ℕ := Nat.rec x (fun j acc => advance (b+j) acc) len
theorem walk_state (b len : ℕ) : walk b len (maskedState b) = maskedState (b+len) := by
  induction len with
  | zero => simp [walk]
  | succ len ih =>
    change advance (b+len) (walk b len (maskedState b)) = _
    rw [ih,← maskedState_succ]; rfl

def turn (q x : ℕ) := residues.foldl (fun acc r => advance (30*q+r) acc) x
theorem walk_fold (b len x : ℕ) : walk b len x =
    (List.range len).foldl (fun acc r => advance (b+r) acc) x := by
  induction len with
  | zero => rfl
  | succ len ih => simp [walk,List.range_succ,List.foldl_append,← ih]

theorem nonresidue (q r : ℕ) (hq : 1<q) (hr : r<30) (hn : r∉residues) : ¬(30*q+r).Prime := by
  have ht : residues = (List.range 30).filter (Nat.Coprime 30) := by decide
  have hnc : ¬Nat.Coprime 30 r := by simpa [ht,hr] using hn
  have hg : Nat.gcd 30 (30*q+r) = Nat.gcd 30 r := by simp
  intro hp
  have hcop := hp.coprime_iff_not_dvd.mpr (show ¬ 30*q+r ∣ 30 by
    intro hd
    have := Nat.le_of_dvd (by decide : 0<30) hd
    omega)
  exact hnc (hg.symm.trans hcop.symm.gcd_eq_one)

theorem turn_walk (q x : ℕ) (hq : 1<q) : turn q x = walk (30*q) 30 x := by
  have hf (rs : List ℕ) (hr : ∀ r∈rs, r<30) (x : ℕ) :
      (rs.filter (fun r => decide (r∈residues))).foldl (fun acc r => advance (30*q+r) acc) x =
      rs.foldl (fun acc r => advance (30*q+r) acc) x := by
    induction rs generalizing x with
    | nil => rfl
    | cons hd tl ih =>
      have hl : ∀ r∈tl, r<30 := fun r h => hr r (by simp [h])
      by_cases hh : hd∈residues
      · simp [hh,ih hl]
      · have hnp := nonresidue q hd hq (hr hd (by simp)) hh
        have ha : advance (30*q+hd) x=x := by simp [advance,hnp]
        simp [hh,ha,ih hl]
  have hlist : (List.range 30).filter (fun r => decide (r∈residues)) = residues := by decide
  simpa only [turn,walk_fold,hlist] using hf (List.range 30) (fun _ h => List.mem_range.mp h) x

theorem turn_state (q : ℕ) (hq : 1<q) : turn q (maskedState (30*q)) = maskedState (30*(q+1)) := by
  rw [turn_walk _ _ hq,walk_state,Nat.mul_succ]



def turns (q t x : ℕ) : ℕ := Nat.rec x (fun k acc => turn (q+k) acc) t

theorem residue_spec {r : ℕ} (h : r∈residues) : r<30 ∧ Nat.Coprime 30 r := by
  have he : residues = (List.range 30).filter (Nat.Coprime 30) := by decide
  simpa [he] using h

theorem turns_add (q a b x : ℕ) : turns (q+a) b (turns q a x) = turns q (a+b) x := by
  induction b with
  | zero => rfl
  | succ b ih =>
    change turn (q+a+b) (turns (q+a) b (turns q a x)) = turn (q+(a+b)) (turns q (a+b) x)
    rw [ih,Nat.add_assoc]

theorem turn_ok (q x : ℕ) (hq : 1<q) (hx : admissible x) : admissible (turn q x) := by
  have h (rs : List ℕ) (a : ℕ) (ha : admissible a) :
      admissible (rs.foldl (fun acc r => advance (30*q+r) acc) a) := by
    induction rs generalizing a with
    | nil => exact ha
    | cons _ _ ih => exact ih _ (advance_ok (by omega) ha)
  exact h residues x hx

theorem turns_ok (q t x : ℕ) (hq : 1<q) (hx : admissible x) : admissible (turns q t x) := by
  induction t with
  | zero => exact hx
  | succ t ih => exact turn_ok _ _ (by omega) ih

theorem turns_state (q t : ℕ) (hq : 1<q) :
    turns q t (maskedState (30*q)) = maskedState (30*(q+t)) := by
  induction t with
  | zero => rfl
  | succ t ih =>
    change turn (q+t) (turns q t _) = _
    rw [ih,turn_state _ (by omega)]; rfl

theorem tile_spec (l B b col : ℕ) (hb : 40000 < 30*b) (hcol : col+64≤B)
    (hend : 30*(b+B*2^l)+30 < 2^31)
    (f : ℕ→ℕ) (hf : ∀ i<2^l, admissible (f i)) :
    tile l B b col (pack (2^l) f) =
    pack (2^l) (fun i => turns (b+B*i+col) 64 (f i)) := by
  let n := 2^l
  let q := fun i => b+B*i+col
  let base := rowPrime n B (b+col)
  let data := residues.map (fun r => (r, gather B col l (primeMask (B*n) b r)))
  let fold := fun pos x => data.foldl
    (fun acc rd => primeStep n pos rd.2 (base + units n*(30*pos+rd.1)) acc) x
  have hstep (pos : ℕ) (hpos : pos<64) (g : ℕ→ℕ) (hg : ∀ i<n, admissible (g i)) :
      fold pos (pack n g) = pack n (fun i => turn (q i+pos) (g i)) := by
    let mask := fun r => primeMask (B*n) b r
    let pval := fun r i => 30*(q i+pos)+r
    have hrange (i : ℕ) (hi : i<n) : B*i+col+pos < B*n := by
      have hh := Nat.mul_le_mul_left B (Nat.succ_le_of_lt hi)
      rw [Nat.mul_succ] at hh
      omega
    have align (r : ℕ) : base + units n*(30*pos+r) = pack n (pval r) := by
      change pack n (fun i => 30*((b+col)+B*i)) + _ = _
      rw [units_scale,pack_add]
      apply pack_congr
      intro i _
      dsimp [pval,q]
      ring
    have foldAux (rs : List ℕ) (hrs : ∀ r∈rs, r∈residues)
        (u : ℕ→ℕ) (hu : ∀ i<n, admissible (u i)) :
        ((rs.map (fun r => (r,gather B col l (mask r)))).foldl
          (fun acc rd => primeStep n pos rd.2 (base+units n*(30*pos+rd.1)) acc) (pack n u)) =
        pack n (fun i => rs.foldl (fun acc r => advance (pval r i) acc) (u i)) := by
      induction rs generalizing u with
      | nil => rfl
      | cons r tail ih =>
        have ⟨hr,hc⟩ := residue_spec (hrs r (by simp))
        have hgath := gather_pack B col l (mask r) hcol
        have hpval (i : ℕ) (hi : i<n) : pval r i < 2^31 := by
          have hh := hrange i hi
          change 30*(b+B*i+col+pos)+r < 2^31
          change 30*(b+B*n)+30 < 2^31 at hend
          omega
        have hbval (i : ℕ) (hi : i<n) :
            (readWord (mask r) (B*i+col)).testBit pos = decide ((pval r i).Prime ∧ pval r i<cap) := by
          rw [readWord_bit]
          simp only [hpos,decide_true,Bool.true_and]
          rw [primeMask_bit _ _ _ _ (hrange i hi) hb hr hc]
          have he : 30*(b+(B*i+col+pos))+r=pval r i := by dsimp [pval,q]; ring
          rw [he]; simp only [cap,Nat.lt_succ_iff]
        simp only [List.map_cons,List.foldl_cons]
        rw [align,hgath,primeStep_pack n pos hpos _ _ _ (fun _ _ => readWord_bound ..) hpval hu hbval]
        apply ih (fun a ha => hrs a (by simp [ha]))
        intro i hi
        apply advance_ok _ (hu i hi)
        dsimp [pval,q]; omega
    exact foldAux residues (fun _ h => h) g hg
  have loop (t : ℕ) (ht : t≤64) : Nat.rec (pack n f) fold t = pack n (fun i => turns (q i) t (f i)) := by
    induction t with
    | zero => rfl
    | succ t ih =>
      change fold t (Nat.rec (pack n f) fold t) = _
      rw [ih (by omega),hstep _ (by omega) _ (fun i hi => turns_ok _ _ _ (show 1 < q i from by dsimp [q]; omega) (hf i hi))]
      rfl
  exact loop 64 (by decide)

theorem groupRun_spec (l B b tiles : ℕ) (hb : 40000<30*b) (ht : 64*tiles≤B)
    (hend : 30*(b+B*2^l)+30<2^31) (f : ℕ→ℕ) (hf : ∀ i<2^l, admissible (f i)) :
    groupRun l B b (pack (2^l) f) tiles =
      pack (2^l) (fun i => turns (b+B*i) (64*tiles) (f i)) := by
  induction tiles with
  | zero => rfl
  | succ t ih =>
    change tile l B b (64*t) (groupRun l B b (pack (2^l) f) t) = _
    rw [ih (by omega),tile_spec _ _ _ _ hb (by omega) hend _ (fun i hi =>
      turns_ok _ _ _ (by omega) (hf i hi))]
    apply pack_congr
    intro i hi
    rw [turns_add,Nat.mul_succ]



def geo (n : ℕ) := ((1 <<< (64*n))-1) / 18446744073709551615
def offset : ℕ → ℕ
  | 0 => 0
  | l+1 =>
    let m := 2^l
    let low := offset l
    low + ((low+geo m*m) <<< (64*m))

theorem units_id (n : ℕ) : units n*18446744073709551615+1=2^(64*n) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have hu : units (n+1)=2^64*units n+1 := rfl
    rw [hu,Nat.mul_succ 64 n,pow_add,← ih]
    ring

theorem geo_eq (n : ℕ) : geo n=units n := by
  rw [geo,Nat.shiftLeft_eq,one_mul,← units_id,Nat.add_sub_cancel,Nat.mul_div_cancel _ (by decide)]

theorem offset_eq (l : ℕ) : offset l = pack (2^l) id := by
  induction l with
  | zero => rfl
  | succ l ih =>
    let m := 2^l
    rw [offset,show 2^(l+1)=m+m from by simp [m,pow_succ,Nat.mul_two],pack_append,ih,
      Nat.shiftLeft_eq,geo_eq,units_scale,pack_add]
    change pack m id + pack m (fun j => id j + m) * 2^(64*m) = _
    rw [Nat.mul_comm _ (2^_)]
    congr 2
    apply pack_congr
    intro j _
    simp [Nat.add_comm]

theorem base_eq (l b : ℕ) : geo (2^l)*(30*b)+offset l*1920 = rowPrime (2^l) 64 b := by
  rw [geo_eq,units_scale,offset_eq,pack_mul,pack_add]
  apply pack_congr
  intro j _
  dsimp
  ring

def fastStage (u s k : ℕ) : ℕ :=
  let m := u*((1 <<< k)-1)
  let keep := ((((s &&& m)+m) >>> k) &&& u)*4294967295
  (s &&& keep) ||| (((s >>> k) &&& (u*4294967295)) &&& (u*4294967295-keep))

def fastOdd (u s : ℕ) := fastStage u (fastStage u (fastStage u (fastStage u (fastStage u s 16) 8) 4) 2) 1
def fastStep (u pos bits p x : ℕ) :=
  fastOdd u (x + (p &&& (((bits >>> pos) &&& u)*4294967295)))

theorem fastStep_eq (n pos bits p x : ℕ) :
    fastStep (units n) pos bits p x = primeStep n pos bits p x := rfl

theorem mask_bound (w b r : ℕ) : primeMask w b r < 2^w := by
  let num := min w ((1579691809-r)/30+1-b)
  have hnum : num≤w := min_le_left .. 
  have hpow := Nat.pow_le_pow_right (by decide : 0<2) hnum
  have hu : ((1:ℕ)<<<num)-1 < 2^w := by
    rw [Nat.shiftLeft_eq,one_mul]
    have : 0<(2:ℕ)^num := by positivity
    omega
  exact Nat.xor_lt_two_pow hu (lt_of_le_of_lt Nat.and_le_right hu)

theorem pack_words (s n : ℕ) (hs : s<2^(64*n)) :
    pack n (fun i => readWord s (64*i)) = s := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [pack_bit _ _ (fun i _ => readWord_bound ..), readWord_bit]
  have hm : j%64<64 := Nat.mod_lt _ (by decide)
  have ha : 64*(j/64)+j%64=j := by omega
  by_cases h : j/64<n
  · simp [hm,ha,h]
  · have hj : 64*n≤j := by omega
    have he := Nat.testBit_lt_two_pow (lt_of_lt_of_le hs (Nat.pow_le_pow_right (by decide : 0<2) hj))
    simp [h,he]

theorem gather_full (l s : ℕ) (hs : s<2^(64*2^l)) : gather 64 0 l s = s := by
  rw [gather_pack _ _ _ _ (by decide)]
  simpa using pack_words s (2^l) hs

structure Eight where
  m1 : ℕ
  m7 : ℕ
  m11 : ℕ
  m13 : ℕ
  m17 : ℕ
  m19 : ℕ
  m23 : ℕ
  m29 : ℕ

def mats (w b : ℕ) : Eight := ⟨primeMask w b 1,primeMask w b 7,primeMask w b 11,
  primeMask w b 13,primeMask w b 17,primeMask w b 19,primeMask w b 23,primeMask w b 29⟩

def eightSteps (u base : ℕ) (m : Eight) (pos x : ℕ) : ℕ :=
  let atPos := base + u*(30*pos)
  let x := fastStep u pos m.m1 (atPos+u) x
  let x := fastStep u pos m.m7 (atPos+u*7) x
  let x := fastStep u pos m.m11 (atPos+u*11) x
  let x := fastStep u pos m.m13 (atPos+u*13) x
  let x := fastStep u pos m.m17 (atPos+u*17) x
  let x := fastStep u pos m.m19 (atPos+u*19) x
  let x := fastStep u pos m.m23 (atPos+u*23) x
  fastStep u pos m.m29 (atPos+u*29) x

def execute (l b : ℕ) (m : Eight) (x : ℕ) : ℕ :=
  let u := geo (2^l)
  Nat.rec x (eightSteps u (u*(30*b)+offset l*1920) m) 64

set_option maxRecDepth 5000 in
theorem execute_tile (l b x : ℕ) : execute l b (mats (64*2^l) b) x = tile l 64 b 0 x := by
  let n := 2^l
  have h (r : ℕ) : gather 64 0 l (primeMask (64*n) b r) = primeMask (64*n) b r :=
    gather_full _ _ (mask_bound ..)
  simp only [execute,tile,Nat.add_zero]
  rw [base_eq,geo_eq]
  have steps : eightSteps (units n) (rowPrime n 64 b) (mats (64*n) b) = fun pos acc =>
      (residues.map (fun r => (r,gather 64 0 l (primeMask (64*n) b r)))).foldl
        (fun x rd => primeStep n pos rd.2 (rowPrime n 64 b+units n*(30*pos+rd.1)) x) acc := by
    funext pos acc
    simp only [eightSteps,mats,residues,List.map_cons,List.map_nil,List.foldl_cons,List.foldl_nil,
      h,fastStep_eq,Nat.mul_add,Nat.mul_one,Nat.add_assoc]
  rw [steps]



def seedWord (z i : ℕ) := ((readWord z (64*i)) &&& 1073741823)*2+1
def seeds (n z : ℕ) := (z &&& (geo n*1073741823))*2+geo n

theorem seed_ok (z i : ℕ) : admissible (seedWord z i) := by
  have h := Nat.and_le_right (n:=readWord z (64*i)) (m:=1073741823)
  exact ⟨⟨readWord z (64*i) &&& 1073741823,by unfold seedWord; omega⟩,by unfold seedWord; omega⟩

theorem seeds_pack (n z : ℕ) : seeds n z = pack n (seedWord z) := by
  let f := fun i => readWord z (64*i) &&& 1073741823
  have ha : z &&& (units n*1073741823) = pack n f := by
    rw [units_scale]
    apply Nat.eq_of_testBit_eq
    intro j
    rw [Nat.testBit_and,pack_bit _ _ (fun _ _ => by decide),
      pack_bit _ _ (fun _ _ => lt_of_le_of_lt Nat.and_le_right (by decide : 1073741823<2^64))]
    simp only [f,Nat.testBit_and,readWord_bit, Nat.mod_lt _ (by decide : 0<64),decide_true,Bool.true_and]
    rw [show 64*(j/64)+j%64=j from by omega]
    cases decide (j/64<n) <;> cases z.testBit j <;> simp
  rw [seeds,geo_eq,ha,pack_mul]
  change pack n _ + pack n (fun _ => 1) = _
  rw [pack_add]
  rfl

theorem link_words (n first last : ℕ) (f g : ℕ→ℕ) (hf : ∀ i<n, f i<2^64)
    (hg : ∀ i<n, g i<2^64) (hfirst : first<2^64) (hlast : last<2^64)
    (h : pack n f + last*2^(64*n) = 2^64*pack n g + first) (i : ℕ) (hi : i≤n) :
    (if i<n then f i else last) = (if i=0 then first else g (i-1)) := by
  let l := fun j => if j<n then f j else last
  let r := fun j => if j=0 then first else g (j-1)
  have hl : pack (n+1) l = pack n f + last*2^(64*n) := by
    rw [pack_append]
    have h0 : pack n l=pack n f := pack_congr (fun j hj => by simp [l,hj])
    rw [h0]
    simp [pack,l,Nat.mul_comm]
  have hr : pack (n+1) r = 2^64*pack n g + first := by
    rw [pack]
    simp [r]
  have hb1 : ∀ j<n+1, l j<2^64 := by
    intro j hj; dsimp [l]; split <;> first | exact hf _ (by omega) | exact hlast
  have hb2 : ∀ j<n+1, r j<2^64 := by
    intro j hj; dsimp [r]; split <;> first | exact hfirst | exact hg _ (by omega)
  have he := congrArg (fun v => readWord v (64*i)) ((hl.trans h).trans hr.symm)
  simpa only [readWord_pack _ _ hb1 _ (by omega : i<n+1), readWord_pack _ _ hb2 _ (by omega : i<n+1)] using he

def agrees (l b first last z : ℕ) (m : Eight) : Prop :=
  let n := 2^l
  let input := seeds n z
  input + (last <<< (64*n)) = (execute l b m input <<< 64) + first

instance (l b first last z : ℕ) (m : Eight) : Decidable (agrees l b first last z m) :=
  inferInstanceAs (Decidable (_ = _))

theorem close_group (l b first last z : ℕ) (m : Eight) (hm : m=mats (64*2^l) b)
    (hb : 40000<30*b) (hend : 30*(b+64*2^l)+30<2^31)
    (hfirst : first<2^64) (hlast : last<2^64) (hcheck : agrees l b first last z m)
    (hstart : maskedState (30*b)=first) :
    maskedState (30*(b+64*2^l)) = last := by
  let n := 2^l
  let f := seedWord z
  let g := fun i => turns (b+64*i) 64 (f i)
  have hg (i : ℕ) : admissible (g i) := turns_ok _ _ _ (by omega) (seed_ok ..)
  change seeds n z + (last <<< (64*n)) = (execute l b m (seeds n z) <<< 64)+first at hcheck
  rw [hm,execute_tile,seeds_pack,tile_spec _ _ _ _ hb (by decide) hend _ (fun _ _ => seed_ok ..)] at hcheck
  simp only [Nat.add_zero,Nat.shiftLeft_eq,Nat.mul_comm _ (2^64)] at hcheck
  have link := link_words n first last f g (fun i _ => lt_trans (seed_ok z i).2 (by decide))
    (fun i _ => lt_trans (hg i).2 (by decide)) hfirst hlast hcheck
  have hs (j : ℕ) (hj : j≤n) : maskedState (30*(b+64*j)) = if j<n then f j else last := by
    induction j with
    | zero => simpa using hstart.trans (by simpa using (link 0 (by omega)).symm)
    | succ j ih =>
      have hj' : j<n := by omega
      have he := ih hj'.le
      simp only [hj',if_true] at he
      have ht := turns_state (b+64*j) 64 (by omega)
      rw [he] at ht
      have hl := link (j+1) hj
      simp only [Nat.succ_ne_zero,if_false,Nat.add_sub_cancel] at hl
      rw [show b+64*(j+1)=b+64*j+64 from by omega]
      exact ht.symm.trans hl.symm
  simpa using hs n le_rfl



def smallPrime (p : ℕ) := if p≤201 then decide p.Prime else p.gcd (Nat.factorial 201) == 1
theorem smallPrime_spec (p : ℕ) (h : p≤40020) : smallPrime p = decide p.Prime := by
  by_cases hs : p≤201
  · simp [smallPrime,hs]
  · simp only [smallPrime,if_neg hs]
    apply Bool.eq_iff_iff.mpr
    simp only [beq_iff_eq,decide_eq_true_eq]
    constructor
    · intro hg
      by_contra hnp
      let d := p.minFac
      have hd : d.Prime := Nat.minFac_prime (by omega)
      have hb : d^2≤p := Nat.minFac_sq_le_self (by omega) hnp
      have h201 : d≤201 := by nlinarith
      have hdvd : d∣p.gcd (Nat.factorial 201) :=
        Nat.dvd_gcd (Nat.minFac_dvd p) (Nat.dvd_factorial hd.pos h201)
      rw [hg] at hdvd
      exact hd.not_dvd_one hdvd
    · intro hp
      exact (hp.coprime_factorial_of_lt (by omega)).gcd_eq_one

def quickOdd (s : ℕ) := dropBits (dropBits (dropBits (dropBits (dropBits s 16) 8) 4) 2) 1
def earlyStep (p x : ℕ) := if smallPrime p then quickOdd (x+p) else x
def earlyRun (b x len : ℕ) : ℕ := Nat.rec x (fun j y => earlyStep (b+j) y) len

theorem early_state (b len : ℕ) (hb : 3≤b) (hend : b+len≤40020) :
    earlyRun b (state b) len = state (b+len) := by
  induction len with
  | zero => rfl
  | succ len ih =>
    change earlyStep (b+len) (earlyRun b (state b) len) = _
    rw [ih (by omega),Nat.add_succ,state_succ]
    simp only [earlyStep,smallPrime_spec (b+len) (by omega),decide_eq_true_eq]
    by_cases hp : (b+len).Prime
    · simp only [hp,if_true]
      have hsmall := (state_bound (b+len) (by omega)).1
      exact scalar_barrel (state (b+len)+(b+len)) (by omega) (by omega)
    · simp [hp]

theorem early_finish (b n x y : ℕ) (hb : 3≤b) (hend : b+n≤40020)
    (h : earlyRun b x n = y) (hstart : state b = x) : state (b+n)=y := by
  rw [← early_state _ _ hb hend,hstart,h]

theorem state_three : state 3 = 1 := by
  have h0 : state 0=0 := rfl
  norm_num [state_succ,h0,strip]



