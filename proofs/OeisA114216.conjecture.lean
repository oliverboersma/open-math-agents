import FormalConjectures.OEIS.«114216»
import Mathlib

/-!
Donovan Johnson found this counterexample in May 2010, as recorded in
OEIS A114217 and A114218. The index is 78493252 and the prime is
1579691809. Its sum with the preceding term 567791839 is 2^31.

This computation checks the original recurrence. A wheel sieve marks the
primes, and one natural number stores independent 64-bit lanes. Trial
values produced by pure arithmetic are only inputs to kernel-checked
equalities for the sieve, the lane transitions and all block boundaries.
-/
namespace ShiftCert


open Nat
def strip (s : ℕ) := s / 2 ^ padicValNat 2 s
noncomputable def state (bound : ℕ) := OeisA114216.a (Nat.count Nat.Prime bound)

theorem state_succ (n : ℕ) : state (n+1) =
    if n.Prime then strip (state n+n) else state n := by
  classical
  unfold state
  rw [Nat.count_succ]
  split <;> rename_i h
  · simp only [add_one, OeisA114216.a, Nat.nth_count h, strip]
  · simp

theorem strip_eq_of_odd {e h s : ℕ} (hh : Odd h) (hs : s=2^e*h) :
    strip s=h := by
  have hn : h ≠ 0 := by rcases hh with ⟨k,hk⟩; omega
  have hval : padicValNat 2 h = 0 := padicValNat.eq_zero_of_not_dvd (by
    exact fun hd => hh.not_two_dvd_nat hd)
  subst s
  rw [strip, padicValNat.mul (by positivity) hn, padicValNat.prime_pow, hval]
  simp [Nat.mul_div_cancel_left, pow_pos]

theorem strip_odd (s : ℕ) (hs : s ≠ 0) : Odd (strip s) := by
  rw [← Nat.not_even_iff_odd, even_iff_two_dvd]
  intro hd
  have hp : 2 ^ (padicValNat 2 s + 1) ∣ s := by
    rw [pow_succ]
    convert Nat.mul_dvd_mul_left (2 ^ padicValNat 2 s) hd using 1
    exact (Nat.mul_div_cancel' (pow_padicValNat_dvd (p:=2) (n:=s))).symm
  exact pow_succ_padicValNat_not_dvd hs hp

theorem state_bound : ∀ n, 2 < n → state n < n ∧ Odd (state n) := by
  intro n
  induction n with
  | zero => omega
  | succ n ih =>
    intro h
    rcases eq_or_lt_of_le (show 2≤n by omega) with hn|hn
    · subst n
      have h0 : state 0 = 0 := rfl
      norm_num [state_succ, h0, strip]
    obtain ⟨hsm, hodd⟩ := ih hn
    rw [state_succ]
    by_cases hp : n.Prime
    · rw [if_pos hp]
      have he : Even (state n + n) := Odd.add_odd hodd (hp.odd_of_ne_two (by omega))
      have hv := one_le_padicValNat_of_dvd (p:=2) (n:=state n+n) (by omega) (even_iff_two_dvd.mp he)
      have hb : 2 ≤ 2 ^ padicValNat 2 (state n+n) := by
        exact Nat.le_of_dvd (by positivity) (dvd_pow_self _ (by omega))
      refine ⟨?_, strip_odd _ (by omega)⟩
      unfold strip
      exact lt_of_le_of_lt (Nat.div_le_div_left hb (by decide)) (by omega)
    · simp [hp, hodd, show state n < n+1 by omega]

theorem index_large : 33900 < Nat.count Nat.Prime 1579691810 := by
  have hsmall := Chebyshev.pi_ge (2^30)
  have hlog : Real.log ((2:ℝ)^30+1) ≤ Real.log ((2:ℝ)^31) :=
    Real.log_le_log (by positivity) (by norm_num)
  have hpos := Real.log_pos (by norm_num : (1:ℝ)<2)
  simp only [Nat.cast_pow, Nat.cast_ofNat] at hsmall
  rw [Real.log_pow] at hlog hsmall
  have hden : 0 < (30:ℝ)*Real.log 2 := by positivity
  have hh := (div_le_iff₀ hden).mp hsmall
  have hc : 33900 < Nat.primeCounting (2^30) := by
    by_contra! hc
    have hc' : ((Nat.primeCounting (2^30):ℕ):ℝ) ≤ 33900 := by exact_mod_cast hc
    have hp := mul_le_mul_of_nonneg_right hc' hden.le
    have ha := hh.trans hp
    norm_num at ha hlog
    linarith only [ha,hlog,hpos]
  exact lt_of_lt_of_le hc (Nat.count_monotone Nat.Prime (by decide : 2^30+1≤1579691810))




def pack : ℕ → (ℕ → ℕ) → ℕ
  | 0, _ => 0
  | n+1, f => 2^64 * pack n (fun i => f (i+1)) + f 0

theorem pack_congr {n : ℕ} {f g : ℕ → ℕ} (h : ∀ i<n, f i=g i) :
    pack n f=pack n g := by
  induction n generalizing f g with
  | zero => rfl
  | succ n ih =>
    rw [pack, pack, h 0 (by omega), ih (f:=fun i => f (i+1)) (g:=fun i => g (i+1))
      (fun i hi => h _ (by omega))]

theorem pack_add (n : ℕ) (f g : ℕ→ℕ) :
    pack n f + pack n g = pack n (fun j => f j+g j) := by
  induction n generalizing f g with
  | zero => rfl
  | succ n ih =>
    simp only [pack]
    rw [← ih (fun j => f (j+1)) (fun j => g (j+1))]
    ring

theorem pack_mul (n : ℕ) (f : ℕ→ℕ) (a : ℕ) :
    pack n f * a = pack n (fun j => f j*a) := by
  induction n generalizing f with
  | zero => simp [pack]
  | succ n ih => simp only [pack]; rw [← ih (fun j => f (j+1))]; ring

theorem pack_sub (n : ℕ) (f g : ℕ→ℕ) (h : ∀ i<n, g i ≤ f i) :
    pack n f - pack n g = pack n (fun j => f j-g j) := by
  have h' : pack n (fun j => f j-g j) + pack n g = pack n f := by
    rw [pack_add]
    exact pack_congr (fun j hj => Nat.sub_add_cancel (h j hj))
  omega

theorem pack_bit (n : ℕ) (f : ℕ→ℕ) (h : ∀ i<n, f i<2^64) (k : ℕ) :
    (pack n f).testBit k = (decide (k/64<n) && (f (k/64)).testBit (k%64)) := by
  induction n generalizing f k with
  | zero => simp [pack]
  | succ n ih =>
    rw [pack, Nat.testBit_two_pow_mul_add _ (h 0 (by omega))]
    split <;> rename_i hk
    · simp [Nat.div_eq_of_lt hk, Nat.mod_eq_of_lt hk]
    · rw [ih (fun j => f (j+1)) (fun j hj => h _ (by omega))]
      have hdiv : (k-64)/64+1 = k/64 := by omega
      have hmod : (k-64)%64 = k%64 := by omega
      have hc : ((k-64)/64<n) ↔ k/64<n+1 := by omega
      simp [hdiv,hmod,hc]

theorem pack_and (n : ℕ) (f g : ℕ→ℕ) (hf : ∀ i<n, f i<2^64)
    (hg : ∀ i<n, g i<2^64) :
    pack n f &&& pack n g = pack n (fun i => f i &&& g i) := by
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.testBit_and,pack_bit _ _ hf,pack_bit _ _ hg,
    pack_bit _ _ (fun j hj => lt_of_le_of_lt Nat.and_le_left (hf j hj)), Nat.testBit_and]
  cases decide (k/64<n) <;> simp

theorem pack_or (n : ℕ) (f g : ℕ→ℕ) (hf : ∀ i<n, f i<2^64)
    (hg : ∀ i<n, g i<2^64) :
    pack n f ||| pack n g = pack n (fun i => f i ||| g i) := by
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.testBit_or,pack_bit _ _ hf,pack_bit _ _ hg,
    pack_bit _ _ (fun j hj => Nat.or_lt_two_pow (hf j hj) (hg j hj)), Nat.testBit_or]
  cases decide (k/64<n) <;> simp

theorem pack_mask_shift (n : ℕ) (f : ℕ→ℕ) (hf : ∀ i<n, f i<2^64)
    (s l : ℕ) (h : s+l≤64) :
    ((pack n f >>> s) &&& pack n (fun _ => 2^l-1)) =
      pack n (fun j => (f j >>> s) &&& (2^l-1)) := by
  have hm : 2^l-1 < 2^64 := by
    have : (2:ℕ)^l ≤ 2^64 := Nat.pow_le_pow_right (by decide) (by omega)
    have : 0<(2:ℕ)^l := by positivity
    omega
  apply Nat.eq_of_testBit_eq
  intro k
  rw [Nat.testBit_and, Nat.testBit_shiftRight, pack_bit _ _ hf,
    pack_bit _ _ (fun _ _ => hm),
    pack_bit _ _ (fun _ _ => lt_of_le_of_lt Nat.and_le_right hm), Nat.testBit_and,
    Nat.testBit_shiftRight]
  by_cases hb : k%64 < l
  · have hd : (s+k)/64=k/64 := by omega
    have hr : (s+k)%64=s+k%64 := by omega
    rw [hd,hr]
    cases decide (k/64<n) <;> simp
  · have hfals : (2^l-1 : ℕ).testBit (k%64) = false := by
      apply Nat.testBit_lt_two_pow
      have := Nat.pow_le_pow_right (by decide : 0<(2:ℕ)) (show l≤k%64 by omega)
      have : 0<(2:ℕ)^l := by positivity
      omega
    simp [hfals]


def units (n : ℕ) := pack n (fun _ => 1)
def mask32 (n : ℕ) := units n * 4294967295

def stage (n s k : ℕ) : ℕ :=
  let u := units n
  let m := u*((1 <<< k)-1)
  let keep := ((((s &&& m)+m) >>> k) &&& u)*4294967295
  (s &&& keep) ||| (((s >>> k) &&& mask32 n) &&& (mask32 n-keep))

def dropBits (s k : ℕ) := if s%2^k=0 then s >>> k else s

theorem units_scale (n c : ℕ) : units n * c = pack n (fun _ => c) := by
  simp [units, pack_mul]

theorem flag_single (z k : ℕ) :
    (((z &&& (2^k-1)) + (2^k-1)) >>> k) &&& 1 =
      if z % 2^k=0 then 0 else 1 := by
  rw [Nat.and_two_pow_sub_one_eq_mod, Nat.shiftRight_eq_div_pow]
  have hpos : 0 < (2:ℕ)^k := by positivity
  have hr := Nat.mod_lt z hpos
  split <;> rename_i h
  · rw [h,zero_add,Nat.div_eq_of_lt (by omega)]; decide
  · have hq : (z%2^k+(2^k-1))/2^k=1 := by
      apply Nat.div_eq_of_lt_le
      · omega
      · omega
    rw [hq]; decide

theorem stage_pack (n : ℕ) (f : ℕ→ℕ) (hf : ∀ i<n, f i<2^32)
    (k : ℕ) (hk : k≤16) :
    stage n (pack n f) k = pack n (fun j => dropBits (f j) k) := by
  let m : ℕ := 2^k-1
  have hm : m ≤ 65535 := by
    have : (2:ℕ)^k ≤ 2^16 := Nat.pow_le_pow_right (by decide) hk
    dsimp [m]; omega
  let w := fun i => (f i &&& m)+m
  have hw : ∀ i<n, w i<2^64 := by
    intro i _; dsimp [w]; have := Nat.and_le_right (n:=f i) (m:=m); omega
  have hf' : ∀ i<n, f i<2^64 := fun i hi => lt_trans (hf i hi) (by decide)
  let flag := fun i => if f i%2^k=0 then 0 else 1
  let keep := fun i => flag i * 4294967295
  have hkeep : ∀ i, keep i ≤ 4294967295 := by intro i; dsimp [keep,flag]; split <;> decide
  have hmask : mask32 n = pack n (fun _ => 4294967295) := units_scale _ _
  have hlow : units n*((1<<<k)-1) = pack n (fun _ => m) := by
    simp [units_scale, m, Nat.shiftLeft_eq]
  have hsum : (pack n f &&& pack n (fun _ => m)) + pack n (fun _ => m) = pack n w := by
    rw [pack_and n _ _ hf' (fun _ _ => by omega),pack_add]
  have hflags : (pack n w >>> k) &&& units n = pack n flag := by
    have hh := pack_mask_shift n w hw k 1 (by omega)
    change (pack n w >>> k) &&& pack n (fun _ => 1) = _
    norm_num only at hh
    exact hh.trans (pack_congr (fun i _ => flag_single (f i) k))
  simp only [stage]
  rw [hlow,hsum,hflags,pack_mul,hmask]
  change (pack n f &&& pack n keep) |||
    (((pack n f >>> k) &&& pack n (fun _ => 2^32-1)) &&&
      (pack n (fun _ => 4294967295)-pack n keep)) = _
  rw [pack_sub _ _ _ (fun i _ => hkeep i),pack_mask_shift _ _ hf' k 32 (by omega),
    pack_and _ _ _ hf' (fun i _ => by have := hkeep i; omega),
    pack_and _ _ _ (fun i _ => lt_of_le_of_lt Nat.and_le_right (by decide))
      (fun i _ => by have := hkeep i; omega),
    pack_or _ _ _ (fun i hi => lt_of_le_of_lt Nat.and_le_left (hf' i hi))
      (fun i _ => lt_of_le_of_lt Nat.and_le_left (lt_of_le_of_lt Nat.and_le_right (by decide)))]
  apply pack_congr
  intro i hi
  have hx := hf i hi
  have hy : f i >>> k < 2^32 := lt_of_le_of_lt (Nat.shiftRight_le _ _) hx
  dsimp [keep,flag,dropBits]
  split <;> rename_i h
  · simp [h, Nat.and_two_pow_sub_one_of_lt_two_pow hy]
  · simp [h, Nat.and_two_pow_sub_one_of_lt_two_pow hx]

def oddPack (n s : ℕ) := stage n (stage n (stage n (stage n (stage n s 16) 8) 4) 2) 1

theorem drop_le (s k : ℕ) : dropBits s k ≤ s := by
  unfold dropBits
  split
  · exact Nat.shiftRight_le .. 
  · rfl

theorem drop_strip (s k : ℕ) (hs : s≠0) (hk : 0<k) (hb : padicValNat 2 s<2*k) :
    dropBits s k ≠ 0 ∧ strip (dropBits s k)=strip s ∧ padicValNat 2 (dropBits s k)<k := by
  unfold dropBits
  split <;> rename_i h
  · have hd : 2^k ∣ s := Nat.dvd_of_mod_eq_zero h
    have hkv : k ≤ padicValNat 2 s := (padicValNat_dvd_iff_le hs).mp hd
    rw [Nat.shiftRight_eq_div_pow]
    have hx : 0 < s / 2^k := Nat.div_pos (Nat.le_of_dvd (by omega) hd) (by positivity)
    refine ⟨hx.ne', ?_, ?_⟩
    · unfold strip
      rw [padicValNat.div_pow hd, Nat.div_div_eq_div_mul, ← pow_add,
        Nat.add_sub_of_le hkv]
    · rw [padicValNat.div_pow hd]; omega
  · refine ⟨hs,rfl,?_⟩
    by_contra! hn
    exact h (Nat.mod_eq_zero_of_dvd ((padicValNat_dvd_iff_le hs).mpr hn))

theorem scalar_barrel (s : ℕ) (h0 : 0<s) (h : s<2^32) :
    dropBits (dropBits (dropBits (dropBits (dropBits s 16) 8) 4) 2) 1 = strip s := by
  have hm := Nat.le_of_dvd h0 (pow_padicValNat_dvd (p:=2) (n:=s))
  have hv : padicValNat 2 s < 32 := by
    by_contra! hh
    have := Nat.pow_le_pow_right (by decide : 0<2) hh
    omega
  obtain ⟨h16,t16,v16⟩ := drop_strip s 16 h0.ne' (by decide) hv
  obtain ⟨h8,t8,v8⟩ := drop_strip _ 8 h16 (by decide) v16
  obtain ⟨h4,t4,v4⟩ := drop_strip _ 4 h8 (by decide) v8
  obtain ⟨h2,t2,v2⟩ := drop_strip _ 2 h4 (by decide) v4
  obtain ⟨_,t1,v1⟩ := drop_strip _ 1 h2 (by decide) v2
  have hzero := Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ v1)
  rw [strip,hzero,pow_zero,Nat.div_one] at t1
  exact t1.trans (t2.trans (t4.trans (t8.trans t16)))

theorem oddPack_pack (n : ℕ) (f : ℕ→ℕ) (hp : ∀ i<n, 0<f i) (hf : ∀ i<n, f i<2^32) :
    oddPack n (pack n f) = pack n (fun i => strip (f i)) := by
  unfold oddPack
  rw [stage_pack _ _ hf 16 (by decide)]
  repeat' rw [stage_pack _ _ (fun i hi => lt_of_le_of_lt (drop_le _ _) (by
    repeat' first | exact hf i hi | apply lt_of_le_of_lt (drop_le _ _))) _ (by decide)]
  exact pack_congr (fun i hi => scalar_barrel (f i) (hp i hi) (hf i hi))


