/-- If u ~ v and u-w = o(v) then w ~ v. -/
theorem Asymptotics.IsEquivalent.add_isLittleO'' {α : Type*} {β : Type*} [NormedAddCommGroup β]
    {u : α → β} {v : α → β} {w : α → β} {l : Filter α}
    (huv : Asymptotics.IsEquivalent l u v) (hwu : (u - w) =o[l] v) :
    Asymptotics.IsEquivalent l w v := by
  rw [← sub_sub_self u w]
  exact sub_isLittleO huv hwu

theorem WeakPNT' : Tendsto (fun N ↦ (∑ n ∈ Iic N, Λ n) / N) atTop (nhds 1) := by
  have : (fun N ↦ (∑ n ∈ Iic N, Λ n) / N) =
      (fun N ↦ (∑ n ∈ range N, Λ n)/N + Λ N / N) := by
    ext N
    have : N ∈ Iic N := mem_Iic.mpr (le_refl _)
    rw [← Finset.sum_erase_add _ _ this, ← Nat.Iio_eq_range, Iic_erase]
    exact add_div _ _ _

  rw [this, ← add_zero 1]
  apply Tendsto.add WeakPNT
  convert squeeze_zero (f := fun N ↦ Λ N / N) (g := fun N ↦ log N / N) (t₀ := atTop) ?_ ?_ ?_
  · intro N
    exact div_nonneg vonMangoldt_nonneg (cast_nonneg N)
  · intro N
    exact div_le_div_of_nonneg_right vonMangoldt_le_log (cast_nonneg N)
  have := Real.tendsto_pow_log_div_pow_atTop 1 1 Real.zero_lt_one
  simp only [rpow_one] at this
  exact Tendsto.comp this tendsto_natCast_atTop_atTop

/-- An alternate form of the Weak PNT. -/
theorem WeakPNT'' : ψ ~[atTop] (fun x ↦ x) := by
    rw [(by rfl : ψ = (fun x ↦ ψ x))]
    simp_rw [Chebyshev.psi_eq_sum_Icc]
    apply IsEquivalent.trans (v := fun x ↦ (⌊x⌋₊:ℝ))
    · rw [isEquivalent_iff_tendsto_one]
      · convert! Tendsto.comp WeakPNT' tendsto_nat_floor_atTop
        infer_instance
      rw [eventually_iff]
      simp only [ne_eq, cast_eq_zero, floor_eq_zero, not_lt, mem_atTop_sets,
        Set.mem_setOf_eq]
      use 1
      simp only [imp_self, implies_true]
    apply IsLittleO.isEquivalent
    rw [← isLittleO_neg_left]
    apply IsLittleO.of_bound
    intro ε hε
    simp only [Pi.sub_apply, neg_sub, norm_eq_abs, eventually_atTop]
    use ε⁻¹
    intro b hb
    have hb' : 0 ≤ b := le_of_lt (lt_of_lt_of_le (inv_pos_of_pos hε) hb)
    rw [abs_of_nonneg, abs_of_nonneg hb']
    · apply LE.le.trans _ ((inv_le_iff_one_le_mul₀' hε).mp hb)
      linarith [Nat.lt_floor_add_one b]
    rw [sub_nonneg]
    exact floor_le hb'

/-- `√x · log x = o(x)` as `x → ∞`. -/
lemma isLittleO_sqrt_mul_log : (fun x : ℝ ↦ x.sqrt * x.log) =o[atTop] _root_.id := by
  have : (fun x : ℝ ↦ x.sqrt * x.log) =o[atTop] fun x ↦ x := by
    refine (isLittleO_mul_iff_isLittleO_div ?_).mpr ?_
    · filter_upwards [eventually_gt_atTop 0] with x hx; exact (sqrt_ne_zero hx.le).mpr hx.ne'
    · convert! isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 2) using 2 with x
      rw [div_sqrt, sqrt_eq_rpow]
  exact this

theorem chebyshev_asymptotic : θ ~[atTop] id := by
  refine WeakPNT''.add_isLittleO'' (IsBigO.trans_isLittleO (g := fun x ↦ 2 * x.sqrt * x.log) ?_ ?_)
  · rw [isBigO_iff']; refine ⟨1, one_pos, ?_⟩
    simp only [one_mul, eventually_atTop]
    exact ⟨2, fun x hx ↦ by
      rw [Pi.sub_apply, norm_eq_abs, norm_eq_abs, abs_of_nonneg (by bound : 0 ≤ 2 * √x * log x)]
      exact (abs_of_nonneg (sub_nonneg.mpr (Chebyshev.theta_le_psi x))).symm ▸
        Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log (by linarith : 1 ≤ x)⟩
  · simpa only [mul_assoc] using! isLittleO_sqrt_mul_log.const_mul_left 2

end PNTConseq

end PNTX_Conseq

open Finset SimpleGraph

namespace OMA573

section Walks

variable {V : Type*} {G : SimpleGraph V}

theorem cycle_four {a b c d : V}
    (hab : G.Adj a b) (hbc : G.Adj b c) (hcd : G.Adj c d) (hda : G.Adj d a)
    (hac : a ≠ c) (hbd : b ≠ d) : cycleGraph 4 ⊑ G := by
  let p : G.Walk a a := .cons hab (.cons hbc (.cons hcd (.cons hda .nil)))
  apply (cycleGraph_isContained_iff (by decide : 2 < 4)).mpr
  refine ⟨a, p, ?_, rfl⟩
  apply Walk.isCycle_iff_isPath_tail_and_le_length.mpr
  refine ⟨?_, by simp [p]⟩
  simp [p, Walk.isPath_def, hab.ne, hbc.ne, hcd.ne, hda.ne, hac, hbd, ne_comm]

lemma exists_split [DecidableEq V] {u v : V} (q : G.Walk u v) (hq : ¬ q.IsPath) :
    ∃ (x : V) (a : G.Walk u x) (b : G.Walk x x) (c : G.Walk x v),
      q.length = a.length + b.length + c.length ∧ 0 < b.length := by
  induction q with
  | nil => exact absurd Walk.IsPath.nil hq
  | @cons u w v h q' ih =>
    rw [Walk.cons_isPath_iff] at hq
    by_cases hp : q'.IsPath
    · have hu : u ∈ q'.support := by
        by_contra hu
        exact hq ⟨hp, hu⟩
      refine ⟨u, Walk.nil, Walk.cons h (q'.takeUntil u hu), q'.dropUntil u hu, ?_, by simp⟩
      have h1 := congrArg Walk.length (q'.take_spec hu)
      simp only [Walk.length_append] at h1
      simp only [Walk.length_cons, Walk.length_nil]
      omega
    · obtain ⟨x, a, b, c, hlen, hb⟩ := ih hp
      refine ⟨x, Walk.cons h a, b, c, ?_, hb⟩
      simp only [Walk.length_cons]
      omega

lemma exists_odd_cycle [DecidableEq V] : ∀ (n : ℕ) (u : V) (w : G.Walk u u), w.length = n → Odd n →
    ∃ (v : V) (c : G.Walk v v), c.IsCycle ∧ Odd c.length := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro u w hw hodd
    cases w with
    | nil =>
      simp only [Walk.length_nil] at hw
      subst hw
      exact absurd hodd (by decide)
    | @cons _ v _ h q =>
      simp only [Walk.length_cons] at hw
      by_cases hp : q.IsPath
      · refine ⟨u, Walk.cons h q, ?_, by simp only [Walk.length_cons]; rw [hw]; exact hodd⟩
        rw [Walk.isCycle_iff_isPath_tail_and_le_length]
        refine ⟨by simpa using hp, ?_⟩
        simp only [Walk.length_cons]
        have hq0 : q.length ≠ 0 := by
          intro h0
          exact h.ne (Walk.eq_of_length_eq_zero h0).symm
        rw [Nat.odd_iff] at hodd
        omega
      · obtain ⟨x, a, b, c, hlen, hb⟩ := exists_split q hp
        by_cases hbo : Odd b.length
        · exact ih b.length (by omega) x b rfl hbo
        · have hbe : Even b.length := Nat.not_odd_iff_even.mp hbo
          refine ih (a.length + c.length + 1) (by omega) u (Walk.cons h (a.append c))
            (by simp [Walk.length_append]) ?_
          rw [Nat.odd_iff] at hodd ⊢
          rw [Nat.even_iff] at hbe
          omega

lemma colorable_two_of_free (h : ∀ k, Odd k → 3 ≤ k → (cycleGraph k).Free G) :
    G.Colorable 2 := by
  classical
  rw [two_colorable_iff_forall_loop_even]
  intro u w
  by_contra hodd
  rw [Nat.not_even_iff_odd] at hodd
  obtain ⟨v, c, hc, hco⟩ := exists_odd_cycle w.length u w rfl hodd
  exact h c.length hco hc.three_le_length
    ((cycleGraph_isContained_iff (by have := hc.three_le_length; omega)).mpr ⟨v, c, hc, rfl⟩)

end Walks

section Count

variable {V : Type*} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]

/-- number of adjacent pairs in `S × T` -/
def eST (G : SimpleGraph V) [DecidableRel G.Adj] (S T : Finset V) : ℕ :=
  ∑ s ∈ S, ∑ t ∈ T, if G.Adj s t then 1 else 0

lemma eST_symm (S T : Finset V) : eST G S T = eST G T S := by
  unfold eST
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun s _ =>
    if_congr (G.adj_comm _ _) rfl rfl

lemma codeg_le_one (h4 : (cycleGraph 4).Free G) (T : Finset V) {s s' : V} (hss : s ≠ s') :
    ∑ t ∈ T, (if G.Adj s t then 1 else 0) * (if G.Adj s' t then 1 else 0) ≤ 1 := by
  have hmul : ∀ t, (if G.Adj s t then 1 else 0) * (if G.Adj s' t then 1 else 0)
      = if (G.Adj s t ∧ G.Adj s' t) then 1 else 0 := by
    intro t
    by_cases h1 : G.Adj s t <;> by_cases h2 : G.Adj s' t <;> simp [h1, h2]
  simp_rw [hmul]
  rw [← Finset.card_filter, Finset.card_le_one]
  intro x hx y hy
  simp only [Finset.mem_filter] at hx hy
  by_contra hxy
  exact h4 (cycle_four hx.2.1 hx.2.2.symm hy.2.2 hy.2.1.symm hss hxy)

lemma kst_ineq (h4 : (cycleGraph 4).Free G) (S T : Finset V) :
    eST G S T ^ 2 ≤ T.card * (S.card ^ 2 + eST G S T) := by
  have h1 : eST G S T = ∑ t ∈ T, ∑ s ∈ S, if G.Adj s t then 1 else 0 := Finset.sum_comm
  have h2 : ∑ t ∈ T, (∑ s ∈ S, if G.Adj s t then 1 else 0) ^ 2
      ≤ S.card ^ 2 + eST G S T := by
    calc ∑ t ∈ T, (∑ s ∈ S, if G.Adj s t then 1 else 0) ^ 2
        = ∑ t ∈ T, ∑ s ∈ S, ∑ s' ∈ S,
            (if G.Adj s t then 1 else 0) * (if G.Adj s' t then 1 else 0) := by
          refine Finset.sum_congr rfl fun t _ => ?_
          rw [sq, Finset.sum_mul_sum]
      _ = ∑ s ∈ S, ∑ s' ∈ S, ∑ t ∈ T,
            (if G.Adj s t then 1 else 0) * (if G.Adj s' t then 1 else 0) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [Finset.sum_comm]
      _ ≤ ∑ s ∈ S, ∑ s' ∈ S,
            (1 + if s = s' then (∑ t ∈ T, if G.Adj s t then 1 else 0) else 0) := by
          refine Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun s' _ => ?_
          by_cases hss : s = s'
          · subst hss
            rw [if_pos rfl]
            refine le_trans (Finset.sum_le_sum fun t _ => ?_) (Nat.le_add_left _ _)
            by_cases h : G.Adj s t <;> simp [h]
          · rw [if_neg hss, add_zero]
            exact codeg_le_one h4 T hss
      _ = ∑ s ∈ S, (S.card + ∑ t ∈ T, if G.Adj s t then 1 else 0) := by
          refine Finset.sum_congr rfl fun s hs => ?_
          rw [Finset.sum_add_distrib, Finset.sum_ite_eq, if_pos hs]
          simp
      _ = S.card ^ 2 + eST G S T := by
          rw [Finset.sum_add_distrib]
          simp [eST, sq]
  calc eST G S T ^ 2 = (∑ t ∈ T, ∑ s ∈ S, if G.Adj s t then 1 else 0) ^ 2 := by rw [h1]
    _ ≤ T.card * ∑ t ∈ T, (∑ s ∈ S, if G.Adj s t then 1 else 0) ^ 2 :=
        sq_sum_le_card_mul_sum_sq
    _ ≤ T.card * (S.card ^ 2 + eST G S T) := Nat.mul_le_mul_left _ h2

lemma edges_eq_eST (A : Finset V) (hA : ∀ s t, G.Adj s t → (s ∈ A ↔ t ∉ A)) :
    G.edgeFinset.card = eST G A Aᶜ := by
  have h1 : ∑ v, G.degree v = 2 * G.edgeFinset.card := G.sum_degrees_eq_twice_card_edges
  have hdeg : ∀ v, G.degree v = ∑ t, if G.Adj v t then 1 else 0 := by
    intro v
    rw [← Finset.card_filter, ← G.neighborFinset_eq_filter, G.card_neighborFinset_eq_degree]
  have h2 : ∑ v, G.degree v = eST G A Aᶜ + eST G Aᶜ A := by
    rw [← Finset.sum_add_sum_compl A]
    unfold eST
    congr 1
    · refine Finset.sum_congr rfl fun s hs => ?_
      rw [hdeg]
      symm
      refine Finset.sum_subset (Finset.subset_univ _) fun t _ ht => ?_
      rw [Finset.mem_compl, not_not] at ht
      rw [if_neg]
      intro hadj
      exact ((hA s t hadj).mp hs) ht
    · refine Finset.sum_congr rfl fun s hs => ?_
      rw [hdeg]
      symm
      refine Finset.sum_subset (Finset.subset_univ _) fun t _ ht => ?_
      rw [if_neg]
      intro hadj
      exact (Finset.mem_compl.mp hs) ((hA s t hadj).mpr ht)
  rw [eST_symm (G := G) Aᶜ A] at h2
  omega

end Count

lemma num_bound {a b e : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) (he : 0 ≤ e)
    (h1 : e ^ 2 ≤ b * (a ^ 2 + e)) (h2 : e ^ 2 ≤ a * (b ^ 2 + e)) :
    e ≤ ((a + b) / 2) ^ (3 / 2 : ℝ) + (a + b) := by
  have hy : 0 ≤ ((a + b) / 2) ^ (3 / 2 : ℝ) := Real.rpow_nonneg (by positivity) _
  by_cases hle : e ≤ a + b
  · linarith
  · rw [not_le] at hle
    have hy4 : (((a + b) / 2) ^ (3 / 2 : ℝ)) ^ 4 = ((a + b) / 2) ^ 6 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
      norm_num
    have h3 : (e - (a + b)) ^ 2 ≤ b * a ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hle.le) (by positivity : 0 ≤ 2 * a + b),
        mul_nonneg ha hb, mul_nonneg ha ha, mul_nonneg hb hb]
    have h4 : (e - (a + b)) ^ 2 ≤ a * b ^ 2 := by
      nlinarith [mul_nonneg (sub_nonneg.mpr hle.le) (by positivity : 0 ≤ 2 * b + a),
        mul_nonneg ha hb, mul_nonneg ha ha, mul_nonneg hb hb]
    have h5 : (e - (a + b)) ^ 4 ≤ (a * b) ^ 3 := by
      calc (e - (a + b)) ^ 4 = (e - (a + b)) ^ 2 * (e - (a + b)) ^ 2 := by ring
        _ ≤ (b * a ^ 2) * (a * b ^ 2) := mul_le_mul h3 h4 (sq_nonneg _) (by positivity)
        _ = (a * b) ^ 3 := by ring
    have h6 : a * b ≤ ((a + b) / 2) ^ 2 := by nlinarith [sq_nonneg (a - b)]
    have h7 : (e - (a + b)) ^ 4 ≤ (((a + b) / 2) ^ (3 / 2 : ℝ)) ^ 4 := by
      rw [hy4]
      calc (e - (a + b)) ^ 4 ≤ (a * b) ^ 3 := h5
        _ ≤ (((a + b) / 2) ^ 2) ^ 3 := pow_le_pow_left₀ (by positivity) h6 3
        _ = ((a + b) / 2) ^ 6 := by ring
    have h8 : e - (a + b) ≤ ((a + b) / 2) ^ (3 / 2 : ℝ) := by
      by_contra hcon
      rw [not_le] at hcon
      have := pow_lt_pow_left₀ hcon hy (by norm_num : (4 : ℕ) ≠ 0)
      linarith
    linarith

lemma upper_bound (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]
    (h4 : (cycleGraph 4).Free G) (hodd : ∀ k, Odd k → 3 ≤ k → (cycleGraph k).Free G) :
    (G.edgeFinset.card : ℝ) ≤ ((n : ℝ) / 2) ^ (3 / 2 : ℝ) + n := by
  obtain ⟨c⟩ := colorable_two_of_free hodd
  let A : Finset (Fin n) := Finset.univ.filter fun v => c v = 0
  have hA : ∀ s t, G.Adj s t → (s ∈ A ↔ t ∉ A) := by
    intro s t hst
    have hv := c.valid hst
    simp only [A, Finset.mem_filter, Finset.mem_univ, true_and]
    have h1 := (c s).isLt
    have h2 := (c t).isLt
    rw [Ne, Fin.ext_iff] at hv
    rw [Fin.ext_iff, Fin.ext_iff]
    simp only [Fin.val_zero]
    omega
  have he := edges_eq_eST A hA
  have k1 := kst_ineq h4 A Aᶜ
  have k2 := kst_ineq h4 Aᶜ A
  rw [eST_symm (G := G) Aᶜ A] at k2
  have hcard : A.card + Aᶜ.card = n := by
    rw [Finset.card_add_card_compl]; simp
  rw [he]
  have r1 : ((eST G A Aᶜ : ℕ) : ℝ) ^ 2 ≤ (Aᶜ.card : ℝ) * ((A.card : ℝ) ^ 2 + eST G A Aᶜ) := by
    exact_mod_cast k1
  have r2 : ((eST G A Aᶜ : ℕ) : ℝ) ^ 2 ≤ (A.card : ℝ) * ((Aᶜ.card : ℝ) ^ 2 + eST G A Aᶜ) := by
    exact_mod_cast k2
  have key := num_bound (Nat.cast_nonneg A.card) (Nat.cast_nonneg Aᶜ.card)
    (Nat.cast_nonneg _) r1 r2
  have hn : ((A.card : ℝ) + Aᶜ.card) = n := by exact_mod_cast hcard
  rw [hn] at key
  exact key


section Construct

/-- point-line incidence graph of the affine plane over `ZMod p` (non-vertical lines) -/
def incGraph (p : ℕ) : SimpleGraph ((ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)) :=
  SimpleGraph.fromRel fun u v =>
    ∃ P L : ZMod p × ZMod p, u = Sum.inl P ∧ v = Sum.inr L ∧ P.2 = L.1 * P.1 + L.2

lemma incGraph_adj_iff {p : ℕ} {u v : (ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)} :
    (incGraph p).Adj u v ↔
      (∃ P L : ZMod p × ZMod p, u = Sum.inl P ∧ v = Sum.inr L ∧ P.2 = L.1 * P.1 + L.2) ∨
      (∃ P L : ZMod p × ZMod p, v = Sum.inl P ∧ u = Sum.inr L ∧ P.2 = L.1 * P.1 + L.2) := by
  unfold incGraph
  rw [SimpleGraph.fromRel_adj]
  constructor
  · rintro ⟨-, h⟩
    exact h
  · intro h
    refine ⟨?_, h⟩
    rintro rfl
    rcases h with ⟨P, L, h1, h2, -⟩ | ⟨P, L, h1, h2, -⟩ <;>
    · rw [h1] at h2
      exact Sum.inl_ne_inr h2

lemma adj_inl_inr {p : ℕ} {P L : ZMod p × ZMod p} :
    (incGraph p).Adj (Sum.inl P) (Sum.inr L) ↔ P.2 = L.1 * P.1 + L.2 := by
  rw [incGraph_adj_iff]
  constructor
  · rintro (⟨P', L', h1, h2, h3⟩ | ⟨P', L', h1, h2, h3⟩)
    · cases h1
      cases h2
      exact h3
    · exact absurd h1 Sum.inr_ne_inl
  · intro h
    exact Or.inl ⟨P, L, rfl, rfl, h⟩

lemma not_adj_inl_inl {p : ℕ} {P P' : ZMod p × ZMod p} :
    ¬ (incGraph p).Adj (Sum.inl P) (Sum.inl P') := by
  rw [incGraph_adj_iff]
  rintro (⟨_, _, _, h2, _⟩ | ⟨_, _, _, h2, _⟩)
  · exact Sum.inl_ne_inr h2
  · exact Sum.inl_ne_inr h2

lemma not_adj_inr_inr {p : ℕ} {L L' : ZMod p × ZMod p} :
    ¬ (incGraph p).Adj (Sum.inr L) (Sum.inr L') := by
  rw [incGraph_adj_iff]
  rintro (⟨_, _, h1, _, _⟩ | ⟨_, _, h1, _, _⟩)
  · exact Sum.inr_ne_inl h1
  · exact Sum.inr_ne_inl h1

lemma inc_no_c4_aux {p : ℕ} [Fact p.Prime] {P1 : ZMod p × ZMod p}
    {b c d : (ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)}
    (hab : (incGraph p).Adj (Sum.inl P1) b) (hbc : (incGraph p).Adj b c)
    (hcd : (incGraph p).Adj c d) (hda : (incGraph p).Adj d (Sum.inl P1))
    (hac : Sum.inl P1 ≠ c) (hbd : b ≠ d) : False := by
  rcases b with P | L1
  · exact not_adj_inl_inl hab
  rcases c with P2 | L
  swap
  · exact not_adj_inr_inr hbc
  rcases d with P | L2
  · exact not_adj_inl_inl hcd
  have e1 := adj_inl_inr.mp hab
  have e2 := adj_inl_inr.mp hbc.symm
  have e3 := adj_inl_inr.mp hcd
  have e4 := adj_inl_inr.mp hda.symm
  have key : (L1.1 - L2.1) * (P1.1 - P2.1) = 0 := by
    linear_combination -e1 + e2 - e3 + e4
  rcases mul_eq_zero.mp key with h | h
  · apply hbd
    have h1 : L1.1 = L2.1 := sub_eq_zero.mp h
    have h2 : L1.2 = L2.2 := by linear_combination -e1 + e4 - P1.1 * h1
    exact congrArg Sum.inr (Prod.ext h1 h2)
  · apply hac
    have h1 : P1.1 = P2.1 := sub_eq_zero.mp h
    have h2 : P1.2 = P2.2 := by linear_combination e1 - e2 + L1.1 * h1
    exact congrArg Sum.inl (Prod.ext h1 h2)

lemma inc_no_c4 {p : ℕ} [Fact p.Prime]
    {a b c d : (ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)}
    (hab : (incGraph p).Adj a b) (hbc : (incGraph p).Adj b c)
    (hcd : (incGraph p).Adj c d) (hda : (incGraph p).Adj d a)
    (hac : a ≠ c) (hbd : b ≠ d) : False := by
  rcases a with P1 | L
  · exact inc_no_c4_aux hab hbc hcd hda hac hbd
  · rcases b with P | L'
    · exact inc_no_c4_aux hbc hcd hda hab hbd (Ne.symm hac)
    · exact not_adj_inr_inr hab

lemma map_c4_free {p n : ℕ} [Fact p.Prime]
    (f : ((ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)) ↪ Fin n) :
    (cycleGraph 4).Free ((incGraph p).map f) := by
  rintro ⟨φ⟩
  have e01 : (cycleGraph 4).Adj 0 1 := (cycleGraph_adj (n := 2)).mpr (by decide)
  have e12 : (cycleGraph 4).Adj 1 2 := (cycleGraph_adj (n := 2)).mpr (by decide)
  have e23 : (cycleGraph 4).Adj 2 3 := (cycleGraph_adj (n := 2)).mpr (by decide)
  have e30 : (cycleGraph 4).Adj 3 0 := (cycleGraph_adj (n := 2)).mpr (by decide)
  have h01 := φ.toHom.map_adj e01
  have h12 := φ.toHom.map_adj e12
  have h23 := φ.toHom.map_adj e23
  have h30 := φ.toHom.map_adj e30
  rw [SimpleGraph.map_adj] at h01 h12 h23 h30
  obtain ⟨a, b, hab, ha, hb⟩ := h01
  obtain ⟨b', c, hbc, hb', hc⟩ := h12
  obtain ⟨c', d, hcd, hc', hd⟩ := h23
  obtain ⟨d', a', hda, hd', ha'⟩ := h30
  have hb2 : b' = b := f.injective (hb'.trans hb.symm)
  have hc2 : c' = c := f.injective (hc'.trans hc.symm)
  have hd2 : d' = d := f.injective (hd'.trans hd.symm)
  have ha2 : a' = a := f.injective (ha'.trans ha.symm)
  subst hb2 hc2 hd2 ha2
  refine inc_no_c4 hab hbc hcd hda ?_ ?_
  · intro hac
    rw [hac] at ha
    have h02 : (0 : Fin 4) = 2 := φ.injective (ha.symm.trans hc)
    exact absurd h02 (by decide)
  · intro hbd
    rw [hbd] at hb
    have h13 : (1 : Fin 4) = 3 := φ.injective (hb.symm.trans hd)
    exact absurd h13 (by decide)

lemma map_colorable {p n : ℕ}
    (f : ((ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)) ↪ Fin n) :
    ((incGraph p).map f).Colorable 2 := by
  classical
  refine ⟨Coloring.mk (fun v => if ∃ P, f (Sum.inl P) = v then (0 : Fin 2) else 1) ?_⟩
  intro v w hvw
  rw [SimpleGraph.map_adj] at hvw
  obtain ⟨a, b, hab, rfl, rfl⟩ := hvw
  rw [incGraph_adj_iff] at hab
  rcases hab with ⟨P, L, rfl, rfl, -⟩ | ⟨P, L, rfl, rfl, -⟩
  · have h1 : ∃ P', f (Sum.inl P') = f (Sum.inl P) := ⟨P, rfl⟩
    have h2 : ¬ ∃ P', f (Sum.inl P') = f (Sum.inr L) := by
      rintro ⟨P', h⟩
      exact Sum.inl_ne_inr (f.injective h)
    rw [if_pos h1, if_neg h2]
    decide
  · have h1 : ∃ P', f (Sum.inl P') = f (Sum.inl P) := ⟨P, rfl⟩
    have h2 : ¬ ∃ P', f (Sum.inl P') = f (Sum.inr L) := by
      rintro ⟨P', h⟩
      exact Sum.inl_ne_inr (f.injective h)
    rw [if_pos h1, if_neg h2]
    decide

lemma free_odd_of_colorable {V : Type*} {G : SimpleGraph V} (hc : G.Colorable 2) {k : ℕ}
    (hk : Odd k) (hk3 : 3 ≤ k) : (cycleGraph k).Free G := by
  rintro ⟨φ⟩
  have h2 : (cycleGraph k).Colorable 2 := Colorable.of_hom φ.toHom hc
  have h3 := chromaticNumber_cycleGraph_of_odd k (by omega) hk
  have h4 := h2.chromaticNumber_le
  rw [h3] at h4
  exact absurd h4 (by decide)

lemma card_edges_inc {p : ℕ} [Fact p.Prime] [DecidableRel (incGraph p).Adj] :
    p ^ 3 ≤ (incGraph p).edgeFinset.card := by
  have hc : Fintype.card (ZMod p × ZMod p × ZMod p) = p ^ 3 := by
    simp [ZMod.card]
    ring
  rw [← hc, ← Finset.card_univ]
  refine Finset.card_le_card_of_injOn
    (fun t => s(Sum.inl (t.2.2, t.1 * t.2.2 + t.2.1), Sum.inr (t.1, t.2.1))) ?_ ?_
  · intro t _
    simp only [Finset.mem_coe, SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet]
    exact adj_inl_inr.mpr rfl
  · rintro ⟨a, b, x⟩ _ ⟨a', b', x'⟩ _ h
    simp only [Sym2.eq_iff, Sum.inl.injEq, Sum.inr.injEq, Prod.mk.injEq, reduceCtorEq,
      and_false, or_false] at h
    obtain ⟨⟨hx, -⟩, ha, hb⟩ := h
    simp [hx, ha, hb]

end Construct

open scoped Classical in
lemma upper_ex (n : ℕ) :
    (Erdos573.cycleExtremalNumber ({4} ∪ {k | Odd k ∧ 3 ≤ k}) n : ℝ)
      ≤ ((n : ℝ) / 2) ^ (3 / 2 : ℝ) + n := by
  let admissible := Finset.univ.filter fun G : SimpleGraph (Fin n) =>
    ∀ k ∈ (({4} ∪ {k | Odd k ∧ 3 ≤ k}) : Set ℕ), (cycleGraph k).Free G
  change ((admissible.sup (fun G => G.edgeFinset.card) : ℕ) : ℝ) ≤ _
  by_cases hne : admissible.Nonempty
  · obtain ⟨G, hG, he⟩ := admissible.exists_mem_eq_sup hne (fun G => G.edgeFinset.card)
    have hfree := (Finset.mem_filter.mp hG).2
    rw [he]
    exact upper_bound n G (hfree 4 (by simp)) (fun k hk hk3 => hfree k (Or.inr ⟨hk, hk3⟩))
  · simp only [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.sup_empty, bot_eq_zero,
      Nat.cast_zero]
    positivity

open scoped Classical in
lemma lower_ex (p n : ℕ) (hp : p.Prime) (hn : 2 * p ^ 2 ≤ n) :
    p ^ 3 ≤ Erdos573.cycleExtremalNumber ({4} ∪ {k | Odd k ∧ 3 ≤ k}) n := by
  have : Fact p.Prime := ⟨hp⟩
  have hcard : Fintype.card ((ZMod p × ZMod p) ⊕ (ZMod p × ZMod p)) ≤ Fintype.card (Fin n) := by
    simp only [Fintype.card_sum, Fintype.card_prod, ZMod.card, Fintype.card_fin]
    nlinarith
  obtain ⟨f⟩ := Function.Embedding.nonempty_of_card_le hcard
  have hG : (incGraph p).map f ∈ Finset.univ.filter fun G : SimpleGraph (Fin n) =>
      ∀ k ∈ (({4} ∪ {k | Odd k ∧ 3 ≤ k}) : Set ℕ), (cycleGraph k).Free G := by
    rw [Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    rintro k (hk | ⟨hk, hk3⟩)
    · rw [Set.mem_singleton_iff] at hk
      subst hk
      exact map_c4_free f
    · exact free_odd_of_colorable (map_colorable f) hk hk3
  have h1 : p ^ 3 ≤ ((incGraph p).map f).edgeFinset.card := by
    rw [card_edgeFinset_map]
    exact card_edges_inc
  have h2 := Finset.le_sup (f := fun G : SimpleGraph (Fin n) => G.edgeFinset.card) hG
  have h3 : ∀ (i1 i2 : Fintype ((incGraph p).map f).edgeSet),
      (@edgeFinset _ _ i1).card = (@edgeFinset _ _ i2).card := by
    intro i1 i2
    rw [Subsingleton.elim i1 i2]
  calc p ^ 3 ≤ _ := h1
    _ = _ := h3 _ _
    _ ≤ _ := h2


/-- The target, assuming primes in short intervals (not available in Mathlib). -/
lemma glue (HP : ∀ ε : ℝ, 0 < ε → ∀ᶠ m : ℕ in Filter.atTop,
      ∃ p : ℕ, p.Prime ∧ (1 - ε) * (m : ℝ) < p ∧ p ≤ m) :
    Asymptotics.IsEquivalent Filter.atTop
      (fun n : ℕ ↦ (Erdos573.cycleExtremalNumber ({4} ∪ {k | Odd k ∧ 3 ≤ k}) n : ℝ))
      (fun n : ℕ ↦ ((n : ℝ) / 2) ^ (3 / 2 : ℝ)) := by
  rw [Asymptotics.IsEquivalent, Asymptotics.isLittleO_iff]
  intro c hc
  have hmin0 : 0 < min c 1 := lt_min hc one_pos
  set ε : ℝ := min c 1 / 6 with hε
  have hε0 : 0 < ε := by positivity
  have hε1 : ε ≤ 1 / 6 := by
    have := min_le_right c 1
    rw [hε]; linarith
  have hεc : 6 * ε ≤ c := by
    have := min_le_left c 1
    rw [hε]; linarith
  have hsq : Filter.Tendsto (fun n : ℕ => Nat.sqrt (n / 2)) Filter.atTop Filter.atTop := by
    rw [Filter.tendsto_atTop_atTop]
    intro b
    refine ⟨2 * (b * b), fun n hn => ?_⟩
    rw [Nat.le_sqrt]
    omega
  have hev := hsq.eventually (HP ε hε0)
  filter_upwards [hev, Filter.eventually_ge_atTop
    (Nat.ceil (8 / c ^ 2) + Nat.ceil (2 / ε ^ 2) + 1)] with n hn hN
  obtain ⟨p, hp, hpl, hpm⟩ := hn
  have hy : ((n : ℝ) / 2) ^ (3 / 2 : ℝ) = Real.sqrt ((n : ℝ) / 2) ^ 3 := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
    norm_num
  have hup := upper_ex n
  simp only [Pi.sub_apply]
  rw [hy] at hup ⊢
  have hs0 : 0 ≤ Real.sqrt ((n : ℝ) / 2) := Real.sqrt_nonneg _
  have hs2 : Real.sqrt ((n : ℝ) / 2) ^ 2 = (n : ℝ) / 2 := Real.sq_sqrt (by positivity)
  generalize Real.sqrt ((n : ℝ) / 2) = s at hup hs0 hs2 ⊢
  have hm1 : n / 2 < (Nat.sqrt (n / 2) + 1) * (Nat.sqrt (n / 2) + 1) := Nat.lt_succ_sqrt (n / 2)
  have hm2 : Nat.sqrt (n / 2) * Nat.sqrt (n / 2) ≤ n / 2 := Nat.sqrt_le (n / 2)
  generalize Nat.sqrt (n / 2) = m at hpl hpm hm1 hm2
  have hNr : ((Nat.ceil (8 / c ^ 2) + Nat.ceil (2 / ε ^ 2) + 1 : ℕ) : ℝ) ≤ n := by
    exact_mod_cast hN
  push_cast at hNr
  have hc1 : 8 / c ^ 2 ≤ (n : ℝ) := by
    have h1 := Nat.le_ceil (8 / c ^ 2)
    have h2 : (0 : ℝ) ≤ (Nat.ceil (2 / ε ^ 2) : ℝ) := Nat.cast_nonneg _
    linarith
  have he1 : 2 / ε ^ 2 ≤ (n : ℝ) := by
    have h1 := Nat.le_ceil (2 / ε ^ 2)
    have h2 : (0 : ℝ) ≤ (Nat.ceil (8 / c ^ 2) : ℝ) := Nat.cast_nonneg _
    linarith
  have hcs : 2 ≤ c * s := by
    have h1 : 4 ≤ (c * s) ^ 2 := by
      rw [mul_pow, hs2]
      rw [div_le_iff₀ (by positivity)] at hc1
      nlinarith
    nlinarith [mul_nonneg hc.le hs0]
  have hes : 1 ≤ ε * s := by
    have h1 : 1 ≤ (ε * s) ^ 2 := by
      rw [mul_pow, hs2]
      rw [div_le_iff₀ (by positivity)] at he1
      nlinarith
    nlinarith [mul_nonneg hε0.le hs0]
  have hsm : s < (m : ℝ) + 1 := by
    have h2 : n < 2 * ((m + 1) * (m + 1)) := by omega
    have h3 : (n : ℝ) < 2 * (((m : ℝ) + 1) * ((m : ℝ) + 1)) := by exact_mod_cast h2
    have h4 : s ^ 2 < ((m : ℝ) + 1) ^ 2 := by rw [hs2]; nlinarith
    exact lt_of_pow_lt_pow_left₀ 2 (by positivity) h4
  have hpn : 2 * p ^ 2 ≤ n := by
    have h1 : p * p ≤ m * m := Nat.mul_le_mul hpm hpm
    rw [sq]; omega
  have hlow := lower_ex p n hp hpn
  have hlowr : (p : ℝ) ^ 3 ≤
      (Erdos573.cycleExtremalNumber ({4} ∪ {k | Odd k ∧ 3 ≤ k}) n : ℝ) := by
    exact_mod_cast hlow
  have h1ε : 0 ≤ 1 - ε := by linarith
  have hms : (1 - ε) * s ≤ m := by
    have h1 : (1 - ε) * s = s - ε * s := by ring
    rw [h1]; linarith
  have hp1 : (1 - ε) ^ 2 * s ≤ p := by
    calc (1 - ε) ^ 2 * s = (1 - ε) * ((1 - ε) * s) := by ring
      _ ≤ (1 - ε) * m := mul_le_mul_of_nonneg_left hms h1ε
      _ ≤ p := hpl.le
  have hp3 : ((1 - ε) ^ 2 * s) ^ 3 ≤ (p : ℝ) ^ 3 := pow_le_pow_left₀ (by positivity) hp1 3
  have hbern : 1 - 6 * ε ≤ (1 - ε) ^ 6 := by
    calc 1 - 6 * ε = 1 + ((6 : ℕ) : ℝ) * (-ε) := by push_cast; ring
      _ ≤ (1 + (-ε)) ^ 6 := one_add_mul_le_pow (by linarith) 6
      _ = (1 - ε) ^ 6 := by ring
  have hs3 : 0 ≤ s ^ 3 := by positivity
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hs3, abs_le]
  constructor
  · have h5 : (1 - c) * s ^ 3 ≤ (p : ℝ) ^ 3 := by
      calc (1 - c) * s ^ 3 ≤ (1 - 6 * ε) * s ^ 3 := by
            nlinarith [mul_nonneg (sub_nonneg.mpr hεc) hs3]
        _ ≤ (1 - ε) ^ 6 * s ^ 3 := mul_le_mul_of_nonneg_right hbern hs3
        _ = ((1 - ε) ^ 2 * s) ^ 3 := by ring
        _ ≤ (p : ℝ) ^ 3 := hp3
    linarith
  · have h6 : (n : ℝ) ≤ c * s ^ 3 := by
      have h7 : (n : ℝ) = 2 * s ^ 2 := by rw [hs2]; ring
      nlinarith [mul_le_mul_of_nonneg_right hcs (pow_nonneg hs0 2)]
    linarith

lemma theta_le_of_no_prime {m : ℕ} {y : ℝ}
    (h : ∀ p : ℕ, p.Prime → p ≤ m → (p : ℝ) ≤ y) :
    Chebyshev.theta (m : ℝ) ≤ Chebyshev.theta y := by
  rw [Chebyshev.theta_eq_sum_Icc, Chebyshev.theta_eq_sum_Icc]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
  · intro p hp
    rw [Finset.mem_filter, Finset.mem_Icc] at hp ⊢
    have h1 : p ≤ m := by simpa using hp.1.2
    exact ⟨⟨Nat.zero_le _, Nat.le_floor (h p hp.2 h1)⟩, hp.2⟩
  · intro p _ _
    exact Real.log_natCast_nonneg p

lemma hp_of_theta
    (h1 : ∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in Filter.atTop, (1 - ε) * x ≤ Chebyshev.theta x)
    (h2 : ∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in Filter.atTop, Chebyshev.theta x ≤ (1 + ε) * x) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ m : ℕ in Filter.atTop,
      ∃ p : ℕ, p.Prime ∧ (1 - ε) * (m : ℝ) < p ∧ p ≤ m := by
  intro ε hε
  have hη0 : 0 < min ε (1 / 2) := lt_min hε (by norm_num)
  have hηε : min ε (1 / 2) ≤ ε := min_le_left _ _
  have hη2 : min ε (1 / 2) ≤ 1 / 2 := min_le_right _ _
  generalize min ε (1 / 2) = η at hη0 hηε hη2
  have hδ : 0 < η / 4 := by positivity
  have t1 : Filter.Tendsto (fun m : ℕ => (m : ℝ)) Filter.atTop Filter.atTop :=
    tendsto_natCast_atTop_atTop
  have t2 : Filter.Tendsto (fun m : ℕ => (1 - η) * (m : ℝ)) Filter.atTop Filter.atTop :=
    t1.const_mul_atTop (by linarith)
  filter_upwards [t1.eventually (h1 (η / 4) hδ), t2.eventually (h2 (η / 4) hδ),
    Filter.eventually_ge_atTop 1] with m hm1 hm2 hm
  by_contra hno
  have hmpos : (0 : ℝ) < m := by exact_mod_cast hm
  have key : Chebyshev.theta (m : ℝ) ≤ Chebyshev.theta ((1 - η) * (m : ℝ)) := by
    refine theta_le_of_no_prime fun p hp hpm => ?_
    by_contra hlt
    rw [not_le] at hlt
    have h3 : (1 - ε) * (m : ℝ) ≤ (1 - η) * (m : ℝ) :=
      mul_le_mul_of_nonneg_right (by linarith) hmpos.le
    exact hno ⟨p, hp, lt_of_le_of_lt h3 hlt, hpm⟩
  have h4 : (1 - η / 4) * (m : ℝ) ≤ (1 + η / 4) * ((1 - η) * (m : ℝ)) :=
    le_trans hm1 (le_trans key hm2)
  nlinarith [mul_pos hmpos hη0, mul_pos (mul_pos hmpos hη0) hη0]

/-- The two one-sided bounds follow from the prime number theorem in the form `theta(x) ~ x`. -/
lemma halves_of_isEquivalent
    (h : Asymptotics.IsEquivalent Filter.atTop Chebyshev.theta (fun x : ℝ => x)) :
    (∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in Filter.atTop, (1 - ε) * x ≤ Chebyshev.theta x) ∧
    (∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in Filter.atTop, Chebyshev.theta x ≤ (1 + ε) * x) := by
  have h' := Asymptotics.isLittleO_iff.mp h.isLittleO
  constructor
  · intro ε hε
    filter_upwards [h' hε, Filter.eventually_ge_atTop (0 : ℝ)] with x hx hx0
    simp only [Pi.sub_apply, Real.norm_eq_abs, abs_of_nonneg hx0] at hx
    have h3 := (abs_le.mp hx).1
    linarith
  · intro ε hε
    filter_upwards [h' hε, Filter.eventually_ge_atTop (0 : ℝ)] with x hx hx0
    simp only [Pi.sub_apply, Real.norm_eq_abs, abs_of_nonneg hx0] at hx
    have h3 := (abs_le.mp hx).2
    linarith

/-- Entry point from the other usual form of the prime number theorem, `psi(x) ~ x`. -/
lemma theta_equiv_of_psi_equiv
    (h : Asymptotics.IsEquivalent Filter.atTop Chebyshev.psi (fun x : ℝ => x)) :
    Asymptotics.IsEquivalent Filter.atTop Chebyshev.theta (fun x : ℝ => x) := by
  have hs : Asymptotics.IsLittleO Filter.atTop Real.sqrt (fun x : ℝ => x) := by
    rw [Asymptotics.isLittleO_iff]
    intro c hc
    filter_upwards [Filter.eventually_ge_atTop (1 / c ^ 2),
      Filter.eventually_ge_atTop (0 : ℝ)] with x hx hx0
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg x),
      abs_of_nonneg hx0]
    have h0 : 1 / c ≤ Real.sqrt x :=
      (Real.le_sqrt' (by positivity)).mpr (by rw [div_pow, one_pow]; exact hx)
    have h1 : 1 ≤ c * Real.sqrt x := by
      calc (1 : ℝ) = c * (1 / c) := by field_simp
        _ ≤ c * Real.sqrt x := mul_le_mul_of_nonneg_left h0 hc.le
    calc Real.sqrt x = 1 * Real.sqrt x := (one_mul _).symm
      _ ≤ (c * Real.sqrt x) * Real.sqrt x :=
          mul_le_mul_of_nonneg_right h1 (Real.sqrt_nonneg x)
      _ = c * x := by rw [mul_assoc, Real.mul_self_sqrt hx0]
  have h1 : Asymptotics.IsLittleO Filter.atTop (Chebyshev.psi - Chebyshev.theta)
      (fun x : ℝ => x) := Chebyshev.isBigO_psi_sub_theta_sqrt.trans_isLittleO hs
  have h2 := h.isLittleO.sub h1
  show Asymptotics.IsLittleO Filter.atTop (Chebyshev.theta - fun x : ℝ => x) (fun x : ℝ => x)
  refine h2.congr_left fun x => ?_
  simp only [Pi.sub_apply]
  ring

end OMA573

theorem OMA573.kst_reused : type_of% @Erdos573.erdos_573.variants.kst := by
  have pnt : Asymptotics.IsEquivalent Filter.atTop Chebyshev.theta (fun x : ℝ => x) :=
    chebyshev_asymptotic
  obtain ⟨h1, h2⟩ := OMA573.halves_of_isEquivalent pnt
  exact OMA573.glue (OMA573.hp_of_theta h1 h2)

lemma OMA573.cycleExtremalNumber_anti {L L' : Set ℕ} (h : L ⊆ L') (n : ℕ) :
    Erdos573.cycleExtremalNumber L' n ≤ Erdos573.cycleExtremalNumber L n := by
  classical
  unfold Erdos573.cycleExtremalNumber
  apply Finset.sup_mono
  intro G hG
  simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hG ⊢
  exact fun k hk => hG k (h hk)

theorem OMA.solution : OMA.R_Erdos573_erdos_573_R1.H1 := by
  unfold OMA.R_Erdos573_erdos_573_R1.H1
  intro ε hε
  have hk' := Asymptotics.isLittleO_iff.mp OMA573.kst_reused.isLittleO hε
  filter_upwards [hk'] with n hn
  have hv : (0 : ℝ) ≤ ((n : ℝ) / 2) ^ (3 / 2 : ℝ) := Real.rpow_nonneg (by positivity) _
  rw [Pi.sub_apply, Real.norm_eq_abs, Real.norm_of_nonneg hv] at hn
  have h1 := (abs_le.mp hn).1
  have hsub : ({3, 4} : Set ℕ) ⊆ {4} ∪ {k | Odd k ∧ 3 ≤ k} := by
    intro k hk
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hk
    rcases hk with rfl | rfl
    · exact Or.inr ⟨by decide, le_rfl⟩
    · exact Or.inl rfl
  have hmono : (Erdos573.cycleExtremalNumber ({4} ∪ {k | Odd k ∧ 3 ≤ k}) n : ℝ) ≤
      (Erdos573.cycleExtremalNumber {3, 4} n : ℝ) := by
    exact_mod_cast OMA573.cycleExtremalNumber_anti hsub n
  linarith
