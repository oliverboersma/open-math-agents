private def rawAt (j : ℕ) : List (List ℕ) :=
  (allRows[j/100]?.getD #[])[j%100]?.getD []

private def rowAt (j : ℕ) : List (List ℕ) :=
  let row := rawAt j
  let start := 25*(j-row.length)+7
  row.map (fun xs => xs.map (fun a => start+a))

private def proper (xs : List ℕ) : Bool :=
  xs.all fun a => xs.all fun b => decide (a=b) || fast (a*b+1)

private def valid (j : ℕ) : Bool :=
  let row := rowAt j
  let t := row.length
  let start := 25*(j-t)+7
  decide (0 < t ∧ t ≤ j) &&
    (List.range (25*t)).all (fun d =>
      let a := start+d
      row.any (fun xs => xs.contains a) || fast (a*a+1)) &&
    row.all proper

private def chunk (c : ℕ) : Bool :=
  (List.range 100).all fun i =>
    let j := 100*c+i
    decide (j=0 ∨ 8400<j) || valid j

