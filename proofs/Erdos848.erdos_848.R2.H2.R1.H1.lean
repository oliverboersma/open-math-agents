private def primeBlock (i : ℕ) : Bool :=
  (List.range 61).all fun j =>
    let q := 61*i+j
    decide (q < 2 ∨ 3600 < q ∨ (1 < q.gcd smallPrimes ∧ ¬ q*q ∣ smallPrimes))

set_option maxRecDepth 16000 in
set_option maxHeartbeats 8000000 in
private theorem smallTable : (List.range 60).all primeBlock = true := by decide +kernel

private theorem control {q : ℕ} (pq : q.Prime) (hq : q ≤ 3600) :
    q ∣ smallPrimes ∧ ¬ q*q ∣ smallPrimes := by
  have block := List.all_eq_true.mp smallTable (q/61) (List.mem_range.mpr (by omega))
  have cell := List.all_eq_true.mp block (q%61) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  change decide (61*(q/61)+q%61 < 2 ∨ 3600 < 61*(q/61)+q%61 ∨ _) = true at cell
  rw [show 61*(q/61)+q%61=q by omega] at cell
  have ok := of_decide_eq_true cell
  have lower := pq.two_le
  obtain h | h | ⟨big,sq⟩ := ok
  · omega
  · omega
  obtain one | eqn := (Nat.dvd_prime pq).mp (Nat.gcd_dvd_left q smallPrimes)
  · omega
  · exact ⟨eqn ▸ Nat.gcd_dvd_right q smallPrimes,sq⟩

private theorem productFactor {q : ℕ} (pq : q.Prime) (l : List ℕ) (h : q ∣ l.prod) :
    ∃ v ∈ l, q ∣ v := by
  induction l with
  | nil => exact (pq.not_dvd_one h).elim
  | cons v l ih =>
    obtain hv | hl := pq.dvd_mul.mp (show q ∣ v*l.prod from h)
    · exact ⟨v,List.mem_cons_self,hv⟩
    · obtain ⟨a,ha,dvd⟩ := ih hl
      exact ⟨a,List.mem_cons_of_mem _ ha,dvd⟩

private theorem smallSquarefree : Squarefree smallPrimes := by
  apply Nat.squarefree_iff_prime_squarefree.mpr
  intro q pq square
  have dvd : q ∣ factors.prod := factorTable.1.symm ▸ (dvd_mul_right q q).trans square
  obtain ⟨v,hv,qd⟩ := productFactor pq factors dvd
  have bounds := of_decide_eq_true (List.all_eq_true.mp factorTable.2 v hv)
  exact (control pq ((Nat.le_of_dvd bounds.1 qd).trans bounds.2)).2 square

private def fast (n : ℕ) : Bool :=
  let r := n / n.gcd smallPrimes
  decide (0 < n ∧ n ≤ 3600^3 ∧ r.gcd smallPrimes = 1 ∧
    (r = 1 ∨ r.sqrt*r.sqrt ≠ r))

private theorem sound {n : ℕ} (h : fast n = true) : Squarefree n := by
  let P := smallPrimes
  let g := n.gcd P
  let r := n/g
  obtain ⟨hn,cap,copr,nsq⟩ := of_decide_eq_true h
  change Nat.gcd r P = 1 at copr
  change r = 1 ∨ r.sqrt*r.sqrt ≠ r at nsq
  have gp : g ∣ P := Nat.gcd_dvd_right _ _
  have div : r*g = n := Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)
  have rp : 0 < r := Nat.pos_of_ne_zero (fun z => by
    rw [z,zero_mul] at div
    omega)
  have free : Squarefree g := smallSquarefree.squarefree_of_dvd gp
  have cop : r.Coprime P := copr
  have disj : r.Coprime g := cop.coprime_dvd_right gp
  rw [←div,Nat.squarefree_mul disj]
  refine ⟨Nat.squarefree_iff_prime_squarefree.mpr ?_,free⟩
  intro q pq qq
  have big (p : ℕ) (pr : p.Prime) (dvd : p ∣ r) : 3600 < p := by
    by_contra! sm
    have inP : p ∣ P := (control pr sm).1
    exact pr.not_dvd_one (copr ▸ Nat.dvd_gcd dvd inP)
  have qbig := big q pq ((dvd_mul_right q q).trans qq)
  obtain ⟨s,hs⟩ := qq
  by_cases one : s=1
  · rw [one,Nat.mul_one] at hs
    rcases nsq with low | nonsq
    · have hq := pq.two_le
      nlinarith
    · apply nonsq
      rw [hs,Nat.sqrt_eq]
  · obtain ⟨p,pr,pd⟩ := Nat.exists_prime_and_dvd one
    have sr : s ∣ r := ⟨q*q,by simpa [Nat.mul_comm] using hs⟩
    have pbig := big p pr (pd.trans sr)
    have sp : 0 < s := by
      by_contra! no
      have z : s=0 := by omega
      rw [z,Nat.mul_zero] at hs
      omega
    have sle := Nat.le_of_dvd sp pd
    have bnd : 3601*3601*3601 ≤ (q*q)*s :=
      Nat.mul_le_mul (Nat.mul_le_mul (by omega) (by omega)) (by omega)
    have grow : 3600^3 < (q*q)*s := (by decide : 3600^3 < 3601*3601*3601).trans_le bnd
    have le : r ≤ n := Nat.div_le_self ..
    omega

