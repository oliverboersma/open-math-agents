private theorem verified (j : ℕ) (hj : 0 < j) (hlim : j ≤ 8400) : valid j = true := by
  have hh := checked ⟨j/100,by omega⟩
  have h := List.all_eq_true.mp hh (j%100) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  change (decide (100*(j/100)+j%100 = 0 ∨ 8400 < 100*(j/100)+j%100) ||
    valid (100*(j/100)+j%100)) = true at h
  have eq : 100*(j/100)+j%100 = j := by omega
  rw [eq] at h
  simp only [Bool.or_eq_true] at h
  exact h.resolve_left (fun hbad => by
    have bad := of_decide_eq_true hbad
    omega)

open Erdos848

private theorem bound_by_rows (j : ℕ) (A : Finset ℕ) (row : List (List ℕ))
    (admissible : NonSquarefreeProductProp A)
    (cover : ∀ n ∈ A, ∃ xs ∈ row, n ∈ xs) (edges : row.all proper = true)
    (size : row.length ≤ j) : A.card ≤ j := by
  classical
  let pts (xs : List ℕ) := A ∩ xs.toFinset
  have subUnion : A ⊆ row.toFinset.biUnion pts := by
    intro a ha
    obtain ⟨xs, hx, hxa⟩ := cover a ha
    exact Finset.mem_biUnion.mpr ⟨xs, List.mem_toFinset.mpr hx, Finset.mem_inter.mpr
      ⟨ha,List.mem_toFinset.mpr hxa⟩⟩
  have small (xs : List ℕ) (hx : xs ∈ row.toFinset) : (pts xs).card ≤ 1 := by
    apply Finset.card_le_one_iff.mpr
    intro a b ha hb
    obtain ⟨haA,hax⟩ := Finset.mem_inter.mp ha
    obtain ⟨hbA,hbx⟩ := Finset.mem_inter.mp hb
    have e := List.all_eq_true.mp edges xs (List.mem_toFinset.mp hx)
    have ea := List.all_eq_true.mp e a (List.mem_toFinset.mp hax)
    have eb := List.all_eq_true.mp ea b (List.mem_toFinset.mp hbx)
    simp only [Bool.or_eq_true] at eb
    rcases eb with same | okay
    · exact of_decide_eq_true same
    · exact False.elim (admissible a haA b hbA (sound okay))
  calc
    A.card ≤ (row.toFinset.biUnion pts).card := Finset.card_le_card subUnion
    _ ≤ ∑ xs ∈ row.toFinset, (pts xs).card := Finset.card_biUnion_le
    _ ≤ ∑ _ ∈ row.toFinset, 1 := Finset.sum_le_sum small
    _ = row.toFinset.card := by simp
    _ ≤ row.length := List.toFinset_card_le _
    _ ≤ j := size

private theorem covered_bound (j : ℕ) (hj : 0 < j) (hlimit : j ≤ 8400)
    (A : Finset ℕ) (sub : A ⊆ Finset.range (25*j+7))
    (adm : NonSquarefreeProductProp A)
    (low : ∀ a ∈ A, 25*(j-(rowAt j).length)+7 ≤ a) :
    A.card ≤ (rowAt j).length := by
  have hv := verified j hj hlimit
  simp only [valid, Bool.and_eq_true] at hv
  obtain ⟨⟨lengths, coverage⟩, edges⟩ := hv
  obtain ⟨_, len⟩ := of_decide_eq_true lengths
  apply bound_by_rows _ A (rowAt j) adm _ edges le_rfl
  intro a ha
  let start := 25*(j-(rowAt j).length)+7
  have left : start ≤ a := low a ha
  have right : a < 25*j+7 := Finset.mem_range.mp (sub ha)
  have mem : a-start ∈ List.range (25*(rowAt j).length) :=
    List.mem_range.mpr (by dsimp [start] at *; omega)
  have check := List.all_eq_true.mp coverage (a-start) mem
  have point : start + (a-start) = a := by omega
  change (List.any (rowAt j) (fun xs => xs.contains (start + (a-start))) ||
    fast ((start+(a-start))*(start+(a-start))+1)) = true at check
  rw [point] at check
  simp only [Bool.or_eq_true] at check
  have has := check.resolve_right (fun h =>
    adm a ha a ha (sound h))
  simpa using List.any_eq_true.mp has

private theorem endpoint (j : ℕ) : j ≤ 8400 → ∀ A : Finset ℕ,
    A ⊆ Finset.range (25*j+7) → NonSquarefreeProductProp A → A.card ≤ j := by
  induction j using Nat.strong_induction_on with
  | h j ih =>
    intro limit A sub adm
    by_cases zero : j = 0
    · subst j
      have sq : ∀ n : Fin 7, Squarefree (n.val*n.val+1) := by decide +kernel
      have empty : A = ∅ := by
        apply Finset.eq_empty_iff_forall_notMem.mpr
        intro a ha
        have low : a < 7 := Finset.mem_range.mp (sub ha)
        exact adm a ha a ha (sq ⟨a,low⟩)
      simp [empty]
    have positive : 0 < j := Nat.pos_of_ne_zero zero
    have hv := verified j positive limit
    simp only [valid, Bool.and_eq_true] at hv
    obtain ⟨lt, le⟩ := of_decide_eq_true hv.1.1
    let i := j-(rowAt j).length
    have smaller : i < j := by dsimp [i]; omega
    let p (a : ℕ) := a < 25*i+7
    let first := A.filter p
    let last := A.filter (fun a => ¬p a)
    have inherit (S : Finset ℕ) (hS : S ⊆ A) : NonSquarefreeProductProp S :=
      fun a ha b hb => adm a (hS ha) b (hS hb)
    have earlier : first.card ≤ i := by
      apply ih i smaller (by omega) first _ (inherit _ (Finset.filter_subset _ _))
      intro a ha
      exact Finset.mem_range.mpr (Finset.mem_filter.mp ha).2
    have suffix : last.card ≤ (rowAt j).length := by
      apply covered_bound j positive limit last
        ((Finset.filter_subset _ _).trans sub) (inherit _ (Finset.filter_subset _ _))
      intro a ha
      exact Nat.le_of_not_gt (Finset.mem_filter.mp ha).2
    have partition : first.card + last.card = A.card :=
      Finset.card_filter_add_card_filter_not p
    dsimp [i] at earlier
    omega

private theorem candidate_card (N : ℕ) : (A₇ N).card = (N+17)/25 := by
  induction N with
  | zero => rfl
  | succ N ih =>
    simp only [A₇, Finset.range_add_one, Finset.filter_insert] at *
    split
    · rw [Finset.card_insert_of_notMem (by simp), ih]
      omega
    · rw [ih]
      omega

theorem fullPrefix : ∀ N ≤ 210007, Erdos848.Erdos848For N := by
  intro N limit A sub adm
  rw [candidate_card]
  let j := (N+17)/25
  change A.card ≤ j
  apply endpoint j (by dsimp [j]; omega) A _ adm
  intro a ha
  have low := Finset.mem_range.mp (sub ha)
  exact Finset.mem_range.mpr (by dsimp [j]; omega)

end Erdos848Prefix210007

theorem OMA.solution : OMA.R_Erdos848_erdos_848_R2_H2_R1.H1 := Erdos848Prefix210007.fullPrefix
