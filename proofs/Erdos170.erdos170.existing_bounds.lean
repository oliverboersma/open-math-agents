/-- A version of the *Wiener-Ikehara Tauberian Theorem*: If `f` is a nonnegative arithmetic
function whose L-series has a simple pole at `s = 1` with residue `A` and otherwise extends
continuously to the closed half-plane `re s ≥ 1`, then `∑ n < N, f n` is asymptotic to `A*N`. -/

lemma tendsto_mul_ceil_div :
    Tendsto (fun (p : ℝ × ℕ) => ⌈p.1 * p.2⌉₊ / (p.2 : ℝ)) (𝓝[>] 0 ×ˢ atTop) (𝓝 0) := by
  rw [Metric.tendsto_nhds] ; intro δ hδ
  have l1 : ∀ᶠ ε : ℝ in 𝓝[>] 0, ε ∈ Ioo 0 (δ / 2) := inter_mem_nhdsWithin _ (Iio_mem_nhds (by positivity))
  have l2 : ∀ᶠ N : ℕ in atTop, 1 ≤ δ / 2 * N := by
    apply Tendsto.eventually_ge_atTop
    exact tendsto_natCast_atTop_atTop.const_mul_atTop (by positivity)
  filter_upwards [l1.prod_mk l2] with (ε, N) ⟨⟨hε, h1⟩, h2⟩ ; dsimp only at *
  have l3 : 0 < (N : ℝ) := by
    simp only [Nat.cast_pos, Nat.pos_iff_ne_zero] ; rintro rfl ; simp [zero_lt_one.not_ge] at h2
  have l5 : 0 ≤ ε * ↑N := by positivity
  have l6 : ε * N ≤ δ / 2 * N := mul_le_mul h1.le le_rfl (by positivity) (by positivity)
  simp only [dist_zero_right, norm_div, RCLike.norm_natCast, div_lt_iff₀ l3, gt_iff_lt]
  convert (Nat.ceil_lt_add_one l5).trans_le (add_le_add l6 h2) using 1 ; ring

noncomputable def S (f : ℕ → 𝕜) (ε : ℝ) (N : ℕ) : 𝕜 := (∑ n ∈ Finset.Ico ⌈ε * N⌉₊ N, f n) / N

lemma S_sub_S {f : ℕ → 𝕜} {ε : ℝ} {N : ℕ} (hε : ε ≤ 1) : S f 0 N - S f ε N = cumsum f ⌈ε * N⌉₊ / N := by
  have hceilN : ⌈ε * N⌉₊ ≤ N := by
    simp only [Nat.ceil_le]
    exact mul_le_of_le_one_left N.cast_nonneg hε
  have r1 : Finset.range N = Finset.range ⌈ε * N⌉₊ ∪ Finset.Ico ⌈ε * N⌉₊ N := by
    ext n
    simp only [Finset.mem_range, Finset.mem_union, Finset.mem_Ico]
    omega
  have r2 : Disjoint (Finset.range ⌈ε * N⌉₊) (Finset.Ico ⌈ε * N⌉₊ N) := by
    rw [Finset.range_eq_Ico] ; apply Finset.Ico_disjoint_Ico_consecutive
  simp [S, r1, Finset.sum_union r2, cumsum, add_div]

lemma tendsto_S_S_zero {f : ℕ → ℝ} (hpos : 0 ≤ f) (hcheby : cheby f) :
    TendstoUniformlyOnFilter (S f) (S f 0) (𝓝[>] 0) atTop := by
  rw [Metric.tendstoUniformlyOnFilter_iff] ; intro δ hδ
  obtain ⟨C, hC⟩ := hcheby
  have l1 : ∀ᶠ (p : ℝ × ℕ) in 𝓝[>] 0 ×ˢ atTop, C * ⌈p.1 * p.2⌉₊ / p.2 < δ := by
    have r1 := tendsto_mul_ceil_div.const_mul C
    simp only [mul_div_assoc', mul_zero] at r1 ; exact r1 (Iio_mem_nhds hδ)
  have : Ioc 0 1 ∈ 𝓝[>] (0 : ℝ) := inter_mem_nhdsWithin _ (Iic_mem_nhds zero_lt_one)
  filter_upwards [l1, Eventually.prod_inl this _] with (ε, N) h1 h2
  have l2 : ‖cumsum f ⌈ε * ↑N⌉₊ / ↑N‖ ≤ C * ⌈ε * N⌉₊ / N := by
    have r1 := hC ⌈ε * N⌉₊
    have r2 : 0 ≤ cumsum f ⌈ε * N⌉₊ := by apply cumsum_nonneg hpos
    simp only [norm_real, norm_of_nonneg (hpos _), norm_div,
      norm_of_nonneg r2, Real.norm_natCast] at r1 ⊢
    apply div_le_div_of_nonneg_right r1 (by positivity)
  simpa [← S_sub_S h2.2] using! l2.trans_lt h1

theorem WienerIkeharaTheorem' {f : ℕ → ℝ} (hpos : 0 ≤ f)
    (hf : ∀ (σ' : ℝ), 1 < σ' → Summable (nterm f σ'))
    (hcheby : cheby f) (hG : ContinuousOn G {s | 1 ≤ s.re})
    (hG' : Set.EqOn G (fun s ↦ LSeries f s - A / (s - 1)) {s | 1 < s.re}) :
    Tendsto (fun N => cumsum f N / N) atTop (𝓝 A) := by

  convert_to Tendsto (S f 0) atTop (𝓝 A) ; · ext N ; simp [S, cumsum]
  apply (tendsto_S_S_zero hpos hcheby).tendsto_of_eventually_tendsto
  · have L0 : Ioc 0 1 ∈ 𝓝[>] (0 : ℝ) := inter_mem_nhdsWithin _ (Iic_mem_nhds zero_lt_one)
    apply eventually_of_mem L0
    · intro ε hε
      simpa using! WienerIkeharaInterval_discrete' hpos hf hcheby hG hG' hε.1 hε.2
  · have : Tendsto (fun ε : ℝ => ε) (𝓝[>] 0) (𝓝 0) := nhdsWithin_le_nhds
    simpa using (this.const_sub 1).const_mul A

theorem vonMangoldt_cheby : cheby Λ := by
  use Real.log 4 + 4
  intro N
  by_cases! h : N = 0
  · simp [h, cumsum]
  simp only [cumsum, norm_real, norm_eq_abs]
  rw [Nat.range_eq_Icc_zero_sub_one _ h, (by simp : N - 1 = ⌊(N : ℝ) - 1⌋₊)]
  simp_rw [abs_of_nonneg vonMangoldt_nonneg]
  rw [← Chebyshev.psi_eq_sum_Icc]
  grw [Chebyshev.psi_le_const_mul_self <| sub_nonneg_of_le <| Nat.one_le_cast_iff_ne_zero.mpr h]
  gcongr
  linarith



-- Proof extracted from the `EulerProducts` project so we can adapt it to the
-- version of the Wiener-Ikehara theorem proved above (with the `cheby`
-- hypothesis)

theorem WeakPNT : Tendsto (fun N ↦ cumsum Λ N / N) atTop (𝓝 1) := by
  let F := vonMangoldt.LFunctionResidueClassAux (q := 1) 1
  have hnv := riemannZeta_ne_zero_of_one_le_re
  have l1 (n : ℕ) : 0 ≤ Λ n := vonMangoldt_nonneg
  have l2 s (hs : 1 < s.re) : F s = LSeries Λ s - 1 / (s - 1) := by
    have := vonMangoldt.eqOn_LFunctionResidueClassAux (q := 1) isUnit_one hs
    simp only [F, this, vonMangoldt.residueClass, Nat.totient_one, Nat.cast_one, inv_one, one_div, sub_left_inj]
    apply LSeries_congr
    intro n _
    simp only [ofReal_inj, indicator_apply_eq_self, mem_setOf_eq]
    exact fun hn ↦ absurd (Subsingleton.eq_one _) hn
  have l3 : ContinuousOn F {s | 1 ≤ s.re} := vonMangoldt.continuousOn_LFunctionResidueClassAux 1
  have l4 : cheby Λ := vonMangoldt_cheby
  have l5 (σ' : ℝ) (hσ' : 1 < σ') : Summable (nterm Λ σ') := by
    simpa only [← nterm_eq_norm_term] using (@ArithmeticFunction.LSeriesSummable_vonMangoldt σ' hσ').norm
  apply WienerIkeharaTheorem' l1 l5 l4 l3 l2

end PNTX_Wiener

-- Ported from PrimeNumberTheoremAnd: Consequences.lean (selected lemmas up to chebyshev_asymptotic), followed by the new proof of H1
section PNTX_Conseq

section PNTConseq
open ArithmeticFunction hiding log
open Nat hiding log
open Finset
open BigOperators Filter Real Classical Asymptotics MeasureTheory intervalIntegral
open scoped ArithmeticFunction.Moebius ArithmeticFunction.Omega Chebyshev

/-- If u ~ v and u-w = o(v) then w ~ v. -/
theorem Asymptotics.IsEquivalent.add_isLittleO'' {α : Type*} {β : Type*} [NormedAddCommGroup β]
    {u : α → β} {v : α → β} {w : α → β} {l : Filter α}
    (huv : Asymptotics.IsEquivalent l u v) (hwu : (u - w) =o[l] v) :
    Asymptotics.IsEquivalent l w v := by
  rw [← sub_sub_self u w]
  exact sub_isLittleO huv hwu

theorem WeakPNT' : Tendsto (fun N ↦ (∑ n ∈ Iic N, Λ n) / N) atTop (nhds 1) := by
  have : (fun N ↦ (∑ n ∈ Iic N, Λ n) / N) =
      (fun N ↦ (∑ n ∈ range N, Λ n)/N + Λ N / N) := by
    ext N
    have : N ∈ Iic N := mem_Iic.mpr (le_refl _)
    rw [← Finset.sum_erase_add _ _ this, ← Nat.Iio_eq_range, Iic_erase]
    exact add_div _ _ _

  rw [this, ← add_zero 1]
  apply Tendsto.add WeakPNT
  convert squeeze_zero (f := fun N ↦ Λ N / N) (g := fun N ↦ log N / N) (t₀ := atTop) ?_ ?_ ?_
  · intro N
    exact div_nonneg vonMangoldt_nonneg (cast_nonneg N)
  · intro N
    exact div_le_div_of_nonneg_right vonMangoldt_le_log (cast_nonneg N)
  have := Real.tendsto_pow_log_div_pow_atTop 1 1 Real.zero_lt_one
  simp only [rpow_one] at this
  exact Tendsto.comp this tendsto_natCast_atTop_atTop

/-- An alternate form of the Weak PNT. -/
theorem WeakPNT'' : ψ ~[atTop] (fun x ↦ x) := by
    rw [(by rfl : ψ = (fun x ↦ ψ x))]
    simp_rw [Chebyshev.psi_eq_sum_Icc]
    apply IsEquivalent.trans (v := fun x ↦ (⌊x⌋₊:ℝ))
    · rw [isEquivalent_iff_tendsto_one]
      · convert! Tendsto.comp WeakPNT' tendsto_nat_floor_atTop
        infer_instance
      rw [eventually_iff]
      simp only [ne_eq, cast_eq_zero, floor_eq_zero, not_lt, mem_atTop_sets,
        Set.mem_setOf_eq]
      use 1
      simp only [imp_self, implies_true]
    apply IsLittleO.isEquivalent
    rw [← isLittleO_neg_left]
    apply IsLittleO.of_bound
    intro ε hε
    simp only [Pi.sub_apply, neg_sub, norm_eq_abs, eventually_atTop]
    use ε⁻¹
    intro b hb
    have hb' : 0 ≤ b := le_of_lt (lt_of_lt_of_le (inv_pos_of_pos hε) hb)
    rw [abs_of_nonneg, abs_of_nonneg hb']
    · apply LE.le.trans _ ((inv_le_iff_one_le_mul₀' hε).mp hb)
      linarith [Nat.lt_floor_add_one b]
    rw [sub_nonneg]
    exact floor_le hb'

/-- `√x · log x = o(x)` as `x → ∞`. -/
lemma isLittleO_sqrt_mul_log : (fun x : ℝ ↦ x.sqrt * x.log) =o[atTop] _root_.id := by
  have : (fun x : ℝ ↦ x.sqrt * x.log) =o[atTop] fun x ↦ x := by
    refine (isLittleO_mul_iff_isLittleO_div ?_).mpr ?_
    · filter_upwards [eventually_gt_atTop 0] with x hx; exact (sqrt_ne_zero hx.le).mpr hx.ne'
    · convert! isLittleO_log_rpow_atTop (by norm_num : (0 : ℝ) < 1 / 2) using 2 with x
      rw [div_sqrt, sqrt_eq_rpow]
  exact this

theorem chebyshev_asymptotic : θ ~[atTop] id := by
  refine WeakPNT''.add_isLittleO'' (IsBigO.trans_isLittleO (g := fun x ↦ 2 * x.sqrt * x.log) ?_ ?_)
  · rw [isBigO_iff']; refine ⟨1, one_pos, ?_⟩
    simp only [one_mul, eventually_atTop]
    exact ⟨2, fun x hx ↦ by
      rw [Pi.sub_apply, norm_eq_abs, norm_eq_abs, abs_of_nonneg (by bound : 0 ≤ 2 * √x * log x)]
      exact (abs_of_nonneg (sub_nonneg.mpr (Chebyshev.theta_le_psi x))).symm ▸
        Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log (by linarith : 1 ≤ x)⟩
  · simpa only [mul_assoc] using! isLittleO_sqrt_mul_log.const_mul_left 2

end PNTConseq

section OMAH1

theorem OMA.PNT.exists_prime_of_theta_lt (n : ℕ) (y : ℝ)
    (h : Chebyshev.theta (n : ℝ) < Chebyshev.theta y) :
    ∃ p : ℕ, p.Prime ∧ n < p ∧ (p : ℝ) ≤ y := by
  by_contra hne
  push Not at hne
  apply absurd h
  apply not_lt.mpr
  unfold Chebyshev.theta
  rw [Nat.floor_natCast]
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro p hp
    simp only [Finset.mem_filter, Finset.mem_Ioc] at hp ⊢
    refine ⟨⟨hp.1.1, ?_⟩, hp.2⟩
    have hpy : (p : ℝ) ≤ y := (Nat.le_floor_iff' (Nat.pos_iff_ne_zero.mp hp.1.1)).1 hp.1.2
    by_contra hpn
    push Not at hpn
    have := hne p hp.2 hpn
    linarith
  · intro p _ _
    exact Real.log_natCast_nonneg p

theorem OMA.PNT.h1 : ∀ δ : ℝ, 0 < δ → ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
    ∃ p : ℕ, p.Prime ∧ n < p ∧ (p : ℝ) ≤ (1 + δ) * (n : ℝ) := by
  intro δ hδ
  have hlo := chebyshev_asymptotic.isLittleO
  have hεpos : 0 < δ / (2 * (2 + δ)) := by positivity
  have hε2 : δ / (2 * (2 + δ)) * (2 + δ) = δ / 2 := by
    field_simp
  have hb := hlo.bound hεpos
  obtain ⟨X, hX⟩ := Filter.eventually_atTop.1 hb
  refine ⟨⌈X⌉₊ + 1, fun n hn => ?_⟩
  apply OMA.PNT.exists_prime_of_theta_lt
  have hn' : ((⌈X⌉₊ : ℕ) : ℝ) + 1 ≤ (n : ℝ) := by exact_mod_cast hn
  have hceil := Nat.le_ceil X
  have hnX : X ≤ (n : ℝ) := by linarith
  have hn1 : (1 : ℝ) ≤ n := by
    have : 1 ≤ n := by omega
    exact_mod_cast this
  have hn0 : (0 : ℝ) ≤ n := by linarith
  have hnn : (n : ℝ) ≤ (1 + δ) * n := by nlinarith
  have hn2 : (0 : ℝ) ≤ (1 + δ) * n := by linarith
  have h1 := hX n hnX
  have h2 := hX ((1 + δ) * n) (le_trans hnX hnn)
  simp only [Pi.sub_apply, id_eq, Real.norm_eq_abs] at h1 h2
  rw [abs_of_nonneg hn0] at h1
  rw [abs_of_nonneg hn2] at h2
  have h1' := (abs_le.1 h1).2
  have h2' := (abs_le.1 h2).1
  have key : δ / (2 * (2 + δ)) * ((1 + δ) * n) + δ / (2 * (2 + δ)) * n = δ / 2 * n := by
    have : δ / (2 * (2 + δ)) * ((1 + δ) * n) + δ / (2 * (2 + δ)) * n
        = (δ / (2 * (2 + δ)) * (2 + δ)) * n := by ring
    rw [this, hε2]
  have hpos : 0 < δ / 2 * n := by positivity
  linarith

end OMAH1

end PNTX_Conseq


namespace Erdos707Singer

lemma cube_sub_one (q : ℕ) (hq : 1 ≤ q) : q ^ 3 - 1 = (q - 1) * (q ^ 2 + q + 1) := by
  obtain ⟨s, rfl⟩ := Nat.exists_eq_add_of_le hq
  apply Nat.sub_eq_of_eq_add
  simp only [Nat.add_sub_cancel_left]
  ring

/-- An element fixed by the `q`-th power map lies in the subfield with `q` elements. -/
lemma mem_range_of_pow_card_eq {F K : Type*} [Field F] [Field K] [Algebra F K] [Finite F]
    (x : K) (hx : x ^ Nat.card F = x) : ∃ a : F, algebraMap F K a = x := by
  classical
  have := Fintype.ofFinite F
  have hq : 1 < Fintype.card F := Fintype.one_lt_card
  rw [Nat.card_eq_fintype_card] at hx
  have hP0 : (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K) ≠ 0 :=
    FiniteField.X_pow_card_sub_X_ne_zero K hq
  have hdeg : (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).natDegree
      = Fintype.card F := FiniteField.X_pow_card_sub_X_natDegree_eq K hq
  have hroot : ∀ y : K, y ^ Fintype.card F = y →
      y ∈ (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).roots.toFinset := by
    intro y hy
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot.def]
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
    rw [hy, sub_self]
  have hsub : (Finset.univ.image (algebraMap F K)) ⊆
      (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).roots.toFinset := by
    intro y hy
    obtain ⟨a, -, rfl⟩ := Finset.mem_image.1 hy
    apply hroot
    rw [← map_pow, FiniteField.pow_card]
  have hcard : (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).roots.toFinset.card
      ≤ (Finset.univ.image (algebraMap F K)).card := by
    rw [Finset.card_image_of_injective _ (algebraMap F K).injective, Finset.card_univ]
    calc (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).roots.toFinset.card
        ≤ (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).roots.card :=
          Multiset.toFinset_card_le _
      _ ≤ (Polynomial.X ^ Fintype.card F - Polynomial.X : Polynomial K).natDegree :=
          Polynomial.card_roots' _
      _ = Fintype.card F := hdeg
  have heq := Finset.eq_of_subset_of_card_le hsub hcard
  have hxmem := hroot x hx
  rw [← heq] at hxmem
  obtain ⟨a, -, ha⟩ := Finset.mem_image.1 hxmem
  exact ⟨a, ha⟩

/-- A generator of the multiplicative group of a finite field, as an element of the field. -/
lemma exists_gen (K : Type*) [Field K] [Finite K] :
    ∃ γ : K, γ ≠ 0 ∧ (∀ x : K, x ≠ 0 → ∃ i : ℕ, γ ^ i = x) ∧
      (∀ m : ℕ, γ ^ m = 1 → (Nat.card K - 1) ∣ m) ∧ γ ^ (Nat.card K - 1) = 1 := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := Kˣ)
  have hord : orderOf g = Nat.card K - 1 := by
    rw [orderOf_eq_card_of_forall_mem_powers hg, Nat.card_units]
  refine ⟨(g : K), g.ne_zero, ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨i, hi⟩ := (Submonoid.mem_powers_iff _ _).1 (hg (Units.mk0 x hx))
    exact ⟨i, by rw [← Units.val_pow_eq_pow_val, hi, Units.val_mk0]⟩
  · intro m hm
    rw [← hord]
    apply orderOf_dvd_of_pow_eq_one
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, hm, Units.val_one]
  · rw [← hord, ← Units.val_pow_eq_pow_val, pow_orderOf_eq_one, Units.val_one]

lemma exists_plane {F K : Type*} [Field F] [Field K] [Algebra F K] [Module.Finite F K]
    (h3 : Module.finrank F K = 3) : ∃ W : Submodule F K, Module.finrank F W = 2 := by
  have hli : LinearIndependent F
      (fun i : Fin 2 => (Module.finBasisOfFinrankEq F K h3) (Fin.castSucc i)) :=
    (Module.finBasisOfFinrankEq F K h3).linearIndependent.comp _ (Fin.castSucc_injective 2)
  exact ⟨Submodule.span F
    (Set.range (fun i : Fin 2 => (Module.finBasisOfFinrankEq F K h3) (Fin.castSucc i))), by
      rw [finrank_span_eq_card hli, Fintype.card_fin]⟩

/-- A plane is not stable under multiplication by an element outside the base field. -/
lemma not_stable {F K : Type*} [Field F] [Field K] [Algebra F K] [Module.Finite F K]
    (h3 : Module.finrank F K = 3) (W : Submodule F K) (hW : Module.finrank F W = 2)
    (c : K) (hc : c ∉ (algebraMap F K).range) : ¬ ∀ w ∈ W, c * w ∈ W := by
  intro hst
  have hpos : 0 < Module.finrank F W := by omega
  obtain ⟨⟨w, hwW⟩, hw0⟩ := Module.finrank_pos_iff_exists_ne_zero.1 hpos
  have hw : w ≠ 0 := fun h => hw0 (Subtype.ext h)
  have hint : IsIntegral F c := IsIntegral.of_finite F c
  have hdeg : (minpoly F c).natDegree = 3 := by
    have hdvd := minpoly.degree_dvd hint
    rw [h3] at hdvd
    rcases (Nat.dvd_prime Nat.prime_three).1 hdvd with h1 | h3'
    · exact absurd (minpoly.natDegree_eq_one_iff.1 h1) hc
    · exact h3'
  have hli := linearIndependent_pow (K := F) c
  rw [hdeg] at hli
  have hli2 : LinearIndependent F (fun i : Fin 3 => c ^ (i : ℕ) * w) := by
    have hker : LinearMap.ker (LinearMap.mulRight F w) = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      intro x y hxy
      exact mul_right_cancel₀ hw hxy
    exact hli.map' (LinearMap.mulRight F w) hker
  have hmem : ∀ i : ℕ, c ^ i * w ∈ W := by
    intro i
    induction i with
    | zero => simpa using hwW
    | succ k ih =>
      rw [pow_succ', mul_assoc]
      exact hst _ ih
  have hspan : Submodule.span F (Set.range (fun i : Fin 3 => c ^ (i : ℕ) * w)) ≤ W := by
    rw [Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    exact hmem i
  have hle := Submodule.finrank_mono hspan
  rw [finrank_span_eq_card hli2, Fintype.card_fin, hW] at hle
  omega

/-- Two planes in a three-dimensional space meet: some nonzero `y ∈ W` has `c * y ∈ W`. -/
lemma key_exists {F K : Type*} [Field F] [Field K] [Algebra F K] [Module.Finite F K]
    (h3 : Module.finrank F K = 3) (W : Submodule F K) (hW : Module.finrank F W = 2)
    (c : K) (hc0 : c ≠ 0) : ∃ y ∈ W, y ≠ 0 ∧ c * y ∈ W := by
  have hinj : Function.Injective (LinearMap.mulLeft F c) := by
    intro x y hxy
    exact mul_left_cancel₀ hc0 hxy
  have h1 : Module.finrank F
      (W.map ((LinearEquiv.ofInjectiveEndo (LinearMap.mulLeft F c) hinj : K ≃ₗ[F] K) :
        K →ₗ[F] K)) = 2 := by
    rw [LinearEquiv.finrank_map_eq, hW]
  have h2 := Submodule.finrank_sup_add_finrank_inf_eq W
    (W.map ((LinearEquiv.ofInjectiveEndo (LinearMap.mulLeft F c) hinj : K ≃ₗ[F] K) :
      K →ₗ[F] K))
  have h4 : Module.finrank F
      ↥(W ⊔ W.map ((LinearEquiv.ofInjectiveEndo (LinearMap.mulLeft F c) hinj : K ≃ₗ[F] K) :
        K →ₗ[F] K)) ≤ 3 := by
    rw [← h3]
    exact Submodule.finrank_le _
  have hpos : 0 < Module.finrank F
      ↥(W ⊓ W.map ((LinearEquiv.ofInjectiveEndo (LinearMap.mulLeft F c) hinj : K ≃ₗ[F] K) :
        K →ₗ[F] K)) := by omega
  obtain ⟨⟨x, hx⟩, hx0⟩ := Module.finrank_pos_iff_exists_ne_zero.1 hpos
  have hx' : x ≠ 0 := fun h => hx0 (Subtype.ext h)
  rw [Submodule.mem_inf, Submodule.mem_map] at hx
  obtain ⟨hxW, y, hyW, hyx⟩ := hx
  have hcy : c * y = x := by
    rw [← hyx]
    rfl
  refine ⟨y, hyW, ?_, ?_⟩
  · rintro rfl
    exact hx' (by rw [← hcy, mul_zero])
  · rw [hcy]
    exact hxW

/-- For `c` outside the base field, the solutions `y ∈ W` of `c * y ∈ W` form a line. -/
lemma key_unique {F K : Type*} [Field F] [Field K] [Algebra F K] [Module.Finite F K]
    (h3 : Module.finrank F K = 3) (W : Submodule F K) (hW : Module.finrank F W = 2)
    (c : K) (hc : c ∉ (algebraMap F K).range) {y y' : K} (hy : y ∈ W) (hy0 : y ≠ 0)
    (hcy : c * y ∈ W) (hy' : y' ∈ W) (hcy' : c * y' ∈ W) : ∃ a : F, y' = a • y := by
  have hne : W ⊓ W.comap (LinearMap.mulLeft F c) ≠ W := by
    intro h
    apply not_stable h3 W hW c hc
    intro w hw
    rw [← h] at hw
    exact (Submodule.mem_inf.1 hw).2
  have hlt : W ⊓ W.comap (LinearMap.mulLeft F c) < W := lt_of_le_of_ne inf_le_left hne
  have hfr := Submodule.finrank_lt_finrank_of_lt hlt
  have hle1 : Module.finrank F ↥(W ⊓ W.comap (LinearMap.mulLeft F c)) ≤ 1 := by omega
  obtain ⟨v, hv⟩ := finrank_le_one_iff.1 hle1
  have hyU : y ∈ W ⊓ W.comap (LinearMap.mulLeft F c) := Submodule.mem_inf.2 ⟨hy, hcy⟩
  have hyU' : y' ∈ W ⊓ W.comap (LinearMap.mulLeft F c) := Submodule.mem_inf.2 ⟨hy', hcy'⟩
  obtain ⟨t, ht⟩ := hv ⟨y, hyU⟩
  obtain ⟨t', ht'⟩ := hv ⟨y', hyU'⟩
  have ht0 : t ≠ 0 := by
    rintro rfl
    rw [zero_smul] at ht
    exact hy0 (congrArg Subtype.val ht).symm
  have e1 : t • (v : K) = y := congrArg Subtype.val ht
  have e2 : t' • (v : K) = y' := congrArg Subtype.val ht'
  refine ⟨t' * t⁻¹, ?_⟩
  rw [← e1, ← e2, smul_smul, inv_mul_cancel_right₀ ht0]

/-- The Singer construction for a field `F` with a cubic extension `K`. -/
theorem core {F K : Type*} [Field F] [Field K] [Finite F] [Finite K] [Algebra F K]
    (h3 : Module.finrank F K = 3) :
    ∃ D : Finset ℕ, D ⊆ Finset.range (Nat.card F ^ 2 + Nat.card F + 1) ∧ D.card = Nat.card F + 1 ∧
      IsPerfectDifferenceSet (D : Set ℕ) (Nat.card F ^ 2 + Nat.card F + 1) := by
  classical
  have := Fintype.ofFinite F
  obtain ⟨q, hqdef⟩ : ∃ q, q = Nat.card F := ⟨_, rfl⟩
  rw [← hqdef]
  have hq2 : 2 ≤ q := by
    rw [hqdef]
    exact Finite.one_lt_card
  obtain ⟨n, hn⟩ : ∃ n, n = q ^ 2 + q + 1 := ⟨_, rfl⟩
  rw [← hn]
  have hnpos : 0 < n := by omega
  have : NeZero n := ⟨hnpos.ne'⟩
  have hcardK : Nat.card K = q ^ 3 := by
    rw [hqdef, ← h3]
    exact Module.natCard_eq_pow_finrank
  have hN : Nat.card K - 1 = (q - 1) * n := by
    rw [hcardK, hn]
    exact cube_sub_one q (by omega)
  obtain ⟨γ, hγ0, hγsurj, hγord, hγpow⟩ := exists_gen K
  rw [hN] at hγord hγpow
  obtain ⟨W, hW⟩ := exists_plane (F := F) (K := K) h3
  -- powers of `γ` in the base field
  have hA1 : ∀ (i : ℕ) (a : F), algebraMap F K a = γ ^ i → n ∣ i := by
    intro i a ha
    have ha0 : a ≠ 0 := by
      rintro rfl
      rw [map_zero] at ha
      exact pow_ne_zero i hγ0 ha.symm
    have h1 : a ^ (q - 1) = 1 := by
      rw [hqdef, Nat.card_eq_fintype_card]
      exact FiniteField.pow_card_sub_one_eq_one a ha0
    have h2 : γ ^ (i * (q - 1)) = 1 := by
      rw [pow_mul, ← ha, ← map_pow, h1, map_one]
    have h3' := hγord _ h2
    rw [mul_comm i] at h3'
    exact Nat.dvd_of_mul_dvd_mul_left (by omega) h3'
  have hA2 : ∀ i : ℕ, n ∣ i → ∃ a : F, algebraMap F K a = γ ^ i := by
    rintro i ⟨m, rfl⟩
    apply mem_range_of_pow_card_eq
    have h1 : (γ ^ (n * m)) ^ (q - 1) = 1 := by
      rw [← pow_mul, show n * m * (q - 1) = (q - 1) * n * m by ring, pow_mul, hγpow, one_pow]
    rw [← hqdef]
    calc (γ ^ (n * m)) ^ q = (γ ^ (n * m)) ^ (q - 1 + 1) := by
          rw [Nat.sub_add_cancel (by omega)]
      _ = γ ^ (n * m) := by rw [pow_succ, h1, one_mul]
  -- the exponent `M'` acts as `-1`
  obtain ⟨M', hM'⟩ : ∃ M', (q - 1) * n = M' + 1 :=
    ⟨(q - 1) * n - 1, by
      have : 0 < (q - 1) * n := Nat.mul_pos (by omega) hnpos
      omega⟩
  have hM'cast : (M' : ZMod n) = -1 := by
    have h : ((M' + 1 : ℕ) : ZMod n) = 0 := by
      rw [← hM', Nat.cast_mul, ZMod.natCast_self, mul_zero]
    push_cast at h
    exact eq_neg_of_add_eq_zero_left h
  have hrel1 : ∀ i j : ℕ, γ ^ (j + M' * i) * γ ^ i = γ ^ j := by
    intro i j
    rw [← pow_add, show j + M' * i + i = j + (M' + 1) * i by ring, ← hM', pow_add, pow_mul,
      hγpow, one_pow, mul_one]
  have hrel2 : ∀ i j : ℕ, ((j + M' * i : ℕ) : ZMod n) = (j : ZMod n) - (i : ZMod n) := by
    intro i j
    push_cast
    rw [hM'cast]
    ring
  -- proportional powers have congruent exponents, and conversely
  have hP : ∀ (i j : ℕ) (a : F), γ ^ j = algebraMap F K a * γ ^ i →
      (j : ZMod n) = (i : ZMod n) := by
    intro i j a h
    have h1 : algebraMap F K a = γ ^ (j + M' * i) := by
      have h' := hrel1 i j
      rw [h] at h'
      exact (mul_right_cancel₀ (pow_ne_zero i hγ0) h').symm
    have h2 := hA1 _ a h1
    have h3' : ((j + M' * i : ℕ) : ZMod n) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 h2
    rw [hrel2] at h3'
    exact sub_eq_zero.1 h3'
  have hQ : ∀ i j : ℕ, (j : ZMod n) = (i : ZMod n) →
      ∃ a : F, γ ^ j = algebraMap F K a * γ ^ i := by
    intro i j h
    have h1 : ((j + M' * i : ℕ) : ZMod n) = 0 := by rw [hrel2, h, sub_self]
    obtain ⟨a, ha⟩ := hA2 _ ((ZMod.natCast_eq_zero_iff _ _).1 h1)
    exact ⟨a, by rw [ha, hrel1]⟩
  have hWmod : ∀ i j : ℕ, (j : ZMod n) = (i : ZMod n) → γ ^ i ∈ W → γ ^ j ∈ W := by
    intro i j h hi
    obtain ⟨a, ha⟩ := hQ i j h
    rw [ha, ← Algebra.smul_def]
    exact W.smul_mem a hi
  have hcast : ∀ a b : ℕ, a < n → b < n → (a : ZMod n) = (b : ZMod n) → a = b := by
    intro a b ha hb h
    have h' := (ZMod.natCast_eq_natCast_iff' a b n).1 h
    rwa [Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hb] at h'
  -- the difference set
  obtain ⟨B, hB⟩ : ∃ B : Set ℕ, B = {i : ℕ | i < n ∧ γ ^ i ∈ W} := ⟨_, rfl⟩
  have hBmem : ∀ i : ℕ, i ∈ B ↔ i < n ∧ γ ^ i ∈ W := by
    intro i
    rw [hB]
    rfl
  have hpds : IsPerfectDifferenceSet B n := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨a, b⟩ hab
      obtain ⟨ha, hb, hne⟩ := hab
      show (a : ZMod n) - (b : ZMod n) ≠ 0
      intro h
      exact hne (hcast a b ((hBmem a).1 ha).1 ((hBmem b).1 hb).1 (sub_eq_zero.1 h))
    · rintro ⟨a, b⟩ hab ⟨a', b'⟩ hab' heq
      obtain ⟨ha, hb, hne⟩ := hab
      obtain ⟨ha', hb', hne'⟩ := hab'
      have heq' : (a : ZMod n) - (b : ZMod n) = (a' : ZMod n) - (b' : ZMod n) := heq
      obtain ⟨han, haW⟩ := (hBmem a).1 ha
      obtain ⟨hbn, hbW⟩ := (hBmem b).1 hb
      obtain ⟨han', haW'⟩ := (hBmem a').1 ha'
      obtain ⟨hbn', hbW'⟩ := (hBmem b').1 hb'
      -- `c = γ ^ a / γ ^ b`, written as a power of `γ`
      have hc : γ ^ (a + M' * b) ∉ (algebraMap F K).range := by
        rintro ⟨t, ht⟩
        have h1 := hA1 _ t ht
        have h2 : ((a + M' * b : ℕ) : ZMod n) = 0 := (ZMod.natCast_eq_zero_iff _ _).2 h1
        rw [hrel2] at h2
        exact hne (hcast a b han hbn (sub_eq_zero.1 h2))
      have hcy : γ ^ (a + M' * b) * γ ^ b ∈ W := by
        rw [hrel1]
        exact haW
      have hcy' : γ ^ (a + M' * b) * γ ^ b' ∈ W := by
        rw [← pow_add]
        refine hWmod a' _ ?_ haW'
        push_cast
        rw [hM'cast]
        linear_combination heq'
      obtain ⟨s, hs⟩ := key_unique h3 W hW _ hc hbW (pow_ne_zero b hγ0) hcy hbW' hcy'
      rw [Algebra.smul_def] at hs
      have hbb : b' = b := hcast b' b hbn' hbn (hP b b' s hs)
      subst hbb
      have haa : (a : ZMod n) = (a' : ZMod n) := by linear_combination heq'
      have haa' : a = a' := hcast a a' han han' haa
      subst haa'
      rfl
    · intro x hx
      have hx0 : x ≠ 0 := hx
      obtain ⟨d, hd⟩ : ∃ d : ℕ, (d : ZMod n) = x := ⟨x.val, ZMod.natCast_zmod_val x⟩
      obtain ⟨y, hyW, hy0, hcy⟩ := key_exists h3 W hW (γ ^ d) (pow_ne_zero d hγ0)
      obtain ⟨j, rfl⟩ := hγsurj y hy0
      rw [← pow_add] at hcy
      refine ⟨((d + j) % n, j % n), ⟨?_, ?_, ?_⟩, ?_⟩
      · exact (hBmem _).2 ⟨Nat.mod_lt _ hnpos, hWmod (d + j) _ (ZMod.natCast_mod _ _) hcy⟩
      · exact (hBmem _).2 ⟨Nat.mod_lt _ hnpos, hWmod j _ (ZMod.natCast_mod _ _) hyW⟩
      · intro h
        apply hx0
        have h' : ((d + j : ℕ) : ZMod n) = (j : ZMod n) :=
          (ZMod.natCast_eq_natCast_iff' _ _ _).2 h
        push_cast at h'
        rw [← hd]
        linear_combination h'
      · show (((d + j) % n : ℕ) : ZMod n) - ((j % n : ℕ) : ZMod n) = x
        rw [ZMod.natCast_mod, ZMod.natCast_mod, ← hd]
        push_cast
        ring
  -- counting the differences gives the size
  have hfin : B.Finite := (Set.finite_Iio n).subset (fun i hi => ((hBmem i).1 hi).1)
  have hcard : B.ncard = q + 1 := by
    have h1 : B.offDiag.ncard = n - 1 := by
      have h' := hpds.injOn.ncard_image
      rw [hpds.image_eq] at h'
      rw [← h']
      have h0 : {x : ZMod n | x ≠ 0} = ({0} : Set (ZMod n))ᶜ := by
        ext x
        simp
      rw [h0, Set.ncard_compl, Set.ncard_singleton, Nat.card_zmod]
    clear hB hBmem
    lift B to Finset ℕ using hfin
    rw [← Finset.coe_offDiag, Set.ncard_coe_finset, Finset.offDiag_card] at h1
    rw [Set.ncard_coe_finset]
    have hk : B.card * B.card = q ^ 2 + q + B.card := by
      have := Nat.le_mul_self B.card
      omega
    have hz : ((B.card : ℤ) - (q + 1)) * ((B.card : ℤ) + q) = 0 := by
      have hk' : (B.card : ℤ) * B.card = q ^ 2 + q + B.card := by exact_mod_cast hk
      linear_combination hk'
    rcases mul_eq_zero.1 hz with h | h
    · omega
    · omega
  refine ⟨hfin.toFinset, ?_, ?_, ?_⟩
  · intro i hi
    exact Finset.mem_range.mpr ((hBmem _).mp (hfin.mem_toFinset.mp hi)).1
  · simpa only [← Set.ncard_coe_finset, hfin.coe_toFinset] using hcard
  · simpa only [hfin.coe_toFinset] using hpds

end Erdos707Singer


open Finset Filter Real Erdos170
open scoped Topology
namespace RulerLimit

private def PrimeWindow := ∀ δ : ℝ, 0 < δ → ∃ n₀ : ℕ, ∀ u : ℕ, n₀ ≤ u →
    ∃ p : ℕ, p.Prime ∧ u < p ∧ (p : ℝ) ≤ (1+δ)*u

private def SingerSets := ∀ p : ℕ, p.Prime → let g := p^2+p+1
  ∃ D : Finset ℕ, D ⊆ range g ∧ D.card = p+1 ∧ IsPerfectDifferenceSet (D : Set ℕ) g

private lemma get_ruler (m : ℕ) : ∃ A ∈ PerfectRulersLengthN m, A.card = F m :=
  mem_image.mp (Finset.min'_mem _ _)

private lemma trivial_bound (m : ℕ) : F m ≤ m+1 := by
  have h : F m ≤ (TrivialRuler m).card :=
    min'_le _ _ (mem_image.mpr ⟨_,trivial_ruler_is_perfect m,rfl⟩)
  simpa [TrivialRuler] using h

private lemma inflate {m g : ℕ} (hg : 0 < g) (A D : Finset ℕ) (hA : A ∈ PerfectRulersLengthN m)
    (hD : D ⊆ range g) (hne : D.Nonempty) (hsing : IsPerfectDifferenceSet (D : Set ℕ) g) :
    ∃ C : Finset ℕ, C.card ≤ A.card*D.card ∧ (∀ z ∈ C, z < (m+1)*g) ∧ PerfectRuler (m*g) C := by
  classical
  let C := (A ×ˢ D).image (fun z => z.1*g+z.2)
  have hAs := mem_powerset.mp (mem_filter.mp hA).1
  have ruler := (mem_filter.mp hA).2
  have one {a x : ℕ} (ha : a ∈ A) (hx : x ∈ D) : a*g+x ∈ C :=
    mem_image.mpr ⟨(a,x),mem_product.mpr ⟨ha,hx⟩,rfl⟩
  refine ⟨C,card_image_le.trans (card_product A D).le, ?_, ?_⟩
  · intro z hz
    obtain ⟨⟨a,x⟩,h,rfl⟩ := mem_image.mp hz
    obtain ⟨ha,hx⟩ := mem_product.mp h
    have hm := mem_range.mp (hAs ha)
    have hgx := mem_range.mp (hD hx)
    change a*g+x < (m+1)*g
    have := Nat.mul_le_mul_right g (show a ≤ m by omega)
    rw [Nat.add_mul]
    omega
  · intro k hk
    have hkm : k ≤ m*g := by have := mem_range.mp hk; omega
    let q := k/g
    let t := k%g
    have hql : q < m+1 := (Nat.div_lt_iff_lt_mul hg).mpr (show k < (m+1)*g by rw [Nat.add_mul]; omega)
    have hq : q ≤ m := by omega
    have ht : t < g := Nat.mod_lt _ hg
    have split : q*g+t=k := by simpa [q,t,Nat.mul_comm,Nat.add_comm] using Nat.mod_add_div k g
    have same (s x y : ℕ) (hs : s ≤ m) (hx : x ∈ D) (hy : y ∈ D)
        (he : s*g+y=k+x) : ∃ a ∈ C, ∃ b ∈ C, k=b-a := by
      by_cases hk0 : k = 0
      · obtain ⟨a,ha,b,hb,_⟩ := ruler 0 (by simp)
        exact ⟨_,one ha hx,_,one ha hx,by simp [hk0]⟩
      obtain ⟨a,ha,b,hb,hd⟩ := ruler s (mem_range.mpr (by omega))
      by_cases hs0 : s = 0
      · exact ⟨_,one ha hx,_,one ha hy,by simp [hs0] at he; omega⟩
      have hb' : b = a+s := by omega
      exact ⟨_,one ha hx,_,one hb hy,by rw [hb',Nat.add_mul]; omega⟩
    by_cases ht0 : t = 0
    · obtain ⟨x,hx⟩ := hne
      exact same q x x hq hx hx (by omega)
    · have htz : (t : ZMod g) ≠ 0 := by
        intro h
        have := congrArg ZMod.val h
        simpa [ZMod.val_cast_of_lt ht, ht0] using this
      obtain ⟨⟨y,x⟩,hxy,heq⟩ := hsing.2.2 (show (t : ZMod g) ∈ {v : ZMod g | v ≠ 0} from htz)
      obtain ⟨hy,hx,-⟩ := hxy
      have hyx : (y : ZMod g)-(x : ZMod g)=t := heq
      have hxg := mem_range.mp (hD hx)
      have hyg := mem_range.mp (hD hy)
      have hz : ((x+t : ℕ) : ZMod g) = y := by push_cast; linear_combination -hyx
      have modEq := (ZMod.natCast_eq_natCast_iff' _ _ _).mp hz
      rw [Nat.mod_eq_of_lt hyg] at modEq
      by_cases hlt : x+t < g
      · rw [Nat.mod_eq_of_lt hlt] at modEq
        exact same q x y hq hx hy (by omega)
      · rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)] at modEq
        have hqm : q < m := by
          by_contra! h
          have := Nat.mul_le_mul_right g h
          omega
        exact same (q+1) x y hqm hx hy (by rw [Nat.add_mul]; omega)
private lemma extend {n l : ℕ} (hl : l ≤ n) (A : Finset ℕ)
    (hbound : ∀ a ∈ A, a ≤ n) (hA : PerfectRuler l A) :
    F n ≤ A.card + 2*(Nat.sqrt (n-l)+2) := by
  let t := Nat.sqrt (n-l)+1
  let D := (range (t+1)).image (fun j => n-j*t)
  let B := (A ∪ range t ∪ D).filter (· ≤ n)
  have hab : A ⊆ B := by
    intro a ha
    exact mem_filter.mpr ⟨mem_union_left _ (mem_union_left _ ha), hbound a ha⟩
  have hB : B ∈ PerfectRulersLengthN n := by
    apply mem_filter.mpr
    refine ⟨mem_powerset.mpr (fun i hi => mem_range.mpr (by have := (mem_filter.mp hi).2; omega)), ?_⟩
    intro k hk
    have hkn : k ≤ n := by have := mem_range.mp hk; omega
    by_cases hkl : k ≤ l
    · obtain ⟨u,hu,v,hv,h⟩ := hA k (mem_range.mpr (by omega))
      exact ⟨u,hab hu,v,hab hv,h⟩
    · let j := (n-k)/t
      let a := (n-k)%t
      have ht : 0 < t := by dsimp [t]; omega
      have hj : j < t := (Nat.div_lt_iff_lt_mul ht).mpr (by
        have h := Nat.lt_succ_sqrt (n-l)
        change n-l < t*t at h
        omega)
      have ha : a < t := Nat.mod_lt _ ht
      have eqn : a+j*t=n-k := by simpa [a,j,Nat.mul_comm] using Nat.mod_add_div (n-k) t
      refine ⟨a,mem_filter.mpr ⟨mem_union_left _ (mem_union_right _ (mem_range.mpr ha)),by omega⟩,
        n-j*t,mem_filter.mpr ⟨mem_union_right _ (mem_image.mpr ⟨j,mem_range.mpr (by omega),rfl⟩),by omega⟩,by omega⟩
  have hmin : F n ≤ B.card := min'_le _ _ (mem_image.mpr ⟨B,hB,rfl⟩)
  apply hmin.trans
  have hsize := (card_filter_le .. : B.card ≤ (A ∪ range t ∪ D).card)
  have h₁ := card_union_le (A ∪ range t) D
  have h₂ := card_union_le A (range t)
  have h₃ : D.card ≤ t+1 := card_image_le.trans (card_range (t+1)).le
  simp only [card_range] at h₂
  apply hsize.trans
  change (A ∪ range t ∪ D).card ≤ A.card + 2*(t+1)
  omega

private lemma scale_bounds {m u p n : ℕ} (hm : 10 ≤ m) (hu : m+10 ≤ u)
    (h₁ : (m+10)*u^2 ≤ n) (h₂ : n < (m+10)*(u+1)^2) (hp : u < p)
    (hpu : m*p ≤ (m+1)*u) :
    let g := p^2+p+1
    (m+1)*g ≤ n ∧ Nat.sqrt (n-m*g) ≤ 4*u ∧
      F m * (p+1) ≤ (F m+4)*u := by
  dsimp only
  have hp1 : m*(p+1) ≤ (m+2)*u := by nlinarith only [hu,hpu]
  have hgap : p^2+p+1 ≤ (p+1)^2 := by nlinarith
  have hpoly : (m+1)*(m+2)^2 ≤ (m+10)*m^2 := by
    nlinarith only [Nat.mul_le_mul_left m hm, hm]
  have safe : (m+1)*(p^2+p+1) ≤ (m+10)*u^2 := by
    apply le_of_mul_le_mul_left (a := m^2) _ (by positivity)
    calc
      m^2*((m+1)*(p^2+p+1)) ≤ m^2*((m+1)*(p+1)^2) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hgap)
      _ = (m+1)*(m*(p+1))^2 := by ring
      _ ≤ (m+1)*((m+2)*u)^2 := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hp1 _)
      _ = ((m+1)*(m+2)^2)*u^2 := by ring
      _ ≤ ((m+10)*m^2)*u^2 := Nat.mul_le_mul_right _ hpoly
      _ = _ := by ring
  have huu : u^2 ≤ p^2+p+1 := (Nat.pow_le_pow_left hp.le 2).trans (by omega)
  have nlow := Nat.mul_le_mul_left m huu
  have hmul := Nat.mul_le_mul_right u hu
  have hdiff : n-m*(p^2+p+1) ≤ (4*u)^2 := by
    have HH : n ≤ m*(p^2+p+1) + (4*u)^2 := by
      nlinarith only [h₂,nlow,hmul,hu,hm,Nat.mul_le_mul_left u (show 10 ≤ u by omega)]
    omega
  have fbound := trivial_bound m
  refine ⟨safe.trans h₁, (Nat.sqrt_le_sqrt hdiff).trans (Nat.sqrt_eq' _).le, ?_⟩
  apply le_of_mul_le_mul_left (a := m) _ (by omega)
  calc
    m*(F m*(p+1)) = F m*(m*(p+1)) := by ring
    _ ≤ F m*((m+2)*u) := Nat.mul_le_mul_left _ hp1
    _ = (F m*(m+2))*u := by ring
    _ ≤ (m*(F m+4))*u := Nat.mul_le_mul_right _ (by nlinarith only [fbound,hm])
    _ = _ := by ring

private lemma upper (primes : PrimeWindow) (singer : SingerSets) (m : ℕ) (hm : 10 ≤ m) :
    ∀ᶠ n : ℕ in atTop, (F n : ℝ)/Real.sqrt n ≤ ((F m : ℝ)+16)/Real.sqrt m := by
  have hmpos : (0:ℝ) < m := by exact_mod_cast (by omega : 0 < m)
  obtain ⟨n₀,window⟩ := primes (1/(m:ℝ)) (by positivity)
  filter_upwards [eventually_ge_atTop ((m+10)*(max n₀ (m+10))^2)] with n hn
  let u := Nat.sqrt (n/(m+10))
  have hu : max n₀ (m+10) ≤ u := Nat.le_sqrt'.mpr ((Nat.le_div_iff_mul_le (by omega)).mpr (by simpa [Nat.mul_comm] using hn))
  have hum := (le_max_right _ _).trans hu
  have h₁ : (m+10)*u^2 ≤ n := by
    rw [Nat.mul_comm]
    exact (Nat.le_div_iff_mul_le (by omega)).mp (Nat.sqrt_le' _)
  have h₂ : n < (m+10)*(u+1)^2 := by
    rw [Nat.mul_comm]
    exact (Nat.div_lt_iff_lt_mul (by omega)).mp (Nat.lt_succ_sqrt' _)
  obtain ⟨p, hprime, hpu, hp⟩ := window u ((le_max_left _ _).trans hu)
  have hmp : m*p ≤ (m+1)*u := by
    have hh := mul_le_mul_of_nonneg_left hp hmpos.le
    have he : (m:ℝ)*((1+1/(m:ℝ))*(u:ℝ)) = (m+1 : ℝ)*u := by field_simp
    rw [he] at hh
    exact_mod_cast hh
  let g := p^2+p+1
  have hg : 0<g := by dsimp [g]; omega
  obtain ⟨hspan, htail, hcost⟩ := scale_bounds hm hum h₁ h₂ hpu hmp
  obtain ⟨A,hA,ha⟩ := get_ruler m
  obtain ⟨D,hD,hd,hS⟩ := singer p hprime
  obtain ⟨C,hC,hfit,hcov⟩ := inflate hg A D hA hD (card_pos.mp (by omega)) hS
  have hl : m*g ≤ n := (Nat.mul_le_mul_right g (Nat.le_succ m)).trans hspan
  have pad := extend hl C (fun z hz => (hfit z hz).le.trans hspan) hcov
  rw [ha,hd] at hC
  have hF : F n ≤ (F m+16)*u := by
    change F n ≤ C.card+2*((n-m*(p^2+p+1)).sqrt+2) at pad
    nlinarith only [pad,hC,hcost,htail,hum,hm]
  have low : m*u^2 ≤ n := (Nat.mul_le_mul_right _ (by omega : m ≤ m+10)).trans h₁
  have hnpos : (0:ℝ) < n := by exact_mod_cast (by nlinarith [hum,hm,h₁] : 0<n)
  have hscale : (u:ℝ)*Real.sqrt m ≤ Real.sqrt n := by
    apply le_of_sq_le_sq _ (Real.sqrt_nonneg _)
    have hlow : (m:ℝ)*u^2 ≤ n := by exact_mod_cast low
    rw [mul_pow,Real.sq_sqrt (Nat.cast_nonneg _), Real.sq_sqrt (Nat.cast_nonneg _), mul_comm]
    exact hlow
  apply (div_le_div_iff₀ (Real.sqrt_pos.2 hnpos) (Real.sqrt_pos.2 hmpos)).mpr
  have hF' : (F n:ℝ) ≤ ((F m:ℝ)+16)*u := by exact_mod_cast hF
  calc
    _ ≤ (((F m:ℝ)+16)*u)*Real.sqrt m := mul_le_mul_of_nonneg_right hF' (Real.sqrt_nonneg _)
    _ = ((F m:ℝ)+16)*((u:ℝ)*Real.sqrt m) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hscale (by positivity)

private lemma limit_exists (primes : PrimeWindow) (singer : SingerSets) :
    OMA.R_Erdos170_erdos170_existing_bounds_R1.H1 := by
  let values : Set ℝ := {x | ∃ m : ℕ, 10 ≤ m ∧ x = ((F m:ℝ)+16)/Real.sqrt m}
  let L := sInf values
  have hnon : values.Nonempty := ⟨_,10,le_rfl,rfl⟩
  have hb : BddBelow values := ⟨0,by rintro x ⟨m,hm,rfl⟩; positivity⟩
  refine ⟨L, tendsto_order.mpr ⟨?_,?_⟩⟩
  · intro a ha
    have hlim : Tendsto (fun n : ℕ => 16 / Real.sqrt (n:ℝ)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop (Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop)
    filter_upwards [eventually_ge_atTop 10,hlim.eventually_lt_const (sub_pos.mpr ha)] with n hn herr
    have hL : L ≤ ((F n:ℝ)+16)/Real.sqrt n := csInf_le hb ⟨n,hn,rfl⟩
    rw [add_div] at hL
    linarith
  · intro b hb'
    obtain ⟨x, ⟨m,hm,rfl⟩, hx⟩ := exists_lt_of_csInf_lt hnon hb'
    exact (upper primes singer m hm).mono fun _ h => h.trans_lt hx

end RulerLimit

private theorem oma_erdos170_h1 : OMA.R_Erdos170_erdos170_existing_bounds_R1.H1 := by
  apply RulerLimit.limit_exists OMA.PNT.h1
  intro p hp
  let : Fact p.Prime := ⟨hp⟩
  have h := Erdos707Singer.core (F := GaloisField p 1) (K := FiniteField.Extension (GaloisField p 1) p 3)
    (FiniteField.finrank_extension (GaloisField p 1) p 3)
  simpa only [GaloisField.card p 1 (by decide), pow_one] using h
end

section

/-! Leech's estimate uses a nonnegative trigonometric weight on every difference.
Each positive spacing and its negative occur among ordered pairs of ruler marks. -/

open Finset Filter Real Erdos170
open scoped Topology

private lemma ruler_weight (n : ℕ) (a : ℝ) :
    2 * (∑ k ∈ range n, (1 - cos (a * (k + 1 : ℝ)))) ≤ (F n : ℝ)^2 := by
  classical
  have hmin : F n ∈ (PerfectRulersLengthN n).image Finset.card := Finset.min'_mem _ _
  obtain ⟨A, hA, hcard⟩ := mem_image.mp hmin
  have hper := (mem_filter.mp hA).2
  have hw (k : Fin n) : ∃ p : ℕ × ℕ, p.1 ∈ A ∧ p.2 ∈ A ∧ p.2 = p.1 + (k.val+1) := by
    obtain ⟨u, hu, v, hv, h⟩ := hper (k.val+1) (mem_range.mpr (by omega))
    exact ⟨(u,v), hu, hv, by dsimp; omega⟩
  choose p hp1 hp2 hp using hw
  let q (k : Fin n) := (p k).swap
  have pinj : Function.Injective p := by
    intro i j h
    have h1 := congrArg Prod.fst h
    have h2 := congrArg Prod.snd h
    exact Fin.ext (by have := hp i; have := hp j; omega)
  have qinj : Function.Injective q := fun _ _ h => pinj (Prod.swap_injective h)
  let w (z : ℕ × ℕ) := 1 - cos (a*z.2 - a*z.1)
  have wp (i : Fin n) : w (p i) = 1 - cos (a * (i.val + 1 : ℝ)) := by
    simp only [w, hp i, Nat.cast_add, Nat.cast_one]
    congr 2
    ring
  have wq (i : Fin n) : w (q i) = w (p i) := by
    dsimp [w, q]
    rw [← cos_neg (a * (p i).1 - a * (p i).2), neg_sub]
  have dis : Disjoint (univ.image p) (univ.image q) := by
    apply Finset.disjoint_left.mpr
    intro z hz hz'
    obtain ⟨i, -, rfl⟩ := mem_image.mp hz
    obtain ⟨j, -, hj⟩ := mem_image.mp hz'
    have h1 := congrArg Prod.fst hj
    have h2 := congrArg Prod.snd hj
    change (p j).2 = (p i).1 at h1
    change (p j).1 = (p i).2 at h2
    have := hp i
    have := hp j
    omega
  have sub : univ.image p ∪ univ.image q ⊆ A ×ˢ A := by
    intro z hz
    rcases mem_union.mp hz with h | h <;> obtain ⟨i, -, rfl⟩ := mem_image.mp h
    · exact mem_product.mpr ⟨hp1 i, hp2 i⟩
    · exact mem_product.mpr ⟨hp2 i, hp1 i⟩
  have lower := sum_le_sum_of_subset_of_nonneg (f := w) sub
    (fun z _ _ => sub_nonneg.mpr (cos_le_one _))
  rw [sum_union dis, sum_image pinj.injOn, sum_image qinj.injOn] at lower
  simp only [wq, wp] at lower
  have upper : ∑ z ∈ A ×ˢ A, w z ≤ (A.card : ℝ)^2 := by
    simp only [w, sum_product, cos_sub, sum_sub_distrib, sum_add_distrib, ← mul_sum,
      ← sum_mul, sum_const, nsmul_eq_mul, mul_one, card_product, Nat.cast_mul]
    nlinarith [sq_nonneg (∑ x ∈ A, cos (a * x)), sq_nonneg (∑ x ∈ A, sin (a * x))]
  rw [← hcard, ← Fin.sum_univ_eq_sum_range]
  linarith

private lemma mean_cos (θ : ℝ) (hθ : θ ≠ 0) :
    Tendsto (fun n : ℕ => (∑ k ∈ range n, cos (θ / n * (k + 1 : ℝ))) / n)
      atTop (𝓝 (sin θ / θ)) := by
  let x (n : ℕ) : ℝ := (θ / 2) / n
  have hx : Tendsto x atTop (𝓝 0) := tendsto_const_div_atTop_nhds_zero_nat _
  have hs : Tendsto (fun n => sinc (x n)) atTop (𝓝 1) := by
    simpa only [Function.comp_def, sinc_zero] using (continuous_sinc.tendsto 0).comp hx
  have hc : Tendsto (fun n => cos (θ/2 + x n)) atTop (𝓝 (cos (θ/2))) := by
    exact (continuous_cos.tendsto _).comp (by simpa using tendsto_const_nhds.add hx)
  have hlim := ((tendsto_const_nhds (x := sin (θ/2))).mul hc).div
    ((tendsto_const_nhds (x := θ/2)).mul hs) (by simpa using (div_ne_zero hθ (by norm_num : (2:ℝ) ≠ 0)))
  rw [mul_one] at hlim
  have trig : sin (θ/2) * cos (θ/2) / (θ/2) = sin θ / θ := by
    have h := sin_two_mul (θ/2)
    rw [show 2*(θ/2)=θ by ring] at h
    rw [h]
    ring
  rw [trig] at hlim
  apply hlim.congr'
  filter_upwards [eventually_ge_atTop 1, hs.eventually_ne (by norm_num : (1:ℝ) ≠ 0)] with n hn hsn
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast (by omega : n ≠ 0)
  have hx' : x n ≠ 0 := div_ne_zero (div_ne_zero hθ (by norm_num)) hn'
  have formula := Real.sin_mul_sum_cos n (θ / n) (θ / n)
  have adj (k : ℕ) : θ / n * k + θ / n = θ / n * (k + 1) := by ring
  simp_rw [adj] at formula
  rw [show θ / n / 2 = x n by dsimp [x]; ring,
    show (n:ℝ) * (θ/n) / 2 = θ/2 by field_simp,
    show ((n:ℝ)-1)*(θ/n)/2 + θ/n = θ/2 + x n by dsimp [x]; field_simp; ring] at formula
  apply (div_eq_div_iff (mul_ne_zero (div_ne_zero hθ (by norm_num)) hsn) hn').mpr
  have hxmul : (θ/2) * sinc (x n) = n * sin (x n) := by
    rw [sinc_of_ne_zero hx']
    dsimp [x]
    field_simp
  dsimp only
  rw [hxmul, ← formula]
  ring

private theorem oma_erdos170_h2 : OMA.R_Erdos170_erdos170_existing_bounds_R1.H2 := by
  intro θ hθ ε hε
  have hmean := mean_cos θ hθ
  have hlim : Tendsto (fun n : ℕ =>
      2 * (1 - (∑ k ∈ range n, cos (θ/n * (k+1 : ℝ))) / n)) atTop
      (𝓝 (2 * (1 - sin θ / θ))) := tendsto_const_nhds.mul (tendsto_const_nhds.sub hmean)
  filter_upwards [hlim.eventually_const_lt (show 2 * (1 - sin θ / θ) - ε < _ by linarith),
    eventually_ge_atTop 1] with n hlo hn
  apply hlo.le.trans
  have hp : (0:ℝ) < n := by exact_mod_cast (by omega : 0 < n)
  have hh := ruler_weight n (θ/n)
  simp only [sum_sub_distrib, sum_const, card_range, nsmul_eq_mul, mul_one] at hh
  rw [div_pow, Real.sq_sqrt hp.le]
  apply (le_div_iff₀ hp).mpr
  calc
    _ = 2 * ((n : ℝ) - ∑ k ∈ range n, cos (θ/n * (k+1 : ℝ))) := by
      field_simp
    _ ≤ _ := hh
end

section

/-! B. A. Wichmann, A Note on Restricted Difference Bases (1963).
The marks in this ruler form five arithmetic progressions. We express each mark in base 2r+1. In these coordinates, finding two
marks with a prescribed difference reduces to linear integer inequalities. -/

open Finset Filter Real Erdos170
namespace Wichmann

private inductive Mark (r : ℤ) : ℤ → ℤ → Prop
  | a (i : ℤ) : 0 ≤ i → i ≤ r → Mark r 0 i
  | b (i : ℤ) : 1 ≤ i → i ≤ r+1 → Mark r i 0
  | c (i : ℤ) : 0 ≤ i → i ≤ 2*r → Mark r (r+1+2*i) i
  | d (i : ℤ) : 0 ≤ i → i ≤ r+1 → Mark r (5*r+1+i) (2*r+i)
  | e (i : ℤ) : 0 ≤ i → i ≤ r → Mark r (6*r+2) (3*r+1+i)


private lemma digits1 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : q = 0 ∧ r > 0 ∧ (0 ≤ s  ∧ s ≤ r)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.a (0) (by omega) (by omega),
    Mark.a (s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits2 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : s = 0 ∧ r > 0 ∧ (0 < q  ∧ q ≤ 1 + r)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.a (0) (by omega) (by omega),
    Mark.b (q) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits3 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (0 ≤ q  ∧ q ≤ r) ∧ (r < s  ∧ s ≤ 2*r)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, -1, Mark.a (1 + 2*r - s) (by omega) (by omega),
    Mark.b (1 + q) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits4 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (r + q) % 2 = 0 ∧ q > r ∧ s ≤ 2*r ∧ 2*s ≥ 2 + r + q) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, -1, Mark.a (1 + r - s + ((r + q) / 2)) (by omega) (by omega),
    Mark.c (-r + ((r + q) / 2)) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits5 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (1 + r + q) % 2 = 0 ∧ (2 + r ≤ q  ∧ q ≤ 1 + 5*r) ∧ s ≥ 0 ∧ (-1 - 3*r + q ≤ 2*s  ∧ 2*s < -r + q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.a (-1 - r - s + ((1 + r + q) / 2)) (by omega) (by omega),
    Mark.c (-1 - r + ((1 + r + q) / 2)) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits6 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : r > 0 ∧ q ≤ 3 + 6*r ∧ (0 ≤ s  ∧ s ≤ -3 - 5*r + q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.a (-3 - 5*r + q - s) (by omega) (by omega),
    Mark.d (-2 - 5*r + q) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits7 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : q > 5*r ∧ (-1 - 4*r + q ≤ s  ∧ s ≤ 2*r) ∧ (((1 + r + q) % 2 = 0 ∧ q ≥ 2 + 5*r) ∨ ((r + q) % 2 = 0 ∧ r > 0))) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.a (-1 - 3*r + q - s) (by omega) (by omega),
    Mark.d (-1 - 5*r + q) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits8 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : q = 3 + 6*r ∧ (r < s  ∧ s ≤ 2*r)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.a (0) (by omega) (by omega),
    Mark.e (-r + s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits9 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (0 < s  ∧ s ≤ 2*r) ∧ (-r + q ≤ 2*s  ∧ 2*s ≤ q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.b (1 + r - q + 2*s) (by omega) (by omega),
    Mark.c (s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits10 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : r > 0 ∧ s ≥ 0 ∧ (-2 - 5*r + q ≤ s  ∧ s ≤ -2 - 4*r + q) ∧ s ≤ r) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.b (3 + 5*r - q + s) (by omega) (by omega),
    Mark.d (1 + s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits11 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : q ≤ 2 + 6*r ∧ (r < s  ∧ s ≤ -2 - 4*r + q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.b (3 + 6*r - q) (by omega) (by omega),
    Mark.e (-r + s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits12 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : s ≤ q ∧ s ≤ 2*r ∧ (q < 2*s  ∧ 2*s ≤ 1 + r + q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.c (2*r - q + s) (by omega) (by omega),
    Mark.d (-q + 2*s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits13 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : s ≥ 0 ∧ s ≥ -1 - 4*r + q ∧ 2*s ≤ -2 - 3*r + q) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.c (2 + 4*r - q + s) (by omega) (by omega),
    Mark.d (3 + 4*r - q + 2*s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits14 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (r + q) % 2 = 0 ∧ q ≤ 5*r ∧ s ≥ 0 ∧ (-1 - 3*r + q ≤ 2*s  ∧ 2*s ≤ -2 - r + q)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 1, Mark.c (1 + 2*r - q + ((r + q) / 2)) (by omega) (by omega),
    Mark.e (1 + r - q + s + ((r + q) / 2)) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits15 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : (1 + r + q) % 2 = 0 ∧ q > r ∧ s ≤ 2*r ∧ 2*s ≥ 2 + r + q) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.c (2*r - q + ((1 + r + q) / 2)) (by omega) (by omega),
    Mark.e (-1 - r - q + s + ((1 + r + q) / 2)) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma digits16 (r q s : ℤ) (_hr : 1 ≤ r) (_hq : 0 ≤ q) (_hq' : q ≤ 6*r+3)
    (_hs : 0 ≤ s) (_hs' : s ≤ 2*r) (h : q > 0 ∧ (q < s  ∧ s ≤ r)) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  refine ⟨_, _, _, _, 0, Mark.d (1 + r - q) (by omega) (by omega),
    Mark.e (-q + s) (by omega) (by omega), ?_, ?_⟩ <;> omega

private lemma cover_digits (r q s : ℤ) (hr : 1 ≤ r) (hq : 0 ≤ q) (hq' : q ≤ 6*r+3)
    (hs : 0 ≤ s) (hs' : s ≤ 2*r) :
    ∃ a b c d t : ℤ, Mark r a b ∧ Mark r c d ∧ c-a+t=q ∧ d-b-t*(2*r+1)=s := by
  by_cases h0 : 2*s < -r + q
  · by_cases h1 : -1 - 4*r + q ≤ s
    · by_cases h2 : q ≤ 1 + r
      · exact digits2 r q s hr hq hq' hs hs' (by omega)
      · by_cases h3 : q ≤ 1 + 5*r
        · by_cases h4 : -1 - 3*r + q ≤ 2*s
          · by_cases h5 : (r + q) % 2 = 0
            · exact digits14 r q s hr hq hq' hs hs' (by omega)
            · exact digits5 r q s hr hq hq' hs hs' (by omega)
          · exact digits13 r q s hr hq hq' hs hs' (by omega)
        · exact digits7 r q s hr hq hq' hs hs' (by omega)
    · by_cases h2 : r < s
      · by_cases h3 : q = 3 + 6*r
        · exact digits8 r q s hr hq hq' hs hs' (by omega)
        · exact digits11 r q s hr hq hq' hs hs' (by omega)
      · by_cases h3 : s ≤ -3 - 5*r + q
        · exact digits6 r q s hr hq hq' hs hs' (by omega)
        · exact digits10 r q s hr hq hq' hs hs' (by omega)
  · by_cases h1 : r < s
    · by_cases h2 : 2*s ≥ 2 + r + q
      · by_cases h3 : q > r
        · by_cases h4 : (r + q) % 2 = 0
          · exact digits4 r q s hr hq hq' hs hs' (by omega)
          · exact digits15 r q s hr hq hq' hs hs' (by omega)
        · exact digits3 r q s hr hq hq' hs hs' (by omega)
      · by_cases h3 : q < 2*s
        · exact digits12 r q s hr hq hq' hs hs' (by omega)
        · exact digits9 r q s hr hq hq' hs hs' (by omega)
    · by_cases h2 : q < 2*s
      · by_cases h3 : q = 0
        · exact digits1 r q s hr hq hq' hs hs' (by omega)
        · by_cases h4 : q < s
          · exact digits16 r q s hr hq hq' hs hs' (by omega)
          · exact digits12 r q s hr hq hq' hs hs' (by omega)
      · by_cases h3 : q = 0
        · exact digits1 r q s hr hq hq' hs hs' (by omega)
        · by_cases h4 : s = 0
          · exact digits2 r q s hr hq hq' hs hs' (by omega)
          · exact digits9 r q s hr hq hq' hs hs' (by omega)


private def base (r : ℤ) := 2*r+1
private def marks (r : ℤ) : Finset ℤ :=
  (Icc 0 r ∪ (Icc 1 (r+1)).image (fun i => i*base r)) ∪
  ((Icc 0 (2*r)).image (fun i => (r+1+2*i)*base r+i) ∪
  ((Icc 0 (r+1)).image (fun i => (5*r+1+i)*base r+(2*r+i)) ∪
    (Icc 0 r).image (fun i => (6*r+2)*base r+(3*r+1+i))))

private lemma mark_mem {r a b : ℤ} (h : Mark r a b) : a*base r+b ∈ marks r := by
  simp only [marks, mem_union, mem_image, mem_Icc]
  cases h with
  | a i hi hi' => exact Or.inl <| Or.inl <| by simpa using And.intro hi hi'
  | b i hi hi' => exact Or.inl <| Or.inr ⟨_, ⟨hi,hi'⟩, by simp⟩
  | c i hi hi' => exact Or.inr <| Or.inl ⟨_, ⟨hi,hi'⟩, rfl⟩
  | d i hi hi' => exact Or.inr <| Or.inr <| Or.inl ⟨i, ⟨hi,hi'⟩, rfl⟩
  | e i hi hi' => exact Or.inr <| Or.inr <| Or.inr ⟨i, ⟨hi,hi'⟩, rfl⟩

private lemma mark_bounds {r a b : ℤ} (hr : 1 ≤ r) (h : Mark r a b) :
    0 ≤ a*base r+b ∧ a*base r+b < (6*r+4)*base r := by
  have hcoords : 0 ≤ a ∧ a ≤ 6*r+2 ∧ 0 ≤ b ∧ b ≤ 4*r+1 := by
    cases h <;> omega
  obtain ⟨ha, ha', hb, hb'⟩ := hcoords
  have hb0 : 0 ≤ base r := by dsimp [base]; omega
  constructor
  · exact add_nonneg (mul_nonneg ha hb0) hb
  · have hm := mul_le_mul_of_nonneg_right ha' hb0
    dsimp [base] at *
    nlinarith

private lemma marks_card (r : ℕ) : (marks (r : ℤ)).card ≤ 6*r+7 := by
  have h (s t : Finset ℤ) := card_union_le s t
  have general (a b c d e : Finset ℤ) :
      ((a ∪ b) ∪ (c ∪ (d ∪ e))).card ≤ a.card+b.card+c.card+d.card+e.card := by
    have h₁ := h a b
    have h₂ := h d e
    have h₃ := h c (d∪e)
    have h₄ := h (a∪b) (c∪(d∪e))
    omega
  dsimp [marks]
  apply (general _ _ _ _ _).trans
  grw [card_image_le, card_image_le, card_image_le, card_image_le]
  simp only [Int.card_Icc]
  omega

private def length (r : ℕ) := (6*r+4)*(2*r+1)-1

private lemma short_ruler (r : ℕ) (hr : 1 ≤ r) :
    ∃ A : Finset ℕ, A.card ≤ 6*r+7 ∧ (∀ a ∈ A, a ≤ length r) ∧ PerfectRuler (length r) A := by
  let A := ((marks (r : ℤ)).image Int.toNat).filter (· ≤ length r)
  refine ⟨A, (card_filter_le ..).trans (card_image_le.trans (marks_card r)),
    fun _ h => (mem_filter.mp h).2, ?_⟩
  intro d hd
  have hd' := mem_range.mp hd
  have he : length r + 1 = (6*r+4)*(2*r+1) := Nat.sub_add_cancel (show 0 < (6*r+4)*(2*r+1) by positivity)
  rw [he] at hd'
  let Q := d / (2*r+1)
  let S := d % (2*r+1)
  have hu : 0 < 2*r+1 := by omega
  have hQ : Q < 6*r+4 := (Nat.div_lt_iff_lt_mul hu).mpr hd'
  have hS : S < 2*r+1 := Nat.mod_lt _ hu
  have hdiv : Q*(2*r+1)+S=d := by simpa [Q,S,Nat.mul_comm,Nat.add_comm] using Nat.mod_add_div d (2*r+1)
  obtain ⟨a,b,c,e,t,hab,hce,hq,hs⟩ := cover_digits r Q S (by exact_mod_cast hr)
    (by positivity) (by exact_mod_cast (by omega : Q ≤ 6*r+3))
    (by positivity) (by exact_mod_cast (by omega : S ≤ 2*r))
  have mem {a b : ℤ} (h : Mark (r:ℤ) a b) : (a*base r+b).toNat ∈ A := by
    obtain ⟨_,hhi⟩ := mark_bounds (by exact_mod_cast hr) h
    refine mem_filter.mpr ⟨mem_image.mpr ⟨_, mark_mem h, rfl⟩, ?_⟩
    have hcast : (((6*r+4)*(2*r+1) : ℕ) : ℤ) = (6*(r:ℤ)+4)*base r := by simp [base]
    omega
  refine ⟨_,mem hab,_,mem hce,?_⟩
  have hval : (d : ℤ) = (c*base r+e)-(a*base r+b) := by
    have hdiv' : (Q : ℤ)*(2*(r:ℤ)+1)+S=d := by exact_mod_cast hdiv
    dsimp [base]
    linear_combination -hdiv' - (2*(r:ℤ)+1)*hq - hs
  have h₁ := (mark_bounds (by exact_mod_cast hr) hab).1
  have h₂ := (mark_bounds (by exact_mod_cast hr) hce).1
  omega

private lemma extend {n l : ℕ} (hl : l ≤ n) (A : Finset ℕ)
    (hbound : ∀ a ∈ A, a ≤ l) (hA : PerfectRuler l A) :
    F n ≤ A.card + 2*(Nat.sqrt (n-l)+2) := by
  let t := Nat.sqrt (n-l)+1
  let D := (range (t+1)).image (fun j => n-j*t)
  let B := (A ∪ range t ∪ D).filter (· ≤ n)
  have hab : A ⊆ B := by
    intro a ha
    exact mem_filter.mpr ⟨mem_union_left _ (mem_union_left _ ha), (hbound a ha).trans hl⟩
  have hB : B ∈ PerfectRulersLengthN n := by
    apply mem_filter.mpr
    refine ⟨mem_powerset.mpr (fun i hi => mem_range.mpr (by have := (mem_filter.mp hi).2; omega)), ?_⟩
    intro k hk
    have hkn : k ≤ n := by have := mem_range.mp hk; omega
    by_cases hkl : k ≤ l
    · obtain ⟨u,hu,v,hv,h⟩ := hA k (mem_range.mpr (by omega))
      exact ⟨u,hab hu,v,hab hv,h⟩
    · let j := (n-k)/t
      let a := (n-k)%t
      have ht : 0 < t := by dsimp [t]; omega
      have hj : j < t := (Nat.div_lt_iff_lt_mul ht).mpr (by
        have h := Nat.lt_succ_sqrt (n-l)
        change n-l < t*t at h
        omega)
      have ha : a < t := Nat.mod_lt _ ht
      have eqn : a+j*t=n-k := by simpa [a,j,Nat.mul_comm] using Nat.mod_add_div (n-k) t
      refine ⟨a,mem_filter.mpr ⟨mem_union_left _ (mem_union_right _ (mem_range.mpr ha)),by omega⟩,
        n-j*t,mem_filter.mpr ⟨mem_union_right _ (mem_image.mpr ⟨j,mem_range.mpr (by omega),rfl⟩),by omega⟩,by omega⟩
  have hmin : F n ≤ B.card := min'_le _ _ (mem_image.mpr ⟨B,hB,rfl⟩)
  apply hmin.trans
  have hsize := (card_filter_le .. : B.card ≤ (A ∪ range t ∪ D).card)
  have h₁ := card_union_le (A ∪ range t) D
  have h₂ := card_union_le A (range t)
  have h₃ : D.card ≤ t+1 := card_image_le.trans (card_range (t+1)).le
  simp only [card_range] at h₂
  apply hsize.trans
  change (A ∪ range t ∪ D).card ≤ A.card + 2*(t+1)
  omega

end Wichmann

private theorem oma_erdos170_h3 : OMA.R_Erdos170_erdos170_existing_bounds_R1.H3 := by
  intro ε hε
  obtain ⟨K, hK⟩ := exists_nat_gt (max (max (11/ε) (100/ε^2)) 100)
  filter_upwards [eventually_ge_atTop (12*(K+1)^2)] with n hn
  have hk : K+1 ≤ (n/12).sqrt := Nat.le_sqrt'.mpr ((Nat.le_div_iff_mul_le (by decide)).mpr (by simpa [Nat.mul_comm] using hn))
  let r := (n/12).sqrt-1
  have hKr : K ≤ r := by dsimp [r]; omega
  have hKR : (K:ℝ) ≤ r := by exact_mod_cast hKr
  have hR : (100:ℝ) ≤ r := ((le_max_right _ _).trans hK.le).trans hKR
  have hr : 1 ≤ r := by exact_mod_cast (show (1:ℝ) ≤ r by linarith)
  have hr' : r+1 = (n/12).sqrt := by dsimp [r]; omega
  have hlow := Nat.sqrt_le' (n/12)
  have hhigh := Nat.lt_succ_sqrt' (n/12)
  rw [← hr'] at hlow hhigh
  have hlo : 12*(r+1)^2 ≤ n := by omega
  have hhi : n < 12*(r+2)^2 := by change n/12 < (r+2)^2 at hhigh; omega
  have hformula : Wichmann.length r = 12*r^2+14*r+3 := by
    unfold Wichmann.length
    have h : (6*r+4)*(2*r+1) = 12*r^2+14*r+4 := by ring
    omega
  have hlen : Wichmann.length r ≤ n := by rw [hformula]; nlinarith [hlo]
  have hdiff : n-Wichmann.length r ≤ 34*r+45 := by
    rw [hformula]; have h : n < 12*r^2+48*r+48 := by nlinarith [hhi]
    omega
  obtain ⟨A, hA, hab, hper⟩ := Wichmann.short_ruler r hr
  have hfin := Wichmann.extend hlen A hab hper
  let t := Nat.sqrt (n-Wichmann.length r)
  have ht : t^2 ≤ 34*r+45 := (Nat.sqrt_le' _).trans hdiff
  have hf : (F n : ℝ) ≤ 6*(r:ℝ)+11+2*t := by exact_mod_cast (show F n ≤ 6*r+11+2*t by dsimp [t]; omega)
  have h11 : 11/ε ≤ (r:ℝ) := ((le_max_left _ _).trans ((le_max_left _ _).trans hK.le)).trans hKR
  have h100 : 100/ε^2 ≤ (r:ℝ) := ((le_max_right _ _).trans ((le_max_left _ _).trans hK.le)).trans hKR
  have ha := (div_le_iff₀ hε).mp h11
  have hb := (div_le_iff₀ (sq_pos_of_pos hε)).mp h100
  have hb' := mul_le_mul_of_nonneg_right hb (Nat.cast_nonneg r : (0:ℝ) ≤ r)
  have ht' : (t:ℝ)^2 ≤ 34*(r:ℝ)+45 := by exact_mod_cast ht
  have herr : (t:ℝ) ≤ ε*r := by
    apply le_of_sq_le_sq _ (mul_nonneg hε.le (Nat.cast_nonneg r))
    nlinarith only [ht', hb', hR]
  have hbase : 12*r^2 ≤ n := by nlinarith [hlo]
  have hbase' : 12*(r:ℝ)^2 ≤ n := by exact_mod_cast hbase
  have hnpos : (0:ℝ) < n := by exact_mod_cast (by nlinarith [hlo] : 0 < n)
  have hsr := Real.sq_sqrt hnpos.le
  have h3 := Real.sq_sqrt (by norm_num : (0:ℝ) ≤ 3)
  have hsqrt : 3*(r:ℝ) ≤ Real.sqrt n := by
    apply le_of_sq_le_sq _ (Real.sqrt_nonneg _)
    nlinarith only [hsr,hbase',sq_nonneg (r:ℝ)]
  have hmain : 6*(r:ℝ) ≤ Real.sqrt 3 * Real.sqrt n := by
    have sq : (Real.sqrt 3 * Real.sqrt n)^2 = 3*n := by rw [mul_pow,h3,hsr]
    apply le_of_sq_le_sq _ (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
    nlinarith only [hbase',sq]
  apply (div_le_iff₀ (Real.sqrt_pos.2 hnpos)).mpr
  change (F n : ℝ) ≤ (Real.sqrt 3 + ε) * Real.sqrt n
  nlinarith only [hf,ha,herr,hmain,mul_le_mul_of_nonneg_left hsqrt hε.le]
end

theorem OMA.solution : type_of% @Erdos170.erdos170.existing_bounds :=
  OMA.R_Erdos170_erdos170_existing_bounds_R1.main oma_erdos170_h1 oma_erdos170_h2 oma_erdos170_h3
