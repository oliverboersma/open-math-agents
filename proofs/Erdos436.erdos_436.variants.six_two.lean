private theorem negate (w : ℕ → F) (ww : Wins fun p => -w p) : Wins w := by
  obtain ⟨n,hn,hu,hv⟩ := ww
  have hneg (ps : List ℕ) : (ps.map (fun p => -w p)).sum = -(ps.map w).sum := by
    induction ps with
    | nil => simp
    | cons p ps ih => simp [ih,add_comm]
  exact ⟨n,hn, by simpa only [hneg, neg_eq_zero] using hu,
    by simpa only [hneg, neg_eq_zero] using hv⟩

private theorem allCases (w : ℕ → F) : Wins w := by
  have h : ∀ a : F, a=0 ∨ a=1 ∨ a=2 ∨ a=3 ∨ a=4 ∨ a=5 := by decide
  rcases h (w 2) with h0|h1|h2|h3|h4|h5
  · exact ⟨1, by decide, by simp, by
      have he : (1 + 1 : ℕ).primeFactorsList = [2] := by decide +kernel
      rw [he]
      simpa using h0⟩
  · exact case1 w h1
  · exact case2 w h2
  · exact case3 w h3
  · exact negate w (case2 (fun p => -w p) (by change -w 2 = 2; rw [h4]; decide))
  · exact negate w (case1 (fun p => -w p) (by change -w 2 = 1; rw [h5]; decide))

