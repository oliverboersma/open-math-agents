lemma lift_roots {I : Type} [Fintype I] (p : I → ℕ) (hp : ∀ i, (p i).Prime)
    (hinj : Function.Injective p) (v : I → ℕ) :
    ∃ (L : Type) (_ : Field L) (_ : CharZero L) (_ : NumberField L) (_ : IsGalois ℚ L)
      (σ : (𝓞 L) ≃+* (𝓞 L)) (u : 𝓞 L), IsPrimitiveRoot u 6 ∧ σ u=u ∧ (∃ m : ℕ, 0 < m ∧ ∀ x, (σ : 𝓞 L → 𝓞 L)^[m] x = x) ∧
      ∀ i, ∃ r : 𝓞 L, r^6 = p i ∧ σ r=r*u^(v i) := by
  classical
  let g (i : I) : ℚ[X] := X^6 - C (p i : ℚ)
  let P := cyclotomic 6 ℚ * ∏ i, g i
  let L := P.SplittingField
  letI : Polynomial.IsSplittingField ℚ L P := Polynomial.IsSplittingField.splittingField P
  letI : NumberField L := ⟨⟩
  letI : IsGalois ℚ L := isGalois_iff.mpr ⟨inferInstance,Polynomial.SplittingField.instNormal P⟩
  have pg (i : I) : (g i).natDegree = 6 := natDegree_X_pow_sub_C
  have neP : P ≠ 0 := mul_ne_zero (cyclotomic_ne_zero 6 ℚ) (Finset.prod_ne_zero_iff.mpr
    (fun i _ h => by have := pg i; simp [h] at this))
  have root (f : ℚ[X]) (hf : f ∣ P) (hd : 0 < f.natDegree) : ∃ y : L, f.aeval y = 0 := by
    let j := algebraMap ℚ L
    have h := (IsSplittingField.splits L P).of_dvd (map_ne_zero (f := j) neP)
      (map_dvd (mapRingHom j) hf)
    have hd0 : (f.map j).natDegree ≠ 0 := by rw [natDegree_map]; exact hd.ne'
    obtain ⟨y,hy⟩ := h.exists_eval_eq_zero (degree_ne_of_natDegree_ne (n := 0) hd0)
    refine ⟨y,?_⟩
    rw [aeval_def,eval₂_eq_eval_map]
    exact hy
  obtain ⟨u,hu⟩ := root (cyclotomic 6 ℚ) (dvd_mul_right ..) (by rw [natDegree_cyclotomic]; exact Nat.totient_pos.mpr (by decide))
  have prim : IsPrimitiveRoot u 6 := by
    apply isRoot_cyclotomic_iff.mp
    simpa [Polynomial.IsRoot.def,aeval_def,eval₂_eq_eval_map] using hu
  have each (i : I) : ∃ r : L, r^6 = p i := by
    obtain ⟨r,hr⟩ := root (g i) (dvd_trans (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)) (dvd_mul_left ..))
      (by rw [pg]; exact (by decide))
    exact ⟨r,by simpa [g,sub_eq_zero] using hr⟩
  choose r hr using each
  let F : IntermediateField ℚ L := ℚ⟮u⟯
  let u' : F := ⟨u,IntermediateField.mem_adjoin_simple_self ℚ u⟩
  have hu' : IsPrimitiveRoot u' 6 := prim.of_map_of_injective (f := F.subtype) Subtype.val_injective
  have deg : Module.finrank ℚ F = 2 := by
    rw [show Module.finrank ℚ F = (minpoly ℚ u).natDegree from IntermediateField.adjoin.finrank (IsIntegral.of_finite ℚ u),
      ← cyclotomic_eq_minpoly_rat prim (by decide),natDegree_cyclotomic]
    decide
  have rn (i : I) : r i ≠ 0 := by
    intro hz
    have h := hr i
    rw [hz,zero_pow (by decide : 6 ≠ 0)] at h
    exact (Nat.cast_ne_zero.mpr (hp i).ne_zero) h.symm
  obtain ⟨σ,hσ⟩ := prescribe deg u' hu' p hp hinj r hr rn v
  let τ := RingOfIntegers.mapRingEquiv σ.toRingEquiv
  let U : 𝓞 L := ⟨u,prim.isIntegral (by decide)⟩
  refine ⟨L,inferInstance,inferInstance,inferInstance,inferInstance,τ,U,?_,?_,?_,?_⟩
  · exact prim.of_map_of_injective (f := algebraMap (𝓞 L) L) (FaithfulSMul.algebraMap_injective (𝓞 L) L)
  · exact Subtype.ext (σ.commutes u')
  · refine ⟨orderOf σ,orderOf_pos _,fun x => Subtype.ext ?_⟩
    have it (j : ℕ) : (((τ : 𝓞 L → 𝓞 L)^[j] x : 𝓞 L) : L) = (σ^j) (x : L) := by
      induction j with
      | zero => rfl
      | succ j ih =>
        rw [Function.iterate_succ_apply',pow_succ']
        exact congrArg σ ih
    exact (it _).trans (by rw [pow_orderOf_eq_one]; rfl)
  · intro i
    have integral : IsIntegral ℤ (r i) := IsIntegral.of_pow (by decide : 0<6)
      ((hr i).symm ▸ (isIntegral_algebraMap : IsIntegral ℤ (algebraMap ℤ L (p i : ℤ))))
    refine ⟨⟨r i,integral⟩,Subtype.ext (hr i),?_⟩
    apply Subtype.ext
    change σ (r i) = r i*u^(v i)
    exact hσ i

end Sextic436


open NumberField Filter Set Chebotarev
open scoped Topology
namespace WeakDensity436
noncomputable section
abbrev BigPrime (B:ℕ) := {q:Nat.Primes // B<q.val}

lemma degree_series (K : Type) [Field K] [NumberField K] (B:ℕ) (s:ℝ) (hs:1<s) :
    HasSum (fun q:BigPrime B => (Nat.card (𝓞 K →+* ZMod q.val.val):ℝ) * (q.val.val:ℝ)^(-s))
      (Chebotarev.primeIdealZetaSum (Targets K B) s) := by
  classical
  let A := {I:Ideal (𝓞 K) // I∈Targets K B ∧ I.IsPrime ∧ I≠⊥}
  let f (I:A) := (I.1.absNorm:ℝ)^(-s)
  let g (I:A) : BigPrime B := ⟨⟨I.1.absNorm,I.2.1.2⟩,I.2.1.1⟩
  have has : HasSum f (Chebotarev.primeIdealZetaSum (Targets K B) s) :=
    (summable_prime_absNorm_rpow (Targets K B) hs).hasSum
  have eq (q:BigPrime B) :
      (∑' I : (g ⁻¹' {q} : Set A), f I.val) =
        (Nat.card (𝓞 K →+* ZMod q.val.val):ℝ) * (q.val.val:ℝ)^(-s) := by
    let V := (g ⁻¹' {q} : Set A)
    have norm (I:V) : I.val.val.absNorm=q.val.val := congrArg (fun j:BigPrime B => j.val.val) (show g I.val=q from I.property)
    let e : V ≃ Fibr K q.val.val := {
      toFun := fun I => ⟨I.1.1,norm I⟩
      invFun := fun ⟨I,h⟩ => ⟨⟨I,⟨by simpa only [h] using q.2,by simpa only [h] using q.1.2⟩,Ideal.isPrime_of_irreducible_absNorm (by rw [h]; exact q.1.2),
        fun bot => q.1.2.ne_zero (by rw [←h,bot,Ideal.absNorm_bot])⟩,Subtype.ext (Subtype.ext h)⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
    letI : Fintype (Fibr K q.val.val) := (Ideal.finite_setOfPred_absNorm_eq (S := 𝓞 K) _).fintype
    letI : Fintype V := Fintype.ofEquiv _ e.symm
    rw [tsum_congr (fun I:V => show f I.val=(q.val.val:ℝ)^(-s) by dsimp [f]; rw [norm]),tsum_fintype,Finset.sum_const,Finset.card_univ,nsmul_eq_mul,
      ←Nat.card_eq_fintype_card,Nat.card_congr e,←count_homs K _ q.1.2]
  simpa only [eq] using has.tsum_fiberwise g

lemma trimmed_le_univ (K : Type) [Field K] [NumberField K] (B:ℕ) (s:ℝ) (hs:1<s) :
    Chebotarev.primeIdealZetaSum (Targets K B) s ≤ Chebotarev.primeIdealZetaSum (univ:Set (Ideal (𝓞 K))) s := by
  have add := primeIdealZetaSum_union_of_disjoint (S := Targets K B) (T := (Targets K B)ᶜ) disjoint_compl_right hs
  rw [union_compl_self] at add
  have pos : 0 ≤ Chebotarev.primeIdealZetaSum (Targets K B)ᶜ s := tsum_nonneg fun _ => Real.rpow_nonneg (Nat.cast_nonneg _) _
  linarith

theorem triple (E K L : Type) [Field E] [NumberField E] [Field K] [NumberField K] [Field L] [NumberField L] (B:ℕ) :
    ∃ p>B, p.Prime ∧ 3*Nat.card (𝓞 K →+* ZMod p)+2*Nat.card (𝓞 L →+* ZMod p)<6*Nat.card (𝓞 E →+* ZMod p) := by
  classical
  by_contra! no
  obtain ⟨C,tail⟩ := high_tail E B
  obtain ⟨a,low⟩ := log_minus_bounded_le_primeIdealZetaSum E
  obtain ⟨b,up⟩ := primeIdealZetaSum_le_log_plus_bounded K
  obtain ⟨c,uq⟩ := primeIdealZetaSum_le_log_plus_bounded L
  have pos : ∀ᶠ s in 𝓝[>] (1:ℝ), 1<s := self_mem_nhdsWithin
  obtain ⟨s,hs,lo,hi,hj,big⟩ := (pos.and (low.and (up.and (uq.and
    (tendsto_log_one_div_sub_one_atTop.eventually_gt_atTop (6*a+6*C+3*b+2*c)))))).exists
  have aE := (degree_series E B s hs).mul_left 6
  have aK := (degree_series K B s hs).mul_left 3
  have aL := (degree_series L B s hs).mul_left 2
  have bound := hasSum_le (g := fun q:BigPrime B =>
      3*((Nat.card (𝓞 K →+* ZMod q.val.val):ℝ)*(q.val.val:ℝ)^(-s))+
      2*((Nat.card (𝓞 L →+* ZMod q.val.val):ℝ)*(q.val.val:ℝ)^(-s))) (fun q => by
        have n : (6:ℝ)*Nat.card (𝓞 E →+* ZMod q.val.val) ≤ 3*Nat.card (𝓞 K →+* ZMod q.val.val)+2*Nat.card (𝓞 L →+* ZMod q.val.val) := by exact_mod_cast no q.1.1 q.2 q.1.2
        linarith only [mul_le_mul_of_nonneg_right n (Real.rpow_nonneg (Nat.cast_nonneg (α:=ℝ) q.val.val) (-s))]) aE (aK.add aL)
  have add := primeIdealZetaSum_union_of_disjoint (S := Targets E B) (T := (Targets E B)ᶜ) disjoint_compl_right hs
  rw [union_compl_self] at add
  linarith [tail s hs,trimmed_le_univ K B s hs,trimmed_le_univ L B s hs]
end
end WeakDensity436


open NumberField
