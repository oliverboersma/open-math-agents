namespace CombinedOrder436
lemma cases_count {A S T : Type} [Finite A] [Finite S] [Finite T] (f:S→A) (g:T→A)
    (lifts : ∀ a, Nonempty (Fin 2 ↪ {b // f b=a}) ∨ Nonempty (Fin 3 ↪ {b // g b=a})) :
    6*Nat.card A ≤ 3*Nat.card S+2*Nat.card T := by
  classical
  letI := Fintype.ofFinite A
  letI := Fintype.ofFinite S
  letI := Fintype.ofFinite T
  have pt (a:A) : 6 ≤ 3*Fintype.card {b // f b=a}+2*Fintype.card {b // g b=a} := by
    rcases lifts a with i|i <;> have h := Fintype.card_le_of_embedding i.some <;> simp only [Fintype.card_fin] at h <;> omega
  have s : (∑ a, Fintype.card {b // f b=a}) = Fintype.card S :=
    Fintype.card_sigma.symm.trans (Fintype.card_congr (Equiv.sigmaFiberEquiv f))
  have t : (∑ a, Fintype.card {b // g b=a}) = Fintype.card T :=
    Fintype.card_sigma.symm.trans (Fintype.card_congr (Equiv.sigmaFiberEquiv g))
  have all := Finset.sum_le_sum (s:=Finset.univ) (fun a _ => pt a)
  simp only [Finset.sum_add_distrib,←Finset.mul_sum,Finset.sum_const,Finset.card_univ,nsmul_eq_mul,s,t] at all
  simpa only [Nat.card_eq_fintype_card,Nat.cast_id,Nat.mul_comm 6] using all

lemma lifts {A F:Type} [CommRing A] [Field F] {p:ℕ} [Fact p.Prime] [CharP F p]
    (σ:A≃+*A) (z u:A) (hu:σ u=u) (act:σ z=z*u) (n:ℕ)
    (R:Subalgebra ℤ A) (fixed:∀ x, x∈R ↔ σ x=x)
    (f:R→+*ZMod p) (φ:A→+*F) (hφ:∀ x:R, φ x=ZMod.castHom (m:=p) dvd_rfl F (f x))
    (rational:(φ z)^p=φ z) (nonzero:φ z≠0) (prim:IsPrimitiveRoot (φ u) n) :
    let S:=Algebra.adjoin ℤ ((R:Set A)∪{z})
    let inc:R≤S:=fun _ h => Algebra.subset_adjoin (Set.mem_union_left _ h)
    Nonempty (Fin n ↪ {g:S→+*ZMod p // g.comp (Subalgebra.inclusion inc).toRingHom=f}) := by
  classical
  dsimp only
  let S:=Algebra.adjoin ℤ ((R:Set A)∪{z})
  let inc:R≤S:=fun _ h => Algebra.subset_adjoin (Set.mem_union_left _ h)
  let j:=ZMod.castHom (m:=p) dvd_rfl F
  let ψ (i:Fin n) := φ.comp (σ^i.val).toRingHom
  have powfix (x:A) (hx:σ x=x) (l:ℕ) : (σ^l) x=x := by
    induction l with
    | zero => rfl
    | succ l ih => rw [pow_succ']; exact (congrArg σ ih).trans hx
  have powact (l:ℕ) : (σ^l) z=z*u^l := by
    induction l with
    | zero => simp
    | succ l ih =>
      rw [pow_succ']; change σ ((σ^l) z)=_
      rw [ih,map_mul,map_pow,hu,act,pow_succ]; ring
  have agree (i:Fin n) (x:R) : ψ i x=j (f x) := (congrArg φ (powfix x ((fixed x).mp x.2) i)).trans (hφ x)
  have zval (i:Fin n) : ψ i z=φ z*(φ u)^i.val := by change φ ((σ^i.val) z)=_; rw [powact,map_mul,map_pow]
  have uf : (φ u)^p=φ u := by
    let q : R := ⟨u,(fixed u).mpr hu⟩
    have eq : φ u=j (f q) := hφ q
    rw [eq,←map_pow,ZMod.pow_card]
  have rz : z∈S := Algebra.subset_adjoin (Set.mem_union_right _ (Set.mem_singleton _))
  have get (i:Fin n) : ∃ g:S→+*ZMod p, ∀ x:S, j (g x)=ψ i x := by
    let φ' := (frobenius F p).comp (ψ i)
    have le : S ≤ AlgHom.equalizer φ'.toIntAlgHom (ψ i).toIntAlgHom := by
      apply Algebra.adjoin_le_iff.mpr
      intro x hx
      change (ψ i x)^p=ψ i x
      rcases hx with h|h
      · have e := agree i ⟨x,h⟩
        change ψ i x=_ at e
        rw [e,←map_pow,ZMod.pow_card]
      · obtain rfl : x=z := Set.mem_singleton_iff.mp h
        rw [zval,mul_pow,rational,←pow_mul,Nat.mul_comm i.val p,pow_mul,uf]
    exact FixedOrder436.descend_hom ((ψ i).comp S.val.toRingHom) fun x => le x.2
  choose g hg using get
  have res (i:Fin n) : (g i).comp (Subalgebra.inclusion inc).toRingHom=f := by
    ext x
    exact j.injective ((hg i ⟨x,inc x.2⟩).trans (agree i x))
  refine ⟨⟨fun i => ⟨g i,res i⟩,?_⟩⟩
  intro i l eq
  have same := congrArg (fun h:{g:S→+*ZMod p // g.comp (Subalgebra.inclusion inc).toRingHom=f} => j (h.1 ⟨z,rz⟩)) eq
  change j (g i ⟨z,rz⟩)=j (g l ⟨z,rz⟩) at same
  rw [hg,hg] at same
  change ψ i z=ψ l z at same
  rw [zval,zval] at same
  exact Fin.ext (prim.pow_inj i.isLt l.isLt (mul_left_cancel₀ nonzero same))

end CombinedOrder436

namespace CombinedOrder436
lemma choose_prime (L:Type) [Field L] [NumberField L] (σ:(𝓞 L)≃+*(𝓞 L)) (z u:𝓞 L)
    (zu:σ z=z*u) (un:σ u=u) (zn:z≠0) (prim:IsPrimitiveRoot u 6) (B:ℕ) :
    ∃ p>B, p.Prime ∧ ∃ (F:Type) (_:Field F) (_:CharP F p) (φ:𝓞 L→+*F),
      (∀ x, σ x=x → (φ x)^p=φ x) ∧
      (φ (z^3))^p≠φ (z^3) ∧ (φ (z^2))^p≠φ (z^2) := by
  classical
  let R := AlgHom.equalizer σ.toRingHom.toIntAlgHom (AlgHom.id ℤ (𝓞 L))
  let S := Algebra.adjoin ℤ ((R:Set (𝓞 L))∪{z^3})
  let T := Algebra.adjoin ℤ ((R:Set (𝓞 L))∪{z^2})
  have fixed (x:𝓞 L) : x∈R ↔ σ x=x := Iff.rfl
  have iS : R≤S := fun _ h => Algebra.subset_adjoin (Set.mem_union_left _ h)
  have iT : R≤T := fun _ h => Algebra.subset_adjoin (Set.mem_union_left _ h)
  obtain ⟨E,_,_,b,hb⟩ := OrderCompare.maximal L R
  obtain ⟨K,_,_,c,hc⟩ := OrderCompare.maximal L S
  obtain ⟨J,_,_,d,hd⟩ := OrderCompare.maximal L T
  obtain ⟨a₂,ha₂⟩ := FixedOrder436.distinguish L (prim.pow_ne_one_of_pos_of_lt (by decide : 3≠0) (by decide))
  obtain ⟨a₃,ha₃⟩ := FixedOrder436.distinguish L (prim.pow_ne_one_of_pos_of_lt (by decide : 2≠0) (by decide))
  obtain ⟨a₀,ha₀⟩ := FixedOrder436.distinguish L zn
  obtain ⟨p,large,hp,counts⟩ := WeakDensity436.triple E K J (B+b+c+d+a₂+a₃+a₀)
  letI : Fact p.Prime := ⟨hp⟩
  obtain ⟨eR⟩ := hb p (by omega) hp
  obtain ⟨eS⟩ := hc p (by omega) hp
  obtain ⟨eT⟩ := hd p (by omega) hp
  rw [←Nat.card_congr eR,←Nat.card_congr eS,←Nat.card_congr eT] at counts
  letI := FixedOrder436.finite_hom E p
  letI := FixedOrder436.finite_hom K p
  letI := FixedOrder436.finite_hom J p
  letI : Finite (R→+*ZMod p) := Finite.of_equiv _ eR.symm
  letI : Finite (S→+*ZMod p) := Finite.of_equiv _ eS.symm
  letI : Finite (T→+*ZMod p) := Finite.of_equiv _ eT.symm
  refine ⟨p,by omega,hp,?_⟩
  by_contra bad
  apply counts.not_ge
  apply cases_count (fun g:S→+*ZMod p => g.comp (Subalgebra.inclusion iS).toRingHom)
    (fun g:T→+*ZMod p => g.comp (Subalgebra.inclusion iT).toRingHom)
  intro f
  obtain ⟨F,_,_,φ,hφ⟩ := FixedOrder436.lift_mod L R p f
  have fixφ (x:𝓞 L) (hx:σ x=x) : (φ x)^p=φ x := by
    have e := hφ ⟨x,(fixed x).mpr hx⟩
    change φ x=_ at e
    rw [e,←map_pow,ZMod.pow_card]
  have nz : φ z≠0 := by simpa only [map_zero] using ha₀ p (by omega) F φ
  have good (m n:ℕ) (hn:n.Prime) (hm:6=m*n) (ne:φ (u^m)≠φ 1) :
      IsPrimitiveRoot (φ (u^m)) n := by
    apply isPrimitiveRoot_of_mem_nthRootsFinset hn
    · apply (Polynomial.mem_nthRootsFinset hn.pos 1).mpr
      rw [←map_pow,←pow_mul,←hm,prim.pow_eq_one,map_one]
    · simpa only [map_one] using ne
  by_cases z₂ : (φ (z^3))^p=φ (z^3)
  · left
    exact lifts σ (z^3) (u^3) (by rw [map_pow,un]) (by rw [map_pow,zu,mul_pow]) 2 R fixed f φ hφ z₂
      (by rw [map_pow]; exact pow_ne_zero _ nz) (good 3 2 (by decide) rfl (ha₂ p (by omega) F φ))
  · have z₃ : (φ (z^2))^p=φ (z^2) := by
      by_contra hh
      exact bad ⟨F,inferInstance,inferInstance,φ,fixφ,z₂,hh⟩
    right
    exact lifts σ (z^2) (u^2) (by rw [map_pow,un]) (by rw [map_pow,zu,mul_pow]) 3 R fixed f φ hφ z₃
      (by rw [map_pow]; exact pow_ne_zero _ nz) (good 2 3 (by decide) rfl (ha₃ p (by omega) F φ))
end CombinedOrder436


open NumberField
lemma iterate_radical {R : Type} [CommRing R] (σ : R ≃+* R) (u : R) (hu : σ u=u)
    (r : R) (k : ℕ) (hr : σ r=r*u^k) (t : ℕ) :
    (σ : R → R)^[t] r=r*(u^t)^k := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Function.iterate_succ_apply',ih,map_mul,map_pow,map_pow,hu,hr,pow_succ,mul_pow]
    ring

lemma descend {p : ℕ} [Fact p.Prime] {F : Type} [Field F] [CharP F p]
    (y : F) (hy : y^p=y) : ∃ z : ZMod p, ZMod.castHom (m := p) dvd_rfl F z = y := by
  have h := (Subfield.mem_bot_iff_pow_eq_self F p).mpr hy
  rw [← ZMod.fieldRange_castHom_eq_bot p] at h
  exact h

theorem prescribe_sextic (v : ℕ → ℕ) (M B : ℕ) :
    ∃ p>B, p.Prime ∧ 6 ∣ p-1 ∧ ∃ u:ZMod p, IsPrimitiveRoot u 6 ∧
      ∀ q:ℕ, q.Prime → q≤M → (q:ZMod p)^((p-1)/6)=u^(v q) := by
  classical
  obtain ⟨Q,hL,hQ⟩ := Nat.exists_infinite_primes (M+1)
  let w (q:ℕ) : ℕ := if q=Q then 1 else v q
  let T := (Finset.range (Q+1)).filter Nat.Prime
  obtain ⟨L,_,_,_,_,σ,u,hu,hs,⟨m,hm,hit⟩,roots⟩ := Sextic436.lift_roots
    (fun i : T => i.val) (fun i => (Finset.mem_filter.mp i.property).2) Subtype.val_injective (fun i => w i.val)
  have haveRoot (q : ℕ) (hq : q.Prime) (h : q≤Q) :
      ∃ r : 𝓞 L, r^6=q ∧ σ r=r*u^(w q) :=
    roots ⟨q,Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega),hq⟩⟩
  obtain ⟨r0,r5,rs⟩ := haveRoot Q hQ le_rfl
  have rne : r0≠0 := by intro he; rw [he,zero_pow (by decide : 6≠0)] at r5; exact (Nat.cast_ne_zero.mpr hQ.ne_zero) r5.symm
  have w2 : w Q=1 := by simp [w]
  rw [w2,pow_one] at rs
  obtain ⟨p,hpB,hp,F,_,_,φ,fixed,moves₃,moves₂⟩ := CombinedOrder436.choose_prime L σ r0 u rs hs rne hu (max (max B Q) (m*m))
  letI : Fact p.Prime := ⟨hp⟩
  obtain ⟨t,hF⟩ := OrbitResidue.orbit σ m p hm hit (by omega) hp F φ fixed
  let j := ZMod.castHom (m := p) dvd_rfl F
  obtain ⟨z,hz⟩ := descend (φ u) (fixed u hs)
  change j z=φ u at hz
  have z5 : z^6=1 := j.injective (by simpa only [map_pow,hz,map_one] using congrArg φ hu.pow_eq_one)
  have force (b:ℕ) (moves:(φ (r0^b))^p≠φ (r0^b)) : (z^t)^b≠1 := by
    intro e
    apply moves
    have act : σ (r0^b)=(r0^b)*u^b := by rw [map_pow,rs,mul_pow]
    have hres := congrArg j e
    simp only [map_pow,hz,map_one] at hres
    rw [hF,iterate_radical σ u hs (r0^b) b act t,map_mul]
    simp only [map_pow,hres,mul_one]
  have zt5 : (z^t)^6=1 := by rw [←pow_mul,Nat.mul_comm,pow_mul,z5,one_pow]
  have prim : IsPrimitiveRoot (z^t) 6 := by
    have h₆ := orderOf_dvd_of_pow_eq_one zt5
    have h₂ : ¬orderOf (z^t) ∣ 2 := fun h => force 2 moves₂ (orderOf_dvd_iff_pow_eq_one.mp h)
    have h₃ : ¬orderOf (z^t) ∣ 3 := fun h => force 3 moves₃ (orderOf_dvd_iff_pow_eq_one.mp h)
    have cases (n:ℕ) (le:n≤6) : n∣6 → ¬n∣2 → ¬n∣3 → n=6 := by interval_cases n <;> decide
    rw [←cases _ (Nat.le_of_dvd (by decide : 0<6) h₆) h₆ h₂ h₃]
    exact IsPrimitiveRoot.orderOf _
  have zne : z^t ≠ 0 := by intro he; simp [he,(by decide : 6≠0)] at zt5
  have pd := prim.dvd_of_pow_eq_one (p-1) (ZMod.pow_card_sub_one_eq_one zne)
  refine ⟨p,by omega,hp,pd,z^t,prim,fun q hq hM => ?_⟩
  obtain ⟨r,rc,rσ⟩ := haveRoot q hq (by omega)
  have ec : (φ r)^6 = (q : F) := by simpa only [map_pow,map_natCast] using congrArg φ rc
  have en : (q : ZMod p) ≠ 0 := by
    intro he
    have := Nat.le_of_dvd hq.pos ((ZMod.natCast_eq_zero_iff _ _).mp he)
    omega
  have nz : φ r ≠ 0 := by
    intro er
    apply en
    apply j.injective
    simpa [er,(by decide : 6≠0)] using ec.symm
  have ep : (φ r)^(p-1) = ((φ u)^t)^(w q) := by
    apply mul_left_cancel₀ nz
    calc
      φ r*(φ r)^(p-1) = (φ r)^p := by rw [←pow_succ',Nat.sub_add_cancel hp.pos]
      _ = φ ((σ : 𝓞 L → 𝓞 L)^[t] r) := hF r
      _ = _ := by rw [iterate_radical σ u hs r (w q) rσ t,map_mul,map_pow,map_pow]
  apply j.injective
  simp only [map_pow,map_natCast,hz,← ec,← pow_mul,Nat.mul_div_cancel' pd,ep]
  all_goals simp [w,show q≠Q by omega]


lemma criterion (p k : ℕ) (hp : p.Prime) (hk : k ∣ p-1) (hk0 : 0<k)
    (a : ZMod p) (ha : a ≠ 0) : (∃ x : ZMod p, x^k=a) ↔ a^((p-1)/k)=1 := by
  letI : Fact p.Prime := ⟨hp⟩
  constructor
  · rintro ⟨x,rfl⟩
    have hx : x ≠ 0 := by rintro rfl; simp [hk0.ne'] at ha
    rw [← pow_mul,Nat.mul_div_cancel' hk]
    exact ZMod.pow_card_sub_one_eq_one hx
  · intro hz
    let b : (ZMod p)ˣ := Units.mk0 a ha
    obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
    obtain ⟨e,he⟩ := (mem_powers_iff_mem_zpowers.mpr (hg b) : b ∈ Submonoid.powers g)
    change g^e = b at he
    have hcard : orderOf g = p-1 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hg,Nat.card_eq_fintype_card,ZMod.card_units]
    have heq : g^(e*((p-1)/k))=1 := by
      rw [pow_mul,he]
      apply Units.ext
      exact hz
    have hd := orderOf_dvd_of_pow_eq_one heq
    rw [hcard] at hd
    let m := (p-1)/k
    have hprod : k*m=p-1 := Nat.mul_div_cancel' hk
    have hm : 0 < m := Nat.div_pos (Nat.le_of_dvd (by have := hp.one_lt; omega) hk) hk0
    have hd' : k*m ∣ e*m := hprod ▸ hd
    obtain ⟨j,hj⟩ := Nat.dvd_of_mul_dvd_mul_right hm hd'
    refine ⟨(g : ZMod p)^j,?_⟩
    rw [← pow_mul,Nat.mul_comm,← hj]
    exact congrArg (fun x : (ZMod p)ˣ => (x : ZMod p)) he


lemma eval_list {p : ℕ} (w : ℕ → ℕ) (u : ZMod p) (e : ℕ) (l : List ℕ)
    (h : ∀ q ∈ l, (q : ZMod p)^e = u^(w q)) :
    (l.prod : ZMod p)^e = u^(l.map w).sum := by
  induction l with
  | nil => simp
  | cons q l ih =>
    simp only [List.prod_cons,Nat.cast_mul,mul_pow,List.map_cons,List.sum_cons,pow_add]
    rw [h q (by simp),ih (fun x hx => h x (by simp [hx]))]


theorem solve : OMA.R_Erdos436_erdos_436_variants_six_two_R1_H2_R1.H2 := by
  intro B
  let w (q : ℕ) : ℕ := if q ∈ ([3,43,61] : List ℕ) then 0 else
    if q ∈ ([71,101,331,733,1423,4877,5413,6043] : List ℕ) then 4 else 5
  obtain ⟨p,hB,hp,h6,u,hu,hchar⟩ := prescribe_sextic w 202124 (max B 202124)
  letI : Fact p.Prime := ⟨hp⟩
  refine ⟨p,by omega,hp,fun n hn hN => ?_⟩
  have hnz : (n : ZMod p) ≠ 0 := by
    intro he
    have := Nat.le_of_dvd hn ((ZMod.natCast_eq_zero_iff _ _).mp he)
    omega
  let l := n.primeFactorsList
  have heval (e : ℕ) (z : ZMod p)
      (h : ∀ q : ℕ, q.Prime → q ≤ 202124 → (q : ZMod p)^e = z^(w q)) :
      (n : ZMod p)^e=z^(l.map w).sum := by
    rw [← Nat.prod_primeFactorsList (n := n) (by omega : n ≠ 0)] at ⊢
    change ((n.primeFactorsList.prod : ℕ) : ZMod p)^e = z^(l.map w).sum
    apply eval_list
    intro q hmem
    exact h q (Nat.prime_of_mem_primeFactorsList hmem)
      ((Nat.le_of_mem_primeFactors (Nat.mem_primeFactors_iff_mem_primeFactorsList.mpr hmem)).trans hN)
  have hx : (n:ZMod p)^((p-1)/6)=1 ↔ 6 ∣ (l.map w).sum := by
    rw [heval _ _ hchar,hu.pow_eq_one_iff_dvd]
  rw [Erdos436.IsPowerResidue,and_iff_right hnz,criterion p 6 hp h6 (by decide) _ hnz,hx,
    ← ZMod.natCast_eq_zero_iff]
  let f (q : ℕ) : ZMod 6 := if q ∈ ([3,43,61] : List ℕ) then 0 else
    if q ∈ ([71,101,331,733,1423,4877,5413,6043] : List ℕ) then 4 else 5
  suffices eqsum : ∀ t : List ℕ, ((t.map w).sum : ZMod 6) = (t.map f).sum by
    rw [eqsum]
  intro t
  induction t with
  | nil => rfl
  | cons q l ih =>
    simp only [List.map_cons,List.sum_cons,Nat.cast_add]
    rw [ih]
    congr 1
    unfold w f
    split_ifs <;> norm_num

