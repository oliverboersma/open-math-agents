namespace PrimeKummer436

lemma prime_independence {k : ℕ} [Fact k.Prime] {I F : Type} [Fintype I] [Field F] [CharZero F] [FiniteDimensional ℚ F]
    (hdeg : Module.finrank ℚ F < k) (p : I → ℕ) (hinj : Function.Injective p) (hp : ∀ i, (p i).Prime)
    (a : I → ZMod k) (x : F) (h : x^k = ∏ i, (p i : F)^(a i).val) : a = 0 := by
  classical
  have hk := (Fact.out : k.Prime)
  let N : ℕ := ∏ i, p i ^ (a i).val
  have eqn : x^k = algebraMap ℚ F (N : ℚ) := by simpa [N] using h
  have eq' := congrArg (Algebra.norm ℚ) eqn
  simp only [map_pow,Algebra.norm_algebraMap] at eq'
  funext i
  haveI : Fact (p i).Prime := ⟨hp i⟩
  have fac : N.factorization (p i) = (a i).val := by
    unfold N
    rw [Nat.factorization_prod_apply (fun j _ => pow_ne_zero _ (hp j).ne_zero)]
    rw [Finset.sum_eq_single i]
    · exact Nat.factorization_pow_self (hp i)
    · intro j _ hj
      rw [(hp j).factorization_pow,Finsupp.single_eq_of_ne (fun he => hj (hinj he.symm))]
    · simp
  have hv := congrArg (padicValRat (p i)) eq'
  simp only [padicValRat.pow,← padicValRat_of_nat] at hv
  rw [← Nat.factorization_def N (hp i),fac] at hv
  have degpos := Module.finrank_pos (R := ℚ) (M := F)
  have av := (a i).val_lt
  have eq0 : (a i).val = 0 := by
    have hv' : (k : ℤ) * padicValRat (p i) (Algebra.norm ℚ x) = (Module.finrank ℚ F : ℤ) * ((a i).val : ℤ) := hv
    have hd : (k : ℤ) ∣ (Module.finrank ℚ F : ℤ) * ((a i).val : ℤ) := ⟨_,hv'.symm⟩
    have hdN : k ∣ Module.finrank ℚ F * (a i).val := by exact_mod_cast hd
    rcases hk.dvd_mul.mp hdN with d|d
    · exact False.elim (hdeg.not_ge (Nat.le_of_dvd degpos d))
    · by_contra nz
      exact av.not_ge (Nat.le_of_dvd (Nat.pos_of_ne_zero nz) d)
  exact ZMod.val_injective k (by simpa using eq0)

lemma prescribe {k : ℕ} [Fact k.Prime] {I F E : Type} [Fintype I] [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] (z : F) (hz : IsPrimitiveRoot z k)
    (b : I → F) (r : I → E) (hr : ∀ i, (r i)^k = algebraMap F E (b i)) (hne : ∀ i, r i ≠ 0)
    (hind : ∀ (a : I → ZMod k) (x : F), x^k = ∏ i, (b i)^(a i).val → a=0)
    (v : I → ZMod k) : ∃ σ : E ≃ₐ[F] E, ∀ i, σ (r i) = r i * (algebraMap F E z)^(v i).val := by
  classical
  have hk := (Fact.out : k.Prime)
  let u := algebraMap F E z
  have hu : IsPrimitiveRoot u k := hz.map_of_injective (algebraMap F E).injective
  have fixed (σ : E ≃ₐ[F] E) : σ u = u := σ.commutes z
  let S : AddSubmonoid (I → ZMod k) := {
    carrier := {a | ∃ σ : E ≃ₐ[F] E, ∀ i, σ (r i) = r i * u^(a i).val}
    zero_mem' := ⟨AlgEquiv.refl,fun i => by simp⟩
    add_mem' := by
      rintro a b ⟨σ,hσ⟩ ⟨τ,hτ⟩
      refine ⟨τ.trans σ,fun i => ?_⟩
      simp only [AlgEquiv.trans_apply,hτ,map_mul,map_pow,hσ,fixed,Pi.add_apply,ZMod.val_add]
      have cyc (n : ℕ) : u^(n%k) = u^n := hu.eq_orderOf ▸ pow_mod_orderOf u n
      rw [cyc,pow_add,mul_assoc] }
  let W : Submodule (ZMod k) (I → ZMod k) := {
    S with
    smul_mem' := fun c a ha => by
      change c • a ∈ S
      have h := S.nsmul_mem ha c.val
      simpa only [← Nat.cast_smul_eq_nsmul (ZMod k),ZMod.natCast_zmod_val] using h }
  suffices W = ⊤ from (show v ∈ W by rw [this]; trivial)
  by_contra hproper
  obtain ⟨g,hg,hker⟩ := W.exists_le_ker_of_lt_top (lt_top_iff_ne_top.mpr hproper)
  let a (i : I) := g (Pi.single i 1)
  have repr (t : I → ZMod k) : g t = ∑ i, t i * a i := by
    have eqv : t = ∑ i, t i • Pi.single i (1 : ZMod k) := by
      funext j
      simp [Finset.sum_apply,Pi.single_apply,ite_mul,mul_ite]
    conv_lhs => rw [eqv]
    simp [a]
  let w := ∏ i, (r i)^(a i).val
  have invari (σ : E ≃ₐ[F] E) : σ w = w := by
    have character (i : I) : ∃ c : ZMod k, σ (r i) = r i*u^c.val := by
      have root : (σ (r i)/r i)^k = 1 := by
        rw [div_pow,← map_pow,hr,σ.commutes,div_self]
        exact (hr i ▸ pow_ne_zero k (hne i))
      obtain ⟨j,hj,he⟩ := hu.eq_pow_of_pow_eq_one root
      refine ⟨j,?_⟩
      rw [ZMod.val_natCast,Nat.mod_eq_of_lt hj]
      exact (div_eq_iff (hne i)).mp he.symm |>.trans (mul_comm ..)
    choose c hc using character
    have hcW : c ∈ W := ⟨σ,hc⟩
    have eqz : ∑ i, c i * a i = 0 := (repr c).symm.trans (hker hcW)
    have hd : k ∣ ∑ i, (c i).val * (a i).val := (ZMod.natCast_eq_zero_iff ..).mp (by simpa using eqz)
    change σ (∏ i, (r i)^(a i).val) = _
    simp only [map_prod,map_pow,hc,mul_pow,Finset.prod_mul_distrib,← pow_mul,Finset.prod_pow_eq_pow_sum]
    rw [hu.pow_eq_one_iff_dvd _ |>.mpr hd,mul_one]
  obtain ⟨x,hx⟩ := (IsGalois.mem_range_algebraMap_iff_fixed w).mpr invari
  have hx3 : x^k = ∏ i, b i ^ (a i).val := (algebraMap F E).injective (by
    rw [map_pow,hx,map_prod]
    change (∏ i, (r i)^(a i).val)^k = _
    rw [← Finset.prod_pow]
    apply Finset.prod_congr rfl
    intro i _
    rw [← pow_mul,Nat.mul_comm,pow_mul,hr,map_pow])
  have zero := hind a x hx3
  apply hg
  apply LinearMap.ext
  intro t
  simp [repr t,zero]

end PrimeKummer436

open NumberField
namespace QuadraticPrescribe436

lemma square_descends {F : Type} [Field F] [CharZero F] [FiniteDimensional ℚ F]
    (two : Module.finrank ℚ F=2) (z:F) (D:ℕ) (hD:0<D) (hz : z^2=-(D:F))
    (N:ℕ) (x:F) (hx : x^2=N) : ∃ r : ℚ, (algebraMap ℚ F) r=x := by
  classical
  let e : F →ₐ[ℚ] ℂ := IsAlgClosed.lift
  let j := IsScalarTower.toAlgHom ℚ ℝ ℂ
  let T := j.fieldRange.comap e
  have proper : T≠⊤ := by
    intro eq
    have mem : z∈T := eq ▸ IntermediateField.mem_top
    obtain ⟨r,hr⟩ := (show ∃ r:ℝ, j r=e z from mem)
    have neg : r^2=-(D:ℝ) := j.injective (calc
      j (r^2) = (j r)^2 := map_pow ..
      _ = (e z)^2 := congrArg (fun w:ℂ => w^2) hr
      _ = e (z^2) := (map_pow ..).symm
      _ = j (-(D:ℝ)) := by rw [hz,map_neg,map_neg,map_natCast,map_natCast])
    have pos : (0:ℝ)<D := by exact_mod_cast hD
    nlinarith [sq_nonneg r]
  have bot := ((IntermediateField.isSimpleOrder_of_finrank_prime ℚ F (two ▸ Nat.prime_two)).eq_bot_or_eq_top T).resolve_right proper
  have mem : x∈T := by
    let r := Real.sqrt (N:ℝ)
    have sq : r^2=(N:ℝ) := Real.sq_sqrt (Nat.cast_nonneg _)
    have same : (e x)^2=(j r)^2 := by rw [←map_pow,hx,←map_pow,sq,map_natCast,map_natCast]
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp same with h|h
    · exact ⟨r,h.symm⟩
    · exact ⟨-r,(map_neg j r).trans h.symm⟩
  exact IntermediateField.mem_bot.mp (bot ▸ mem)

end QuadraticPrescribe436


namespace Sextic436
open QuadraticPrescribe436 Polynomial
lemma prescribe {I F E : Type} [Fintype I] [Field F] [CharZero F] [FiniteDimensional ℚ F]
    [Field E] [Algebra F E] [FiniteDimensional F E] [IsGalois F E]
    (deg : Module.finrank ℚ F=2) (z:F) (prim:IsPrimitiveRoot z 6) (p:I→ℕ)
    (hp:∀ i,(p i).Prime) (inj:Function.Injective p) (r:I→E)
    (hr:∀ i,(r i)^6=(p i:E)) (rn:∀ i, r i≠0) (v:I→ℕ) :
    ∃ σ : E ≃ₐ[F] E, ∀ i, σ (r i)=r i * (algebraMap F E z)^(v i) := by
  classical
  let u := algebraMap F E z
  have hu : IsPrimitiveRoot u 6 := prim.map_of_injective (algebraMap F E).injective
  have cyc : z^2-z+1=0 := by simpa [Polynomial.IsRoot.def,cyclotomic_six] using (isRoot_cyclotomic_iff.mpr prim)
  have neg : (2*z-1)^2=-(3:F) := by linear_combination 4*cyc
  have use₂ : ∃ σ:E≃ₐ[F]E, ∀ i, σ ((r i)^3)=(r i)^3*(u^3)^(v i) := by
    obtain ⟨σ,hσ⟩ := PrimeKummer436.prescribe (z^3) (prim.pow (by decide) (show 6=3*2 by decide))
      (fun i => (p i:F)) (fun i => (r i)^3) (fun i => by rw [←pow_mul]; simpa using hr i)
      (fun i => pow_ne_zero _ (rn i)) (fun b x ex => by
        let N:=∏ i,p i^(b i).val
        obtain ⟨y,hy⟩ := square_descends deg (2*z-1) 3 (by decide) neg N x (by simpa [N] using ex)
        apply PrimeKummer436.prime_independence (F:=ℚ) (by simp) p inj hp b y
        apply (algebraMap ℚ F).injective
        simpa only [map_pow,map_prod,map_natCast,hy] using ex) (fun i => (v i:ZMod 2))
    have hu' : IsPrimitiveRoot (u^3) 2 := hu.pow (by decide) (show 6=3*2 by decide)
    exact ⟨σ,fun i => by simpa only [map_pow,ZMod.val_natCast,hu'.eq_orderOf,u,pow_mod_orderOf] using hσ i⟩
  have use₃ : ∃ σ:E≃ₐ[F]E, ∀ i, σ ((r i)^2)=(r i)^2*(u^2)^(v i) := by
    obtain ⟨σ,hσ⟩ := PrimeKummer436.prescribe (z^2) (prim.pow (by decide) (show 6=2*3 by decide))
      (fun i => (p i:F)) (fun i => (r i)^2) (fun i => by rw [←pow_mul]; simpa using hr i)
      (fun i => pow_ne_zero _ (rn i)) (PrimeKummer436.prime_independence (by omega : Module.finrank ℚ F<3) p inj hp) (fun i => (v i:ZMod 3))
    have hu' : IsPrimitiveRoot (u^2) 3 := hu.pow (by decide) (show 6=2*3 by decide)
    exact ⟨σ,fun i => by simpa only [map_pow,ZMod.val_natCast,hu'.eq_orderOf,u,pow_mod_orderOf] using hσ i⟩
  have power (σ:E≃ₐ[F]E) (i:I) (b:ℕ) (act:σ ((r i)^b)=(r i)^b*(u^b)^(v i)) :
      (σ^b) (r i)=r i*(u^b)^(v i) := by
    have e : (σ (r i)/r i)^6=1 := by
      rw [div_pow,←map_pow,hr,map_natCast,div_self]; exact hr i ▸ pow_ne_zero 6 (rn i)
    obtain ⟨l,_,hl⟩ := hu.eq_pow_of_pow_eq_one e
    have h : σ (r i)=r i*u^l := ((div_eq_iff (rn i)).mp hl.symm).trans (mul_comm ..)
    have it (k:ℕ) : (σ^k) (r i)=r i*(u^l)^k := by
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ']; change σ ((σ^k) (r i))=_
        rw [ih,map_mul,map_pow,map_pow,show σ u=u from σ.commutes z,h,pow_succ]; ring
    have eq : (u^l)^b=(u^b)^(v i) := mul_left_cancel₀ (pow_ne_zero b (rn i)) (by simpa only [map_pow,h,mul_pow] using act)
    rw [it,eq]
  obtain ⟨σ,hσ⟩ := use₂
  obtain ⟨τ,hτ⟩ := use₃
  let a:=σ^3
  let b:=τ^2
  refine ⟨(a.trans b).trans b,fun i => ?_⟩
  have ha : a (r i)=r i*(u^3)^(v i):=power σ i 3 (hσ i)
  have hb : b (r i)=r i*(u^2)^(v i):=power τ i 2 (hτ i)
  simp only [AlgEquiv.trans_apply,ha,map_mul,map_pow,hb,show b u=u from b.commutes z]
  have eq : (u^2)^(v i)*(u^2)^(v i)*(u^3)^(v i)=u^(v i) := by
    rw [←mul_pow,←mul_pow,←pow_add,←pow_add,show 2+2+3=6+1 by decide,pow_add,hu.pow_eq_one,one_mul,pow_one]
  linear_combination (r i)*eq
end Sextic436


