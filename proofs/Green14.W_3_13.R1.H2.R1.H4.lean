import OMAReductions.R_Green14_W_3_13_R1_H2_R1

/-!
# A blue endpoint obstruction in a medium central gap

If neither endpoint completes a blue thirteen-term progression, extending an avoiding interior by two blue endpoints gives an avoiding coloring of the full interval. A certificate rules this out.

When only two positions can meet a progression, the blue branch immediately forces the other position red. Several exact singleton intersections from one count are checked consecutively against the updated board. The packed coverage test adapts the W(3,12) proof in PR 3245. The partitioned search follows the large-gap certificate in PR 5141.
-/

namespace OMA.MediumTwoBlue

private def NoTriple (R : Nat → Prop) :=
  ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

private lemma distinct_terms {R : Nat → Prop} (hn : NoTriple R) {u v w : Nat}
    (hu : R u) (hv : R v) (hw : R w) (he : u+w=2*v) (hne : u ≠ w) : False := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact hn u (v-u) (by omega) hu (by simpa only [show u+(v-u)=v by omega] using hv)
      (by simpa only [show u+2*(v-u)=w by omega] using hw)
  · exact hn w (v-w) (by omega) hw (by simpa only [show w+(v-w)=v by omega] using hv)
      (by simpa only [show w+2*(v-w)=u by omega] using hu)

-- Four views of the chosen red positions give every forbidden third point
-- by shifts. The last two views compress even and odd positions separately.
private structure Marks where
  rev : Nat
  dbl : Nat
  ev : Nat
  od : Nat
  deriving DecidableEq

private def mark (q : Nat) : Marks :=
  ⟨1 <<< (5*(159-q)), 1 <<< (10*q),
    if q%2=0 then 1 <<< (5*(q/2)) else 0,
    if q%2=1 then 1 <<< (5*(q/2)) else 0⟩

private def join (s t : Marks) : Marks :=
  ⟨s.rev ||| t.rev, s.dbl ||| t.dbl, s.ev ||| t.ev, s.od ||| t.od⟩

private def forbidden (s : Marks) (p : Nat) : Nat :=
  ((s.rev <<< (10*p)) >>> 795) ||| (s.dbl >>> (5*p)) |||
    ((if p%2=0 then s.ev else s.od) <<< (5*((p+1)/2)))

private def Good (R : Nat → Prop) (s : Marks) :=
  ∀ p t, R p → R t → t ≠ p → (forbidden s p).testBit (5*t) = false

private lemma mark_good {R : Nat → Prop} (hn : NoTriple R)
    {q : Nat} (hq : R q) (hq' : q ≤ 159) : Good R (mark q) := by
  intro p t hp ht hne
  have h₁ : t+q ≠ 2*p := fun he =>
    distinct_terms hn ht hp hq he (by rintro rfl; omega)
  have h₂ : t+p ≠ 2*q := fun he => distinct_terms hn ht hq hp he hne
  have h₃ : p+q ≠ 2*t := fun he =>
    distinct_terms hn hp ht hq he (by rintro rfl; omega)
  have single (x i : Nat) : (1 <<< x : Nat).testBit i = decide (x=i) := by
    rw [Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow]
  unfold forbidden mark
  split_ifs <;> simp only [Nat.testBit_or, Nat.testBit_shiftRight, single,
    Nat.testBit_shiftLeft, Nat.zero_testBit, Bool.or_eq_false_iff,
    Bool.and_eq_false_imp, decide_eq_true_eq, decide_eq_false_iff_not]
  all_goals (repeat' apply And.intro) <;> intros <;> first | trivial | omega

private lemma join_good {R : Nat → Prop} {s u : Marks} (hs : Good R s) (hu : Good R u) :
    Good R (join s u) := by
  intro p t hp ht hn
  have h₁ := hs p t hp ht hn
  have h₂ := hu p t hp ht hn
  unfold forbidden at *
  unfold join
  split_ifs at * <;> simp_all [Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]

private def addRed (s : Marks) (a p : Nat) : Marks × Nat :=
  let bad := forbidden s p
  (join s (mark p), (a ^^^ (a &&& bad)) ||| (1 <<< (5*p)))

private def Bad (hit : (Nat → Prop) → Prop) (seed : Marks × Nat) :=
  ∀ R : Nat → Prop, (∀ x, R x → x ≤ 159) → NoTriple R → hit R →
    Good R seed.1 → (∀ x, R x → seed.2.testBit (5*x) = true) → False

private lemma add_safe {R : Nat → Prop} {s : Marks} {a p : Nat} (hs : Good R s)
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : R p) :
    ∀ x, R x → (addRed s a p).2.testBit (5*x) = true := by
  intro x hx
  by_cases he : x = p
  · simp [addRed, he, Nat.shiftLeft_eq]
  · simp [addRed, Nat.testBit_xor, ha x hx, hs p x hp hx he]

private def bluePattern (a d : Nat) : Nat :=
  (List.range 13).foldr (fun t m => (1 <<< (5*(a+t*d))) ||| m) 0

private def base (d : Nat) := Nat.land (Nat.shiftRight  (Nat.mul 800 d)) 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

private def pattern (i : Nat) : Nat :=
  let a := i % 160
  let d := i / 160 + 1
  if a + 12*d < 160 then base d <<< (5*a) else base 1

private def Hits (R : Nat → Prop) := ∀ i, ∃ t, (pattern i).testBit (5*t) = true ∧ R t

private def erase (a p : Nat) := Nat.xor a (Nat.shiftLeft 1 (Nat.mul 5 p))

private lemma erase_safe {R : Nat → Prop} {a p : Nat}
    (ha : ∀ x, R x → a.testBit (5*x) = true) (hp : ¬R p) :
    ∀ x, R x → (erase a p).testBit (5*x) = true := by
  intro t ht
  have hne : p ≠ t := fun he => hp (he ▸ ht)
  simp [erase, Nat.testBit_xor, ha t ht, Nat.shiftLeft_eq, hne]


private abbrev State := Marks × Nat
private def Closed (s : State) := Bad Hits s

-- A separated base-32 board lets one multiplication count the possible red
-- entries in every thirteen-term progression.  The counts guide the search.
-- Every claimed empty or singleton progression is checked on the original board.
private def spread (x : Nat) : Nat :=
  let x := (x ||| (x <<< 1024)) &&& 
  let x := (x ||| (x <<< 512)) &&& 
  let x := (x ||| (x <<< 256)) &&& 
  let x := (x ||| (x <<< 128)) &&& 
  let x := (x ||| (x <<< 64)) &&& 
  let x := (x ||| (x <<< 32)) &&& 
  let x := (x ||| (x <<< 16)) &&& 
  let x := (x ||| (x <<< 8)) &&& 
  let x := (x ||| (x <<< 4)) &&& 
  x

private def pointIndex (x : Nat) : Nat :=
  let key := Nat.mod (Nat.xor x (Nat.sub x 1)) 163
  Nat.land (Nat.shiftRight  (Nat.mul 8 key)) 255

private def endIndex (x : Nat) : Nat :=
  let key := Nat.mod (Nat.xor x (Nat.sub x 1)) 2083
  Nat.land (Nat.shiftRight  (Nat.mul 12 key)) 4095

private def convolution : Nat := 

private def slots : Nat := 

private def high : Nat := slots <<< 4
private def fieldMask : Nat := slots * 31

private def slotAt (highBit : Nat) : Nat :=
  let i := endIndex highBit
  let d := Nat.succ (Nat.div i 160)
  Nat.sub i (Nat.mul 12 d)

private def tight (deficit live k : Nat) : Nat → Nat
  | 0 => 0
  | fuel+1 =>
    let marks := Nat.land (Nat.add deficit (Nat.mul k slots)) live
    bif Nat.beq marks 0 then tight deficit live (Nat.succ k) fuel else slotAt marks

private abbrev Board := State × Nat
private def Left (s : Board) (p : Nat) : Board :=
  (addRed s.1.1 s.1.2 p, Nat.xor s.2 (Nat.land s.2 (Nat.shiftLeft (Nat.shiftLeft convolution 4) (Nat.mul 5 p))))
private def Right (s : Board) (p : Nat) : Board := ((s.1.1, erase s.1.2 p), s.2)
private def Sealed (s : Board) := Closed s.1
private def Facts (l : List Board) := ∀ s ∈ l, Sealed s
private lemma emptyFacts : Facts [] := by simp [Facts]
private lemma consFacts {s : Board} {l : List Board} (hs : Sealed s) (hl : Facts l) :
    Facts (s :: l) := by
  intro t ht
  rcases List.mem_cons.mp ht with rfl | h
  · exact hs
  · exact hl t h

private def upperPoint (x : Nat) : Nat :=
  let x := Nat.lor x (Nat.shiftRight x 5)
  let x := Nat.lor x (Nat.shiftRight x 10)
  let x := Nat.lor x (Nat.shiftRight x 20)
  let x := Nat.lor x (Nat.shiftRight x 40)
  let x := Nat.lor x (Nat.shiftRight x 80)
  let x := Nat.lor x (Nat.shiftRight x 160)
  let x := Nat.lor x (Nat.shiftRight x 320)
  let x := Nat.lor x (Nat.shiftRight x 640)
  pointIndex (Nat.xor x (Nat.shiftRight x 5))

private def select (s : Board) : Bool × Nat :=
  let deficit := Nat.sub high (Nat.land (Nat.mul s.1.2 convolution) fieldMask)
  let empty := Nat.land deficit s.2
  bif Nat.beq empty 0 then
    let units := Nat.land (Nat.add deficit slots) s.2
    bif Nat.beq units 0 then (false, tight deficit s.2 2 12) else (true, units)
  else (true, empty)

private def prefer (rest lo : Nat) : Nat :=
  bif Nat.ble (Nat.shiftLeft 1 (Nat.mul 5 (Nat.sub 159 lo))) rest then lo else upperPoint rest

private def atCut (mask trail : Nat) (cuts : List (Nat × Board)) (s : Board) : Bool :=
  if mask = 0 then false else
    mask.testBit (trail % 256) && (cuts.lookup trail == some s)

private lemma lookup_mem {trail : Nat} {cuts : List (Nat × Board)} {s : Board}
    (h : cuts.lookup trail = some s) : s ∈ cuts.map Prod.snd := by
  induction cuts with
  | nil => simp at h
  | cons p rest ih =>
    rcases p with ⟨k, v⟩
    simp only [List.lookup_cons] at h
    split at h
    · cases h
      exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (ih h)

private lemma cut_sound {mask trail : Nat} {cuts : List (Nat × Board)} {s : Board}
    (hc : atCut mask trail cuts s = true) (facts : Facts (cuts.map Prod.snd)) : Sealed s := by
  unfold atCut at hc
  split at hc
  · contradiction
  · have eqn : cuts.lookup trail = some s := beq_iff_eq.mp (Bool.and_eq_true_iff.mp hc).2
    exact facts s (lookup_mem eqn)

private lemma singleton_red {R : Nat → Prop} {p t m a : Nat}
    (ht : R t) (hm : m.testBit (5*t) = true) (ha : a.testBit (5*t) = true)
    (hs : m &&& a = 1 <<< (5*p)) : R p := by
  have h : (m &&& a).testBit (5*t) = true := by simp [hm, ha]
  rw [hs, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at h
  have e : t = p := by have := of_decide_eq_true h; omega
  exact e ▸ ht

private def consume (pending : Nat) (finish : Board → Bool) : Nat → Board → Bool
  | 0, s => finish s
  | steps+1, s =>
    let active := Nat.land pending s.2
    if active = 0 then finish s else
      let pat := pattern (slotAt active)
      let rest := Nat.land pat s.1.2
      if rest = 0 then true else
        let p := pointIndex rest
        if rest = 1 <<< (5*p) then consume active finish steps (Left s p) else false

private lemma consume_sound (pending : Nat) (finish : Board → Bool)
    (hfinish : ∀ s, finish s = true → Sealed s) (steps : Nat) (s : Board)
    (h : consume pending finish steps s = true) : Sealed s := by
  induction steps generalizing pending s with
  | zero => exact hfinish _ h
  | succ steps ih =>
    simp only [consume] at h
    split at h
    · exact hfinish _ h
    · let active := Nat.land pending s.2
      let k := slotAt active
      let pat := pattern k
      let rest := Nat.land pat s.1.2
      let p := pointIndex rest
      intro R bound hn hit hs ha
      obtain ⟨t, hbit, ht⟩ := hit k
      split at h
      · rename_i hz
        have truth : rest.testBit (5*t) = true := by
          change (pattern k &&& s.1.2).testBit (5*t) = true
          simp [hbit, ha t ht]
        change rest = 0 at hz
        simp [hz] at truth
      · split at h
        · rename_i single
          change pat &&& s.1.2 = 1 <<< (5*p) at single
          have hp := singleton_red ht hbit (ha t ht) single
          exact ih _ _ h R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · contradiction

private def visit (mask : Nat) (cuts : List (Nat × Board)) : Nat → Nat → Board → Bool
  | 0, _, _ => false
  | fuel+1, trail, s =>
    if atCut mask trail cuts s then true else
      let choice := select s
      if choice.1 then
        consume choice.2 (fun v => visit mask cuts fuel (trail*2) v) 4 s
      else
        let pat := pattern choice.2
        let rest := Nat.land pat s.1.2
        let p := prefer rest (pointIndex rest)
        let blue := Right s p
        let others := Nat.land pat blue.1.2
        let q := pointIndex others
        visit mask cuts fuel (trail*2) (Left s p) &&
          (if others = 1 <<< (5*q) then visit mask cuts fuel (trail*2+1) (Left blue q)
           else visit mask cuts fuel (trail*2+1) blue)

private lemma visit_sound (mask : Nat) (cuts : List (Nat × Board)) (facts : Facts (cuts.map Prod.snd))
    (fuel trail : Nat) (s : Board) (hw : visit mask cuts fuel trail s = true) : Sealed s := by
  induction fuel generalizing trail s with
  | zero => simp [visit] at hw
  | succ fuel ih =>
    simp only [visit] at hw
    split at hw
    · exact cut_sound (by assumption) facts
    · split at hw
      · exact consume_sound _ _ (fun v hv => ih (trail*2) v hv) _ _ hw
      · obtain ⟨left,right⟩ := Bool.and_eq_true_iff.mp hw
        let k := (select s).2
        let pat := pattern k
        let rest := Nat.land pat s.1.2
        let p := prefer rest (pointIndex rest)
        intro R bound hn hit hs ha
        by_cases hp : R p
        · exact ih _ _ left R bound hn hit (join_good hs (mark_good hn hp (bound _ hp))) (add_safe hs ha hp)
        · let blue := Right s p
          have kept : ∀ x, R x → blue.1.2.testBit (5*x) = true := erase_safe ha hp
          split at right
          · rename_i single
            let q := pointIndex (Nat.land pat blue.1.2)
            change pat &&& blue.1.2 = 1 <<< (5*q) at single
            obtain ⟨t, hbit, ht⟩ := hit k
            have hq := singleton_red ht hbit (kept t ht) single
            exact ih _ _ right R bound hn hit (join_good hs (mark_good hn hq (bound _ hq))) (add_safe hs kept hq)
          · exact ih _ _ right R bound hn hit hs kept

private lemma certify {s : Board} (mask : Nat) (cuts : List (Nat × Board))
    (h : visit mask cuts 150 1 s = true) (facts : Facts (cuts.map Prod.snd)) : Sealed s :=
  visit_sound mask cuts facts 150 1 s h

private def seed (rev dbl ev od allow red : Nat) : Board :=
  ((⟨spread rev, spread dbl, spread ev, spread od⟩, spread allow), ((high - ((spread red * convolution) &&& fieldMask)) &&& high))

private lemma pattern_has {t : ℕ} (ht : t < 13) (a d : ℕ) :
    (bluePattern a d).testBit (5*(a+t*d)) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs → (xs.foldr (fun i m : ℕ => (1 <<< (5*(a+i*d))) ||| m) 0).testBit (5*(a+t*d)) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq]
    · simp [ih h]

private lemma base_correct : ∀ d : Fin 14, base d.val = bluePattern 0 d.val := by decide +kernel

private lemma all_hit_of_cover {R : ℕ → Prop}
    (cover : ∀ a d : ℕ, 0 < d → a + 12*d < 160 → ∃ t : Fin 13, R (a+t.val*d)) :
    Hits R := by
  have shifted (a d : ℕ) (hd : 0 < d) (bound : a + 12*d < 160) :
      ∃ x, ((base d) <<< (5*a)).testBit (5*x) = true ∧ R x := by
    obtain ⟨t, ht⟩ := cover a d hd bound
    refine ⟨a+t.val*d, ?_, ht⟩
    rw [base_correct ⟨d, by omega⟩]
    simpa [Nat.mul_add, Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has t.isLt 0 d
  intro i
  dsimp only [pattern]
  split
  · exact shifted _ _ (by omega) (by assumption)
  · simpa using shifted 0 1 (by decide) (by decide)

private def initialAllowed : Nat := 0x421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084000002108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108420

private lemma blue_endpoint_of_certificate (cert : Closed (mark 77, initialAllowed)) :
    OMA.R_Green14_W_3_13_R1_H2_R1.H4 := by
  intro c anchor gap avoid
  by_contra neither
  let R (x : ℕ) : Prop := 0 < x ∧ x < 159 ∧ c x = true
  have red : R 77 := ⟨by decide, by decide, anchor⟩
  have hn : NoTriple R := by
    intro a d hd ha hm he
    obtain ⟨t, ht, wrong⟩ := avoid true a d ha.1 hd he.2.1
    change t.val ≤ 2 at ht
    have any : t.val = 0 ∨ t.val = 1 ∨ t.val = 2 := by omega
    apply wrong
    rcases any with h | h | h
    · simpa only [h, zero_mul, Nat.add_zero] using ha.2.2
    · simpa only [h, one_mul] using hm.2.2
    · simpa only [h] using he.2.2
  have cover (a d : ℕ) (hd : 0 < d) (hb : a+12*d < 160) :
      ∃ t : Fin 13, R (a+t.val*d) := by
    by_contra miss
    have blue (t : Fin 13) (lo : 0 < a+t.val*d) (hi : a+t.val*d < 159) :
        c (a+t.val*d) = false := by
      cases eqn : c (a+t.val*d) with
      | false => rfl
      | true => exact (miss ⟨t, by exact ⟨lo,hi,eqn⟩⟩).elim
    by_cases hz : a = 0
    · subst a
      have bound : 12*d < 159 := by omega
      apply neither
      refine Or.inl ⟨d,hd,bound,?_⟩
      intro t ht ht'
      have hi := Nat.mul_le_mul_right d ht'
      have lo := Nat.mul_pos ht hd
      simpa only [Nat.zero_add] using blue t (by omega) (by omega)
    · by_cases small : a+12*d < 159
      · obtain ⟨t,ht,wrong⟩ := avoid false a d (by omega) hd small
        change t.val ≤ 12 at ht
        have hi := Nat.mul_le_mul_right d ht
        exact wrong (blue t (by omega) (by omega))
      · have last : a+12*d = 159 := by omega
        apply neither
        refine Or.inr ⟨a,d,by omega,hd,last,?_⟩
        intro t ht
        have hi := Nat.mul_le_mul_right d (show t.val ≤ 11 by omega)
        exact blue t (by omega) (by omega)
  have table : ∀ i : Fin 160, 0 < i.val → i.val < 159 → ¬ (77 < i.val ∧ i.val < 82) →
      initialAllowed.testBit (5*i.val) = true := by decide +kernel
  have allowed (x : ℕ) (hx : R x) : initialAllowed.testBit (5*x) = true := by
    obtain ⟨lo,hi,hred⟩ := hx
    have outside : ¬ (77 < x ∧ x < 82) := by
      rintro ⟨hl, hr⟩
      have blue := gap x hl hr
      rw [hred] at blue
      cases blue
    exact table ⟨x, by omega⟩ lo hi outside
  exact cert R (fun _ hx => (hx.2.1).le) hn (all_hit_of_cover cover)
    (mark_good hn red (by decide)) allowed

