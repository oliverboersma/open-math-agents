/-!
# Kronecker substitution certificate for discrete autoconvolutions

Pure `ℕ` lemmas. A vector `a` is stored as the base-`B` digits of one number `A`.
One multiplication `A * A` then encodes every autoconvolution value, and
a divide-and-conquer digit check bounds all of them.
-/

namespace C1aUpper

open Finset

/-- Discrete autoconvolution of `a` restricted to indices `< N`. -/
def conv (N : ℕ) (a : ℕ → ℕ) (m : ℕ) : ℕ :=
  ∑ i ∈ range N, ∑ j ∈ range N, if i + j = m then a i * a j else 0

/-- The `i`-th base-`B` digit of `Y`. -/
def digit (B Y i : ℕ) : ℕ := Y / B ^ i % B

/-- Divide-and-conquer check that the lowest `n` base-`B` digits of `Y` are all `≤ T`. -/
def chk (B T : ℕ) : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => false
  | fuel + 1, Y, n =>
    if n ≤ 1 then (n == 0 || Nat.ble (Y % B) T)
    else chk B T fuel (Y % B ^ (n / 2)) (n / 2) && chk B T fuel (Y / B ^ (n / 2)) (n - n / 2)

/-- Divide-and-conquer sum of the lowest `n` base-`B` digits of `Y` (a lower bound if fuel runs
out). -/
def dsum (B : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 0
  | fuel + 1, Y, n =>
    if n ≤ 1 then (if n = 0 then 0 else Y % B)
    else dsum B fuel (Y % B ^ (n / 2)) (n / 2) + dsum B fuel (Y / B ^ (n / 2)) (n - n / 2)

/-- Horner packing of a list of chunks with a fixed bit shift. -/
def packL (s : ℕ) : List ℕ → ℕ
  | [] => 0
  | c :: cs => c + 2 ^ s * packL s cs

lemma digit_mod {B Y h m : ℕ} (hm : m < h) : digit B (Y % B ^ h) m = digit B Y m := by
  unfold digit
  have hh : B ^ h = B ^ m * B ^ (h - m) := by rw [← pow_add]; congr 1; omega
  rw [hh, Nat.mod_mul_right_div_self]
  apply Nat.mod_mod_of_dvd
  exact dvd_pow_self B (by omega)

lemma digit_div {B Y h m : ℕ} : digit B (Y / B ^ h) m = digit B Y (h + m) := by
  unfold digit
  rw [Nat.div_div_eq_div_mul, ← pow_add]

lemma digit_zero {B Y : ℕ} : digit B Y 0 = Y % B := by simp [digit]

theorem chk_sound (B T : ℕ) : ∀ (fuel Y n : ℕ), chk B T fuel Y n = true →
    ∀ m < n, digit B Y m ≤ T := by
  intro fuel
  induction fuel with
  | zero => intro Y n h; simp [chk] at h
  | succ fuel ih =>
    intro Y n h m hm
    simp only [chk] at h
    split_ifs at h with hn
    · have hm0 : m = 0 := by omega
      subst hm0
      have hn1 : n ≠ 0 := by omega
      simp [hn1] at h
      rw [digit_zero]; exact h
    · rw [Bool.and_eq_true] at h
      by_cases hmh : m < n / 2
      · rw [← digit_mod hmh]; exact ih _ _ h.1 m hmh
      · have := ih _ _ h.2 (m - n / 2) (by omega)
        rw [digit_div] at this
        rwa [show n / 2 + (m - n / 2) = m by omega] at this

theorem dsum_le (B : ℕ) : ∀ (fuel Y n : ℕ), dsum B fuel Y n ≤ ∑ m ∈ range n, digit B Y m := by
  intro fuel
  induction fuel with
  | zero => intro Y n; simp [dsum]
  | succ fuel ih =>
    intro Y n
    simp only [dsum]
    split_ifs with hn hn0
    · simp
    · have : n = 1 := by omega
      subst this; simp [digit_zero]
    · have hsplit : n = n / 2 + (n - n / 2) := by omega
      conv_rhs => rw [hsplit, Finset.sum_range_add]
      gcongr
      · calc dsum B fuel (Y % B ^ (n / 2)) (n / 2)
            ≤ ∑ m ∈ range (n / 2), digit B (Y % B ^ (n / 2)) m := ih _ _
          _ = ∑ m ∈ range (n / 2), digit B Y m := by
            apply Finset.sum_congr rfl
            intro m hm; exact digit_mod (Finset.mem_range.mp hm)
      · calc dsum B fuel (Y / B ^ (n / 2)) (n - n / 2)
            ≤ ∑ m ∈ range (n - n / 2), digit B (Y / B ^ (n / 2)) m := ih _ _
          _ = _ := by
            apply Finset.sum_congr rfl
            intro m _; exact digit_div

theorem sum_digit_pow (B Y : ℕ) : ∀ n, ∑ i ∈ range n, digit B Y i * B ^ i = Y % B ^ n := by
  intro n
  induction n with
  | zero => simp [Nat.mod_one]
  | succ n ih =>
    rw [Finset.sum_range_succ, ih, Nat.mod_pow_succ, digit]; ring

theorem digit_of_sum (B : ℕ) : ∀ (n : ℕ) (d : ℕ → ℕ), (∀ m < n, d m < B) →
    ∀ k < n, digit B (∑ m ∈ range n, d m * B ^ m) k = d k := by
  intro n
  induction n with
  | zero => intro d _ k hk; omega
  | succ n ih =>
    intro d hd k hk
    have hB : 0 < B := lt_of_le_of_lt (Nat.zero_le _) (hd 0 (by omega))
    have hrepr : ∑ m ∈ range (n + 1), d m * B ^ m
        = d 0 + B * ∑ m ∈ range n, d (m + 1) * B ^ m := by
      rw [Finset.sum_range_succ', Finset.mul_sum]
      rw [add_comm]; congr 1
      · simp
      · apply Finset.sum_congr rfl; intro m _; ring
    rw [hrepr]
    have hd0 := hd 0 (by omega)
    rcases k with _ | k
    · rw [digit_zero, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hd0]
    · have : digit B (d 0 + B * ∑ m ∈ range n, d (m + 1) * B ^ m) (k + 1)
          = digit B (∑ m ∈ range n, d (m + 1) * B ^ m) k := by
        unfold digit
        rw [pow_succ', ← Nat.div_div_eq_div_mul, Nat.add_mul_div_left _ _ hB,
          Nat.div_eq_of_lt hd0, zero_add]
      rw [this]
      exact ih (fun m => d (m + 1)) (fun m hm => hd (m + 1) (by omega)) k (by omega)

theorem sq_pack (B N : ℕ) (a : ℕ → ℕ) :
    (∑ i ∈ range N, a i * B ^ i) * (∑ i ∈ range N, a i * B ^ i)
      = ∑ m ∈ range (2 * N), conv N a m * B ^ m := by
  rw [Finset.sum_mul_sum]
  have h1 : ∀ i ∈ range N, ∀ j ∈ range N, a i * B ^ i * (a j * B ^ j)
      = ∑ m ∈ range (2 * N), if i + j = m then a i * a j * B ^ m else 0 := by
    intro i hi j hj
    rw [Finset.sum_ite_eq]
    rw [if_pos (by simp at hi hj ⊢; omega), pow_add]; ring
  rw [Finset.sum_congr rfl (fun i hi => Finset.sum_congr rfl (fun j hj => h1 i hi j hj))]
  rw [Finset.sum_congr rfl (fun i _ => Finset.sum_comm), Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro m _
  rw [Finset.sum_comm, conv, Finset.sum_mul]
  apply Finset.sum_congr rfl; intro i _
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl; intro j _
  split_ifs <;> first | omega | ring

theorem conv_le (N : ℕ) (a : ℕ → ℕ) (amax : ℕ) (ha : ∀ i < N, a i ≤ amax) (m : ℕ) :
    conv N a m ≤ N * amax ^ 2 := by
  unfold conv
  calc ∑ i ∈ range N, ∑ j ∈ range N, (if i + j = m then a i * a j else 0)
      ≤ ∑ i ∈ range N, amax ^ 2 := by
        apply Finset.sum_le_sum
        intro i hi
        calc ∑ j ∈ range N, (if i + j = m then a i * a j else 0)
            ≤ ∑ j ∈ range N, (if j = m - i then a i * a j else 0) := by
              apply Finset.sum_le_sum; intro j _
              split_ifs with h1 h2 <;> first | exact le_rfl | omega
          _ = if m - i ∈ range N then a i * a (m - i) else 0 := Finset.sum_ite_eq' _ _ _
          _ ≤ amax ^ 2 := by
              split_ifs with h
              · simp at hi h
                rw [sq]; exact Nat.mul_le_mul (ha i hi) (ha _ h)
              · exact Nat.zero_le _
    _ = N * amax ^ 2 := by simp

/-- Main Kronecker certificate: digit checks on `A` and `A * A` bound every autoconvolution
value of the digit vector of `A`. -/
theorem kron_cert (B N amax M fuel1 fuel2 A : ℕ) (hA : A < B ^ N)
    (hamax : chk B amax fuel1 A N = true) (hB : N * amax ^ 2 < B)
    (hM : chk B M fuel2 (A * A) (2 * N) = true) :
    ∀ m < 2 * N, conv N (digit B A) m ≤ M := by
  intro m hm
  have ha : ∀ i < N, digit B A i ≤ amax := chk_sound B amax fuel1 A N hamax
  have hpack : ∑ i ∈ range N, digit B A i * B ^ i = A := by
    rw [sum_digit_pow, Nat.mod_eq_of_lt hA]
  have hsq := sq_pack B N (digit B A)
  rw [hpack] at hsq
  have hlt : ∀ m < 2 * N, conv N (digit B A) m < B :=
    fun m _ => lt_of_le_of_lt (conv_le N _ amax ha m) hB
  have hdig := digit_of_sum B (2 * N) (conv N (digit B A)) hlt m hm
  rw [← hsq] at hdig
  rw [← hdig]
  exact chk_sound B M fuel2 (A * A) (2 * N) hM m hm

end C1aUpper

/-! Guard-bit certificates for packed natural numbers. The geometric mask is
computed by one power and quotient, independently of the number of fields. -/

namespace C1aUpper

open Finset

def unitMask (B n : ℕ) : ℕ := (B ^ n - 1) / (B - 1)

theorem unitMask_eq_sum {B n : ℕ} (hB : 2 ≤ B) :
    unitMask B n = ∑ j ∈ range n, B ^ j := (Nat.geomSum_eq hB n).symm

theorem digit_and (b X Y i : ℕ) :
    digit (2 ^ b) (X &&& Y) i = digit (2 ^ b) X i &&& digit (2 ^ b) Y i := by
  unfold digit
  rw [← pow_mul, Nat.and_div_two_pow, Nat.and_mod_two_pow]

theorem digit_repeated {B n T i : ℕ} (hB : 2 ≤ B) (hT : T < B) (hi : i < n) :
    digit B (T * unitMask B n) i = T := by
  rw [unitMask_eq_sum hB, Finset.mul_sum]
  exact digit_of_sum B n (fun _ => T) (fun _ _ => hT) i hi

/-- A repeated low-bit mask selecting all of Y bounds every input field. -/
theorem lowMask_sound {b w Y n : ℕ} (hb : 0 < b) (hw : w ≤ b)
    (hmask : Y &&& ((2 ^ w - 1) * unitMask (2 ^ b) n) = Y) :
    ∀ i < n, digit (2 ^ b) Y i < 2 ^ w := by
  intro i hi
  have hB : 2 ≤ 2 ^ b := Nat.one_lt_two_pow (by omega)
  have hpow : 2 ^ w ≤ (2 : ℕ) ^ b := Nat.pow_le_pow_right (by decide) hw
  have hpos : 0 < (2 : ℕ) ^ w := Nat.two_pow_pos w
  have h := congrArg (fun Z => digit (2 ^ b) Z i) hmask
  change digit (2 ^ b) (Y &&& ((2 ^ w - 1) * unitMask (2 ^ b) n)) i = _ at h
  rw [digit_and, digit_repeated hB (by omega) hi] at h
  have hle : digit (2 ^ b) Y i ≤ 2 ^ w - 1 := by
    calc digit (2 ^ b) Y i = digit (2 ^ b) Y i &&& (2 ^ w - 1) := h.symm
      _ ≤ _ := Nat.and_le_right
  omega

/-- One guard bit per packed digit certifies an upper bound for every field. -/
theorem guard_pack_sound {k n Y M : ℕ} {d : ℕ → ℕ}
    (hpack : Y = ∑ i ∈ range n, d i * (2 ^ (k + 1)) ^ i)
    (hd : ∀ i < n, d i < 2 ^ k) (hM : M < 2 ^ k)
    (hguard : (Y + (2 ^ k - 1 - M) * unitMask (2 ^ (k+1)) n) &&&
      ((2 ^ k) * unitMask (2 ^ (k+1)) n) = 0) :
    ∀ i < n, d i ≤ M := by
  let L : ℕ := 2 ^ k
  let B : ℕ := 2 ^ (k+1)
  let pad : ℕ := L - 1 - M
  have hBL : B = L + L := by simp [B,L,pow_succ,Nat.mul_two]
  have hLM : M < L := hM
  have hB : 2 ≤ B := by omega
  have hpad (i) (hi : i < n) : d i + pad < B := by
    have h0 : d i < L := hd i hi
    dsimp [pad]
    omega
  have hsum : Y + pad * unitMask B n =
      ∑ i ∈ range n, (d i + pad) * B ^ i := by
    rw [hpack, unitMask_eq_sum hB, Finset.mul_sum]
    change (∑ i ∈ range n, d i * B ^ i) + _ = _
    simp only [Nat.add_mul, Finset.sum_add_distrib]
  intro i hi
  have h := congrArg (fun Z => digit B Z i) hguard
  change digit B ((Y + pad * unitMask B n) &&& (L * unitMask B n)) i = digit B 0 i at h
  rw [show digit B ((Y + pad * unitMask B n) &&& (L * unitMask B n)) i =
      digit B (Y + pad * unitMask B n) i &&& digit B (L * unitMask B n) i
      from digit_and (k+1) _ _ i, hsum, digit_of_sum B n (fun z => d z + pad) hpad i hi,
      digit_repeated hB (by omega) hi] at h
  simp only [digit, Nat.zero_div, Nat.zero_mod] at h
  by_contra! hbad
  have hhigh : 2 ^ k ≤ d i + pad := by
    change L ≤ _
    dsimp [pad]
    omega
  have hb := Nat.testBit_of_two_pow_le_and_two_pow_add_one_gt hhigh (hpad i hi)
  have hz := congrArg (fun z : ℕ => z.testBit k) h
  change ((d i + pad) &&& (2 ^ k)).testBit k = (0 : ℕ).testBit k at hz
  simp [Nat.testBit_and, hb, Nat.testBit_two_pow_self] at hz

theorem guard_sound {k n Y M : ℕ}
    (hY : Y < (2 ^ (k+1)) ^ n)
    (hd : ∀ i < n, digit (2 ^ (k+1)) Y i < 2 ^ k) (hM : M < 2 ^ k)
    (hguard : (Y + (2 ^ k - 1 - M) * unitMask (2 ^ (k+1)) n) &&&
      ((2 ^ k) * unitMask (2 ^ (k+1)) n) = 0) :
    ∀ i < n, digit (2 ^ (k+1)) Y i ≤ M := by
  apply guard_pack_sound (Y := Y) _ hd hM hguard
  rw [sum_digit_pow, Nat.mod_eq_of_lt hY]

end C1aUpper

namespace C1aUpper

open Finset

/-- Carry-free Kronecker substitution followed by a single guard-bit bound on
the convolution. The input and square may use different low-bit masks. -/
theorem kron_guard_cert {k w N A M : ℕ}
    (hw : w ≤ k + 1)
    (hA : A < (2 ^ (k+1)) ^ N)
    (hA_low : A &&& ((2 ^ w - 1) * unitMask (2 ^ (k+1)) N) = A)
    (hnoCarry : N * (2 ^ w - 1) ^ 2 < 2 ^ (k+1))
    (hY_low : (A * A) &&& ((2 ^ k - 1) * unitMask (2 ^ (k+1)) (2*N)) = A * A)
    (hM : M < 2 ^ k)
    (hguard : (A*A + (2 ^ k - 1 - M) * unitMask (2 ^ (k+1)) (2*N)) &&&
      (2 ^ k * unitMask (2 ^ (k+1)) (2*N)) = 0) :
    ∀ m < 2*N, conv N (digit (2 ^ (k+1)) A) m ≤ M := by
  let B : ℕ := 2 ^ (k+1)
  let a := digit B A
  have ha (i) (hi : i < N) : a i ≤ 2 ^ w - 1 := by
    have h := lowMask_sound (b := k+1) (w := w) (by omega) hw hA_low i hi
    change digit (2^(k+1)) A i ≤ _
    omega
  have hpack : ∑ i ∈ range N, a i * B ^ i = A := by
    change ∑ i ∈ range N, digit B A i * B ^ i = A
    rw [sum_digit_pow, Nat.mod_eq_of_lt hA]
  have hsq := sq_pack B N a
  rw [hpack] at hsq
  have hlt (m) (_hm : m < 2*N) : conv N a m < B :=
    lt_of_le_of_lt (conv_le N a (2 ^ w - 1) ha m) hnoCarry
  have hlow (m) (hm : m < 2*N) : conv N a m < 2 ^ k := by
    have hd := digit_of_sum B (2*N) (conv N a) hlt m hm
    rw [← hsq] at hd
    rw [← hd]
    exact lowMask_sound (b := k+1) (w := k) (by omega) (by omega) hY_low m hm
  exact guard_pack_sound (d := conv N a) hsq hlow hM hguard

end C1aUpper

namespace C1aUpper

open Finset

theorem packed_mod_le_digit_sum (B A N : ℕ) (hB : 1 < B) (hA : A < B ^ N) :
    A % (B - 1) ≤ ∑ i ∈ range N, digit B A i := by
  have hb : B ≡ 1 [MOD B - 1] :=
    ((Nat.modEq_iff_dvd' hB.le).2 (dvd_refl (B - 1))).symm
  have hs : (∑ i ∈ range N, digit B A i * B ^ i) ≡
      (∑ i ∈ range N, digit B A i) [MOD B - 1] := by
    apply Nat.ModEq.sum
    intro i _
    simpa using (hb.pow i).mul_left (digit B A i)
  rw [sum_digit_pow, Nat.mod_eq_of_lt hA] at hs
  exact le_trans hs.le (Nat.mod_le _ _)

end C1aUpper

/-!
# Step-function upper bound for `Constant1a.C1a`

For `a : ℕ → ℕ` on `N` steps of width `h = 1 / (2 N)` over `(-1/4, 1/4]`, the autoconvolution of
the step function is at most `h * M` whenever every discrete autoconvolution value is at most `M`.
Hence `C1a ≤ 2 N M / S ^ 2`.
-/

namespace C1aUpper

open MeasureTheory Set Finset

/-- The `k`-th step cell `(-1/4 + k h, -1/4 + (k + 1) h]`. -/
def cell (h : ℝ) (k : ℕ) : Set ℝ := Ioc (-1 / 4 + k * h) (-1 / 4 + (k + 1) * h)

/-- The step function with heights `a i` on the cells `i < N`. -/
noncomputable def stepF (N : ℕ) (a : ℕ → ℕ) (h : ℝ) (x : ℝ) : ℝ :=
  ∑ i ∈ range N, (cell h i).indicator (fun _ => (a i : ℝ)) x

lemma cell_meas (h : ℝ) (k : ℕ) : MeasurableSet (cell h k) := measurableSet_Ioc

lemma vol_cell (h : ℝ) (k : ℕ) : volume (cell h k) = ENNReal.ofReal h := by
  rw [cell, Real.volume_Ioc]; congr 1; ring

lemma cell_disj {h : ℝ} (hh : 0 < h) {k l : ℕ} (hkl : k ≠ l) : Disjoint (cell h k) (cell h l) := by
  rw [Set.disjoint_left]
  intro x hx hx'
  simp only [cell, Set.mem_Ioc] at hx hx'
  have h1 : (k : ℝ) * h < (l + 1) * h := by linarith
  have h2 : (l : ℝ) * h < (k + 1) * h := by linarith
  have h1' : (k : ℝ) < l + 1 := lt_of_mul_lt_mul_right h1 hh.le
  have h2' : (l : ℝ) < k + 1 := lt_of_mul_lt_mul_right h2 hh.le
  have : k < l + 1 := by exact_mod_cast h1'
  have : l < k + 1 := by exact_mod_cast h2'
  omega

lemma stepF_nonneg (N : ℕ) (a : ℕ → ℕ) (h : ℝ) : 0 ≤ stepF N a h := by
  intro x
  apply Finset.sum_nonneg
  intro i _
  apply Set.indicator_nonneg
  intro _ _; positivity

lemma stepF_meas (N : ℕ) (a : ℕ → ℕ) (h : ℝ) : Measurable (stepF N a h) := by
  unfold stepF
  apply Finset.measurable_sum
  intro i _
  exact measurable_const.indicator (cell_meas h i)

lemma stepF_memLp (N : ℕ) (a : ℕ → ℕ) (h : ℝ) : MemLp (stepF N a h) 2 := by
  unfold stepF
  apply memLp_finsetSum
  intro i _
  apply memLp_indicator_const 2 (cell_meas h i)
  right; rw [vol_cell]; exact ENNReal.ofReal_ne_top

lemma stepF_integral (N : ℕ) (hN : 0 < N) (a : ℕ → ℕ) :
    ∫ x in (-1 / 4)..(1 / 4), stepF N a (1 / (2 * N)) x
      = (1 / (2 * N)) * (∑ i ∈ range N, (a i : ℝ)) := by
  set h : ℝ := 1 / (2 * N) with hdef
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hh : 0 < h := by positivity
  have hNh : (N : ℝ) * h = 1 / 2 := by rw [hdef]; field_simp
  rw [intervalIntegral.integral_of_le (by norm_num)]
  unfold stepF
  rw [integral_finsetSum]
  · rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [integral_indicator_const _ (cell_meas h i)]
    have hsub : cell h i ⊆ Ioc (-1 / 4) (1 / 4) := by
      have hi' : (i : ℝ) + 1 ≤ N := by
        have := Finset.mem_range.mp hi
        exact_mod_cast this
      intro x hx
      simp only [cell, Set.mem_Ioc] at hx ⊢
      constructor
      · have : 0 ≤ (i : ℝ) * h := by positivity
        linarith
      · have : ((i : ℝ) + 1) * h ≤ N * h := mul_le_mul_of_nonneg_right hi' hh.le
        linarith
    rw [Measure.real, Measure.restrict_apply (cell_meas h i), Set.inter_eq_left.mpr hsub,
      vol_cell, ENNReal.toReal_ofReal hh.le, smul_eq_mul]
  · intro i _
    rw [integrable_indicator_iff (cell_meas h i)]
    exact integrableOn_const (by
      rw [Measure.restrict_apply (cell_meas h i)]
      exact ne_top_of_le_ne_top (by rw [vol_cell]; exact ENNReal.ofReal_ne_top)
        (measure_mono Set.inter_subset_left))

/-- Pairwise overlap set: `x ∈ cell i` and `t - x ∈ cell j`. -/
def pairSet (h t : ℝ) (i j : ℕ) : Set ℝ := cell h i ∩ {x | t - x ∈ cell h j}

lemma pairSet_meas (h t : ℝ) (i j : ℕ) : MeasurableSet (pairSet h t i j) :=
  (cell_meas h i).inter ((cell_meas h j).preimage (measurable_const.sub measurable_id))

lemma pairSet_shift (h t : ℝ) (i j : ℕ) :
    pairSet h t i j = (fun x => x + (-(i * h))) ⁻¹' pairSet h t 0 (i + j) := by
  ext x
  simp only [pairSet, cell, Set.mem_preimage, Set.mem_inter_iff, Set.mem_ofPred_eq, Set.mem_Ioc]
  push_cast
  constructor
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith

lemma vol_pairSet (h t : ℝ) (i j : ℕ) :
    volume (pairSet h t i j) = volume (pairSet h t 0 (i + j)) := by
  rw [pairSet_shift, measure_preimage_add_right]

lemma sum_vol_pairSet {h : ℝ} (hh : 0 < h) (t : ℝ) (K : ℕ) :
    ∑ k ∈ range K, volume (pairSet h t 0 k) ≤ ENNReal.ofReal h := by
  rw [← measure_biUnion_finset]
  · calc volume (⋃ k ∈ range K, pairSet h t 0 k) ≤ volume (cell h 0) := by
          apply measure_mono
          intro x hx
          simp only [mem_iUnion] at hx
          obtain ⟨k, _, hk⟩ := hx
          exact hk.1
      _ = ENNReal.ofReal h := vol_cell h 0
  · intro k _ l _ hkl
    exact Disjoint.mono (fun x hx => hx.2) (fun x hx => hx.2)
      (Disjoint.preimage _ (cell_disj hh hkl))
  · intro k _; exact pairSet_meas h t 0 k

lemma integrand_eq (N : ℕ) (a : ℕ → ℕ) (h t x : ℝ) :
    ENNReal.ofReal (stepF N a h (t - x) * stepF N a h x)
      = ∑ i ∈ range N, ∑ j ∈ range N,
          ((a i * a j : ℕ) : ENNReal) * (pairSet h t i j).indicator 1 x := by
  unfold stepF
  rw [mul_comm, Finset.sum_mul_sum]
  rw [ENNReal.ofReal_sum_of_nonneg]
  · apply Finset.sum_congr rfl
    intro i _
    rw [ENNReal.ofReal_sum_of_nonneg]
    · apply Finset.sum_congr rfl
      intro j _
      by_cases hx : x ∈ cell h i <;> by_cases hy : t - x ∈ cell h j <;>
        simp [Set.indicator, pairSet, hx, hy, ENNReal.ofReal_mul]
    · intro j _
      apply mul_nonneg <;> apply Set.indicator_nonneg <;> intro _ _ <;> positivity
  · intro i _
    apply Finset.sum_nonneg
    intro j _
    apply mul_nonneg <;> apply Set.indicator_nonneg <;> intro _ _ <;> positivity

lemma autoconv_le (N : ℕ) (a : ℕ → ℕ) {h : ℝ} (hh : 0 < h) (M : ℕ)
    (hM : ∀ m < 2 * N, conv N a m ≤ M) (t : ℝ) :
    ∫ x, stepF N a h (t - x) * stepF N a h x ≤ h * M := by
  have hmeas : Measurable fun x => stepF N a h (t - x) * stepF N a h x :=
    ((stepF_meas N a h).comp (measurable_const.sub measurable_id)).mul (stepF_meas N a h)
  rw [integral_eq_lintegral_of_nonneg_ae
    (Filter.Eventually.of_forall fun x => mul_nonneg (stepF_nonneg N a h _) (stepF_nonneg N a h _))
    hmeas.aestronglyMeasurable]
  apply ENNReal.toReal_le_of_le_ofReal (by positivity)
  simp_rw [integrand_eq]
  rw [lintegral_finsetSum (range N) (f := fun i x => ∑ j ∈ range N,
      ((a i * a j : ℕ) : ENNReal) * (pairSet h t i j).indicator 1 x)
    (fun i _ => Finset.measurable_sum _ (fun j _ =>
      (measurable_one.indicator (pairSet_meas h t i j)).const_mul _))]
  have hL : ∀ i ∈ range N, ∫⁻ x, ∑ j ∈ range N,
        ((a i * a j : ℕ) : ENNReal) * (pairSet h t i j).indicator 1 x
      = ∑ j ∈ range N, ((a i * a j : ℕ) : ENNReal) * volume (pairSet h t 0 (i + j)) := by
    intro i _
    rw [lintegral_finsetSum (range N) (f := fun j x =>
        ((a i * a j : ℕ) : ENNReal) * (pairSet h t i j).indicator 1 x)
      (fun j _ => (measurable_one.indicator (pairSet_meas h t i j)).const_mul _)]
    apply Finset.sum_congr rfl
    intro j _
    rw [lintegral_const_mul _ (measurable_one.indicator (pairSet_meas h t i j)),
      lintegral_indicator_one (pairSet_meas h t i j), vol_pairSet]
  rw [Finset.sum_congr rfl hL]
  set L : ℕ → ENNReal := fun k => volume (pairSet h t 0 k) with hLdef
  have hre : ∑ i ∈ range N, ∑ j ∈ range N, ((a i * a j : ℕ) : ENNReal) * L (i + j)
      = ∑ k ∈ range (2 * N), (conv N a k : ENNReal) * L k := by
    have h1 : ∀ i ∈ range N, ∀ j ∈ range N, ((a i * a j : ℕ) : ENNReal) * L (i + j)
        = ∑ k ∈ range (2 * N), if i + j = k then ((a i * a j : ℕ) : ENNReal) * L k else 0 := by
      intro i hi j hj
      rw [Finset.sum_ite_eq, if_pos (by simp at hi hj ⊢; omega)]
    rw [Finset.sum_congr rfl (fun i hi => Finset.sum_congr rfl (fun j hj => h1 i hi j hj))]
    rw [Finset.sum_congr rfl (fun i _ => Finset.sum_comm), Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k _
    rw [conv, Nat.cast_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl; intro i _
    rw [Nat.cast_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl; intro j _
    split_ifs <;> simp
  rw [hre]
  calc ∑ k ∈ range (2 * N), (conv N a k : ENNReal) * L k
      ≤ ∑ k ∈ range (2 * N), (M : ENNReal) * L k := by
        apply Finset.sum_le_sum
        intro k hk
        gcongr
        exact_mod_cast hM k (Finset.mem_range.mp hk)
    _ = (M : ENNReal) * ∑ k ∈ range (2 * N), L k := by rw [Finset.mul_sum]
    _ ≤ (M : ENNReal) * ENNReal.ofReal h := by
        gcongr; exact sum_vol_pairSet hh t _
    _ = ENNReal.ofReal (h * M) := by
        rw [ENNReal.ofReal_mul hh.le, ENNReal.ofReal_natCast, mul_comm]

/-- **Step-function upper bound.** -/
theorem C1a_le_of_steps (N : ℕ) (hN : 0 < N) (a : ℕ → ℕ) (M S0 : ℕ) (hS0 : 0 < S0)
    (hS : S0 ≤ ∑ i ∈ range N, a i) (hM : ∀ m < 2 * N, conv N a m ≤ M) :
    Constant1a.C1a ≤ (2 * N * M : ℝ) / (S0 : ℝ) ^ 2 := by
  set h : ℝ := 1 / (2 * N) with hdef
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hh : 0 < h := by positivity
  have hS0r : (0 : ℝ) < S0 := by exact_mod_cast hS0
  have hSr : (S0 : ℝ) ≤ ∑ i ∈ range N, (a i : ℝ) := by exact_mod_cast hS
  set S : ℝ := ∑ i ∈ range N, (a i : ℝ) with hSdef
  unfold Constant1a.C1a
  apply Real.sSup_le _ (by positivity)
  intro C hC
  have hsup : sSup {∫ x, stepF N a h (t - x) * stepF N a h x | t ∈ Icc (-1 / 2 : ℝ) (1 / 2)}
      ≤ h * M := by
    apply Real.sSup_le _ (by positivity)
    rintro _ ⟨t, _, rfl⟩
    exact autoconv_le N a hh M hM t
  have key := hC (stepF_nonneg N a h) (stepF_memLp N a h)
  rw [stepF_integral N hN a] at key
  have key2 : C * (h * S) ^ 2 ≤ h * M := le_trans key hsup
  rw [le_div_iff₀ (by positivity)]
  have hMr : (0 : ℝ) ≤ M := by positivity
  rcases le_or_gt C 0 with hC0 | hC0
  · have : C * (S0 : ℝ) ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hC0 (by positivity)
    have : (0 : ℝ) ≤ 2 * N * M := by positivity
    linarith
  · have h2 : C * (S0 : ℝ) ^ 2 ≤ C * S ^ 2 := by
      gcongr
    have h3 : C * S ^ 2 * h ≤ M := by
      have : h * (C * S ^ 2 * h) ≤ h * M := by nlinarith
      exact le_of_mul_le_mul_left this hh
    have h4 : (2 * N : ℝ) * h = 1 := by rw [hdef]; field_simp
    have h5 : C * S ^ 2 ≤ 2 * N * M := by
      have : C * S ^ 2 = (C * S ^ 2 * h) * (2 * N) := by
        rw [mul_assoc (C * S ^ 2), mul_comm h, h4, mul_one]
      rw [this]
      have : (0 : ℝ) ≤ 2 * N := by positivity
      nlinarith
    linarith

end C1aUpper

