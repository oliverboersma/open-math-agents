-- Quantized projected heights, stored as low-width biased differences.
-- Each independent block expands logarithmically and computes all inclusive
-- prefix sums by multiplying its spaced lanes by a geometric series.
def N : Nat := 262144
def fieldBits : Nat := 57
def weightBits : Nat := 19
def B : Nat := 2 ^ fieldBits
def amax : Nat := 524287
def M : Nat := 320344831240
def S : Nat := 334319147
def fuel : Nat := 21
def blockCap : Nat := 2 ^ 14592
def repBlock : Nat := (blockCap - 1) / (B - 1)

def spreadStep (w m xs : Nat) : Nat :=
  let mask := (2 ^ (w*m) - 1) * ((blockCap - 1) / (2 ^ (2*m*fieldBits) - 1))
  let low := xs &&& mask
  low + ((xs - low) <<< (m*(fieldBits-w)))

def difBlock (w first bias xs : Nat) : Nat :=
  let x128 := spreadStep w 128 xs
  let x64 := spreadStep w 64 x128
  let x32 := spreadStep w 32 x64
  let x16 := spreadStep w 16 x32
  let x8 := spreadStep w 8 x16
  let x4 := spreadStep w 4 x8
  let x2 := spreadStep w 2 x4
  let x1 := spreadStep w 1 x2
  ((first + x1) * repBlock) % blockCap - (bias * repBlock * repBlock) % blockCap

def constBlock (h : Nat) : Nat := h * repBlock

def stitch (s lo hi : Nat) : Nat := lo + (hi <<< s)

