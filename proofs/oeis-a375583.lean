import OMAStatements.S_oeis_a375583
import Mathlib

/-!
# A practical number and two polygonal numbers

Somu and Tran proved representability of all sufficiently large integers
for any fixed polygonal order (https://cs.uwaterloo.ca/journals/JIS/VOL27/Somu/somu5.html).
Here an explicit construction handles all scales for the given order.

For D = 2^t and 1 ≤ q ≤ 2D, Dq is practical by two binary expansions.
It therefore suffices to choose small polygonal summands in a prescribed
residue class modulo D. At odd indices the polygonal polynomial is
F(x) = 2sx² + (s+2)x + 1, with s equal to the order minus two.
For D = BL, where B and L are powers of two near √D and L divides B,
first choose x,y modulo B with F(x)+F(y) equal to the desired low digit
and F'(y) congruent to C F'(x), with C equal to 9 or 13.
The changes from x,y to x+Bi,y+Bj then depend on i+Cj modulo L.
Representing the high digit by quotient and remainder on division by C
bounds both indices. The finite tables check the smaller powers of two
and the positive integers through 8192.
-/

namespace PolygonPractical
open Finset
def Practical (n : ℕ) : Prop := 0<n ∧ ∀ m : ℕ,m≤n → ∃ s ⊆ n.divisors, ∑ i ∈ s,i=m

lemma binary_sum (t m : ℕ) (lim : m<2*2^t) :
    ∃ s : Finset ℕ,(∀ x ∈ s, ∃ e≤t,x=2^e) ∧ ∑ x ∈ s,x=m := by
  induction t generalizing m with
  | zero =>
    norm_num at lim
    rcases (by omega : m=0 ∨ m=1) with rfl | rfl
    · exact ⟨∅,by simp,by simp⟩
    · exact ⟨{1},by simp,by simp⟩
  | succ t ih =>
    let d := 2^(t+1)
    have de : d=2*2^t := by simp [d,pow_succ']
    by_cases small : m<d
    · obtain ⟨s,valid,sum⟩ := ih m (de ▸ small)
      exact ⟨s,fun x hx => by obtain ⟨e,he,rfl⟩ := valid x hx; exact ⟨_,by omega,rfl⟩,sum⟩
    · obtain ⟨s,valid,sum⟩ := ih (m-d) (by change m<2*d at lim; omega)
      have fresh : d∉s := by
        intro mem
        obtain ⟨e,he,eq⟩ := valid d mem
        have le := Nat.pow_le_pow_right (by decide : 0<2) he
        have pos : 0<2^t := by positivity
        omega
      refine ⟨insert d s,?_,?_⟩
      · intro x h
        rcases Finset.mem_insert.mp h with rfl | mem
        · exact ⟨_,le_rfl,rfl⟩
        · obtain ⟨e,he,rfl⟩ := valid x mem
          exact ⟨e,by omega,rfl⟩
      · rw [Finset.sum_insert fresh,sum]; omega

lemma practical_two (t : ℕ) : Practical (2^t) := by
  have pos : 0<2^t := by positivity
  refine ⟨pos,?_⟩
  intro m lim
  obtain ⟨s,valid,sum⟩ := binary_sum t m (by omega)
  refine ⟨s,?_,sum⟩
  intro x hx
  obtain ⟨e,he,rfl⟩ := valid x hx
  exact Nat.mem_divisors.mpr ⟨pow_dvd_pow _ he,pos.ne'⟩

lemma practical_mul (t q : ℕ) (hq : 0<q) (lim : q≤2*2^t) : Practical (2^t*q) := by
  by_cases powQ : ∃ e : ℕ,q=2^e
  · obtain ⟨e,rfl⟩ := powQ
    simpa [pow_add] using practical_two (t+e)
  have dp : 0<2^t := by positivity
  have np := Nat.mul_pos dp hq
  refine ⟨np,?_⟩
  intro m le
  have quot : m/q≤2^t := Nat.div_le_of_le_mul (by simpa [Nat.mul_comm] using le)
  obtain ⟨s,sv,hs⟩ := binary_sum t (m%q) ((Nat.mod_lt _ hq).trans_le lim)
  obtain ⟨u,uv,hu⟩ := binary_sum t (m/q) (by omega)
  let big := u.image (fun i => i*q)
  have split : Disjoint s big := by
    apply Finset.disjoint_left.mpr
    intro x xs xb
    obtain ⟨e,_,rfl⟩ := sv x xs
    obtain ⟨j,ju,eq⟩ := Finset.mem_image.mp xb
    have d : q∣2^e := eq ▸ dvd_mul_left q j
    obtain ⟨e',_,eq'⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp d
    exact powQ ⟨e',eq'⟩
  refine ⟨s∪big,?_,?_⟩
  · intro x hx
    apply Nat.mem_divisors.mpr
    refine ⟨?_,np.ne'⟩
    rcases Finset.mem_union.mp hx with xs | xb
    · obtain ⟨e,he,rfl⟩ := sv x xs
      exact (pow_dvd_pow 2 he).trans (dvd_mul_right _ _)
    · obtain ⟨j,ju,rfl⟩ := Finset.mem_image.mp xb
      obtain ⟨e,he,rfl⟩ := uv j ju
      exact mul_dvd_mul_right (pow_dvd_pow _ he) q
  · rw [Finset.sum_union split,hs]
    have bs : ∑ x ∈ big,x=(m/q)*q := by
      rw [←hu,Finset.sum_mul]
      apply Finset.sum_image
      intro x _ y _ e
      exact Nat.eq_of_mul_eq_mul_right hq e
    rw [bs,Nat.mul_comm (m/q) q,Nat.mod_add_div]


lemma solve_quad (A E h : ℕ) (ea : Even A) (oe : Odd E) (target : ℤ) :
    ∃ x : ℕ, x < 2^h ∧ ∃ z : ℤ, target - (A*x^2+E*x : ℕ) = (2:ℤ)^h*z := by
  let f (x : ZMod (2^h)) := (A : ZMod (2^h))*x^2+E*x
  have inj : Function.Injective f := by
    intro x y eq
    let u := A*(x+y)+E
    have odd : Odd (A*(x+y).val+E) := (ea.mul_right _).add_odd oe
    have hu : IsUnit u := by
      simpa [u] using (ZMod.isUnit_iff_coprime (A*(x+y).val+E) (2^h)).mpr (odd.coprime_two_right.pow_right h)
    apply sub_eq_zero.mp
    apply hu.mul_right_cancel
    dsimp [u,f] at eq ⊢
    linear_combination eq
  obtain ⟨x,hx⟩ := (Finite.surjective_of_injective inj) (target : ZMod (2^h))
  refine ⟨x.val,x.val_lt,?_⟩
  have hcast : ((A*x.val^2+E*x.val : ℕ) : ZMod (2^h)) = target := by simpa [f] using hx
  have ideq := (ZMod.intCast_eq_intCast_iff ((A*x.val^2+E*x.val : ℕ) : ℤ) target (2^h)).mp (by simpa using hcast)
  obtain ⟨z,hz⟩ := ideq.dvd
  exact ⟨z,by simpa using hz⟩

def F (s x : ℕ) : ℕ := 2*s*x^2+(s+2)*x+1
def deriv (s x : ℕ) : ℕ := 4*s*x+(s+2)

lemma low_roots (s h n : ℕ) (hs : s=7 ∨ s=9) (hh : 0<h) :
    ∃ C x y : ℕ, (C=9 ∨ C=13) ∧ x<2^h ∧ y<2^h ∧
      ((2:ℤ)^h ∣ (n:ℤ)-F s x-F s y) ∧
      ((2:ℤ)^h ∣ (deriv s y:ℤ)-C*deriv s x) := by
  let K := 2+n%2
  let C := 1+4*K
  have range : C=9 ∨ C=13 := by dsimp [C,K]; omega
  have so : Odd s := by rcases hs with rfl | rfl <;> decide
  obtain ⟨k,hk,z,hz⟩ := solve_quad 0 s h (by decide) so (K*(s+2) : ℕ)
  push_cast at hz
  simp only [zero_mul,zero_add] at hz
  have be : Even ((2:ℤ)^h*z) := (Even.pow_of_ne_zero (by decide : Even (2:ℤ)) (by omega : h≠0)).mul_right _
  have parity : Even ((n:ℤ)-F s k-1) := by
    have rel := congrArg (fun v : ℤ => v%2) hz
    rw [Int.even_iff] at be ⊢
    rw [be] at rel
    rcases hs with rfl | rfl <;>
      simp [F,K,Int.add_emod,Int.sub_emod,Int.mul_emod] at rel ⊢ <;> omega
  obtain ⟨target,ht⟩ := parity
  let A := s*(1+C^2)
  let E := 2*s*C*k+(s+2)*(1+2*K)
  have ae : Even A := by
    apply Even.mul_left
    rcases range with c | c <;> rw [c] <;> decide
  have eo : Odd E := by
    apply Even.add_odd ((even_two.mul_right _).mul_right _ |>.mul_right _)
    apply Odd.mul (so.add_even (by decide : Even 2))
    exact ⟨K,by omega⟩
  obtain ⟨x,hx,w,hw⟩ := solve_quad A E h ae eo target
  let y := (C*x+k)%(2^h)
  have hy := Nat.mod_lt (C*x+k) (by positivity : 0<2^h)
  have hyz : (C*x+k : ℕ) = y+2^h*((C*x+k)/(2^h)) := (Nat.mod_add_div _ _).symm
  let q := (C*x+k)/(2^h)
  have hyInt : (C:ℤ)*x+k = y+(2:ℤ)^h*q := by exact_mod_cast hyz
  have hyy : (y:ℤ) = (C:ℤ)*x+k-(2:ℤ)^h*q := by linarith only [hyInt]
  refine ⟨C,x,y,range,hx,hy,?_,?_⟩
  · refine ⟨2*w+q*(2*s*((C:ℤ)*x+k+y)+(s+2)),?_⟩
    push_cast at hw ht ⊢
    dsimp [F] at ht ⊢
    dsimp [A,E,C] at hw hyy ⊢
    linear_combination 2*hw + ht - (2*(s:ℤ)*((1+4*(K:ℤ))*x+k+y)+(s+2))*hyy
  · refine ⟨-4*z-4*s*q,?_⟩
    dsimp [deriv,C] at hyy ⊢
    linear_combination -4*hz + 4*(s:ℤ)*hyy



lemma taylor (s x B i : ℕ) :
    (F s (x+B*i) : ℤ) = F s x+(B:ℤ)*i*deriv s x+2*s*(B:ℤ)^2*(i:ℤ)^2 := by
  simp [F,deriv]
  ring

lemma size_order (s x y D : ℕ) (hs : s≤9) (big : 16≤D)
    (x8 : 8*(x+1)≤D) (y11 : 11*(y+1)≤D) : 2*(F s x+F s y+D)≤D^2 := by
  have upper (v : ℕ) : F s v ≤ 18*(v+1)^2 := by
    unfold F
    have h := Nat.mul_le_mul_right (v^2) (Nat.mul_le_mul_left 2 hs)
    have h' := Nat.mul_le_mul_right v (Nat.add_le_add_right hs 2)
    nlinarith only [h,h',Nat.zero_le v]
  have xs := Nat.pow_le_pow_left x8 2
  have ys := Nat.pow_le_pow_left y11 2
  have ds := Nat.mul_le_mul_right D big
  nlinarith only [xs,ys,ds,upper x,upper y]

lemma big_cover (s h l n : ℕ) (hs : s=7 ∨ s=9) (hh : 0<h)
    (hl : l≤h) (large : 128≤2^l) :
    ∃ X Y : ℕ, ((2:ℤ)^h*2^l ∣ (n:ℤ)-F s X-F s Y) ∧
      2*(F s X+F s Y+2^h*2^l)≤(2^h*2^l)^2 := by
  let B := 2^h
  let L := 2^l
  obtain ⟨C,x,y,cs,hx,hy,⟨z,low⟩,⟨w,ratio⟩⟩ := low_roots s h n hs hh
  obtain ⟨m,hm⟩ := (pow_dvd_pow 2 hl : L∣B)
  have hmZ : (B:ℤ)=L*(m:ℤ) := by exact_mod_cast hm
  have so : Odd s := by rcases hs with rfl | rfl <;> decide
  have dOdd : Odd (deriv s x) := ((by decide : Even 4).mul_right s |>.mul_right x).add_odd (so.add_even (by decide))
  obtain ⟨q,hq,v,hv⟩ := solve_quad 0 (deriv s x) l (by decide) dOdd z
  simp only [zero_mul,zero_add,Nat.cast_mul] at hv
  let i := q%C
  let j := q/C
  have qeq : i+C*j=q := Nat.mod_add_div _ _
  have qZ : (i:ℤ)+C*(j:ℤ)=q := by exact_mod_cast qeq
  refine ⟨x+B*i,y+B*j,?_,?_⟩
  · refine ⟨v-(m:ℤ)*w*j-2*s*m*((i:ℤ)^2+(j:ℤ)^2),?_⟩
    rw [taylor,taylor]
    change (n:ℤ)-F s x-F s y=B*z at low
    change (deriv s y:ℤ)-C*deriv s x=B*w at ratio
    change z-(deriv s x:ℤ)*q=L*v at hv
    change _=(B:ℤ)*L*_ 
    calc
      _ = (B:ℤ)*(z-deriv s x*((i:ℤ)+C*j)-((deriv s y:ℤ)-C*deriv s x)*j-2*s*B*((i:ℤ)^2+(j:ℤ)^2)) := by linear_combination low
      _ = (B:ℤ)*(L*v-B*w*j-2*s*B*((i:ℤ)^2+(j:ℤ)^2)) := by rw [qZ,hv,ratio]
      _ = _ := by rw [hmZ]; ring
  · have ci : i<C := Nat.mod_lt _ (by omega)
    have Hx : x+B*i+1≤B*(i+1) := by change x<B at hx; rw [Nat.mul_add,Nat.mul_one]; omega
    have Hy : y+B*j+1≤B*(j+1) := by change y<B at hy; rw [Nat.mul_add,Nat.mul_one]; omega
    have size (k a : ℕ) (small : k*(a+1)≤L) (u : ℕ) (lm : u+1≤B*(a+1)) : k*(u+1)≤B*L := by
      calc
        _ ≤ k*(B*(a+1)) := Nat.mul_le_mul_left _ lm
        _ = B*(k*(a+1)) := by ring
        _ ≤ _ := Nat.mul_le_mul_left _ small
    have big : 16≤B*L := by
      have pos : 0<B := by dsimp [B]; positivity
      have le := Nat.le_mul_of_pos_left L pos
      change 128≤L at large
      omega
    change q<L at hq
    change 128≤L at large
    rcases cs with cc | cc
    · rw [cc] at ci qeq
      have kx := size 11 i (by omega) _ Hx
      have ky := size 8 j (by omega) _ Hy
      simpa only [Nat.add_comm (F s (y+B*j)) (F s (x+B*i))] using size_order s _ _ _ (by omega) big ky kx
    · rw [cc] at ci qeq
      have kx := size 8 i (by omega) _ Hx
      have ky := size 11 j (by omega) _ Hy
      exact size_order s _ _ _ (by omega) big kx ky

def P (s k : ℕ) := k*(s*k-(s-2))/2
def Rep (s n : ℕ) : Prop := ∃ p j k : ℕ, Practical p ∧ p+P s j+P s k=n

def practicalCheck (n : ℕ) : Prop := 0<n ∧ ∀ m : Fin (n+1),∃ u∈n.divisors.powerset,(∑ x ∈ u,x)=m.val
instance (n : ℕ) : Decidable (practicalCheck n) := by unfold practicalCheck; infer_instance
lemma practical_iff (n : ℕ) : Practical n ↔ practicalCheck n := by
  constructor
  · rintro ⟨h,r⟩
    exact ⟨h,fun m => by obtain ⟨u,sub,sm⟩ := r m (by omega); exact ⟨u,Finset.mem_powerset.mpr sub,sm⟩⟩
  · rintro ⟨h,r⟩
    exact ⟨h,fun m hm => by obtain ⟨u,sub,sm⟩ := r ⟨m,by omega⟩; exact ⟨u,Finset.mem_powerset.mp sub,sm⟩⟩

/-- Check 64 consecutive witnesses stored as digits of a natural number. -/
def block (test : ℕ → ℕ → Bool) (radix : ℕ) : ℕ → ℕ → ℕ → Bool
  | 0,_,_ => true
  | len+1,start,w => test start (w%radix) && block test radix len (start+1) (w/radix)
def table (test : ℕ → ℕ → Bool) (radix len : ℕ) : List ℕ → ℕ → Bool
  | [],_ => true
  | w::ws,start => block test radix len start w && table test radix len ws (start+len)

lemma block_sound (test : ℕ → ℕ → Bool) (radix len start w n : ℕ)
    (ok : block test radix len start w=true) (lo : start≤n) (hi : n<start+len) :
    ∃ v,test n v=true := by
  induction len generalizing start w with
  | zero => omega
  | succ len ih =>
    simp only [block,Bool.and_eq_true] at ok
    by_cases e : n=start
    · exact ⟨_,e ▸ ok.1⟩
    · exact ih _ _ ok.2 (by omega) (by omega)

lemma table_sound (test : ℕ → ℕ → Bool) (radix len : ℕ) (ws : List ℕ) (start n : ℕ)
    (ok : table test radix len ws start=true) (lo : start≤n) (hi : n<start+len*ws.length) :
    ∃ v,test n v=true := by
  induction ws generalizing start with
  | nil => simp at hi; omega
  | cons w ws ih =>
    simp only [table,Bool.and_eq_true] at ok
    simp only [List.length_cons,Nat.mul_add,Nat.mul_one] at hi
    by_cases small : n<start+len
    · exact block_sound _ _ _ _ _ _ ok.1 lo small
    · exact ih _ ok.2 (by omega) (by omega)

/-- A small-case witness stores two indices in base 64 and the power of two in the practical remainder. -/
def smallTest (s bad n v : ℕ) : Bool :=
  let j := v%64
  let k := (v/64)%64
  let t := v/4096
  let a := P s j+P s k
  let p := n-a
  let q := p/2^t
  decide (n=0 ∨ n=bad ∨ (p+a=n ∧ ((0<q ∧ q≤2*2^t ∧ 2^t*q=p) ∨ p=18 ∨ p=36 ∨ p=54)))

lemma small_sound {s bad n v : ℕ} (ok : smallTest s bad n v=true) (pos : 0<n) (ne : n≠bad) : Rep s n := by
  let j := v%64
  let k := (v/64)%64
  let t := v/4096
  let p := n-(P s j+P s k)
  let q := p/2^t
  change decide (n=0 ∨ n=bad ∨ (p+(P s j+P s k)=n ∧ ((0<q ∧ q≤2*2^t ∧ 2^t*q=p) ∨ p=18 ∨ p=36 ∨ p=54)))=true at ok
  obtain ⟨eq,cases⟩ := ((of_decide_eq_true ok).resolve_left (by omega)).resolve_left ne
  refine ⟨p,j,k,?_,by simpa [Nat.add_assoc] using eq⟩
  rcases cases with ⟨qp,lim,eq⟩ | eq | eq | eq
  · exact eq ▸ practical_mul t q qp lim
  all_goals rw [eq,practical_iff]; decide +kernel

/-- A modular witness encodes its two polygonal indices in base 512. -/
def modTest (s D r code : ℕ) : Bool :=
  let v := P s (code%512)+P s (code/512)
  decide (v%D=r ∧ 2*(v+D)≤D^2)

def ModCover (s D : ℕ) : Prop :=
  ∀ r : ℕ,r<D → ∃ j k : ℕ, (P s j+P s k)%D=r ∧ 2*(P s j+P s k+D)≤D^2


lemma choose_scale (n : ℕ) (lo : 8192<n) :
    ∃ t : ℕ,7≤t ∧ n≤2*(2^t)^2 ∧ (2^t)^2<2*n := by
  have avail : ∃ t : ℕ,n≤2*(2^t)^2 := by
    refine ⟨n,?_⟩
    have gt := Nat.lt_two_pow_self (n := n)
    have high : 0<2^n := by positivity
    nlinarith only [gt,Nat.mul_le_mul_left (2^n) high]
  let t := Nat.find avail
  have top := Nat.find_spec avail
  change n≤2*(2^t)^2 at top
  have low : 7≤t := by
    by_contra! small
    have a := Nat.pow_le_pow_right (by decide : 0<2) (show t≤6 by omega)
    have b := Nat.pow_le_pow_left a 2
    norm_num at b
    omega
  refine ⟨t,low,top,?_⟩
  have nod := Nat.find_min avail (m := t-1) (by change t-1<t; omega)
  change ¬ n≤2*(2^(t-1))^2 at nod
  have e : 2^t=2^(t-1)*2 := by convert Nat.pow_succ 2 (t-1) using 2; omega
  rw [e]
  nlinarith only [nod]

lemma odd_index (s x : ℕ) (hs : 2 ≤ s) : P s (2*x+1)=F s x := by
  have sub : s*(2*x+1)-(s-2)=2*s*x+2 := by
    rw [Nat.mul_add,Nat.mul_one,←Nat.mul_assoc,Nat.mul_comm s 2]
    omega
  unfold P
  rw [sub]
  have eq : (2*x+1)*(2*s*x+2)=F s x*2 := by unfold F; ring
  rw [eq,Nat.mul_div_cancel _ (by decide : 0<2)]

lemma assemble_rep (s n t j k : ℕ) (top : n≤2*(2^t)^2) (bottom : (2^t)^2<2*n)
    (cong : (2:ℤ)^t ∣ (n:ℤ)-P s j-P s k)
    (size : 2*(P s j+P s k+2^t)≤(2^t)^2) : Rep s n := by
  let a := P s j+P s k
  have enough : a+2^t≤n := by dsimp [a]; omega
  have dp : 0<2^t := by positivity
  let p := n-a
  have pa : p+a=n := by dsimp [p]; omega
  have pcast : (p:ℤ) = (n:ℤ)-P s j-P s k := by
    have h : (p:ℤ)+a=n := by exact_mod_cast pa
    dsimp [a] at h
    linarith only [h]
  rw [←pcast] at cong
  have d : 2^t∣p := by exact_mod_cast cong
  obtain ⟨q,eq⟩ := d
  have qp : 0<q := by
    by_contra! zero
    have qz : q=0 := by omega
    rw [qz,Nat.mul_zero] at eq
    omega
  have ub : 2^t*q≤2^t*(2*2^t) := by rw [←eq]; nlinarith only [pa,top,Nat.zero_le a]
  have small := Nat.le_of_mul_le_mul_left ub dp
  exact ⟨p,j,k,eq ▸ practical_mul t q qp small,by simpa [a,Nat.add_assoc] using pa⟩

lemma general_rep (s bad : ℕ) (hs : s=7 ∨ s=9)
    (base : ∀ n : ℕ, 0<n → n≤8192 → n≠bad → Rep s n)
    (medium : ∀ t : ℕ,7≤t → t<14 → ModCover s (2^t)) :
    ∀ n : ℕ,0<n → n≠bad → Rep s n := by
  intro n hn nb
  by_cases sm : n≤8192
  · exact base n hn sm nb
  obtain ⟨t,low,top,bottom⟩ := choose_scale n (by omega)
  by_cases md : t<14
  · obtain ⟨j,k,cong,size⟩ := medium t low md (n%(2^t)) (Nat.mod_lt _ (by positivity))
    apply assemble_rep s n t j k top bottom _ size
    have h : (P s j+P s k : ℕ) ≡ n [MOD 2^t] := cong
    have hz := (Int.natCast_modEq_iff.mpr h).dvd
    simpa [Int.sub_sub] using hz
  · let l := t/2
    let h := t-l
    have le : l≤h := by dsimp [h,l]; omega
    have eps : h+l=t := by dsimp [h,l]; omega
    have big : 128≤2^l := Nat.pow_le_pow_right (by decide : 0<2) (show 7≤l by dsimp [l]; omega)
    obtain ⟨x,y,d,z⟩ := big_cover s h l n hs (by dsimp [h,l]; omega) le big
    apply assemble_rep s n t (2*x+1) (2*y+1) top bottom
    · rw [odd_index _ _ (by omega),odd_index _ _ (by omega),←eps,pow_add]
