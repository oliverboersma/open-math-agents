/-- The fourth square, independently reported in formal-conjectures issue 8311.
The two inclusive prime prefixes are certified above by a weighted Legendre sieve. -/
theorem OMA.disproof : ¬ (type_of% @OeisA105720.conjecture) := by
  intro h
  have hs : IsSquare (OeisA105720.a 111008771) := by
    rw [OMA.SumSieve.square_witness OMA.SumSieve.pages OMA.SumSieve.indices
      OMA.SumSieve.s0b4911 OMA.SumSieve.s1b6819]
    exact ⟨622112686,by decide⟩
  rcases (h 111008771 (by decide)).mp hs with h|h|h <;> omega
