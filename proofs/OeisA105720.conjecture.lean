import FormalConjectures.OEIS.«105720»

/-!
# A fourth square in the triangular matchstick prime sums

For n = 111008771 the sum is 622112686 squared. David-glitc previously
reported the numerical witness (google-deepmind/formal-conjectures issue 8311).
Here the two prime counts and both prime sums are verified in the kernel.

The weighted Legendre sieve removes one prime at a time. Its base wheel has
period 2310. Above the square root threshold, only 1 and primes survive.
The small prime table has 32-integer blocks. Each 16-bit mask records odd
primes, and each field stores the starting count and sum for its block.
The mask bits are certified by gcd against lcm(1,...,1024); prefix increments
and the continuity of adjacent blocks are independently verified below.
-/

namespace OMA.SumSieve

open Finset

def survivors (t n : ℕ) := (Icc 1 n).filter fun k => ∀ q ∈ k.primeFactors, t < q

def total (e t n : ℕ) := ∑ k ∈ survivors t n, k^e

def primeTotal (e n : ℕ) := ∑ k ∈ n.primesLE, k^e

lemma alive {t n k : ℕ} : k ∈ survivors t n ↔
    0 < k ∧ k ≤ n ∧ ∀ q, q.Prime → q ∣ k → t < q := by
  unfold survivors
  simp only [mem_filter,mem_Icc,Nat.mem_primeFactors]
  constructor
  · rintro ⟨⟨h,h'⟩,hf⟩
    exact ⟨h,h', fun q hq hd => hf q ⟨hq,hd,by omega⟩⟩
  · rintro ⟨h,h',hf⟩
    exact ⟨⟨h,h'⟩,fun q hq => hf q hq.1 hq.2.1⟩

lemma base_small (e t n : ℕ) (hl : n ≤ t) : total e t n = min n 1 := by
  by_cases hn : n = 0
  · subst n; simp [total,survivors]
  have hset : survivors t n = {1} := by
    ext k
    rw [alive, mem_singleton]
    constructor
    · rintro ⟨hk,hkn,hq⟩
      by_contra h
      have hlt := hq k.minFac (Nat.minFac_prime h) (Nat.minFac_dvd _)
      have := Nat.minFac_le hk
      omega
    · rintro rfl
      exact ⟨by decide,by omega,fun q hq hd => False.elim (hq.ne_one (Nat.dvd_one.mp hd))⟩
  rw [total,hset,sum_singleton,one_pow]
  omega

lemma prime_cut (e t n : ℕ) (ht : 0 < t) (hlo : t < n) (hsq : n ≤ t*t) :
    total e t n = primeTotal e n - primeTotal e t + 1 := by
  have hset : survivors t n = insert 1 (n.primesLE \ t.primesLE) := by
    ext k
    rw [alive,mem_insert,mem_sdiff,Nat.mem_primesLE,Nat.mem_primesLE]
    constructor
    · rintro ⟨hk,hkn,hdiv⟩
      by_cases hone : k=1
      · exact Or.inl hone
      have prim : k.Prime := by
        by_contra h
        have hfac := Nat.minFac_sq_le_self hk h
        have hgt := hdiv k.minFac (Nat.minFac_prime hone) (Nat.minFac_dvd _)
        nlinarith
      exact Or.inr ⟨⟨hkn,prim⟩,fun h => (not_lt_of_ge h.1) (hdiv k prim (dvd_refl _))⟩
    · rintro (rfl|⟨⟨hkn,hk⟩,hh⟩)
      · exact ⟨by decide,by omega,fun q hq hd => False.elim (hq.ne_one (Nat.dvd_one.mp hd))⟩
      · refine ⟨hk.pos,hkn,?_⟩
        intro q hq hd
        have he := ((Nat.dvd_prime hk).mp hd).resolve_left hq.ne_one
        subst q
        exact lt_of_not_ge fun hle => hh ⟨hle,hk⟩
  have hnot : 1 ∉ n.primesLE \ t.primesLE := by simp [Nat.mem_primesLE]
  have hsub : t.primesLE ⊆ n.primesLE := fun x hx => by
    obtain ⟨hl,hp⟩ := Nat.mem_primesLE.mp hx
    exact Nat.mem_primesLE.mpr ⟨by omega,hp⟩
  have hadd := sum_sdiff hsub (f := fun k : ℕ => k^e)
  rw [total,hset,sum_insert hnot,one_pow]
  unfold primeTotal
  omega

lemma peel_add (e t p n : ℕ) (hp : p.Prime) (ht : t < p)
    (hgap : ∀ q, q.Prime → q ≤ p → q ≤ t ∨ q=p) :
    total e p n + p^e * total e t (n/p) = total e t n := by
  let A := survivors t n
  have ha : survivors p n = A.filter (fun x => ¬ p ∣ x) := by
    ext k
    simp only [mem_filter,A,alive]
    constructor
    · rintro ⟨h,hl,hr⟩
      exact ⟨⟨h,hl,fun q hq hd => ht.trans (hr q hq hd)⟩,fun hd => (lt_irrefl p) (hr p hp hd)⟩
    · rintro ⟨⟨h,hl,hr⟩,hnd⟩
      refine ⟨h,hl,fun q hq hd => lt_of_not_ge (fun hqp => ?_)⟩
      rcases hgap q hq hqp with hle|rfl
      · exact (not_lt_of_ge hle) (hr q hq hd)
      · exact hnd hd
  have hb : A.filter (fun x => p ∣ x) = (survivors t (n/p)).image (p*·) := by
    ext x
    simp only [A,mem_filter,alive,mem_image]
    constructor
    · rintro ⟨⟨hx,hn,hr⟩,k,rfl⟩
      refine ⟨k,⟨Nat.pos_of_mul_pos_left hx,(Nat.le_div_iff_mul_le hp.pos).mpr (by simpa [mul_comm] using hn),
        fun q hq h => hr q hq (dvd_mul_of_dvd_right h p)⟩,rfl⟩
    · rintro ⟨k,⟨hk,hn,hr⟩,rfl⟩
      refine ⟨⟨Nat.mul_pos hp.pos hk, by simpa [mul_comm] using (Nat.le_div_iff_mul_le hp.pos).mp hn,?_⟩,
        dvd_mul_right _ _⟩
      intro q hq h
      rcases hq.dvd_mul.mp h with hd|hd
      · obtain rfl := ((Nat.dvd_prime hp).mp hd).resolve_left hq.ne_one
        exact ht
      · exact hr q hq hd
  have htotal := sum_filter_add_sum_filter_not A (fun x => p ∣ x) (fun k : ℕ => k^e)
  rw [hb, sum_image] at htotal
  · simp only [mul_pow, ← mul_sum] at htotal
    unfold total
    rw [ha]
    dsimp only [A] at *
    omega
  · intro a ha b hb h
    exact Nat.eq_of_mul_eq_mul_left hp.pos h

lemma peel (e t p n : ℕ) (hp : p.Prime) (ht : t < p)
    (hgap : ∀ q, q.Prime → q ≤ p → q ≤ t ∨ q=p) :
    total e p n = total e t n - p^e * total e t (n/p) := by
  have := peel_add e t p n hp ht hgap
  omega

lemma prime_total_succ (e n : ℕ) :
    primeTotal e (n+1) = primeTotal e n + if (n+1).Prime then (n+1)^e else 0 := by
  by_cases hp : (n+1).Prime
  · have he : (n+1).primesLE = insert (n+1) n.primesLE := by
      ext p; simp only [Nat.mem_primesLE,mem_insert]; constructor
      · rintro ⟨hl,hh⟩
        by_cases h : p=n+1
        · exact Or.inl h
        · exact Or.inr ⟨by omega,hh⟩
      · rintro (rfl|⟨hl,hh⟩) <;> exact ⟨by omega,by assumption⟩
    rw [primeTotal,he,sum_insert (by simp [Nat.mem_primesLE]),if_pos hp,add_comm]
    rfl
  · have he : (n+1).primesLE = n.primesLE := by
      ext p; simp only [Nat.mem_primesLE]; grind
    simp [primeTotal,he,hp]

