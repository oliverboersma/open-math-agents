/-- Cumulative number and sum of the primes up through n in the small table. -/
def lookupCore (n w : ℕ) : ℕ × ℕ :=
  let j := (n%256)/32
  let s := (w >>> (60+40*j)) % (1<<<40)
  let mask := (s%65536) % (1 <<< ((n%32+1)/2))
  let l := digit (mask%256)
  let h := digit (mask/256)
  let bits := l%16+h%16
  let c := ((s>>>16)%256)+bits
  ⟨(w%(1<<<20))+c+(if 2≤n then 1 else 0),
    ((w>>>20)%(1<<<40))+(n/256*256)*c+(s>>>24)+(j*32+1)*bits+
        2*(l/16+h/16+8*(h%16))+(if 2≤n then 2 else 0)⟩


def entry (n : ℕ) := lookupCore n (page (n/256))
def lookup (e n : ℕ) := if e=0 then (entry n).1 else (entry n).2

def wheel (e n : ℕ) : ℕ :=
  let t := n/2310
  let z := wheelPart (n%2310)
  if e=0 then t*480+z%1024 else
    t*554400+2310*480*(t*(t-1)/2)+2310*t*(z%1024)+z/1024

