def isP (n : ℕ) := if n ≤ 1024 then decide (Nat.Prime n) else n%2==1 && Nat.gcd n mag == 1
def expected (n : ℕ) (v : ℕ × ℕ) (p : Bool) : ℕ × ℕ := if p then (v.1+1,v.2+n) else v
/-- Divisor witnesses for the primality test up to the table bound. -/
def common (a : ℕ) : ℕ → ℕ
  | 0 => a+1
  | k+1 => Nat.lcm (common a k) (common (a+2^k) k)

lemma in_common (d a k : ℕ) (hlo : a<d) (hhi : d≤a+2^k) : d ∣ common a k := by
  induction k generalizing a with
  | zero => have h : d=a+1 := by simp at hhi; omega
            simp [common,h]
  | succ k ih =>
    simp only [common]
    by_cases h : d≤a+2^k
    · exact (ih _ hlo h).trans (Nat.dvd_lcm_left ..)
    · have h' : d≤a+2^k+2^k := by rw [pow_succ] at hhi; omega
      exact (ih _ (by omega) h').trans (Nat.dvd_lcm_right ..)

lemma small_factor {p : ℕ} (hp : p.Prime) (a k : ℕ) (h : p ∣ common a k) : p≤a+2^k := by
  induction k generalizing a with
  | zero => exact Nat.le_of_dvd (by simp) h
  | succ k ih =>
    have hm := h.trans (Nat.lcm_dvd_mul (common a k) (common (a+2^k) k))
    rcases hp.dvd_mul.mp hm with hl|hr
    · have := ih _ hl
      rw [pow_succ]; omega
    · have := ih _ hr
      rw [pow_succ]; omega

lemma common_mag : common 0 10 = mag := by decide +kernel

lemma prime_test {n : ℕ} (hn : n ≤ 786431) : isP n = true ↔ n.Prime := by
  unfold isP
  split_ifs with h
  · simp
  · simp only [Bool.and_eq_true,beq_iff_eq]
    constructor
    · rintro ⟨_,hg⟩
      by_contra hc
      have hp := Nat.minFac_prime (by omega : n ≠ 1)
      have hs := Nat.minFac_sq_le_self (by omega) hc
      have hb : n.minFac ≤ 1024 := by nlinarith
      have hd := in_common n.minFac 0 10 hp.pos (by simpa using hb)
      rw [common_mag] at hd
      have dd := Nat.dvd_gcd (Nat.minFac_dvd n) hd
      rw [hg] at dd
      exact hp.ne_one (Nat.dvd_one.mp dd)
    · intro hp
      have ho := hp.odd_of_ne_two (by omega)
      refine ⟨Nat.odd_iff.mp ho,hp.coprime_iff_not_dvd.mpr ?_⟩
      intro hd
      rw [← common_mag] at hd
      exact h (by simpa using small_factor hp 0 10 hd)

def every (f : ℕ → Bool) (b r : ℕ) : Bool :=
  Nat.rec true (fun i prev => f (b+i) && prev) r

def span (f : ℕ → Bool) (l r : ℕ) := ∀ n, l≤n → n<r → f n = true

lemma spanOf {f : ℕ → Bool} {l r : ℕ} (h : every f l r = true) : span f l (l+r) := by
  intro n hl hr
  induction r with
  | zero => omega
  | succ r ih =>
    obtain ⟨hh,hs⟩ := Bool.and_eq_true_iff.mp h
    by_cases he : n=l+r
    · simpa [he] using hh
    · exact ih hs (by omega)

lemma joinSpan {f : ℕ → Bool} {l m r : ℕ} (a : span f l m) (b : span f m r) : span f l r :=
  fun n hl hr => (le_or_gt m n).elim (fun h => b n h hr) (fun h => a n hl h)

