def memberMask (m : ℕ) := (((if m<32768 then (if m<16384 then (if m<8192 then (if m<4096 then present0 else present1) else (if m<12288 then present2 else present3)) else (if m<24576 then (if m<20480 then present4 else present5) else (if m<28672 then present6 else present7))) else (if m<49152 then (if m<40960 then (if m<36864 then present8 else present9) else (if m<45056 then present10 else present11)) else (if m<57344 then (if m<53248 then present12 else present13) else (if m<61440 then present14 else present15)))) >>> (m%4096)) % 2) == 1

/-- Pair of count and sum in a 32-integer block, before its starting offset is added. -/
def localBits (m k : ℕ) : ℕ × ℕ :=
  let mask := m % (1 <<< k)
  let l := digit (mask%256)
  let h := digit (mask/256)
  let c := l%16 + h%16
  (c,c + 2*(l/16+h/16+8*(h%16)))

def bitOn (m j : ℕ) := ((m >>> j)%2)==1
def maskOK (m : ℕ) :=
  (localBits m 0 == (0,0)) &&
  every (fun j => localBits m (j+1) == expected (2*j+1) (localBits m j) (bitOn m j)) 0 16

def field (g : ℕ) := (page (g/8) >>> (60+40*(g%8))) % (1<<<40)
def fieldMask (g : ℕ) := field g %65536
def start (g : ℕ) : ℕ × ℕ :=
  let w := page (g/8)
  let f := field g
  let c := (f>>>16)%256
  (w%(1<<<20)+c, (w>>>20)%(1<<<40) + 256*(g/8)*c+(f>>>24))

def combine (g : ℕ) (v u : ℕ × ℕ) : ℕ × ℕ :=
  (v.1+u.1,v.2+32*g*u.1+u.2)
def oddEntry (g r : ℕ) :=
  combine g (start g) (localBits (fieldMask g) ((r+1)/2))
def plusTwo (n : ℕ) (v : ℕ × ℕ) : ℕ × ℕ :=
  (v.1+(if 2≤n then 1 else 0),v.2+(if 2≤n then 2 else 0))
def byteGroupOK (g : ℕ) :=
  let m := fieldMask g
  memberMask m &&
    every (fun j => bitOn m j == isP (32*g+2*j+1)) 0 16 &&
    (g==24575 || start (g+1) == combine g (start g) (localBits m 16))

lemma split_entry (g r : ℕ) (hr : r<32) :
    entry (32*g+r) = plusTwo (32*g+r) (oddEntry g r) := by
  have h8 : g%8+8*(g/8)=g := by omega
  have h1 : (32*g+r)/256=g/8 := by omega
  have h2 : ((32*g+r)%256)/32=g%8 := by omega
  have h3 : (32*g+r)%32=r := by omega
  simp only [entry,lookupCore,h1,h2,h3,plusTwo,oddEntry,combine,start,fieldMask,field,localBits,Prod.mk.injEq]
  constructor
  · omega
  · generalize (page (g/8) >>> (60+40*(g%8))) % (1<<<40) = u
    generalize digit (u%65536%(1<<<((r+1)/2))%256) = l
    generalize digit (u%65536%(1<<<((r+1)/2))/256) = h
    nlinarith only [congrArg (· * (l%16)) h8, congrArg (· * (h%16)) h8]

lemma combine_expected (g j : ℕ) (v u : ℕ × ℕ) (k : Bool) :
    combine g v (expected j u k) = expected (32*g+j) (combine g v u) k := by
  cases k <;> simp [expected,combine] <;> ring_nf <;> simp

lemma plusTwo_expected (n : ℕ) (v : ℕ × ℕ) (h : 2<n) (k : Bool) :
    plusTwo n (expected n v k) = expected n (plusTwo (n-1) v) k := by
  cases k <;> simp [plusTwo,expected,show 2≤n by omega,show 2≤n-1 by omega] <;> omega

lemma isP_even {n : ℕ} (he : n%2=0) (hn : 2<n) (hm : n≤786431) : isP n = false := by
  apply Bool.eq_false_iff.mpr
  intro ht
  have hp := (prime_test hm).mp ht
  have := hp.odd_of_ne_two (by omega)
  have := Nat.odd_iff.mp this
  omega

lemma groups_good (groups : ∀ g < 24576, byteGroupOK g = true)
    (masks : ∀ m < 65536, (Bool.not (memberMask m) || maskOK m) = true)
    (n : ℕ) (hn : n<786432) : entry n = expected n (entry (n-1)) (isP n) := by
  by_cases hs : n≤2
  · interval_cases n <;> decide +kernel
  let g := n/32
  let r := n%32
  have hr : r<32 := Nat.mod_lt _ (by decide)
  have he : n=32*g+r := by dsimp [r,g]; omega
  have hg : g<24576 := by dsimp [g]; omega
  have hgroup := groups g hg
  simp only [byteGroupOK,Bool.and_eq_true] at hgroup
  have hmask := masks (fieldMask g) (Nat.mod_lt _ (by decide))
  simp only [hgroup.1.1,Bool.not_true,Bool.false_or,maskOK,Bool.and_eq_true,beq_iff_eq] at hmask
  rcases Nat.eq_zero_or_pos r with hz|hpos
  · have hgp : 0<g := by omega
    let b := g-1
    have hb : b+1=g := by dsimp [b]; omega
    have hprev := groups b (by omega)
    simp only [byteGroupOK,Bool.and_eq_true,Bool.or_eq_true,beq_iff_eq] at hprev
    have hh := hprev.2.resolve_left (by omega)
    rw [hb] at hh
    have hx : isP n=false := isP_even (by omega) (by omega) (by omega)
    rw [hx,show n=32*g+0 by omega,split_entry g 0 (by decide),show 32*g+0-1=32*b+31 by omega,split_entry b 31 (by decide)]
    simp only [oddEntry,show (0+1)/2=0 by decide,hmask.1,show (31+1)/2=16 by decide,expected, Bool.false_eq_true,if_false]
    simp [combine,plusTwo, hh,show 2≤32*g by omega,show 2≤32*b+31 by omega]
  · have hh : n-1=32*g+(r-1) := by omega
    have hsplit := split_entry g r hr
    rw [← he] at hsplit
    rw [hsplit,hh,split_entry g (r-1) (by omega),← hh]
    rw [← plusTwo_expected n _ (by omega)]
    congr 1
    by_cases ev : r%2=0
    · have hp : isP n=false := isP_even (by omega) (by omega) (by omega)
      rw [hp]
      simp only [oddEntry, expected, Bool.false_eq_true,if_false,
        show (r+1)/2=((r-1)+1)/2 by omega]
    · let j := r/2
      have hj : j<16 := by dsimp [j]; omega
      have hjr : 2*j+1=r := by dsimp [j]; omega
      have hf := spanOf (l:=0) (r:=16) hgroup.1.2 j (by omega) (by omega)
      have hnext := spanOf (l:=0) (r:=16) hmask.2 j (by omega) (by omega)
      simp only [beq_iff_eq] at hf hnext
      rw [show 32*g+2*j+1=n by omega] at hf
      simp only [oddEntry,show (r+1)/2=j+1 by omega,show ((r-1)+1)/2=j by omega,
        hnext,combine_expected,hf,show 32*g+(2*j+1)=n by omega]

lemma lookup_good (cert : ∀ n < 786432, entry n = expected n (entry (n-1)) (isP n)) (e n : ℕ) (he : e≤1) (hn : n ≤ 786431) :
    lookup e n = primeTotal e n := by
  induction n with
  | zero =>
    rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;> decide +kernel
  | succ n ih =>
    have h := cert (n+1) (by omega)
    simp only [Nat.add_one_sub_one] at h
    have hh := prime_test hn
    rw [prime_total_succ, ← ih (by omega)]
    unfold lookup
    rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;>
      by_cases hp : (n+1).Prime <;>
      simp [h,expected,show isP (n+1) = decide ((n+1).Prime) from Bool.eq_iff_iff.mpr (by simpa using hh),hp]

lemma small_primes (p : ℕ) (hp : p.Prime) : p ∣ 2310 ↔ p≤11 := by
  constructor
  · intro hd
    have h : p ∣ 2*3*5*7*11 := hd
    simp only [hp.dvd_mul] at h
    rcases h with (((h|h)|h)|h)|h <;> exact (Nat.le_of_dvd (by decide) h).trans (by decide)
  · intro h
    interval_cases p <;> first | decide | norm_num at hp

lemma alive_wheel {n k : ℕ} : k ∈ survivors 11 n ↔ 0<k ∧ k≤n ∧ k.Coprime 2310 := by
  rw [alive]
  refine and_congr_right fun _ => and_congr_right fun _ => ?_
  constructor
  · intro h
    by_contra hn
    obtain ⟨q,hq,ha,hb⟩ := Nat.Prime.not_coprime_iff_dvd.mp hn
    exact (not_lt_of_ge ((small_primes q hq).mp hb)) (h q hq ha)
  · intro h q hq hd
    by_contra! hl
    exact (Nat.Prime.not_coprime_iff_dvd.mpr ⟨q,hq,hd,(small_primes q hq).mpr hl⟩) h

lemma wheel_total_succ (e n : ℕ) : total e 11 (n+1) = total e 11 n +
    if (n+1).Coprime 2310 then (n+1)^e else 0 := by
  by_cases hp : (n+1).Coprime 2310
  · have hs : survivors 11 (n+1) = insert (n+1) (survivors 11 n) := by
      ext k; simp only [alive_wheel,mem_insert]; grind
    rw [total,hs,sum_insert (by simp [alive_wheel]),if_pos hp,add_comm]; rfl
  · have hs : survivors 11 (n+1) = survivors 11 n := by
      ext k; simp only [alive_wheel]; grind
    simp [total,hs,hp]

def wc (r : ℕ) := wheelPart r % 1024
def ws (r : ℕ) := wheelPart r / 1024
def wheelOK (r : ℕ) : Bool :=
  (wc (r+1) == wc r + if (r+1).Coprime 2310 then 1 else 0) &&
  (ws (r+1) == ws r + if (r+1).Coprime 2310 then r+1 else 0)

set_option maxRecDepth 10000 in
lemma wheel_cert : span wheelOK 0 2309 := spanOf (l:=0) (r:=2309) (by decide +kernel)

lemma wheel_correct (e n : ℕ) (he : e≤1) : wheel e n = total e 11 n := by
  induction n with
  | zero =>
    rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;> decide +kernel
  | succ n ih =>
    rw [wheel_total_succ, ← ih]
    let t := n/2310
    let r := n%2310
    have hr : r<2310 := Nat.mod_lt _ (by decide)
    have hn : n=2310*t+r := by dsimp [t,r]; omega
    have h0 : wc 0=0 ∧ ws 0=0 ∧ wc 2309=480 ∧ ws 2309=554400 := by decide +kernel
    simp only [wheel, ← Nat.choose_two_right]
    change (if e=0 then (n+1)/2310*480+wc ((n+1)%2310) else
      (n+1)/2310*554400+2310*480*((n+1)/2310).choose 2+2310*((n+1)/2310)*wc ((n+1)%2310)+ws ((n+1)%2310))
      = (if e=0 then t*480+wc r else t*554400+2310*480*t.choose 2+2310*t*wc r+ws r) + _
    by_cases hend : r=2309
    · have ht : (n+1)/2310=t+1 := by omega
      have hm : (n+1)%2310=0 := by omega
      have hc : ¬ (n+1).Coprime 2310 := by
        rw [show n+1=0+(t+1)*2310 by omega,Nat.coprime_add_mul_right_left]
        decide
      rw [ht,hm,hend,if_neg hc,h0.1,h0.2.1,h0.2.2.1,h0.2.2.2]
      rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;>
        simp [Nat.choose_succ_succ'] <;> ring
    · have ht : (n+1)/2310=t := by omega
      have hm : (n+1)%2310=r+1 := by omega
      have hc : (n+1).Coprime 2310 ↔ (r+1).Coprime 2310 := by
        rw [show n+1=(r+1)+t*2310 by omega,Nat.coprime_add_mul_right_left]
      obtain ⟨cc,cs⟩ := Bool.and_eq_true_iff.mp (wheel_cert r (by omega) (by omega))
      simp only [beq_iff_eq] at cc cs
      rw [ht,hm,cc,cs]
      by_cases hh : (r+1).Coprime 2310
      · simp only [if_pos hh,if_pos (hc.mpr hh)]
        rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;> simp <;> nlinarith [hn]
      · simp only [if_neg hh,if_neg (fun h => hh (hc.mp h))]
        rcases (show e=0 ∨ e=1 by omega) with rfl|rfl <;> simp

def indexOK (i : ℕ) : Bool :=
  let p := atPrime i
  decide (p≤786431) && isP p && (lookup 0 p == i+1)

lemma total_count (n : ℕ) : primeTotal 0 n = Nat.count Nat.Prime (n+1) := by
  simp [primeTotal, Nat.primesLE_card_eq_primeCounting, Nat.primeCounting, Nat.primeCounting']

lemma table_index (pages : ∀ n < 786432, entry n = expected n (entry (n-1)) (isP n))
    (indices : ∀ i < 6828, indexOK i = true) (i : ℕ) (hi : i<6828) :
    atPrime i = Nat.nth Nat.Prime i ∧ atPrime i ≤ 786431 := by
  have h := indices i hi
  unfold indexOK at h
  simp only [Bool.and_eq_true,decide_eq_true_eq,beq_iff_eq] at h
  have hp := (prime_test h.1.1).mp h.1.2
  have hc := h.2
  rw [lookup_good pages _ _ (by decide) h.1.1,total_count,Nat.count_succ,if_pos hp] at hc
  exact ⟨(Nat.nth_count hp).symm.trans (by rw [show Nat.count Nat.Prime (atPrime i)=i by omega]),h.1.1⟩

lemma adjacent {a : ℕ} {p q : ℕ} (hp : p=Nat.nth Nat.Prime a) (hq : q=Nat.nth Nat.Prime (a+1)) :
    p < q ∧ ∀ k, k.Prime → k≤q → k≤p ∨ k=q := by
  subst p; subst q
  have hs := Nat.nth_strictMono Nat.infinite_setOfPred_prime
  refine ⟨hs (by omega),?_⟩
  intro k hk hle
  have he := Nat.nth_count hk
  rw [← he] at hle ⊢
  have hi := hs.le_iff_le.mp hle
  rcases (show Nat.count Nat.Prime k≤a ∨ Nat.count Nat.Prime k=a+1 by omega) with ha|ha
  · exact Or.inl (hs.monotone ha)
  · right; rw [ha]

lemma prefix_sum (n : ℕ) :
    ∑ i ∈ range (primeTotal 0 n), Nat.nth Nat.Prime i = primeTotal 1 n := by
  rw [total_count]
  have hs : (range (Nat.count Nat.Prime (n+1))).image (Nat.nth Nat.Prime) = n.primesLE := by
    ext k; rw [mem_image,Nat.mem_primesLE]
    constructor
    · rintro ⟨i,hi,rfl⟩
      exact ⟨by have := Nat.nth_lt_of_lt_count (mem_range.mp hi); omega, Nat.prime_nth_prime _⟩
    · rintro ⟨hl,hp⟩
      refine ⟨Nat.count Nat.Prime k,mem_range.mpr ?_,Nat.nth_count hp⟩
      have h := Nat.count_monotone Nat.Prime (show k+1≤n+1 by omega)
      rw [Nat.count_succ, if_pos hp] at h
      omega
  unfold primeTotal
  rw [← hs,sum_image]
  · simp
  · exact fun a _ b _ h => (Nat.nth_strictMono Nat.infinite_setOfPred_prime).injective h

def radix : ℕ := 1<<<40
def bundle (c s : ℕ) := c + radix*s
def lookupPack (n : ℕ) :=
  let v := entry n
  bundle v.1 v.2
def wheelPack (n : ℕ) :=
  let t := n/2310
  let z := wheelPart (n%2310)
  bundle (t*480+z%1024) (t*554400+2310*480*(t*(t-1)/2)+2310*t*(z%1024)+z/1024)
def scaled (p v : ℕ) := p*v-(p-1)*(v%radix)

def stage (a : ℕ) (prev : ℕ → ℕ) (n : ℕ) : ℕ :=
  let p := atPrime (a+5)
  if n≤p then bundle (min n 1) (min n 1) else
  if n≤786431 && n≤p*p then lookupPack n - lookupPack p + bundle 1 1 else
  prev n - scaled p (prev (n/p))

def sievePack (a : ℕ) : ℕ → ℕ :=
  Nat.rec (motive:=fun _ => ℕ → ℕ) wheelPack stage a

lemma pack_zero (n : ℕ) : sievePack 0 n = wheelPack n := rfl
lemma pack_succ (a n : ℕ) : sievePack (a+1) n = stage a (sievePack a) n := rfl

lemma bundle_zero : bundle 0 0 = 0 := by rfl
lemma bundle_add (a b c d : ℕ) : bundle a b + bundle c d = bundle (a+c) (b+d) := by
  unfold bundle; ring
lemma bundle_sub {c d m n : ℕ} (hc : c ≤ m) (hd : d ≤ n) :
    bundle m n - bundle c d = bundle (m-c) (n-d) := by
  apply Nat.sub_eq_of_eq_add
  rw [bundle_add,Nat.sub_add_cancel hc,Nat.sub_add_cancel hd]

lemma scaled_bundle (p c s : ℕ) (hp : 0<p) (hc : c<radix) :
    scaled p (bundle c s) = bundle c (p*s) := by
  have hrem : bundle c s % radix = c := by
    unfold bundle
    rw [Nat.add_mul_mod_self_left,Nat.mod_eq_of_lt hc]
  rw [scaled,hrem]
  apply Nat.sub_eq_of_eq_add
  unfold bundle
  obtain ⟨k,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : p ≠ 0)
  simp; ring

lemma total_count_le (t n : ℕ) : total 0 t n ≤ n := by
  have h := card_le_card (filter_subset (fun k : ℕ => ∀ q ∈ k.primeFactors, t < q) (Icc 1 n))
  simpa [total,survivors,Nat.card_Icc] using h

lemma primeTotal_mono (e : ℕ) : Monotone (primeTotal e) := by
  intro a b h
  apply sum_le_sum_of_subset
  intro k hk
  obtain ⟨hl,hp⟩ := Nat.mem_primesLE.mp hk
  exact Nat.mem_primesLE.mpr ⟨hl.trans h,hp⟩

lemma lookupPack_correct (pages : ∀ n < 786432, entry n = expected n (entry (n-1)) (isP n)) (n : ℕ) (hn : n≤786431) :
    lookupPack n = bundle (primeTotal 0 n) (primeTotal 1 n) := by
  rw [← lookup_good pages 0 n (by decide) hn, ← lookup_good pages 1 n (by decide) hn]
  rfl

lemma sievePack_correct (pages : ∀ n < 786432, entry n = expected n (entry (n-1)) (isP n)) (indices : ∀ i < 6828, indexOK i = true)
    (a n : ℕ) (ha : a+4<6828) (hn : n<radix) :
    sievePack a n = bundle (total 0 (atPrime (a+4)) n) (total 1 (atPrime (a+4)) n) := by
  induction a generalizing n with
  | zero =>
    have hp : atPrime 4=11 := by decide +kernel
    simp only [pack_zero,Nat.zero_add,hp,← wheel_correct 0 n (by decide),← wheel_correct 1 n (by decide)]
    rfl
  | succ a ih =>
    let p := atPrime (a+5)
    let t := atPrime (a+4)
    have hp := table_index pages indices (a+5) (by omega)
    have ht := table_index pages indices (a+4) (by omega)
    have hprim : p.Prime := by change (atPrime (a+5)).Prime; rw [hp.1]; exact Nat.prime_nth_prime _
    have had := adjacent ht.1 hp.1
    change sievePack (a+1) n = bundle (total 0 p n) (total 1 p n)
    rw [pack_succ,stage]
    by_cases hl : n≤p
    · rw [if_pos (show n≤atPrime (a+5) from hl),base_small 0 _ _ hl,base_small 1 _ _ hl]
    · rw [if_neg (show ¬n≤atPrime (a+5) from hl)]
      by_cases hc : n≤786431 ∧ n≤p*p
      · have hb : (decide (n≤786431) && decide (n≤atPrime (a+5)*atPrime (a+5))) = true := by simpa using hc
        rw [if_pos hb,lookupPack_correct pages n hc.1,lookupPack_correct pages _ hp.2,
          bundle_sub (primeTotal_mono 0 (show p≤n by omega)) (primeTotal_mono 1 (show p≤n by omega)),
          bundle_add,prime_cut 0 p n hprim.pos (by omega) hc.2,prime_cut 1 p n hprim.pos (by omega) hc.2]
      · have hb : ¬ (decide (n≤786431) && decide (n≤atPrime (a+5)*atPrime (a+5))) = true := by simpa using hc
        have hdiv := (Nat.div_le_self n p).trans_lt hn
        have h0 := peel_add 0 t p n hprim had.1 had.2
        have h1 := peel_add 1 t p n hprim had.1 had.2
        simp only [pow_zero,one_mul,pow_one] at h0 h1
        rw [if_neg hb,ih n (by omega) hn,ih (n/p) (by omega) hdiv,
          scaled_bundle _ _ _ hprim.pos ((total_count_le t (n/p)).trans_lt hdiv)]
        apply Nat.sub_eq_of_eq_add
        rw [bundle_add,h0,h1]

def extend (a n ans : ℕ) : ℕ → ℕ
  | 0 => ans
  | d+1 =>
    let p := atPrime (a+d+5)
    if n≤p then bundle (min n 1) (min n 1) else
    if n≤786431 && n≤p*p then lookupPack n - lookupPack p + bundle 1 1 else
    extend a n ans d - scaled p (sievePack (a+d) (n/p))

lemma extend_correct (a n ans : ℕ) (ha : sievePack a n=ans) (d : ℕ) :
    sievePack (a+d) n = extend a n ans d := by
  induction d with
  | zero => exact ha
  | succ d ih => rw [Nat.add_succ,pack_succ,stage,extend,ih]

lemma extend_checked {a n ans len value : ℕ} (h : sievePack a n=ans)
    (v : extend a n ans len = value) : sievePack (a+len) n=value :=
  (extend_correct a n ans h len).trans v

lemma bundle_inj {c s x y : ℕ} (hc : c<radix) (hx : x<radix)
    (h : bundle c s = bundle x y) : c=x ∧ s=y := by
  have hm := congrArg (· % radix) h
  unfold bundle at hm h
  simp only [Nat.add_mul_mod_self_left,Nat.mod_eq_of_lt hc,Nat.mod_eq_of_lt hx] at hm
  refine ⟨hm,?_⟩
  subst x
  have hr : 0<radix := by decide
  exact Nat.eq_of_mul_eq_mul_left hr (Nat.add_left_cancel h)

lemma prime_result (pages : ∀ n < 786432, entry n = expected n (entry (n-1)) (isP n)) (indices : ∀ i < 6828, indexOK i = true)
    (a n p c s pc ps : ℕ) (ha : a+4<6828) (hn : n<radix) (hp : atPrime (a+4)=p)
    (hp0 : 0<p) (hpn : p<n) (hsq : n≤p*p) (hsmall : p≤786431) (hc : c<radix)
    (hpC : lookup 0 p = pc) (hpS : lookup 1 p = ps) (hv : sievePack a n = bundle c s) :
    primeTotal 0 n = c+pc-1 ∧ primeTotal 1 n = s+ps-1 := by
  rw [sievePack_correct pages indices a n ha hn,hp] at hv
  have ht := bundle_inj ((total_count_le p n).trans_lt hn) hc hv
  rw [prime_cut 0 p n hp0 hpn hsq,prime_cut 1 p n hp0 hpn hsq] at ht
  have hm0 := primeTotal_mono 0 hpn.le
  have hm1 := primeTotal_mono 1 hpn.le
  rw [lookup_good pages 0 p (by decide) hsmall] at hpC
  rw [lookup_good pages 1 p (by decide) hsmall] at hpS
  omega

lemma window_sum {n x y sx sy : ℕ} (hp : 0<n)
    (lc : primeTotal 0 x=n-1) (ls : primeTotal 1 x=sx)
    (hc : primeTotal 0 y=2*n) (hs : primeTotal 1 y=sy) : OeisA105720.a n = sy-sx := by
  rw [OeisA105720.a,if_neg (by omega)]
  have hl := prefix_sum x
  have hh := prefix_sum y
  rw [lc,ls] at hl
  rw [hc,hs] at hh
  have ha := sum_range_add_sum_Ico (Nat.nth Nat.Prime) (show n-1≤2*n by omega)
  rw [hl,hh] at ha
  omega

