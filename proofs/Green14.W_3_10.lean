lemma center_cases (r : Fin 97 → Bool) (j : Fin 6)
    (hr : r (Fin.ofNat 97 (48 - j.val)) = true)
    (hb : ∀ i : Fin 97, 48 - j.val < i.val → i.val < 48 + j.val → r i = false) : Mono r := by
  rcases Nat.lt_trichotomy j.val 2 with h01 | h2 | h35
  · have hh : j.val = 0 ∨ j.val = 1 := by omega
    rcases hh with h | h
    · exact center0 r (by simpa [h] using hr)
    · exact center1 r (by simpa [h] using hr) (by simpa [h] using hb)
  · exact center2 r (by simpa [h2] using hr) (by simpa [h2] using hb)
  · rcases Nat.lt_trichotomy j.val 4 with h3 | h4 | h5
    · have hh : j.val = 3 := by omega
      exact center3 r (by simpa [hh] using hr) (by simpa [hh] using hb)
    · exact center4 r (by simpa [h4] using hr) (by simpa [h4] using hb)
    · have hh : j.val = 5 := by omega
      exact center5 r (by simpa [hh] using hr) (by simpa [hh] using hb)

