import FormalConjectures.GreensOpenProblems.«14»

/-!
# Exact mixed van der Waerden number W(3,10) = 97

Combines the explicit 96-position lower-bound witness with a unified 16-bit-packed
bitmask-certificate proof of the 97-position upper bound across all central offsets `j ∈ 0..5`.
-/

namespace OMA.Progressions

private def extra (x y : Nat) : Nat :=
  let a := min x y
  let d := max x y - a
  if d = 0 then 0 else
    (1 <<< (a + 2 * d)) ||| (if d ≤ a then 1 <<< (a - d) else 0) |||
      (if d % 2 = 0 then 1 <<< (a + d / 2) else 0)

private def removeMask (allowed bad : Nat) := allowed ^^^ (allowed &&& bad)

private def afterRed (red : List Nat) (allowed p : Nat) : Nat :=
  removeMask allowed (red.foldr (fun q m => extra p q ||| m) 0)

private def bluePattern (a d : Nat) : Nat :=
  (List.range 10).foldr (fun t m => (1 <<< (a + t * d)) ||| m) 0

private def decode (table : Array Nat) (i : Nat) : Nat :=
  (table[i / 256]! >>> (16 * (i % 256))) % 65536

private structure Catalog where
  size : Nat
  mask : Nat → Nat

private def walk (stop : Nat → List Nat → Nat → Bool) (tape : Array Nat) (patterns : Catalog) :
    Nat → Nat → List Nat → Nat → Bool
  | 0, _, _, _ => false
  | gas + 1, i, red, allowed =>
    let z := decode tape i
    if 1940 ≤ z then
      if z < 2196 then stop (z - 1940) red allowed
      else
        let v := z - 2196
        let p := v % 97
        walk stop tape patterns gas (i + 1) (p :: red) (afterRed red allowed p) &&
          walk stop tape patterns gas (v / 97) red (removeMask allowed (1 <<< p))
    else
      let idx := z % 970
      if idx ≥ patterns.size then false else
      let ap := patterns.mask idx
      let rest := ap &&& allowed
      if z < 970 then rest == 0 else
        let p := rest.log2
        (rest == (1 <<< p)) && walk stop tape patterns gas (i + 1) (p :: red) (afterRed red allowed p)

private def NoTriple (R : ℕ → Prop) := ∀ a d, 0 < d → R a → R (a + d) → R (a + 2 * d) → False

private lemma extra_safe {R : ℕ → Prop} (h : NoTriple R) {x y t : ℕ}
    (hx : R x) (hy : R y) (ht : R t) : (extra x y).testBit t = false := by
  suffices ordered : ∀ a d : ℕ, 0 < d → R a → R (a + d) →
      t ≠ a + 2 * d ∧ (d ≤ a → t ≠ a - d) ∧ (d % 2 = 0 → t ≠ a + d / 2) by
    unfold extra
    rcases le_total x y with hxy | hyx
    · rw [min_eq_left hxy, max_eq_right hxy]
      dsimp only
      by_cases hz : y - x = 0
      · simp [hz]
      have hb : R (x + (y - x)) := by simpa [Nat.add_sub_of_le hxy] using hy
      obtain ⟨h₁, h₂, h₃⟩ := ordered x (y - x) (by omega) hx hb
      split_ifs <;> simp_all [Nat.shiftLeft_eq, Nat.testBit_two_pow] <;> omega
    · rw [min_eq_right hyx, max_eq_left hyx]
      dsimp only
      by_cases hz : x - y = 0
      · simp [hz]
      have hb : R (y + (x - y)) := by simpa [Nat.add_sub_of_le hyx] using hx
      obtain ⟨h₁, h₂, h₃⟩ := ordered y (x - y) (by omega) hy hb
      split_ifs <;> simp_all [Nat.shiftLeft_eq, Nat.testBit_two_pow] <;> omega
  intro a d hd ha hb
  refine ⟨fun he => h a d hd ha hb (he ▸ ht), ?_, ?_⟩
  · intro hle he
    apply h (a - d) d hd (he ▸ ht)
    · simpa [Nat.sub_add_cancel hle] using ha
    · convert hb using 1 <;> omega
  · intro heven he
    apply h a (d / 2) (by omega) ha (he ▸ ht)
    convert hb using 1 <;> omega

private lemma remove_safe {a b t : ℕ} (ha : a.testBit t = true) (hb : b.testBit t = false) :
    (removeMask a b).testBit t = true := by simp [removeMask, Nat.testBit_xor, ha, hb]

private lemma after_safe {R : ℕ → Prop} (h : NoTriple R) {red : List ℕ} {a p t : ℕ}
    (hr : ∀ x ∈ red, R x) (hp : R p) (ht : R t) (ha : a.testBit t = true) :
    (afterRed red a p).testBit t = true := by
  apply remove_safe ha
  induction red with
  | nil => simp
  | cons q xs ih =>
    rw [List.foldr_cons, Nat.testBit_or, extra_safe h hp (hr q (by simp)) ht]
    simpa using ih fun x hx => hr x (by simp [hx])

private def Hits (R : ℕ → Prop) (patterns : Catalog) :=
  ∀ i, i < patterns.size → ∃ t, (patterns.mask i).testBit t = true ∧ R t

private lemma walk_sound {R : ℕ → Prop} {tape : Array ℕ} {patterns : Catalog}
    {stop : ℕ → List ℕ → Nat → Bool}
    (hst : ∀ k rs a, (∀ x ∈ rs, R x) → (∀ x, R x → a.testBit x = true) → stop k rs a ≠ true)
    (hn : NoTriple R) (hit : Hits R patterns) (gas i : ℕ) (red : List ℕ) (a : ℕ)
    (hr : ∀ x ∈ red, R x) (ha : ∀ x, R x → a.testBit x = true) :
    walk stop tape patterns gas i red a ≠ true := by
  induction gas generalizing i red a with
  | zero => simp [walk]
  | succ gas ih =>
    intro hw
    simp only [walk] at hw
    split at hw
    · split at hw
      · exact hst _ red a hr ha hw
      · simp only [Bool.and_eq_true] at hw
        obtain ⟨hl, hh⟩ := hw
        by_cases hp : R ((decode tape i - 2196) % 97)
        · exact ih _ _ _ (by simpa using And.intro hp hr)
            (fun t ht => after_safe hn hr hp ht (ha t ht)) hl
        · apply ih _ _ _ hr _ hh
          intro t ht
          apply remove_safe (ha t ht)
          simp [Nat.shiftLeft_eq, Nat.testBit_two_pow, (show (decode tape i - 2196) % 97 ≠ t by
            rintro rfl; exact hp ht)]
    · split at hw
      · contradiction
      · rename_i hin
        obtain ⟨t, hbit, ht⟩ := hit _ (by omega : decode tape i % 970 < patterns.size)
        have hrest : (patterns.mask (decode tape i % 970) &&& a).testBit t = true := by
          simp [hbit, ha t ht]
        split at hw
        · simp only [beq_iff_eq] at hw
          simp [hw] at hrest
        · simp only [Bool.and_eq_true] at hw
          obtain ⟨hpow, hs⟩ := hw
          have heq := beq_iff_eq.mp hpow
          rw [heq, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow] at hrest
          have he := of_decide_eq_true hrest
          apply ih _ _ _ _ _ hs
          · intro x hx
            rcases List.mem_cons.mp hx with he' | hh
            · simpa only [he', he] using ht
            · exact hr _ hh
          · intro x hx
            exact after_safe hn hr (he.symm ▸ ht) hx (ha x hx)

private def Bad (patterns : Catalog) (seed : List ℕ × ℕ) :=
  ∀ R : ℕ → Prop, NoTriple R → Hits R patterns →
    (∀ x ∈ seed.1, R x) → (∀ x, R x → seed.2.testBit x = true) → False

private def gate {patterns : Catalog} (leaves : Array {s // Bad patterns s})
    (k : ℕ) (red : List ℕ) (a : ℕ) : Bool :=
  match leaves[k]? with
  | some leaf => leaf.val == (red, a)
  | none => false

private lemma gate_sound {patterns : Catalog} (leaves : Array {s // Bad patterns s})
    {R : ℕ → Prop} (hn : NoTriple R) (hit : Hits R patterns) (k : ℕ) (rs : List ℕ) (a : ℕ)
    (hr : ∀ x ∈ rs, R x) (ha : ∀ x, R x → a.testBit x = true) :
    gate leaves k rs a ≠ true := by
  unfold gate
  split
  · rename_i t he
    intro hh
    have hbad := t.property
    rw [beq_iff_eq.mp hh] at hbad
    exact hbad R hn hit hr ha
  · decide

private lemma chk {pats : Catalog} {s : List ℕ × ℕ}
    (gas : ℕ) (tape : Array ℕ) (leaves : Array {p // Bad pats p})
    (h : walk (gate leaves) tape pats gas 0 s.1 s.2 = true) : Bad pats s := by
  intro R hn hit hr ha
  exact walk_sound (gate_sound leaves hn hit) hn hit gas 0 s.1 s.2 hr ha h

private def Mono (r : Fin 97 → Bool) := ∃ (b : Bool) (a d : Fin 97), 0 < d.val ∧
  a.val + (if b then 2 else 9) * d.val < 97 ∧
  ∀ t : Fin 10, t.val ≤ (if b then 2 else 9) →
    r (Fin.ofNat 97 (a.val + t.val * d.val)) = b

private def Red (r : Fin 97 → Bool) (n : ℕ) := n < 97 ∧ r (Fin.ofNat 97 n) = true

private lemma noTriple_of_not_mono {r : Fin 97 → Bool} (hn : ¬ Mono r) : NoTriple (Red r) := by
  intro a d hd h0 h1 h2
  obtain ⟨h2n, h2c⟩ := h2
  apply hn
  refine ⟨true, ⟨a, h0.1⟩, ⟨d, by omega⟩, hd, h2n, ?_⟩
  intro t ht
  change t.val ≤ 2 at ht
  have ht' : t.val = 0 ∨ t.val = 1 ∨ t.val = 2 := by omega
  rcases ht' with hh | hh | hh
  · simpa [hh] using h0.2
  · simpa [hh] using h1.2
  · simpa [hh] using h2c

private lemma pattern_has {t : ℕ} (ht : t < 10) (a d : ℕ) :
    (bluePattern a d).testBit (a + t * d) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs →
      (xs.foldr (fun i m : ℕ => (1 <<< (a + i * d)) ||| m) 0).testBit (a + t * d) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq, Nat.testBit_two_pow]
    · simp [ih h]

private def bases : Array ℕ :=
  #[0x1, 0x3ff, 0x55555, 0x9249249, 0x1111111111, 0x210842108421, 0x41041041041041,
    0x8102040810204081, 0x1010101010101010101, 0x201008040201008040201,
    0x40100401004010040100401]

private lemma base_correct : ∀ d : Fin 11, bases[d.val]! = bluePattern 0 d.val := by decide +kernel

private lemma shifted_hit {r : Fin 97 → Bool} (hn : ¬ Mono r) {a d : ℕ}
    (hd : 0 < d) (hb : a + 9 * d < 97) :
    ∃ x, ((bases[d]!) <<< a).testBit x = true ∧ Red r x := by
  by_contra! bad
  apply hn
  refine ⟨false, ⟨a, by omega⟩, ⟨d, by omega⟩, hd, hb, ?_⟩
  intro t _
  have ht : t.val ≤ 9 := by omega
  have h97 : a + t.val * d < 97 := by have := Nat.mul_le_mul_right d ht; omega
  have hbit : ((bases[d]!) <<< a).testBit (a + t.val * d) = true := by
    rw [base_correct ⟨d, by omega⟩]
    simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has t.isLt 0 d
  exact Bool.eq_false_iff.mpr fun h => bad _ hbit ⟨h97, h⟩

private def p97 : Catalog := ⟨970, fun i =>
  let a := i % 97
  let d := i / 97 + 1
  if a + 9 * d < 97 then (bases[d]! <<< a) else bases[1]!⟩

private lemma all_hit {r : Fin 97 → Bool} (hn : ¬ Mono r) : Hits (Red r) p97 := by
  intro i hi
  dsimp only [p97]
  split
  · exact shifted_hit hn (by omega) (by assumption)
  · simpa using shifted_hit hn (a := 0) (d := 1) (by decide) (by decide)

private abbrev B := Bad p97

