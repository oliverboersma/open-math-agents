private lemma center2 (r : Fin 97 → Bool) (hr : r (Fin.ofNat 97 46) = true)
    (hb : ∀ i : Fin 97, 46 < i.val → i.val < 50 → r i = false) : Mono r := by
  by_contra hn
  apply b42 (Red r) (noTriple_of_not_mono hn) (all_hit hn)
  · intro x hx
    have he : x = 46 := by simpa using hx
    exact he ▸ ⟨by decide, hr⟩
  · intro x hx
    obtain ⟨hxlt, hred⟩ := hx
    have hbound : x ≤ 46 ∨ 50 ≤ x := by
      by_contra! bad
      have hblue := hb ⟨x, hxlt⟩ bad.1 bad.2
      have he : (Fin.ofNat 97 x) = ⟨x, hxlt⟩ := Fin.ext (Nat.mod_eq_of_lt hxlt)
      exact Bool.noConfusion (hred.symm.trans ((congrArg r he).trans hblue))
    have hbits : ∀ t : Fin 97, t.val ≤ 46 ∨ 50 ≤ t.val →
        Nat.testBit 0x1fffffffffffc7fffffffffff t.val = true := by decide +kernel
    exact hbits ⟨x, hxlt⟩ hbound

