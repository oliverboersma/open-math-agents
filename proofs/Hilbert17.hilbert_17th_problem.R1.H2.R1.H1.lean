import OMAReductions.R_Hilbert17_hilbert_17th_problem_R1_H2_R1
import Mathlib

/-! A positive nonsquare admits an ordered quadratic extension. The preordering
is generated by nonnegative base scalars times squares. Its elements have
nonnegative real coordinate since the radicand is positive.
The maximal-preordering argument adapts the merged Artin–Schreier step
for Hilbert 17 by @jared-jasinski. -/

namespace Quad17

private structure IsPreorder {K : Type} [Field K] (P : Set K) : Prop where
  sq_mem : ∀ x : K, x * x ∈ P
  add_mem : ∀ {x y : K}, x ∈ P → y ∈ P → x + y ∈ P
  mul_mem : ∀ {x y : K}, x ∈ P → y ∈ P → x * y ∈ P
  neg_one_not_mem : (-1 : K) ∉ P

private lemma IsPreorder.zero_mem {K : Type} [Field K] {P : Set K} (hP : IsPreorder P) :
    (0 : K) ∈ P := by
  simpa using hP.sq_mem 0

private lemma IsPreorder.one_mem {K : Type} [Field K] {P : Set K} (hP : IsPreorder P) :
    (1 : K) ∈ P := by
  simpa using hP.sq_mem 1

-- Adjoining an element x to a preordering P produces a preordering unless -1 is generated.
private lemma adjoin_total {K : Type} [Field K] {P : Set K} (hP : IsPreorder P)
    (hmax : ∀ Q : Set K, IsPreorder Q → P ⊆ Q → Q = P) (x : K) :
    x ∈ P ∨ -x ∈ P := by
  by_contra hneither
  push Not at hneither
  let Q : Set K := {z | ∃ u v : K, u ∈ P ∧ v ∈ P ∧ z = u + x * v}
  have hPQ : P ⊆ Q := fun u hu => ⟨u, 0, hu, hP.zero_mem, by ring⟩
  have hxQ : x ∈ Q := ⟨0, 1, hP.zero_mem, hP.one_mem, by ring⟩
  have hQ_not_prop : (-1 : K) ∈ Q := by
    by_contra hneg1
    have hQ : IsPreorder Q := by
      refine ⟨?_, ?_, ?_, hneg1⟩
      · intro z; exact hPQ (hP.sq_mem z)
      · rintro z1 z2 ⟨u1, v1, hu1, hv1, rfl⟩ ⟨u2, v2, hu2, hv2, rfl⟩
        exact ⟨u1 + u2, v1 + v2, hP.add_mem hu1 hu2, hP.add_mem hv1 hv2, by ring⟩
      · rintro z1 z2 ⟨u1, v1, hu1, hv1, rfl⟩ ⟨u2, v2, hu2, hv2, rfl⟩
        exact ⟨u1 * u2 + (x * x) * (v1 * v2), u1 * v2 + u2 * v1,
          hP.add_mem (hP.mul_mem hu1 hu2) (hP.mul_mem (hP.sq_mem x) (hP.mul_mem hv1 hv2)),
          hP.add_mem (hP.mul_mem hu1 hv2) (hP.mul_mem hu2 hv1), by ring⟩
    have hQP : Q = P := hmax Q hQ hPQ
    exact hneither.1 (hQP ▸ hxQ)
  obtain ⟨u, v, hu, hv, hneg⟩ := hQ_not_prop
  by_cases hv0 : v = 0
  · subst hv0
    have h1u : (-1 : K) = u := by linear_combination hneg
    exact hP.neg_one_not_mem (h1u ▸ hu)
  · have hxv : -x * v = 1 + u := by linear_combination hneg
    have hnx_eq : -x = (1 + u) * v * (v⁻¹ * v⁻¹) := by
      field_simp [hv0]
      linear_combination hxv
    have hnx_mem : -x ∈ P := by
      rw [hnx_eq]
      exact hP.mul_mem (hP.mul_mem (hP.add_mem hP.one_mem hu) hv) (hP.sq_mem v⁻¹)
    exact hneither.2 hnx_mem

private lemma antisymm_of_preorder {K : Type} [Field K] {P : Set K} (hP : IsPreorder P)
    {x : K} (hx : x ∈ P) (hnx : -x ∈ P) : x = 0 := by
  by_contra hx0
  have hneg1 : (-1 : K) = (-x) * x * (x⁻¹ * x⁻¹) := by
    field_simp [hx0]
  exact hP.neg_one_not_mem (hneg1 ▸ hP.mul_mem (hP.mul_mem hnx hx) (hP.sq_mem x⁻¹))

-- Maximal preordering extending P0 via Zorn's lemma.
private lemma exists_max_preorder {K : Type} [Field K] {P0 : Set K} (hP0 : IsPreorder P0) :
    ∃ P : Set K, P0 ⊆ P ∧ IsPreorder P ∧ ∀ Q : Set K, IsPreorder Q → P ⊆ Q → Q = P := by
  let S : Set (Set K) := {Q | P0 ⊆ Q ∧ IsPreorder Q}
  have hchain : ∀ c ⊆ S, IsChain (· ⊆ ·) c → c.Nonempty → ∃ ub ∈ S, ∀ s ∈ c, s ⊆ ub := by
    intro c hc hch hne
    refine ⟨⋃₀ c, ⟨?_, ?_⟩, fun s hs => Set.subset_sUnion_of_mem hs⟩
    · obtain ⟨s0, hs0⟩ := hne
      exact (hc hs0).1.trans (Set.subset_sUnion_of_mem hs0)
    · refine ⟨?_, ?_, ?_, ?_⟩
      · intro x
        obtain ⟨s0, hs0⟩ := hne
        exact Set.mem_sUnion.mpr ⟨s0, hs0, (hc hs0).2.sq_mem x⟩
      · intro x y hx hy
        obtain ⟨s1, hs1, hx1⟩ := Set.mem_sUnion.mp hx
        obtain ⟨s2, hs2, hy2⟩ := Set.mem_sUnion.mp hy
        rcases hch.total hs1 hs2 with h12 | h21
        · exact Set.mem_sUnion.mpr ⟨s2, hs2, (hc hs2).2.add_mem (h12 hx1) hy2⟩
        · exact Set.mem_sUnion.mpr ⟨s1, hs1, (hc hs1).2.add_mem hx1 (h21 hy2)⟩
      · intro x y hx hy
        obtain ⟨s1, hs1, hx1⟩ := Set.mem_sUnion.mp hx
        obtain ⟨s2, hs2, hy2⟩ := Set.mem_sUnion.mp hy
        rcases hch.total hs1 hs2 with h12 | h21
        · exact Set.mem_sUnion.mpr ⟨s2, hs2, (hc hs2).2.mul_mem (h12 hx1) hy2⟩
        · exact Set.mem_sUnion.mpr ⟨s1, hs1, (hc hs1).2.mul_mem hx1 (h21 hy2)⟩
      · intro hneg1
        obtain ⟨s0, hs0, hmem⟩ := Set.mem_sUnion.mp hneg1
        exact (hc hs0).2.neg_one_not_mem hmem
  obtain ⟨P, hP0P, hPmax⟩ := zorn_subset_nonempty S hchain P0 ⟨Set.Subset.rfl, hP0⟩
  have hPS : P ∈ S := hPmax.prop
  refine ⟨P, hP0P, hPS.2, fun Q hQ hPQ => ?_⟩
  exact (hPmax.eq_of_subset ⟨hP0P.trans hPQ, hQ⟩ hPQ).symm


section
variable {F : Type} [Field F] [LinearOrder F] [IsStrictOrderedRing F]
variable {E : Type} [Field E] [Algebra F E]

/-- Finite sums of squares weighted by nonnegative base-field scalars. -/
private inductive Weighted (F : Type) [Field F] [LinearOrder F]
    {E : Type} [CommRing E] [Algebra F E] : E → Prop where
  | term (c : F) (hc : 0≤c) (y : E) : Weighted F (algebraMap F E c * (y*y))
  | add {x y : E} : Weighted F x → Weighted F y → Weighted F (x+y)

private lemma weighted_mul {x y : E} (hx : Weighted F x) (hy : Weighted F y) :
    Weighted F (x*y) := by
  induction hx with
  | term c hc u =>
    induction hy with
    | term d hd v =>
      convert Weighted.term (c*d) (mul_nonneg hc hd) (u*v) using 1; rw [map_mul]; ring
    | add h₁ h₂ ih₁ ih₂ => rw [mul_add]; exact .add ih₁ ih₂
  | add h₁ h₂ ih₁ ih₂ => rw [add_mul]; exact .add ih₁ ih₂

private lemma weighted_re {a : F} (ha : 0≤a) {z : QuadraticAlgebra F a 0}
    (h : Weighted F z) : 0 ≤ z.re := by
  induction h with
  | term c hc u =>
    simp only [QuadraticAlgebra.re_mul,QuadraticAlgebra.algebraMap_re,
      QuadraticAlgebra.algebraMap_im,zero_mul,mul_zero,add_zero]
    exact mul_nonneg hc (by nlinarith [mul_self_nonneg u.re,mul_nonneg ha (mul_self_nonneg u.im)])
  | add _ _ ih₁ ih₂ => exact add_nonneg ih₁ ih₂

private lemma extend_cone {P₀ : Set E} (h₀ : IsPreorder P₀) :
    ∃ (_ : LinearOrder E) (_ : IsStrictOrderedRing E), ∀ x ∈ P₀, 0 ≤ x := by
  classical
  obtain ⟨P, hle, hP, hmax⟩ := exists_max_preorder h₀
  let C : RingCone E := {
    carrier := P
    zero_mem' := hP.zero_mem
    one_mem' := hP.one_mem
    add_mem' := hP.add_mem
    mul_mem' := hP.mul_mem
    eq_zero_of_mem_of_neg_mem' := fun hp hn => antisymm_of_preorder hP hp hn }
  letI : HasMemOrNegMem C := ⟨adjoin_total hP hmax⟩
  letI : LinearOrder E := .mkOfAddGroupCone C
  letI : IsOrderedRing E := IsOrderedRing.mkOfCone C
  refine ⟨inferInstance,inferInstance,fun x hx => ?_⟩
  change x-0 ∈ P
  simpa using hle hx

end

end Quad17

theorem OMA.solution : OMA.R_Hilbert17_hilbert_17th_problem_R1_H2_R1.H1 := by
  classical
  intro F _ _ _ a ha hns
  letI : Fact (∀ r : F, r^2 ≠ a+0*r) := ⟨by
    intro r h
    exact hns ⟨r, by simpa [sq] using h.symm⟩⟩
  let E := QuadraticAlgebra F a 0
  let P : Set E := {z | Quad17.Weighted F z}
  have hp : Quad17.IsPreorder P := {
    sq_mem := fun x => by simpa [P] using Quad17.Weighted.term (1:F) zero_le_one x
    mul_mem := Quad17.weighted_mul
    add_mem := Quad17.Weighted.add
    neg_one_not_mem := fun h => by
      have hh := Quad17.weighted_re (z := (-1 : QuadraticAlgebra F a 0)) ha h
      simpa only [QuadraticAlgebra.re_neg,QuadraticAlgebra.re_one,neg_nonneg,not_le_of_gt zero_lt_one] using hh }
  obtain ⟨order, strict, horder⟩ := Quad17.extend_cone hp
  refine ⟨E,inferInstance,order,strict,inferInstance,inferInstance,fun x hx => horder _ ?_,?_⟩
  · simpa [P] using Quad17.Weighted.term x hx (1:E)
  · exact ⟨(QuadraticAlgebra.omega : QuadraticAlgebra F a 0), by rw [QuadraticAlgebra.omega_mul_omega_eq_algebraMap]; simp [E]⟩
