/-! Anchor the partial-summation inequality at 5,000,000 by bounding the sum of
`log T - log p` over primes. A segmented sieve removes residue classes by bitwise
operations. Each survivor count is checked by the kernel. The logarithms are
enclosed recursively using `log (b/a) ≤ (b-a)/a` on an integer grid. -/

namespace Sieve930
def period (d : ℕ) : ℕ → ℕ
  | 0 => 1
  | k+1 => let w := period d k; w ||| (w <<< (d * 2^k))

theorem period_sound (d k i : ℕ) (h : (period d k).testBit i = true) : d ∣ i := by
  induction k generalizing i with
  | zero =>
    change (2^0 : ℕ).testBit i = true at h
    rw [Nat.testBit_two_pow, decide_eq_true_eq] at h
    subst i
    exact dvd_zero d
  | succ k ih =>
    simp only [period, Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_eq_true,
      Bool.and_eq_true, decide_eq_true_eq] at h
    rcases h with h | ⟨hi,h⟩
    · exact ih _ h
    · have hd := dvd_add (ih _ h) (dvd_mul_right d (2^k))
      rwa [Nat.sub_add_cancel hi] at hd

def bits (a len : ℕ) : List ℕ → ℕ
  | [] => 0
  | d::ds => (if 2 ≤ d ∧ d < a then
      (period d ((len / d + 2).log2 + 1)) >>> (a % d) else 0) ||| bits a len ds

theorem bits_sound {a len i : ℕ} (hp : (a+i).Prime) (ds : List ℕ) :
    (bits a len ds).testBit i = false := by
  induction ds with
  | nil => simp [bits]
  | cons d ds ih =>
    simp only [bits, Nat.testBit_or, ih, Bool.or_false]
    split_ifs with hd
    · simp only [Nat.testBit_shiftRight]
      apply Bool.eq_false_iff.mpr
      intro h
      have hmod := period_sound _ _ _ h
      have hdiv : d ∣ a+i := by
        have h' := dvd_add hmod (dvd_mul_right d (a / d))
        rwa [show a % d + i + d * (a / d) = a+i by
          have := Nat.mod_add_div a d; omega] at h'
      rcases (Nat.dvd_prime hp).mp hdiv with h | h <;> omega
    · simp

def alive (a len : ℕ) (ds : List ℕ) := (2^len - 1) ^^^ ((bits a len ds) % 2^len)

theorem alive_prime {a len i : ℕ} (hi : i < len) (hp : (a+i).Prime) (ds : List ℕ) :
    (alive a len ds).testBit i = true := by
  simp [alive, hi, bits_sound hp ds]

def pc (x n : ℕ) : ℕ := ((Finset.range n).filter (fun i => x.testBit i)).card

theorem pc_split (x n k : ℕ) : pc x (k+n) = pc x k + pc (x >>> k) n := by
  simp only [pc, Finset.card_filter]
  rw [Finset.sum_range_add]
  simp [Nat.testBit_shiftRight]

theorem pc_low (x k : ℕ) : pc x k = pc (x % 2^k) k := by
  unfold pc
  congr 1
  ext i
  simp only [Finset.mem_filter, Finset.mem_range, Nat.testBit_mod_two_pow, Bool.and_eq_true,
    decide_eq_true_eq]
  tauto

def nibble : ℕ → ℕ := fun x => (0x4332322132212110 >>> (4*x)) % 16

theorem nibble_ok (x : ℕ) (h : x < 16) : pc x 4 = nibble x := by
  interval_cases x <;> decide

def pop : ℕ → ℕ → ℕ
  | 0, _ => 0
  | n+1, x => nibble (x%16) + pop n (x >>> 4)

theorem pc_pop (x n : ℕ) : pc x (4*n) = pop n x := by
  induction n generalizing x with
  | zero => simp [pc, pop]
  | succ n ih =>
    rw [show 4*(n+1) = 4+4*n by omega, pc_split, pc_low x 4, show (2:ℕ)^4=16 by decide, nibble_ok _ (Nat.mod_lt _ (by decide)), ih]
    rfl

end Sieve930


open Real Finset
namespace Mass930
abbrev T : ℕ := 5000000
abbrev D : ℕ := 10000000
noncomputable def weight (p : ℕ) : ℝ := if p.Prime then log (T:ℝ) - log (p:ℝ) else 0
noncomputable def mass (a : ℕ) : ℝ := ∑ p ∈ Ico a (T+1), weight p
def S (a w c : ℕ) : Prop :=
  (log (T:ℝ) - log a) * D ≤ w ∧ mass a * D ≤ c

theorem base : S (T+1) 0 0 := by
  constructor
  · have h : log (T : ℝ) ≤ log ((T+1:ℕ) : ℝ) :=
      Real.log_le_log (by norm_num) (by norm_num)
    norm_num [D] at *
    linarith
  · simp [mass]

theorem step {a b wa wb ca cb np : ℕ}
    (h : S b wb cb)
    (hcount : ((range (b-a)).filter (fun i => (a+i).Prime)).card ≤ np)
    (ha : 0<a) (hab : a≤b) (hb : b≤T+1)
    (hlog : wb*a + (b-a)*D ≤ wa*a) (hc : np*wa+cb ≤ ca) : S a wa ca := by
  have ha' : 0 < (a:ℝ) := by exact_mod_cast ha
  have hb' : 0 < (b:ℝ) := by exact_mod_cast lt_of_lt_of_le ha hab
  have hl₀ := log_le_sub_one_of_pos (div_pos hb' ha')
  rw [Real.log_div hb'.ne' ha'.ne'] at hl₀
  have hp : (log (b:ℝ) - log a) * a ≤ b-a := by
    apply (le_div_iff₀ ha').mp
    calc
      _ ≤ (b:ℝ)/a - 1 := hl₀
      _ = _ := by field_simp
  have hl' : (wb:ℝ)*a + ((b:ℝ)-a)*D ≤ (wa:ℝ)*a := by
    simpa only [Nat.cast_add, Nat.cast_mul, Nat.cast_sub hab] using
      (show ((wb*a + (b-a)*D : ℕ):ℝ) ≤ ((wa*a:ℕ):ℝ) by exact_mod_cast hlog)
  have hl : (log (T:ℝ) - log a) * D ≤ wa := by
    apply (mul_le_mul_iff_left₀ ha').mp
    nlinarith [mul_le_mul_of_nonneg_right h.1 ha'.le,
      mul_le_mul_of_nonneg_right hp (show 0 ≤ (D:ℝ) by norm_num)]
  refine ⟨hl, ?_⟩
  have hw (i : ℕ) (hi : (a+i).Prime) : weight (a+i) * D ≤ wa := by
    simp only [weight, if_pos hi]
    have hm : log (a:ℝ) ≤ log ((a+i:ℕ):ℝ) :=
      Real.log_le_log ha' (by exact_mod_cast Nat.le_add_right a i)
    norm_num [D] at *
    linarith
  have hshort : (∑ i ∈ range (b-a), weight (a+i)) * D ≤ (np:ℝ)*wa := by
    rw [Finset.sum_mul]
    calc
      _ = ∑ i ∈ (range (b-a)).filter (fun j => (a+j).Prime), weight (a+i) * D := by
          rw [Finset.sum_filter]
          apply Finset.sum_congr rfl
          intro i _
          split_ifs with hp
          · rfl
          · simp [weight, hp]
      _ ≤ ∑ _i ∈ (range (b-a)).filter (fun j => (a+j).Prime), (wa:ℝ) := by
          apply Finset.sum_le_sum
          intro i hi
          exact hw i (Finset.mem_filter.mp hi).2
      _ ≤ _ := by
          simp only [Finset.sum_const, nsmul_eq_mul]
          gcongr
  have hm : mass a = (∑ i ∈ range (b-a), weight (a+i)) + mass b := by
    unfold mass
    rw [← Finset.sum_Ico_consecutive weight hab hb, Finset.sum_Ico_eq_sum_range]
  rw [hm, add_mul]
  have hc' : (np:ℝ)*wa+cb ≤ ca := by exact_mod_cast hc
  linarith [h.2]

theorem weighted : mass 2 =
    (Nat.primeCounting T : ℝ) * log (T:ℝ) - Chebyshev.theta (T:ℝ) := by
  have hset : (Ico 2 (T+1)).filter Nat.Prime = Nat.primesLE T := by
    ext p
    simp only [mem_filter, mem_Ico, Nat.mem_primesLE]
    constructor
    · rintro ⟨⟨_,ht⟩,hp⟩; exact ⟨by omega, hp⟩
    · rintro ⟨ht,hp⟩; exact ⟨⟨hp.two_le,by omega⟩, hp⟩
  simp only [mass, weight, ← Finset.sum_filter, hset, Finset.sum_sub_distrib,
    Finset.sum_const, nsmul_eq_mul, Nat.primesLE_card_eq_primeCounting, Chebyshev.theta_eq_sum_primesLE_log]
end Mass930


namespace Mass930
open Real

theorem logBounds : 15 ≤ log (T:ℝ) ∧ log (T:ℝ) ≤ 15.44 := by
  have hT : (T:ℝ) = 2^20 * ((5:ℝ)/4)^7 := by norm_num [T]
  have h1 : (1:ℝ)/5 ≤ log ((5:ℝ)/4) := by
    have hh := Real.log_le_sub_one_of_pos (show (0:ℝ)<4/5 by norm_num)
    rw [show (4:ℝ)/5 = (5/4)⁻¹ by norm_num, Real.log_inv] at hh
    linarith
  have h2 : log ((5:ℝ)/4) ≤ 0.225 := by
    apply (Real.log_le_iff_le_exp (by norm_num)).2
    have hh := Real.quadratic_le_exp_of_nonneg (show (0:ℝ) ≤ 0.225 by norm_num)
    linarith
  rw [hT, Real.log_mul (by norm_num) (by norm_num), Real.log_pow, Real.log_pow]
  constructor <;> norm_num <;> linarith [Real.log_two_gt_d9, Real.log_two_lt_d9]

theorem finish (hm : mass 2 ≤ 378600) :
    (Nat.primeCounting T : ℝ) - Chebyshev.theta (T:ℝ) / log (T:ℝ) ≤
      T/(log (T:ℝ)-11/10) - T/log (T:ℝ) - T/(5*(log (T:ℝ))^3) := by
  let L := log (T:ℝ)
  have hlo : 15 ≤ L := logBounds.1
  have hhi : L ≤ 15.44 := logBounds.2
  have hp : 0<L := by linarith
  have hden : 0<L-11/10 := by linarith
  have ha : (383100:ℝ) ≤ 5500000/(L-11/10) := by
    apply (le_div_iff₀ hden).2
    linarith
  have hb : (5000000:ℝ)/(5*L^2) ≤ 4500 := by
    apply (div_le_iff₀ (by positivity)).2
    nlinarith [mul_nonneg (sub_nonneg.mpr hlo) (show 0 ≤ L+15 by linarith)]
  change _ - _ / L ≤ (T:ℝ)/(L-11/10) - T/L - T/(5*L^3)
  apply (le_of_mul_le_mul_right · hp)
  calc
    _ = mass 2 := by
      rw [weighted, sub_mul, div_mul_cancel₀ _ hp.ne']
    _ ≤ 378600 := hm
    _ ≤ 5500000/(L-11/10) - 5000000/(5*L^2) := by linarith
    _ = _ := by
      change 5500000/(L-11/10) - 5000000/(5*L^2) =
        (5000000/(L-11/10) - 5000000/L - 5000000/(5*L^3))*L
      generalize hy : L-11/10 = y
      have hy' : y ≠ 0 := hy ▸ hden.ne'
      field_simp [hy', hp.ne']
      rw [← hy]
      ring
end Mass930


namespace Sieve930
open Finset

theorem count_le (a len : ℕ) (ds : List ℕ) :
    ((range len).filter (fun i => (a+i).Prime)).card ≤
    pop ((len+3)/4) (alive a len ds) := by
  rw [← pc_pop]
  apply Finset.card_le_card
  intro i hi
  obtain ⟨hi,hp⟩ := Finset.mem_filter.mp hi
  have hin := Finset.mem_range.mp hi
  exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), alive_prime hin hp ds⟩

end Sieve930
namespace Mass930
open Sieve930

def test (a b wa wb ca cb np : ℕ) (ds : List ℕ) : Bool :=
  decide (0 < a ∧ a ≤ b ∧ b ≤ T+1 ∧
    wb*a + (b-a)*D ≤ wa*a ∧ np*wa + cb ≤ ca ∧
    pop (((b-a)+3)/4) (alive a (b-a) ds) ≤ np)

theorem cert {a b wa wb ca cb : ℕ} (np : ℕ) (ds : List ℕ)
    (h : S b wb cb) (v : test a b wa wb ca cb np ds = true) : S a wa ca := by
  simp only [test, decide_eq_true_eq] at v
  exact step h ((count_le a (b-a) ds).trans v.2.2.2.2.2) v.1 v.2.1 v.2.2.1 v.2.2.2.1 v.2.2.2.2.1
end Mass930


namespace Mass930
structure Row where
  a : ℕ
  w : ℕ
  c : ℕ
  n : ℕ
  divisors : List ℕ

def verify (b : Row) : List Row → Bool
  | [] => true
  | a :: rows => test a.a b.a a.w b.w a.c b.c a.n a.divisors && verify a rows

def endpoint (b : Row) : List Row → Row
  | [] => b
  | a :: rows => endpoint a rows

theorem block {b : Row} (rows : List Row) (h : S b.a b.w b.c) (v : verify b rows = true) :
    S (endpoint b rows).a (endpoint b rows).w (endpoint b rows).c := by
  induction rows generalizing b with
  | nil => exact h
  | cons a rows ih =>
    simp only [verify, Bool.and_eq_true] at v
    exact ih (cert a.n a.divisors h v.1) v.2

private def initialRow : Row := ⟨T+1,0,0,0,[]⟩
end Mass930


