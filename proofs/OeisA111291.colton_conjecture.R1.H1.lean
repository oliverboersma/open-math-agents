private theorem smallDivisors_eq : smallDivisors = eligibleDivisors := by decide +kernel

private lemma mem_smallDivisors {p : Nat} :
    p ∈ smallDivisors ↔ p < 3201 ∧ 2 ≤ p ∧ (p ≤ 64 ∨ Nat.Coprime p (Nat.factorial 64)) := by
  rw [smallDivisors_eq, eligibleDivisors, List.mem_filter, List.mem_range, decide_eq_true_eq]

private lemma prime_mem_smallDivisors {p : Nat} (hp : p.Prime) (hb : p < 3201) :
    p ∈ smallDivisors := by
  refine mem_smallDivisors.mpr ⟨hb,hp.two_le,?_⟩
  by_cases h : p ≤ 64
  · exact Or.inl h
  · exact Or.inr (hp.coprime_factorial_of_lt (by omega))

private def properMask (width lo len p : Nat) : Nat :=
  progressionMask width lo len p ^^^
    (if lo ≤ p ∧ p < lo+len then (1 : Nat) <<< (width*(p-lo)) else 0)

private lemma properMask_bit {width lo len p i : Nat} (hw : 0 < width) (hp : 0 < p)
    (hi : i < len) :
    (properMask width lo len p).testBit (width*i) = true ↔ p ∣ lo+i ∧ p ≠ lo+i := by
  have singleton :
      (if lo ≤ p ∧ p < lo+len then (1 : Nat) <<< (width*(p-lo)) else 0).testBit
        (width*i) = true ↔ p = lo+i := by
    split
    · next h =>
      rw [Nat.testBit_shiftLeft, Bool.and_eq_true, decide_eq_true_eq,
        Nat.testBit_one_eq_true_iff_self_eq_zero]
      constructor
      · rintro ⟨hle,hzero⟩
        have he : width*i = width*(p-lo) := by omega
        have hi := Nat.eq_of_mul_eq_mul_left hw he
        omega
      · intro he
        have hi : p-lo = i := by omega
        simp [hi]
    · next h =>
      simp only [Nat.zero_testBit, Bool.false_eq_true, false_iff]
      omega
  unfold properMask
  rw [Nat.testBit_xor]
  by_cases h : p = lo+i
  · have hm := (progression_bit hw hp lo len i hi).mpr (h ▸ (dvd_rfl : p ∣ p))
    rw [hm, singleton.mpr h]
    simp [h]
  · have hs : (if lo ≤ p ∧ p < lo+len then (1 : Nat) <<< (width*(p-lo)) else 0).testBit
          (width*i) = false := Bool.eq_false_iff.mpr (h ∘ singleton.mp)
    rw [hs, Bool.xor_false, progression_bit hw hp lo len i hi]
    simp [h]

private def rejectMask (width lo len : Nat) : List Nat → Nat
  | [] => 0
  | p :: ps => (properMask width lo len p) ||| rejectMask width lo len ps

private lemma rejectMask_bit {width lo len i : Nat} (hw : 0 < width) (hi : i < len)
    (ps : List Nat) (hps : ∀ p ∈ ps, 0 < p) :
    (rejectMask width lo len ps).testBit (width*i) = true ↔ ∃ p ∈ ps, p ∣ lo+i ∧ p ≠ lo+i := by
  induction ps with
  | nil => simp [rejectMask]
  | cons p ps ih =>
    rw [rejectMask, Nat.testBit_or, Bool.or_eq_true, properMask_bit hw (hps p (by simp)) hi,
      ih (fun q hq => hps q (List.mem_cons_of_mem _ hq))]
    simp only [List.mem_cons]
    constructor
    · rintro (hp | ⟨q,hq,hd⟩)
      · exact ⟨p, Or.inl rfl, hp⟩
      · exact ⟨q, Or.inr hq, hd⟩
    · rintro ⟨q,rfl | hq, hd⟩
      · exact Or.inl hd
      · exact Or.inr ⟨q,hq,hd⟩

private def intervalDivisors (limit : Nat) : List Nat :=
  smallDivisors.filter (fun p => decide (p^2 < limit))

private lemma mem_intervalDivisors {limit p : Nat} :
    p ∈ intervalDivisors limit ↔ p ∈ smallDivisors ∧ p^2 < limit := by
  rw [intervalDivisors, List.mem_filter, decide_eq_true_eq]

private lemma no_small_factor {n limit : Nat} (hlo : 2 ≤ n) (hn : n < limit) (hhi : limit ≤ 10240000) :
    (¬ ∃ p ∈ intervalDivisors limit, p ∣ n ∧ p ≠ n) ↔ n.Prime := by
  constructor
  · intro h
    by_contra hnot
    have hp : n.minFac.Prime := Nat.minFac_prime (by omega)
    have hs := Nat.minFac_sq_le_self (by omega : 0 < n) hnot
    have hmin : n.minFac < 3201 := by
      by_contra! h
      have := Nat.pow_le_pow_left h 2
      norm_num at this
      omega
    exact h ⟨n.minFac, mem_intervalDivisors.mpr ⟨prime_mem_smallDivisors hp hmin, hs.trans_lt hn⟩, n.minFac_dvd,
      ne_of_lt ((Nat.not_prime_iff_minFac_lt hlo).mp hnot)⟩
  · intro h hn
    obtain ⟨p, hp, hd, hne⟩ := hn
    obtain ⟨hbound,hp,_⟩ := mem_smallDivisors.mp (mem_intervalDivisors.mp hp).1
    exact hne ((Nat.dvd_prime_two_le h hp).mp hd)

private def liveMask (width lo len : Nat) : Nat :=
  let box := pulses width len
  box ^^^ (box &&& rejectMask width lo len (intervalDivisors (lo+len)))

private lemma liveMask_eq {width lo len : Nat} (hw : 0 < width)
    (hlo : 2 ≤ lo) (hhi : lo+len ≤ 10240000) :
    liveMask width lo len = encoded width len (fun i => decide ((lo+i).Prime)) := by
  apply Nat.eq_of_testBit_eq
  intro j
  have he :
      (liveMask width lo len).testBit j = true ↔
        ∃ i < len, j = width*i ∧ (lo+i).Prime := by
    unfold liveMask
    rw [Nat.testBit_xor, Nat.testBit_and]
    cases h : (pulses width len).testBit j
    · simp only [Bool.false_and, Bool.false_xor, Bool.false_eq_true, false_iff]
      rintro ⟨i, hi, hj, _⟩
      have htrue := (pulses_bit hw len j).mpr ⟨i,hi,hj⟩
      rw [h] at htrue
      cases htrue
    · simp only [Bool.true_and, Bool.true_xor]
      obtain ⟨i,hi,rfl⟩ := (pulses_bit hw len j).mp h
      have hit := rejectMask_bit (lo := lo) hw hi (intervalDivisors (lo+len))
          (fun p hp => Nat.lt_of_lt_of_le (by decide : 0 < 2) (mem_smallDivisors.mp (mem_intervalDivisors.mp hp).1).2.1)
      have hbool :
          (!(rejectMask width lo len (intervalDivisors (lo+len))).testBit (width*i)) = true ↔
          (rejectMask width lo len (intervalDivisors (lo+len))).testBit (width*i) = false := by
        cases (rejectMask width lo len (intervalDivisors (lo+len))).testBit (width*i) <;> decide
      have hnn : (rejectMask width lo len (intervalDivisors (lo+len))).testBit (width*i) = false
          ↔ ¬ ∃ p ∈ intervalDivisors (lo+len), p ∣ lo+i ∧ p ≠ lo+i := by
        rw [← Bool.not_eq_true, hit]
      rw [hbool, hnn, no_small_factor (by omega) (by omega) hhi]
      constructor
      · intro hp
        exact ⟨i,hi,rfl,hp⟩
      · rintro ⟨k,hk,hik,hp⟩
        have heq := Nat.eq_of_mul_eq_mul_left hw hik
        simpa only [heq] using hp
  apply Bool.eq_iff_iff.mpr
  rw [he, encoded_bit hw]
  simp only [decide_eq_true_eq]

/-- Unwidened packed prime flags for a segment starting at two or later. -/
def primeMask (lo len : Nat) : Nat := liveMask 1 lo len

theorem primeMask_bit {lo len i : Nat} (hlo : 2 ≤ lo) (hhi : lo+len ≤ 10240000)
    (hi : i < len) : (primeMask lo len).testBit i = true ↔ (lo+i).Prime := by
  unfold primeMask
  rw [liveMask_eq (by decide) hlo hhi, encoded_bit (by decide : 0 < 1)]
  simp only [one_mul, decide_eq_true_eq]
  constructor
  · rintro ⟨j,hj,rfl,hp⟩
    exact hp
  · intro h
    exact ⟨i,hi,rfl,h⟩

/-- A rank difference for a segment shorter than 16383 integers. -/
def blockCount (lo len : Nat) : Nat := liveMask 14 lo len % (2^14-1)

private theorem count_add_range (lo len : Nat) :
    Nat.primeCounting' (lo+len) = Nat.primeCounting' lo +
      ∑ i ∈ range len, (decide ((lo+i).Prime)).toNat := by
  induction len with
  | zero => simp
  | succ len ih =>
    rw [← Nat.add_assoc, Nat.primeCounting', Nat.count_succ, ← Nat.primeCounting', ih,
      sum_range_succ, Nat.add_assoc]
    congr 1
    by_cases hp : (lo+len).Prime <;> simp [hp]

theorem blockCount_correct {lo len : Nat} (hlen : len < 16383)
    (hlo : 2 ≤ lo) (hhi : lo+len ≤ 10240000) :
    Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + blockCount lo len := by
  rw [blockCount, liveMask_eq (by decide) hlo hhi,
    encoded_mod (by decide) hlen, count_add_range]

end ColtonSieve


/- A small verified population-count table for packed prime flags. -/

namespace ColtonPop

open Finset

def popByte (word : Nat) : Nat :=
  (0x8776766576656554766565546554544376656554655454436554544354434332766565546554544365545443544343326554544354434332544343324332322176656554655454436554544354434332655454435443433254434332433232216554544354434332544343324332322154434332433232214332322132212110 >>> (4*(word%256))) % 16

private lemma popByte_checked : ∀ b : Fin 256,
    popByte b.val = ∑ i ∈ range 8, (b.val.testBit i).toNat := by
  decide +kernel

private lemma popByte_eq (word : Nat) :
    popByte word = ∑ i ∈ range 8, (word.testBit i).toNat := by
  have h := popByte_checked ⟨word % 256, Nat.mod_lt _ (by decide)⟩
  have hp : popByte (word%256) = popByte word := by simp [popByte]
  change popByte (word % 256) = ∑ i ∈ range 8, ((word % 256).testBit i).toNat at h
  rw [hp] at h
  rw [h]
  refine sum_congr rfl fun i hi => ?_
  have hlt := mem_range.mp hi
  rw [show (256:Nat) = 2^8 by decide, Nat.testBit_mod_two_pow]
  simp [hlt]

def popBytes : Nat → Nat → Nat
  | 0, _ => 0
  | len+1, word => popByte word + popBytes len (word >>> 8)

private lemma popBytes_eq (len word : Nat) :
    popBytes len word = ∑ i ∈ range (8*len), (word.testBit i).toNat := by
  induction len generalizing word with
  | zero => simp [popBytes]
  | succ len ih =>
    rw [popBytes, popByte_eq, ih]
    rw [show 8*(len+1) = 8 + 8*len by omega, sum_range_add]
    simp [Nat.testBit_shiftRight, Nat.add_comm]

/-- Counts the bits strictly below the given index. -/
def popPrefix (word len : Nat) : Nat :=
  popBytes (len/8) word + popByte ((word >>> (8*(len/8))) % (2^(len%8)))

theorem popPrefix_eq (word len : Nat) :
    popPrefix word len = ∑ i ∈ range len, (word.testBit i).toNat := by
  unfold popPrefix
  rw [popBytes_eq, popByte_eq]
  let base := 8*(len/8)
  let tail := len%8
  have hsum : base+tail=len := by
    dsimp [base,tail]
    omega
  conv_rhs => rw [← hsum, sum_range_add]
  apply congrArg (fun x : Nat => (∑ i ∈ range base, (word.testBit i).toNat) + x)
  rw [← sum_filter_add_sum_filter_not (s := range 8) (p := fun i => i < tail)]
  rw [show (range 8).filter (fun i => i < tail) = range tail by
    ext i
    rw [mem_filter, mem_range, mem_range]
    dsimp [tail]
    omega]
  have hz : (∑ i ∈ (range 8).filter (fun i => ¬ i < tail),
      (((word >>> base) % (2 ^ tail)).testBit i).toNat) = 0 := by
    apply sum_eq_zero
    intro i hi
    have hi' := (mem_filter.mp hi).2
    simp [Nat.testBit_mod_two_pow, hi']
  rw [hz, add_zero]
  refine sum_congr rfl fun i hi => ?_
  have h : i < len % 8 := mem_range.mp hi
  simp [Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, h, base, Nat.add_comm]

end ColtonPop

namespace ColtonSmall

open Finset

def window (masks : Array Nat) (row len : Nat) : Nat :=
  ColtonPop.popPrefix (masks[row/32]! >>> (256*(row%32))) len

def rank (masks : Array Nat) (prefixes : Nat → Nat) (n : Nat) : Nat :=
  if n < 2 then 0
  else prefixes ((n-1)/256) + window masks ((n-1)/256) ((n-1)%256)

private theorem count_add_range (lo len : Nat) :
    Nat.primeCounting' (lo+len) = Nat.primeCounting' lo +
      ∑ i ∈ range len, (decide ((lo+i).Prime)).toNat := by
  induction len with
  | zero => simp
  | succ len ih =>
    rw [← Nat.add_assoc, Nat.primeCounting', Nat.count_succ, ← Nat.primeCounting', ih,
      sum_range_succ, Nat.add_assoc]
    congr 1
    by_cases hp : (lo+len).Prime <;> simp [hp]

theorem window_correct {masks : Array Nat}
    (hmask : ∀ j < 157, masks[j]! = ColtonSieve.primeMask (2+8192*j) 8192)
    {row len : Nat} (hrow : row < 5000) (hlen : len ≤ 256) :
    Nat.primeCounting' ((2+256*row)+len) =
      Nat.primeCounting' (2+256*row) + window masks row len := by
  rw [count_add_range, window, ColtonPop.popPrefix_eq]
  congr 1
  apply sum_congr rfl
  intro i hi
  have hilt := mem_range.mp hi
  have hbase : 32*(row/32)+row%32=row := by omega
  have hc : row/32 < 157 := by omega
  rw [hmask _ hc, Nat.testBit_shiftRight]
  have hbit : 256*(row%32)+i < 8192 := by omega
  have hlo : 2 ≤ 2+8192*(row/32) := by omega
  have hhi : 2+8192*(row/32)+8192 ≤ 10240000 := by omega
  have hh := ColtonSieve.primeMask_bit hlo hhi hbit
  have hidx : (2+8192*(row/32))+(256*(row%32)+i) = (2+256*row)+i := by omega
  rw [hidx] at hh
  by_cases hp : ((2+256*row)+i).Prime
  · rw [hh.mpr hp]
    simp [hp]
  · have hf : (ColtonSieve.primeMask (2+8192*(row/32)) 8192).testBit
          (256*(row%32)+i) = false := Bool.eq_false_iff.mpr (hp ∘ hh.mp)
    rw [hf]
    simp [hp]

theorem rank_correct {masks : Array Nat} {prefixes : Nat → Nat}
    (hmask : ∀ j < 157, masks[j]! = ColtonSieve.primeMask (2+8192*j) 8192)
    (hzero : prefixes 0 = 0)
    (hstep : ∀ row < 5000, prefixes (row+1) = prefixes row + window masks row 256)
    {n : Nat} (hn : n ≤ 1280000) : rank masks prefixes n = n.primeCounting := by
  have hpref : ∀ row ≤ 5000, prefixes row = Nat.primeCounting' (2+256*row) := by
    intro row
    induction row with
    | zero =>
      intro _
      rw [hzero]
      decide
    | succ row ih =>
      intro hm
      have hrow := window_correct hmask (show row < 5000 by omega) (by omega : 256 ≤ 256)
      rw [hstep _ (by omega), ih (by omega)]
      rw [show 2+256*(row+1) = 2+256*row+256 by omega, hrow]
  unfold rank
  split
  · next h =>
    have he : n = 0 ∨ n = 1 := by omega
    rcases he with rfl | rfl <;> decide
  · next h =>
    let row := (n-1)/256
    let len := (n-1)%256
    have hrow : row < 5000 := by dsimp [row]; omega
    have hlen : len ≤ 256 := by dsimp [len]; omega
    have he : (2+256*row)+len = n+1 := by
      dsimp [row,len]
      omega
    change prefixes row + window masks row len = Nat.primeCounting' (n+1)
    rw [hpref _ (by omega), ← window_correct hmask hrow hlen, he]

end ColtonSmall

