private def prefixes (i : Nat) : Nat := (prefixWords[i/64]! >>> (17*(i%64))) % 131072

private def masksOK (start count : Nat) : Bool :=
  (List.range' start count).all (fun i => decide
    (masks[i]! = ColtonSieve.primeMask (2+8192*i) 8192))

private def prefixesOK (start count : Nat) : Bool :=
  (List.range' start count).all (fun i => decide
    (prefixes (i+1) = prefixes i + ColtonSmall.window masks i 256))

private lemma inRange {i start count : Nat} (lo : start ≤ i) (hi : i < start+count) :
    i ∈ List.range' start count :=
  List.mem_range'.mpr ⟨i-start, by omega, by simp; omega⟩

private lemma masksAt {start count i : Nat} (h : masksOK start count = true)
    (lo : start ≤ i) (hi : i < start+count) :
    masks[i]! = ColtonSieve.primeMask (2+8192*i) 8192 :=
  of_decide_eq_true (List.all_eq_true.mp h i (inRange lo hi))

private lemma prefixesAt {start count i : Nat} (h : prefixesOK start count = true)
    (lo : start ≤ i) (hi : i < start+count) :
    prefixes (i+1) = prefixes i + ColtonSmall.window masks i 256 :=
  of_decide_eq_true (List.all_eq_true.mp h i (inRange lo hi))

