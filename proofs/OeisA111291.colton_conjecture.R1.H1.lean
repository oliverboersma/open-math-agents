namespace ColtonFinalChecks

theorem earlyRanks (rank smallRank : Nat → Nat)
    (computed : ∀ {i : Nat}, i < 233 → rank i = smallRank (ColtonApplication.grid i))
    (correct : ∀ {n : Nat}, n ≤ 1280000 → smallRank n = n.primeCounting)
    {i : Nat} (hi : i < 233) : rank i = (ColtonApplication.grid i).primeCounting := by
  have bound : ColtonApplication.grid 232 ≤ 1280000 := by decide +kernel
  have le : i ≤ 232 := by omega
  rw [computed hi, correct ((ColtonApplication.grid_monotone le).trans bound)]

end ColtonFinalChecks

/- Numerical prime tables and explicit generator factorizations are checked in
small blocks. The soundness lemmas transfer the computed inequalities to H1. -/

theorem OMA.solution : OMA.R_OeisA111291_colton_conjecture_R1.H1 := by
  apply ColtonApplication.apply_grid (fun j => ColtonRankData.rank (j+1))
    ColtonSmallCertificate.smallRank ColtonGenerators.largest ColtonGenerators.generators
  · intro j
    change ColtonRankData.rank (j.val+1) =
      (ColtonCounts.grid j.val + ColtonCounts.grid j.val/40).primeCounting
    by_cases early : j.val < 232
    · rw [← ColtonCounts.grid_succ]
      exact ColtonFinalChecks.earlyRanks ColtonRankData.rank ColtonSmallCertificate.smallRank
        ColtonFinalChecks.rankGrid ColtonSmallCertificate.smallRank_correct (by omega)
    · have seed : ColtonRankData.rank 232 = (ColtonCounts.grid 232).primeCounting :=
        ColtonFinalChecks.earlyRanks ColtonRankData.rank ColtonSmallCertificate.smallRank
          ColtonFinalChecks.rankGrid ColtonSmallCertificate.smallRank_correct (by decide)
      exact ColtonCounts.ranks_correct_tail ColtonSieve.narrowCount ColtonRankData.rank 232
        (fun _ lo hi => ColtonSieve.narrowCount_correct (by omega) hi)
        seed ColtonLargeChecks.transitions j (by omega)
  · intro n hn
    exact ColtonSmallCertificate.smallRank_correct hn
  · exact ColtonGenerators.good
  · exact ColtonGenerators.upper_good
  · exact ColtonFinalChecks.estimates