private def factorData : Nat := 

def largest (k : Nat) : Nat := (factorData >>> (13*k)) % 8192

def validRow (fs : List Nat) : Prop :=
  (∀ p ∈ fs, p.Prime) ∧ 8 ≤ fs.prod ∧ fs.prod ≤ 10000 ∧
    2*(∏ p ∈ fs.toFinset, (fs.count p + 1)) ∣ fs.prod ∧
    fs.toFinset.sup id ≤ largest fs.prod ∧ largest fs.prod ≤ 10000

private instance (fs : List Nat) : Decidable (validRow fs) := by
  unfold validRow
  infer_instance

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem verifiedRows : ∀ fs ∈ rows, validRow fs := by
  unfold rows
  decide +kernel

private theorem data_for {k : Nat} (hk : k ∈ generators) :
    ∃ fs ∈ rows, fs.prod = k ∧ validRow fs := by
  obtain ⟨fs, hfs, he⟩ := List.mem_map.mp (List.mem_toFinset.mp hk)
  exact ⟨fs,hfs,he,verifiedRows fs hfs⟩

private theorem factorization_of {fs : List Nat} (hp : ∀ p ∈ fs, p.Prime) :
    fs.prod.primeFactors = fs.toFinset ∧
    ∀ p : Nat, fs.prod.factorization p = fs.count p := by
  have same := Nat.primeFactorsList_unique (n := fs.prod) rfl hp
  constructor
  · rw [← Nat.toFinset_factors]
    ext p
    exact List.mem_toFinset.trans (same.mem_iff.symm.trans List.mem_toFinset.symm)
  · intro p
    rw [← Nat.primeFactorsList_count_eq]
    exact (same.count_eq p).symm

theorem good : ∀ k ∈ generators, 8 ≤ k ∧ k ≤ 10000 ∧ 2*k.divisors.card ∣ k := by
  intro k hk
  obtain ⟨fs, _, hprod, ⟨hp, hlo, hhi, hdiv, _, _⟩⟩ := data_for hk
  subst k
  have hfac := factorization_of hp
  have hdivisors : fs.prod.divisors.card = ∏ p ∈ fs.toFinset, (fs.count p + 1) := by
    rw [Nat.card_divisors (by omega), hfac.1]
    exact Finset.prod_congr rfl fun p _ => by rw [hfac.2 p]
  exact ⟨hlo,hhi,hdivisors.symm ▸ hdiv⟩

theorem upper_good : ∀ k ∈ generators, (k.primeFactors.sup id) ≤ largest k ∧ largest k ≤ 10000 := by
  intro k hk
  obtain ⟨fs, _, hprod, ⟨hp, _, _, _, hlo, hhi⟩⟩ := data_for hk
  subst k
  exact ⟨(factorization_of hp).1.symm ▸ hlo,hhi⟩

end ColtonGenerators



