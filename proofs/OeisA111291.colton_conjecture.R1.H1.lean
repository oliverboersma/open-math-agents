namespace ColtonSieve

def narrowCount (lo len : Nat) : Nat :=
  ColtonPop.popPrefix (primeMask lo len) len

theorem narrowCount_correct {lo len : Nat} (hlo : 2 ≤ lo) (hhi : lo+len ≤ 10240000) :
    Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + narrowCount lo len := by
  rw [narrowCount, ColtonPop.popPrefix_eq, count_add_range]
  congr 1
  apply Finset.sum_congr rfl
  intro i hmem
  have h := primeMask_bit hlo hhi (Finset.mem_range.mp hmem)
  congr 1
  exact Bool.eq_iff_iff.mpr (by simpa using h.symm)

end ColtonSieve


/- Chained prime-count certificates for the Colton grid. -/

namespace ColtonCounts

def fullBlocks (count : Nat → Nat → Nat) (lo : Nat) : Nat → Nat
  | 0 => 0
  | n+1 => fullBlocks count lo n + count (lo+8192*n) 8192

def intervalCount (count : Nat → Nat → Nat) (lo len : Nat) : Nat :=
  fullBlocks count lo (len/8192) + count (lo+8192*(len/8192)) (len%8192)

theorem intervalCount_correct (count : Nat → Nat → Nat)
    (correct : ∀ {lo len : Nat}, len < 16383 → 3201 ≤ lo → lo+len ≤ 10240000 →
      Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + count lo len)
    {lo len : Nat} (hlo : 3201 ≤ lo) (hhi : lo+len ≤ 10240000) :
    Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + intervalCount count lo len := by
  have iter (n : Nat) (hn : lo+8192*n ≤ 10240000) :
      Nat.primeCounting' (lo+8192*n) = Nat.primeCounting' lo + fullBlocks count lo n := by
    induction n with
    | zero => simp [fullBlocks]
    | succ n ih =>
      have stepEq : lo+8192*(n+1) = (lo+8192*n)+8192 := by simp [Nat.mul_succ, Nat.add_assoc]
      have startBound : 3201 ≤ lo+8192*n := hlo.trans (Nat.le_add_right _ _)
      have endBound : (lo+8192*n)+8192 ≤ 10240000 := stepEq ▸ hn
      have prevBound : lo+8192*n ≤ 10240000 := (Nat.le_add_right _ _).trans endBound
      rw [stepEq, correct (by decide) startBound endBound, ih prevBound, fullBlocks, Nat.add_assoc]
  let a := lo+8192*(len/8192)
  let rem := len%8192
  have total : a+rem = lo+len := by dsimp [a,rem]; omega
  have rsmall : rem < 16383 := by dsimp [rem]; omega
  have ha : a ≤ 10240000 := by omega
  calc
    Nat.primeCounting' (lo+len) = Nat.primeCounting' (a+rem) := by rw [total]
    _ = Nat.primeCounting' a + count a rem := correct rsmall (by dsimp [a]; omega) (by omega)
    _ = Nat.primeCounting' lo + intervalCount count lo len := by
      dsimp [a, intervalCount]
      rw [iter _ ha, Nat.add_assoc]

def grid (j : Nat) : Nat := (fun v : Nat => v+v/40)^[j] 4096

theorem grid_succ (j : Nat) : grid (j+1) = grid j + grid j/40 := by
  unfold grid
  rw [Function.iterate_succ_apply']

theorem grid_mono : Monotone grid := by
  apply monotone_nat_of_le_succ
  intro j
  rw [grid_succ]
  omega

def transition (count : Nat → Nat → Nat) (ranks : Nat → Nat) (j : Nat) : Prop :=
  ranks (j+1) = ranks j + intervalCount count (grid j + 1) (grid (j+1) - grid j)

theorem ranks_correct (count : Nat → Nat → Nat) (ranks : Nat → Nat)
    (correct : ∀ {lo len : Nat}, len < 16383 → 3201 ≤ lo → lo+len ≤ 10240000 →
      Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + count lo len)
    (initial : ranks 0 = Nat.primeCounting 4096)
    (transitions : ∀ j : Fin 317, transition count ranks j.val) :
    ∀ j : Fin 317, ranks (j.val+1) = (grid j.val + grid j.val/40).primeCounting := by
  have upper : grid 317 + 1 ≤ 10240000 := by decide +kernel
  have exact_at (n : Nat) (hn : n ≤ 317) : ranks n = (grid n).primeCounting := by
    induction n with
    | zero => exact initial
    | succ n ih =>
      have hle := grid_mono (show n ≤ n+1 by omega)
      have hmin := grid_mono (Nat.zero_le n)
      have hmax := grid_mono hn
      have hs := transitions ⟨n,by omega⟩
      change ranks (n+1) = ranks n + intervalCount count (grid n+1) (grid (n+1)-grid n) at hs
      rw [hs, ih (by omega)]
      simp only [Nat.primeCounting_eq_primeCounting'_succ]
      have shift : grid n+1+(grid (n+1)-grid n) = grid (n+1)+1 := by omega
      have lo : 3201 ≤ grid n+1 := by
        have hbase : grid 0 = 4096 := rfl
        omega
      have hb : grid n+1+(grid (n+1)-grid n) ≤ 10240000 := by omega
      exact (intervalCount_correct count correct lo hb).symm.trans (congrArg Nat.primeCounting' shift)
  intro j
  rw [← grid_succ]
  exact exact_at _ (by have := j.isLt; omega)


theorem ranks_correct_tail (count : Nat → Nat → Nat) (ranks : Nat → Nat) (base : Nat)
    (correct : ∀ {lo len : Nat}, len < 16383 → 3201 ≤ lo → lo+len ≤ 10240000 →
      Nat.primeCounting' (lo+len) = Nat.primeCounting' lo + count lo len)
    (initial : ranks base = (grid base).primeCounting)
    (transitions : ∀ j : Fin 317, base ≤ j.val → transition count ranks j.val) :
    ∀ j : Fin 317, base ≤ j.val → ranks (j.val+1) = (grid j.val + grid j.val/40).primeCounting := by
  have upper : grid 317 + 1 ≤ 10240000 := by decide +kernel
  have exact_at (n : Nat) (hn : base+n ≤ 317) : ranks (base+n) = (grid (base+n)).primeCounting := by
    induction n with
    | zero => simpa only [Nat.add_zero] using initial
    | succ n ih =>
      let j := base+n
      have idx : j < 317 := by dsimp [j]; omega
      have prev : ranks j = (grid j).primeCounting := ih (by omega)
      have hle := grid_mono (show j ≤ j+1 by omega)
      have hmin := grid_mono (Nat.zero_le j)
      have hmax := grid_mono (show j+1 ≤ 317 by dsimp [j]; omega)
      have hs := transitions ⟨j,idx⟩ (by dsimp [j]; omega)
      change ranks (j+1) = ranks j + intervalCount count (grid j+1) (grid (j+1)-grid j) at hs
      change ranks (j+1) = (grid (j+1)).primeCounting
      rw [hs, prev]
      simp only [Nat.primeCounting_eq_primeCounting'_succ]
      have shift : grid j+1+(grid (j+1)-grid j) = grid (j+1)+1 := by omega
      have lo : 3201 ≤ grid j+1 := by
        have hbase : grid 0 = 4096 := rfl
        omega
      have hb : grid j+1+(grid (j+1)-grid j) ≤ 10240000 := by omega
      exact (intervalCount_correct count correct lo hb).symm.trans (congrArg Nat.primeCounting' shift)
  intro j hj
  rw [← grid_succ]
  have eq : base+(j.val+1-base) = j.val+1 := by omega
  have final := exact_at (j.val+1-base) (by rw [eq]; omega)
  rwa [eq] at final


def pieceLen (len i : Nat) : Nat := if i < len/8192 then 8192 else len%8192

theorem intervalCount_eq (count : Nat → Nat → Nat) (lo len : Nat) (row : Nat → Nat)
    (pieces : ∀ i ≤ len/8192, count (lo+8192*i) (pieceLen len i) = row i) :
    intervalCount count lo len = (∑ i ∈ Finset.range (len/8192+1), row i) := by
  open Finset in
  have full (n : Nat) (hn : n ≤ len/8192) :
      fullBlocks count lo n = ∑ i ∈ range n, row i := by
    induction n with
    | zero => simp [fullBlocks]
    | succ n ih =>
      have hp := pieces n (by omega)
      rw [pieceLen, if_pos (by omega)] at hp
      rw [fullBlocks, sum_range_succ, hp, ih (by omega)]
  have last := pieces (len/8192) le_rfl
  rw [pieceLen, if_neg (Nat.lt_irrefl _)] at last
  rw [intervalCount, Finset.sum_range_succ, full _ le_rfl, last]

end ColtonCounts



