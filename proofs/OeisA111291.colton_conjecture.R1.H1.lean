  rw [jp] at step
  unfold transition
  rw [step]
  apply congrArg (ColtonRankData.rank j.val + ·)
  unfold rowSum
  rw [jp]
  symm
  apply intervalCount_eq
  intro i hi
  have small : i < 32 := by
    have h := spansBounded p
    rw [jp] at h
    unfold span at h
    omega
  have valid : positionValid p.val i := of_decide_eq_true (List.all_eq_true.mp
    (coordinatesChecked p) i (by
      rw [List.mem_range, jp]
      unfold span
      omega))
  change offset p.val + i < 1140 ∧ coord (offset p.val + i) = p.val*32+i at valid
  have tile := allChecked (offset p.val+i) valid.1
  unfold pieceCount at tile
  rw [valid.2] at tile
  dsimp only at tile
  rw [show (p.val*32+i)/32 = p.val by omega,
    show (p.val*32+i)%32 = i by omega, jp] at tile
  exact tile

end ColtonLargeChecks


/- The finite Colton grid follows from an exact prime rank and a selected
family of verified generators. The selected family provides a lower bound
because every summand in the official generator count is nonnegative. -/

namespace ColtonApplication

open Finset

def grid (j : Nat) : Nat := (fun m : Nat => m + m/40)^[j] 4096

theorem grid_monotone : Monotone grid := by
  apply monotone_nat_of_le_succ
  intro j
  unfold grid
  rw [Function.iterate_succ_apply']
  omega

theorem query_bound {j : Nat} (hj : j < 317) :
    grid j + grid j / 40 ≤ 10240000 := by
  have h := grid_monotone (show j ≤ 316 by omega)
  have hdiv := Nat.div_le_div_right (c := 40) h
  have last : grid 316 + grid 316 / 40 ≤ 10240000 := by decide +kernel
  omega

def chosen (G : Finset Nat) (x : Nat) : Finset Nat := G.filter (fun k => k ≤ x/2)

def estimated (lhsRank rank upper : Nat → Nat) (G : Finset Nat) (j : Nat) : Prop :=
  let x := grid j
  lhsRank j ≤ 2 * (307 + ∑ k ∈ chosen G x, (rank (x/k) - rank (max (upper k) (4096/k))))

theorem apply_grid (lhsRank rank upper : Nat → Nat) (generators : Finset Nat)
    (lhs_exact : ∀ j : Fin 317, lhsRank j.val = (grid j.val + grid j.val/40).primeCounting)
    (rank_exact : ∀ n ≤ 1280000, rank n = n.primeCounting)
    (good : ∀ k ∈ generators, 8 ≤ k ∧ k ≤ 10000 ∧ 2*k.divisors.card ∣ k)
    (upper_good : ∀ k ∈ generators, (k.primeFactors.sup id) ≤ upper k ∧ upper k ≤ 10000)
    (checked : ∀ j : Fin 317, estimated lhsRank rank upper generators j.val) :
    ∀ j < 317,
      let x := (fun m : ℕ => m + m / 40)^[j] 4096
      let G := ((Icc 1 (min 10000 (x/2))).filter (fun k : ℕ => 0 < k ∧ 2 * k.divisors.card ∣ k))
      (x + x/40).primeCounting ≤ 2 * (307 + (∑ k ∈ G,
        ((x/k).primeCounting - (max (k.primeFactors.sup id) (4096/k)).primeCounting))) := by
  intro j hj
  let x := grid j
  let G := ((Icc 1 (min 10000 (x/2))).filter (fun k : ℕ => 0 < k ∧ 2 * k.divisors.card ∣ k))
  change (x+x/40).primeCounting ≤ 2 * (307 + ∑ k ∈ G,
    ((x/k).primeCounting - (max (k.primeFactors.sup id) (4096/k)).primeCounting))
  have hmain := checked ⟨j,hj⟩
  change lhsRank j ≤ 2 * (307 + ∑ k ∈ chosen generators x,
    (rank (x/k) - rank (max (upper k) (4096/k)))) at hmain
  have hleft : lhsRank j = (x+x/40).primeCounting := lhs_exact ⟨j,hj⟩
  rw [hleft] at hmain
  have inc : chosen generators x ⊆ G := by
    intro k hk
    obtain ⟨hkG, hkx⟩ := mem_filter.mp hk
    obtain ⟨pos, cap, div⟩ := good k hkG
    exact mem_filter.mpr ⟨mem_Icc.mpr ⟨by omega, le_min cap hkx⟩, by omega, div⟩
  have sum_bound :
      (∑ k ∈ chosen generators x, (rank (x/k) - rank (max (upper k) (4096/k)))) ≤
      ∑ k ∈ G, ((x/k).primeCounting - (max (k.primeFactors.sup id) (4096/k)).primeCounting) := by
    calc
      _ ≤ ∑ k ∈ chosen generators x,
          ((x/k).primeCounting - (max (k.primeFactors.sup id) (4096/k)).primeCounting) := by
        apply sum_le_sum
        intro k hk
        have hkG := (mem_filter.mp hk).1
        obtain ⟨factor_bound, cutoff_bound⟩ := upper_good k hkG
        have left_bound : x/k ≤ 1280000 := by
          have hb := query_bound hj
          have hx : x ≤ 10240000 := by dsimp [x]; omega
          have hkfloor := (good k hkG).1
          exact (Nat.div_le_div_left hkfloor (by decide : 0 < 8)).trans (by omega)
        have right_bound : max (upper k) (4096/k) ≤ 1280000 :=
          max_le (cutoff_bound.trans (by decide)) ((Nat.div_le_self _ _).trans (by decide))
        rw [rank_exact _ left_bound, rank_exact _ right_bound]
        apply Nat.sub_le_sub_left
        exact Nat.monotone_primeCounting (max_le_max factor_bound le_rfl)
      _ ≤ _ := sum_le_sum_of_subset_of_nonneg inc (fun _ _ _ => Nat.zero_le _)
  exact hmain.trans (Nat.mul_le_mul_left 2 (Nat.add_le_add_left sum_bound 307))

end ColtonApplication




