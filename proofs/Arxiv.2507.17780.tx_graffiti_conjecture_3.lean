def hasBit (m : UInt64) (v : Fin 50) : Bool := (m &&& bitM v.val) != 0

def adjB (u v : Fin 50) : Bool := hasBit (adjM u.val) v

lemma bitM_eq_shift : ∀ v : Fin 50, bitM v.val = (1 : UInt64) <<< v.val.toUInt64 := by decide

lemma hasBit_iff_getLsbD (m : UInt64) (v : Fin 50) :
    hasBit m v = m.toBitVec.getLsbD v.val := by
  have hbm := bitM_eq_shift v
  unfold hasBit
  rw [hbm]
  have hv : v.val < 64 := by omega
  have hshift : ((1 : UInt64) <<< v.val.toUInt64).toBitVec = (1#64) <<< v.val := by
    ext i hi
    simp [UInt64.toBitVec_shiftLeft, Nat.mod_eq_of_lt hv]
  by_cases hb : m.toBitVec.getLsbD v.val = true
  · rw [hb]
    simp only [bne_iff_ne, ne_eq]
    intro hzero
    have h0 : (m &&& ((1 : UInt64) <<< v.val.toUInt64)).toBitVec.getLsbD v.val = false := by
      rw [hzero]; simp
    rw [UInt64.toBitVec_and, hshift, BitVec.getLsbD_and, BitVec.getLsbD_shiftLeft] at h0
    simp [hv] at h0
    rw [← BitVec.getLsbD_eq_getElem hv, hb] at h0
    cases h0
  · have hbf : m.toBitVec.getLsbD v.val = false := Bool.eq_false_iff.mpr hb
    rw [hbf]
    simp only [bne_eq_false_iff_eq]
    apply UInt64.toBitVec_inj.mp
    ext i hi
    simp only [UInt64.toBitVec_and, hshift, UInt64.toBitVec_zero, BitVec.getElem_and,
      BitVec.getElem_zero, BitVec.getElem_shiftLeft]
    by_cases hlt : i < v.val
    · simp [hlt]
    · by_cases heq : i = v.val
      · subst heq
        have hbf' : m.toBitVec[v.val]'hv = false := by
          rw [← BitVec.getLsbD_eq_getElem hv]; exact hbf
        simp [hbf']
      · have hgt : i - v.val ≠ 0 := by omega
        have h1 : (1#64)[i - v.val]'(by omega) = false := by
          rw [← BitVec.getLsbD_eq_getElem (by omega), BitVec.getLsbD_ofNat]
          cases hk : i - v.val with
          | zero => omega
          | succ k => simp [Nat.testBit_succ]
        simp [hlt, h1]

lemma hasBit_or (m₁ m₂ : UInt64) (v : Fin 50) :
    hasBit (m₁ ||| m₂) v = (hasBit m₁ v || hasBit m₂ v) := by
  simp [hasBit_iff_getLsbD, UInt64.toBitVec_or, BitVec.getLsbD_or]

lemma hasBit_and (m₁ m₂ : UInt64) (v : Fin 50) :
    hasBit (m₁ &&& m₂) v = (hasBit m₁ v && hasBit m₂ v) := by
  simp [hasBit_iff_getLsbD, UInt64.toBitVec_and, BitVec.getLsbD_and]

lemma hasBit_fullM : ∀ v : Fin 50, hasBit fullM v = true := by decide

lemma hasBit_full_and_not (m : UInt64) (v : Fin 50) :
    hasBit (fullM &&& ~~~m) v = !hasBit m v := by
  rw [hasBit_and, hasBit_fullM, Bool.true_and]
  have hv : v.val < 64 := by omega
  simp [hasBit_iff_getLsbD, UInt64.toBitVec_not, hv]

lemma hasBit_zero (v : Fin 50) : hasBit 0 v = false := by
  simp [hasBit_iff_getLsbD]

lemma hasBit_bitM : ∀ u v : Fin 50, hasBit (bitM u.val) v = (u == v) := by decide

lemma hasBit_closedM : ∀ u v : Fin 50, hasBit (closedM u.val) v = (u == v || adjB u v) := by decide

lemma adjB_symm : ∀ u v : Fin 50, adjB u v = adjB v u := by decide

lemma adjB_irrefl : ∀ u : Fin 50, adjB u u = false := by decide

def cgraph : SimpleGraph (Fin 50) where
  Adj u v := adjB u v = true
  symm := ⟨fun u v h => by rwa [adjB_symm]⟩
  loopless := ⟨fun u h => by rw [adjB_irrefl] at h; exact Bool.false_ne_true h⟩

instance : DecidableRel cgraph.Adj := fun u v => inferInstanceAs (Decidable (adjB u v = true))

lemma nbr3_spec : ∀ v : Fin 50,
    (nbr3 v).1 ≠ (nbr3 v).2.1 ∧
    (nbr3 v).1 ≠ (nbr3 v).2.2 ∧
    (nbr3 v).2.1 ≠ (nbr3 v).2.2 ∧
    ∀ w : Fin 50, adjB v w = (w == (nbr3 v).1 || w == (nbr3 v).2.1 || w == (nbr3 v).2.2) := by
  decide

lemma cgraph_reg : ∀ v : Fin 50, cgraph.degree v = 3 := by
  intro v
  rcases nbr3_spec v with ⟨hab, hac, hbc, hiff⟩
  rw [SimpleGraph.degree]
  have hnf : cgraph.neighborFinset v = {(nbr3 v).1, (nbr3 v).2.1, (nbr3 v).2.2} := by
    ext w
    simp only [SimpleGraph.mem_neighborFinset, Finset.mem_insert, Finset.mem_singleton]
    change adjB v w = true ↔ _
    rw [hiff w]
    simp [Bool.or_eq_true, beq_iff_eq, or_assoc]
  rw [hnf, Finset.card_insert_of_notMem, Finset.card_insert_of_notMem, Finset.card_singleton]
  · simp [hbc]
  · simp [hab, hac]

def varEdge (i : Fin 15) : Sym2 (Fin 50) :=
  s(⟨2 * i.val, by omega⟩, ⟨2 * i.val + 1, by omega⟩)

def M : Finset (Sym2 (Fin 50)) := Finset.univ.image varEdge

lemma varEdge_inj : Function.Injective varEdge := by
  intro i j h
  unfold varEdge at h
  rw [Sym2.eq_iff] at h
  rcases h with ⟨h1, _⟩ | ⟨h1, _⟩ <;> {
    have hv := congrArg Fin.val h1
    simp at hv
    exact Fin.ext (by omega)
  }

lemma M_card : M.card = 15 := by
  rw [M, Finset.card_image_of_injective _ varEdge_inj, Finset.card_fin]

lemma varEdge_adj : ∀ i : Fin 15, adjB ⟨2 * i.val, by omega⟩ ⟨2 * i.val + 1, by omega⟩ = true := by
  decide

lemma clause_adj_lt30 : ∀ u v : Fin 50, adjB u v = true → u.val < 30 ∨ v.val < 30 := by
  decide

lemma M_isEdgeMatching : cgraph.IsEdgeMatching M := by
  refine ⟨?_, ?_⟩
  · intro e he
    rw [M, Finset.mem_image] at he
    rcases he with ⟨i, _, rfl⟩
    exact varEdge_adj i
  · intro e₁ he₁ e₂ he₂
    rw [M, Finset.mem_image] at he₁ he₂
    rcases he₁ with ⟨i, _, rfl⟩
    rcases he₂ with ⟨j, _, rfl⟩
    by_cases hij : i = j
    · left; subst hij; rfl
    · right
      intro v ⟨hv1, hv2⟩
      unfold varEdge at hv1 hv2
      rw [Sym2.mem_iff] at hv1 hv2
      rcases hv1 with rfl | rfl <;> rcases hv2 with h2 | h2 <;> {
        have hv := congrArg Fin.val h2
        simp at hv
        exact hij (Fin.ext (by omega))
      }

lemma M_maximal : cgraph.IsMaximalEdgeMatching M := by
  refine ⟨M_isEdgeMatching, ?_⟩
  intro e he heM hmatch
  revert he heM hmatch
  refine Sym2.ind (fun u v => ?_) e
  intro he heM hmatch
  have hadj : adjB u v = true := he
  have hlt : u.val < 30 ∨ v.val < 30 := clause_adj_lt30 u v hadj
  have hex : ∃ w : Fin 50, w ∈ s(u, v) ∧ w.val < 30 := by
    rcases hlt with hu | hv
    · exact ⟨u, Sym2.mem_mk_left u v, hu⟩
    · exact ⟨v, Sym2.mem_mk_right u v, hv⟩
  rcases hex with ⟨w, hw, hwlt⟩
  let i : Fin 15 := ⟨w.val / 2, by omega⟩
  have hiM : varEdge i ∈ M := Finset.mem_image_of_mem varEdge (Finset.mem_univ i)
  have hwi : w ∈ varEdge i := by
    unfold varEdge
    rw [Sym2.mem_iff]
    by_cases hev : w.val % 2 = 0
    · left; apply Fin.ext; simp [i]; omega
    · right; apply Fin.ext; simp [i]; omega
  have hdisj := hmatch.2 s(u, v) (Finset.mem_insert_self _ _) (varEdge i)
    (Finset.mem_insert_of_mem hiM)
  rcases hdisj with heq | hno
  · exact heM (heq ▸ hiM)
  · exact hno w ⟨hw, hwi⟩

lemma cgraph_sat_le : cgraph.saturationNumber ≤ 15 := by
  rw [SimpleGraph.saturationNumber]
  exact Nat.sInf_le ⟨M, M_maximal, M_card⟩

def witB (v : Fin 50) : Bool := hasBit witM v

def W : Finset (Fin 50) := Finset.univ.filter (fun v => witB v = true)

lemma W_indep_bool : ∀ u v : Fin 50, witB u = true → witB v = true → adjB u v = false := by
  decide

lemma W_dom_bool : ∀ v : Fin 50,
    witB v = true ∨
    witB (nbr3 v).1 = true ∨
    witB (nbr3 v).2.1 = true ∨
    witB (nbr3 v).2.2 = true := by
  decide

lemma indepDom_nonempty : {n | ∃ D : Finset (Fin 50), cgraph.IsNIndepDominatingSet n D}.Nonempty := by
  refine ⟨W.card, W, ?_, ?_, rfl⟩
  · intro u hu v hv _ hadj
    have hu' : witB u = true := (Finset.mem_filter.mp (Finset.mem_coe.mp hu)).2
    have hv' : witB v = true := (Finset.mem_filter.mp (Finset.mem_coe.mp hv)).2
    have hno := W_indep_bool u v hu' hv'
    change adjB u v = true at hadj
    rw [hno] at hadj
    exact Bool.false_ne_true hadj
  · intro v
    have hiff := (nbr3_spec v).2.2.2
    rcases W_dom_bool v with hv | h1 | h2 | h3
    · left; exact Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ v, hv⟩)
    · right
      refine ⟨(nbr3 v).1, Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h1⟩), ?_⟩
      change adjB v (nbr3 v).1 = true
      rw [hiff]; simp
    · right
      refine ⟨(nbr3 v).2.1, Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h2⟩), ?_⟩
      change adjB v (nbr3 v).2.1 = true
      rw [hiff]; simp
    · right
      refine ⟨(nbr3 v).2.2, Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h3⟩), ?_⟩
      change adjB v (nbr3 v).2.2 = true
      rw [hiff]; simp

inductive Cert where
  | D (v : Nat)
  | P (vs : List Nat)
  | O (vs : List Nat) (next : Cert)
  | F (v u : Nat) (next : Cert)
  | B (u : Nat) (t f : Cert)

def checkPack (avail dom : UInt64) : List Nat → UInt64 → Option UInt64
  | [], used => some used
  | v :: vs, used =>
    if v ≥ 50 then none
    else if (dom &&& bitM v) != 0 then none
    else
      let cm := closedM v &&& avail
      if (cm &&& used) != 0 then none
      else checkPack avail dom vs (used ||| cm)

def checkCert : Cert → UInt64 → UInt64 → Nat → Bool
  | .D v, ban, dom, _ =>
    decide (v < 50) &&
    ((dom &&& bitM v) == 0) &&
    ((closedM v &&& (fullM &&& ~~~ban)) == 0)
  | .P vs, ban, dom, rem =>
    decide (rem < vs.length) &&
    match checkPack (fullM &&& ~~~ban) dom vs 0 with
    | some _ => true
    | none => false
  | .O vs nxt, ban, dom, rem =>
    (rem == vs.length) &&
    match checkPack (fullM &&& ~~~ban) dom vs 0 with
    | some used => checkCert nxt (fullM &&& ~~~used) dom rem
    | none => false
  | .F v u nxt, ban, dom, rem =>
    match rem with
    | 0 => false
    | rem' + 1 =>
      decide (v < 50) &&
      decide (u < 50) &&
      ((dom &&& bitM v) == 0) &&
      ((closedM v &&& (fullM &&& ~~~ban)) == bitM u) &&
      checkCert nxt (ban ||| closedM u) (dom ||| closedM u) rem'
  | .B u t f, ban, dom, rem =>
    match rem with
    | 0 => false
    | rem' + 1 =>
      decide (u < 50) &&
      checkCert t (ban ||| closedM u) (dom ||| closedM u) rem' &&
      checkCert f (ban ||| bitM u) dom rem

lemma checkPack_sound {D C : Finset (Fin 50)} {ban dom : UInt64}
    (hban : ∀ w ∈ D \ C, hasBit ban w = false)
    (hdom : ∀ v : Fin 50, hasBit dom v = false → ∃ w ∈ D \ C, hasBit (closedM v.val) w = true) :
    ∀ (vs : List Nat) (used0 usedEnd : UInt64),
      checkPack (fullM &&& ~~~ban) dom vs used0 = some usedEnd →
      ((D \ C).filter (fun w => hasBit used0 w = true)).card + vs.length ≤
        ((D \ C).filter (fun w => hasBit usedEnd w = true)).card := by
  intro vs
  induction vs with
  | nil =>
    intro used0 usedEnd h
    simp [checkPack] at h
    subst h
    simp
  | cons v vs ih =>
    intro used0 usedEnd h
    unfold checkPack at h
    by_cases hv : v ≥ 50
    · simp [hv] at h
    · simp only [hv, ↓reduceIte] at h
      by_cases hdv : (dom &&& bitM v) != 0
      · simp [hdv] at h
      · simp only [hdv] at h
        by_cases hdisj : ((closedM v &&& (fullM &&& ~~~ban)) &&& used0) != 0
        · simp [hdisj] at h
        · simp only [hdisj] at h
          have hvlt : v < 50 := by omega
          have hdv' : hasBit dom ⟨v, hvlt⟩ = false := by
            unfold hasBit
            exact Bool.eq_false_iff.mpr hdv
          obtain ⟨w, hw, hwc⟩ := hdom ⟨v, hvlt⟩ hdv'
          have hwb : hasBit (fullM &&& ~~~ban) w = true := by
            rw [hasBit_full_and_not, hban w hw]; rfl
          have hwcm : hasBit (closedM v &&& (fullM &&& ~~~ban)) w = true := by
            rw [hasBit_and, hwc, hwb]; rfl
          have hdisj0 : (closedM v &&& (fullM &&& ~~~ban)) &&& used0 = 0 := by
            simpa using hdisj
          have hwu0 : hasBit used0 w = false := by
            by_contra htrue
            have ht : hasBit used0 w = true := Bool.eq_true_of_not_eq_false htrue
            have h1 : hasBit ((closedM v &&& (fullM &&& ~~~ban)) &&& used0) w = true := by
              rw [hasBit_and, hwcm, ht]; rfl
            rw [hdisj0, hasBit_zero] at h1
            exact Bool.false_ne_true h1
          have hsub : insert w ((D \ C).filter (fun x => hasBit used0 x = true)) ⊆
              (D \ C).filter (fun x => hasBit (used0 ||| (closedM v &&& (fullM &&& ~~~ban))) x = true) := by
            intro x hx
            rw [Finset.mem_insert] at hx
            rcases hx with rfl | hx
            · exact Finset.mem_filter.mpr ⟨hw, by rw [hasBit_or, hwcm, Bool.or_true]⟩
            · rcases Finset.mem_filter.mp hx with ⟨hxDC, hxu⟩
              exact Finset.mem_filter.mpr ⟨hxDC, by rw [hasBit_or, hxu, Bool.true_or]⟩
          have hwnot : w ∉ (D \ C).filter (fun x => hasBit used0 x = true) := by
            intro hm
            have := (Finset.mem_filter.mp hm).2
            rw [hwu0] at this
            exact Bool.false_ne_true this
          have hstep : ((D \ C).filter (fun x => hasBit used0 x = true)).card + 1 ≤
              ((D \ C).filter (fun x => hasBit (used0 ||| (closedM v &&& (fullM &&& ~~~ban))) x = true)).card := by
            have hc := Finset.card_le_card hsub
            rw [Finset.card_insert_of_notMem hwnot] at hc
            exact hc
          have hih := ih (used0 ||| (closedM v &&& (fullM &&& ~~~ban))) usedEnd h
          simp only [List.length_cons]
          omega

lemma step_choose {D C : Finset (Fin 50)} {ban dom : UInt64} {rem' : Nat} {u : Fin 50}
    (hI : cgraph.IsIndepSet (D : Set (Fin 50)))
    (hC : C ⊆ D)
    (hrem : (D \ C).card ≤ rem' + 1)
    (hban : ∀ w ∈ D \ C, hasBit ban w = false)
    (hdom : ∀ v : Fin 50, hasBit dom v = false → ∃ w ∈ D \ C, hasBit (closedM v.val) w = true)
    (hu : u ∈ D \ C) :
    insert u C ⊆ D ∧
    (D \ insert u C).card ≤ rem' ∧
    (∀ w ∈ D \ insert u C, hasBit (ban ||| closedM u.val) w = false) ∧
    (∀ v : Fin 50, hasBit (dom ||| closedM u.val) v = false →
      ∃ w ∈ D \ insert u C, hasBit (closedM v.val) w = true) := by
  have huD : u ∈ D := (Finset.mem_sdiff.mp hu).1
  have hsub' : insert u C ⊆ D := Finset.insert_subset huD hC
  have hsdiff_eq : D \ insert u C = (D \ C).erase u := by
    ext x; simp [Finset.mem_sdiff, Finset.mem_erase, and_left_comm]
  have hrem' : (D \ insert u C).card ≤ rem' := by
    rw [hsdiff_eq, Finset.card_erase_of_mem hu]
    omega
  have hban' : ∀ w ∈ D \ insert u C, hasBit (ban ||| closedM u.val) w = false := by
    intro w hw
    rw [hsdiff_eq, Finset.mem_erase] at hw
    rcases hw with ⟨hwu, hwDC⟩
    rw [hasBit_or, hban w hwDC, Bool.false_or, hasBit_closedM]
    have hneq : (u == w) = false := beq_false_of_ne (Ne.symm hwu)
    have hna : adjB u w = false := by
      by_contra h
      have ht : adjB u w = true := Bool.eq_true_of_not_eq_false h
      exact hI (Finset.mem_coe.mpr huD) (Finset.mem_coe.mpr (Finset.mem_sdiff.mp hwDC).1)
        (Ne.symm hwu) ht
    rw [hneq, hna]; rfl
  have hdom' : ∀ v : Fin 50, hasBit (dom ||| closedM u.val) v = false →
      ∃ w ∈ D \ insert u C, hasBit (closedM v.val) w = true := by
    intro v hv
    rw [hasBit_or, Bool.or_eq_false_iff] at hv
    rcases hv with ⟨hvd, hvc⟩
    obtain ⟨w, hwDC, hwc⟩ := hdom v hvd
    refine ⟨w, ?_, hwc⟩
    rw [hsdiff_eq, Finset.mem_erase]
    refine ⟨?_, hwDC⟩
    intro hwu
    subst hwu
    rw [hasBit_closedM] at hwc hvc
    have hbe : (v == w) = (w == v) := by simp [eq_comm]
    rw [hbe, adjB_symm] at hwc
    rw [hwc] at hvc
    cases hvc
  exact ⟨hsub', hrem', hban', hdom'⟩

lemma checkCert_sound (c : Cert) :
    ∀ (D C : Finset (Fin 50)) (ban dom : UInt64) (rem : Nat),
      cgraph.IsIndepSet (D : Set (Fin 50)) →
      C ⊆ D →
      (D \ C).card ≤ rem →
      (∀ w ∈ D \ C, hasBit ban w = false) →
      (∀ v : Fin 50, hasBit dom v = false → ∃ w ∈ D \ C, hasBit (closedM v.val) w = true) →
      checkCert c ban dom rem = true →
      False := by
  induction c with
  | D v =>
    intro D C ban dom rem _ _ _ hban hdom hok
    unfold checkCert at hok
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hok
    rcases hok with ⟨⟨hv, hdv⟩, hzero⟩
    have hdv' : hasBit dom ⟨v, hv⟩ = false := by
      unfold hasBit; simp [hdv]
    obtain ⟨w, hw, hwc⟩ := hdom ⟨v, hv⟩ hdv'
    have hwb : hasBit (fullM &&& ~~~ban) w = true := by
      rw [hasBit_full_and_not, hban w hw]; rfl
    have h1 : hasBit (closedM v &&& (fullM &&& ~~~ban)) w = true := by
      rw [hasBit_and, hwc, hwb]; rfl
    rw [hzero, hasBit_zero] at h1
    exact Bool.false_ne_true h1
  | P vs =>
    intro D C ban dom rem _ _ hrem hban hdom hok
    unfold checkCert at hok
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
    rcases hok with ⟨hlt, hpk⟩
    cases hp : checkPack (fullM &&& ~~~ban) dom vs 0 with
    | none => rw [hp] at hpk; cases hpk
    | some usedEnd =>
      have hcard := checkPack_sound hban hdom vs 0 usedEnd hp
      have h0 : ((D \ C).filter (fun w => hasBit 0 w = true)).card = 0 := by
        simp [hasBit_zero]
      have hle : ((D \ C).filter (fun w => hasBit usedEnd w = true)).card ≤ (D \ C).card :=
        Finset.card_le_card (Finset.filter_subset _ _)
      omega
  | O vs nxt ih =>
    intro D C ban dom rem hI hC hrem hban hdom hok
    unfold checkCert at hok
    simp only [Bool.and_eq_true, beq_iff_eq] at hok
    rcases hok with ⟨heq, hpk⟩
    cases hp : checkPack (fullM &&& ~~~ban) dom vs 0 with
    | none => rw [hp] at hpk; cases hpk
    | some usedEnd =>
      rw [hp] at hpk
      have hcard := checkPack_sound hban hdom vs 0 usedEnd hp
      have h0 : ((D \ C).filter (fun w => hasBit 0 w = true)).card = 0 := by
        simp [hasBit_zero]
      have hsub := Finset.filter_subset (fun w => hasBit usedEnd w = true) (D \ C)
      have hle : (D \ C).card ≤ ((D \ C).filter (fun w => hasBit usedEnd w = true)).card := by
        omega
      have heqSet : (D \ C).filter (fun w => hasBit usedEnd w = true) = D \ C :=
        Finset.eq_of_subset_of_card_le hsub hle
      have hban' : ∀ w ∈ D \ C, hasBit (fullM &&& ~~~usedEnd) w = false := by
        intro w hw
        rw [← heqSet] at hw
        have hwu := (Finset.mem_filter.mp hw).2
        rw [hasBit_full_and_not, hwu]; rfl
      exact ih D C (fullM &&& ~~~usedEnd) dom rem hI hC hrem hban' hdom hpk
  | F v u nxt ih =>
    intro D C ban dom rem hI hC hrem hban hdom hok
    cases rem with
    | zero => simp [checkCert] at hok
    | succ rem' =>
      unfold checkCert at hok
      simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hok
      rcases hok with ⟨⟨⟨⟨hv, hu⟩, hdv⟩, hmask⟩, hnxt⟩
      have hdv' : hasBit dom ⟨v, hv⟩ = false := by
        unfold hasBit; simp [hdv]
      obtain ⟨w, hw, hwc⟩ := hdom ⟨v, hv⟩ hdv'
      have hwb : hasBit (fullM &&& ~~~ban) w = true := by
        rw [hasBit_full_and_not, hban w hw]; rfl
      have h1 : hasBit (closedM v &&& (fullM &&& ~~~ban)) w = true := by
        rw [hasBit_and, hwc, hwb]; rfl
      rw [hmask] at h1
      have hwu : (⟨u, hu⟩ : Fin 50) = w := by
        have hb := hasBit_bitM ⟨u, hu⟩ w
        rw [h1] at hb
        exact beq_iff_eq.mp hb.symm
      subst hwu
      rcases step_choose hI hC hrem hban hdom hw with ⟨hC', hrem', hban', hdom'⟩
      exact ih D (insert ⟨u, hu⟩ C) (ban ||| closedM u) (dom ||| closedM u) rem' hI hC' hrem' hban' hdom' hnxt
  | B u t f iht ihf =>
    intro D C ban dom rem hI hC hrem hban hdom hok
    cases rem with
    | zero => simp [checkCert] at hok
    | succ rem' =>
      unfold checkCert at hok
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
      rcases hok with ⟨⟨hu, ht⟩, hf⟩
      let uf : Fin 50 := ⟨u, hu⟩
      by_cases hmem : uf ∈ D \ C
      · rcases step_choose hI hC hrem hban hdom hmem with ⟨hC', hrem', hban', hdom'⟩
        exact iht D (insert uf C) (ban ||| closedM u) (dom ||| closedM u) rem' hI hC' hrem' hban' hdom' ht
      · have hban' : ∀ w ∈ D \ C, hasBit (ban ||| bitM u) w = false := by
          intro w hw
          rw [hasBit_or, hban w hw, Bool.false_or]
          have hne : uf ≠ w := fun heq => hmem (heq ▸ hw)
          have hb := hasBit_bitM uf w
          rw [beq_false_of_ne hne] at hb
          exact hb
        exact ihf D C (ban ||| bitM u) dom (rem' + 1) hI hC hrem hban' hdom hf

