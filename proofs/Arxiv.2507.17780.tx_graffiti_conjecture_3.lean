set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
lemma cert_ok : checkCert rootCert 0 0 15 = true := by decide

lemma no_small_ids (D : Finset (Fin 50))
    (hI : cgraph.IsIndepSet (D : Set (Fin 50)))
    (hD : cgraph.IsDominating (D : Set (Fin 50)))
    (hcard : D.card ≤ 15) : False := by
  refine checkCert_sound rootCert D ∅ 0 0 15 hI (Finset.empty_subset D) ?_ ?_ ?_ cert_ok
  · simpa using hcard
  · intro w _
    exact hasBit_zero w
  · intro v _
    rcases hD v with hv | ⟨w, hw, hadj⟩
    · refine ⟨v, by simpa using Finset.mem_coe.mp hv, ?_⟩
      rw [hasBit_closedM]; simp
    · refine ⟨w, by simpa using Finset.mem_coe.mp hw, ?_⟩
      rw [hasBit_closedM]
      change adjB v w = true at hadj
      rw [hadj, Bool.or_true]

lemma cgraph_indepDom_ge : 16 ≤ cgraph.indepDominationNumber := by
  rw [SimpleGraph.indepDominationNumber]
  refine le_csInf indepDom_nonempty ?_
  intro n hn
  rcases hn with ⟨D, hI, hD, rfl⟩
  by_contra hlt
  have hle : D.card ≤ 15 := by omega
  exact no_small_ids D hI hD hle

end TxG3Disproof

theorem OMA.disproof : ¬ (type_of% @Arxiv.«2507.17780».tx_graffiti_conjecture_3) := by
  intro hconj
  have hle := hconj (Fin 50) TxG3Disproof.cgraph 3 TxG3Disproof.cgraph_reg (by omega)
  have h1 := TxG3Disproof.cgraph_indepDom_ge
  have h2 := TxG3Disproof.cgraph_sat_le
  omega
