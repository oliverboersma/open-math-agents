lemma decade (q' : ℕ) (h1 : 0 ≤ q') (h2 : q' < 9999) :
    ∃ e1 e3 e7 e9 : ℕ, ok5 (10 * q' + 1) e1 = true ∧ ok5 (10 * q' + 3) e3 = true ∧ ok5 (10 * q' + 7) e7 = true ∧ ok5 (10 * q' + 9) e9 = true := by
  by_cases g0 : q' < 1250
  · exact loop5_range c0 q' (by omega) (by omega)
  by_cases g1 : q' < 2500
  · exact loop5_range c1 q' (by omega) (by omega)
  by_cases g2 : q' < 3750
  · exact loop5_range c2 q' (by omega) (by omega)
  by_cases g3 : q' < 5000
  · exact loop5_range c3 q' (by omega) (by omega)
  by_cases g4 : q' < 6250
  · exact loop5_range c4 q' (by omega) (by omega)
  by_cases g5 : q' < 7500
  · exact loop5_range c5 q' (by omega) (by omega)
  by_cases g6 : q' < 8750
  · exact loop5_range c6 q' (by omega) (by omega)
  exact loop5_range c7 q' (by omega) (by omega)

theorem last_99991 : ok5 99991 961 = true := by decide +kernel

theorem last_99993 : ok5 99993 288247 = true := by decide +kernel

theorem last_99997 : ok5 99997 1046529 = true := by decide +kernel

theorem finite_slice5 (n : ℕ) (hn : 0 < n) (hlt : n < 10 ^ 5 - 1) (hco : Nat.Coprime n 10) :
    ∃ m < (10 ^ 45 - 1) / 9, 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 := by
  have hg : Nat.gcd n 10 = 1 := hco
  have h2 : n % 2 = 1 := by
    by_contra hc
    have hd : 2 ∣ Nat.gcd n 10 := Nat.dvd_gcd (by omega) (by norm_num)
    rw [hg] at hd; omega
  have h5 : n % 5 ≠ 0 := by
    intro hc
    have hd : 5 ∣ Nat.gcd n 10 := Nat.dvd_gcd (by omega) (by norm_num)
    rw [hg] at hd; omega
  have hlt' : n < 99999 := by norm_num at hlt; exact hlt
  by_cases hbig : 99990 ≤ n
  · have hcase : n = 99991 ∨ n = 99993 ∨ n = 99997 := by omega
    rcases hcase with rfl | rfl | rfl
    · exact ok5_spec _ _ last_99991
    · exact ok5_spec _ _ last_99993
    · exact ok5_spec _ _ last_99997
  · obtain ⟨e1, e3, e7, e9, o1, o3, o7, o9⟩ := decade (n / 10) (by omega) (by omega)
    have hr : n % 10 = 1 ∨ n % 10 = 3 ∨ n % 10 = 7 ∨ n % 10 = 9 := by omega
    rcases hr with hr | hr | hr | hr
    · rw [show 10 * (n / 10) + 1 = n by omega] at o1; exact ok5_spec _ _ o1
    · rw [show 10 * (n / 10) + 3 = n by omega] at o3; exact ok5_spec _ _ o3
    · rw [show 10 * (n / 10) + 7 = n by omega] at o7; exact ok5_spec _ _ o7
    · rw [show 10 * (n / 10) + 9 = n by omega] at o9; exact ok5_spec _ _ o9

end OMA.A4290fin5

theorem OMA.solution : OMA.R_OeisA4290_conjecture_R1_H1_R1_H3_R1.H2 := by
  intro n hn hlt hco
  exact OMA.A4290fin5.finite_slice5 n hn hlt hco
