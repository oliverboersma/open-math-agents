import OMAReductions.R_OeisA4290_conjecture_R1_H1_R1_H3_R1

-- Every n below 99999 coprime to 10 has a positive 0/1 multiple below the repunit with 45 digits.
-- Original proof: a table of least 0/1 multiples, each entry checked by the kernel (divisibility, digits, size).
-- Small cases of the open question on OEIS A004290, not the question itself.

namespace OMA.A4290fin5

/-- Reads a bit mask as a decimal number with digits 0 and 1. -/
def decOf : ℕ → ℕ → ℕ
  | 0, _ => 0
  | f + 1, b => b % 2 + 10 * decOf f (b / 2)

lemma digits01_decOf : ∀ (f b : ℕ), ∀ d ∈ Nat.digits 10 (decOf f b), d = 0 ∨ d = 1 := by
  intro f
  induction f with
  | zero => intro b d hd; simp [decOf] at hd
  | succ f ih =>
    intro b d hd
    rw [decOf] at hd
    by_cases h0 : b % 2 + 10 * decOf f (b / 2) = 0
    · rw [h0] at hd; simp at hd
    · rw [Nat.digits_def' (by norm_num) (Nat.pos_of_ne_zero h0)] at hd
      have hb : b % 2 < 2 := Nat.mod_lt _ (by norm_num)
      have e1 : (b % 2 + 10 * decOf f (b / 2)) % 10 = b % 2 := by omega
      have e2 : (b % 2 + 10 * decOf f (b / 2)) / 10 = decOf f (b / 2) := by omega
      rw [e1, e2] at hd
      rcases List.mem_cons.mp hd with h | h
      · omega
      · exact ih (b / 2) d h

/-- The few witnesses that need more than 31 binary digits. -/
def exc (n : ℕ) : ℕ :=
  if n = 9999 then 68719476735 else
  if n = 10989 then 91626110975 else
  if n = 29997 then 137170518015 else
  if n = 32967 then 91626143735 else
  if n = 69993 then 68719476735 else
  if n = 76923 then 4485386042879 else
  if n = 89991 then 137438953455 else
  if n = 98901 then 91635056597 else
  0

/-- The entry `e` (or the exceptional value when `e = 0`) encodes a positive 0/1 multiple of `n`
below the repunit with 45 digits. -/
def ok5 (n e : ℕ) : Bool :=
  decide (0 < decOf 45 (if e = 0 then exc n else e)) &&
    (decOf 45 (if e = 0 then exc n else e) % n == 0) &&
    decide (decOf 45 (if e = 0 then exc n else e) < 111111111111111111111111111111111111111111111)

def loop5 : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | f + 1, q, W =>
      ok5 (10 * q + 1) (W % 2 ^ 31) && ok5 (10 * q + 3) (W / 2 ^ 31 % 2 ^ 31) &&
      ok5 (10 * q + 7) (W / 2 ^ 62 % 2 ^ 31) && ok5 (10 * q + 9) (W / 2 ^ 93 % 2 ^ 31) &&
      loop5 f (q + 1) (W / 2 ^ 124)


lemma ok5_spec (n e : ℕ) (h : ok5 n e = true) :
    ∃ m < (10 ^ 45 - 1) / 9, 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 := by
  simp only [ok5, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨hpos, hmod⟩, hb⟩ := h
  exact ⟨_, lt_of_lt_of_le hb (by norm_num), hpos, Nat.dvd_of_mod_eq_zero hmod, digits01_decOf _ _⟩

lemma loop5_spec : ∀ (f q W : ℕ), loop5 f q W = true → ∀ j, j < f →
    ∃ e1 e3 e7 e9 : ℕ, ok5 (10 * (q + j) + 1) e1 = true ∧ ok5 (10 * (q + j) + 3) e3 = true ∧
      ok5 (10 * (q + j) + 7) e7 = true ∧ ok5 (10 * (q + j) + 9) e9 = true := by
  intro f
  induction f with
  | zero => intro q W _ j hj; omega
  | succ f ih =>
    intro q W h j hj
    rw [loop5] at h
    simp only [Bool.and_eq_true] at h
    cases j with
    | zero => exact ⟨_, _, _, _, h.1.1.1.1, h.1.1.1.2, h.1.1.2, h.1.2⟩
    | succ j =>
      have := ih (q + 1) (W / 2 ^ 124) h.2 j (by omega)
      rw [show q + (j + 1) = q + 1 + j by omega]
      exact this

lemma loop5_range {f q W : ℕ} (h : loop5 f q W = true) (q' : ℕ) (h1 : q ≤ q') (h2 : q' < q + f) :
    ∃ e1 e3 e7 e9 : ℕ, ok5 (10 * q' + 1) e1 = true ∧ ok5 (10 * q' + 3) e3 = true ∧ ok5 (10 * q' + 7) e7 = true ∧ ok5 (10 * q' + 9) e9 = true := by
  have h3 := loop5_spec f q W h (q' - q) (by omega)
  rw [show q + (q' - q) = q' by omega] at h3
  exact h3

