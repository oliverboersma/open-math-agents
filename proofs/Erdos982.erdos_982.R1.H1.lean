private def inputCount : ℕ := 8665

/- Each learned record starts with two counts, followed by its literals and their ordered
   propagation hints. Every hint must refer to an earlier clause. -/
private def countLits (r : ℕ) := r % 64
private def learned (i : ℕ) : Cl :=
  let r := record i
  (fields 11 (countLits r) (r >>> 14)).map fun l => (variableAt (l / 2), l % 2 == 1)

private def hints (i : ℕ) : List ℕ :=
  let r := record i
  let h := r >>> (14 + 11 * countLits r)
  fields 14 ((r >>> 6) % 256) h

private def clauseAt (i : ℕ) : Cl :=
  if i < inputCount then base (codeAt i) else learned (i-inputCount)

private def validAt (i : ℕ) : Bool :=
  if i < inputCount then baseCheck (codeAt i)
  else
    let hs := hints (i-inputCount)
    hs.all (· < i) && scan (mask (clauseAt i)) (hs.map clauseAt)

private theorem derivations (a : ℕ → Bool) (ha : (E982C.gen 10 4).eval a = true)
    {n : ℕ} (h : span validAt 0 n) {i : ℕ} (hi : i < n) : Holds a (clauseAt i) := by
  induction i using Nat.strong_induction_on with
  | h i ih =>
    have hv := h i hi
    simp only [Nat.zero_add] at hv
    unfold validAt at hv
    split at hv
    next hlt => simpa only [clauseAt,if_pos hlt] using base_ok a ha hv
    next hge =>
      obtain ⟨hl, hp⟩ := Bool.and_eq_true_iff.mp hv
      apply mask_ok hp
      intro c hc
      obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hc
      have hji := of_decide_eq_true (List.all_eq_true.mp hl j hj)
      exact ih j hji (lt_trans hji hi)
