namespace Ten982

private abbrev Lit := ℕ × Bool
private abbrev Cl := List Lit
private abbrev V := Fin 10
private abbrev W := E982C.Shape 10
private def Holds (a : ℕ → Bool) (c : Cl) := ∃ l ∈ c, a l.1 = l.2
private def topCl : Cl := [(0,true),(0,false)]
private theorem top_ok (a : ℕ → Bool) : Holds a topCl := by
  cases h : a 0 <;> simp [Holds, topCl, h]
private def input (w : W) (j : ℕ) : Cl :=
  match (E982C.block 4 w)[j]? with
  | some c => c.map fun l => (E982C.enc l.1,l.2)
  | none => topCl

private theorem input_ok (a : ℕ → Bool) (ha : (E982C.gen 10 4).eval a = true) (w : W) (j : ℕ) :
    Holds a (input w j) := by
  unfold input
  split
  next c he =>
    rw [E982C.gen, Std.Sat.CNF.eval_relabel] at ha
    have hm := E982C.block_sound 4 w (List.mem_of_getElem? he)
    have hc := Array.all_eq_true_iff_forall_mem.mp ha c hm
    obtain ⟨l,hl,ha'⟩ := List.any_eq_true.mp hc
    exact ⟨_, List.mem_map.mpr ⟨l,hl,rfl⟩, by simpa using ha'⟩
  next => exact top_ok a


private def bitNo (u : Lit) : ℕ := 2*u.1 + u.2.toNat
private def litNo (i : ℕ) : Lit := (i/2,i%2 == 1)
private theorem lit_bit (u : Lit) : litNo (bitNo u) = u := by
  rcases u with ⟨i,b⟩
  cases b <;> simp [bitNo,litNo,Nat.mul_comm]
  omega
private theorem bit_inj {u v : Lit} : bitNo u = bitNo v ↔ u = v :=
  ⟨fun h => by simpa [lit_bit] using congrArg litNo h, congrArg bitNo⟩

private def mask : Cl → ℕ
  | [] => 0
  | l::ls => (1 <<< bitNo l) ||| mask ls

private theorem mask_mem (c : Cl) (u : Lit) : (mask c).testBit (bitNo u) = true ↔ u ∈ c := by
  induction c with
  | nil => simp [mask]
  | cons l ls ih =>
    simp only [mask,Nat.testBit_or,Bool.or_eq_true,Nat.one_shiftLeft,Nat.testBit_two_pow,
      decide_eq_true_eq,bit_inj,ih,List.mem_cons]
    exact or_congr eq_comm Iff.rfl

/-- The set bits mark literals known to be false. A unit clause excludes its opposite literal. -/
private def scan (excluded : ℕ) : List Cl → Bool
  | [] => false
  | c::cs =>
    match c.filter (fun l => !excluded.testBit (bitNo l)) with
    | [] => true
    | [u] => scan (excluded ||| (1 <<< bitNo (E982C.flipLit u))) cs
    | _ => false

private theorem scan_sound (a : ℕ → Bool) (cs : List Cl) (e : ℕ)
    (he : ∀ u, e.testBit (bitNo u) = true → a u.1 ≠ u.2)
    (hs : ∀ c ∈ cs, Holds a c) : scan e cs = false := by
  induction cs generalizing e with
  | nil => rfl
  | cons c cs ih =>
    obtain ⟨u,hu,ht⟩ := hs c (.head _)
    have hn : e.testBit (bitNo u) = false := by
      cases h : e.testBit (bitNo u) <;> first | rfl | exact (he u h ht).elim
    have hm : u ∈ c.filter (fun l => !e.testBit (bitNo l)) := by simp [hu,hn]
    unfold scan
    split <;> rename_i hf
    · rw [hf] at hm
      contradiction
    · rw [hf,List.mem_singleton] at hm
      subst u
      apply ih
      · intro z hz
        simp only [Nat.testBit_or,Bool.or_eq_true,Nat.one_shiftLeft,Nat.testBit_two_pow,
          decide_eq_true_eq,bit_inj] at hz
        rcases hz with h|rfl
        · exact he z h
        · simp [E982C.flipLit,ht]
      · exact fun x h => hs x (.tail _ h)
    · rfl

private theorem mask_ok {a : ℕ → Bool} {c : Cl} {cs : List Cl}
    (h : scan (mask c) cs = true) (hs : ∀ d ∈ cs, Holds a d) : Holds a c := by
  by_contra hn
  have he := scan_sound a cs (mask c) (fun u hu ht => hn ⟨u,(mask_mem c u).mp hu,ht⟩) hs
  exact Bool.noConfusion (h.symm.trans he)

private def edge (v j : V) := E982C.cp v j
private def ltLit (x y : V × V) : Lit := (E982C.enc (E982C.Atom.L x y),false)
private def chain (v a b c d e : V) : Cl :=
  let f := edge v
  [ltLit (f a) (f b),ltLit (f b) (f c),ltLit (f c) (f d),ltLit (f d) (f e)]


private theorem edge_mem : ∀ (v j : V), v ≠ j → edge v j ∈ E982C.prs 10 := by decide +kernel
private theorem edge_inj : ∀ (v i j : V), i ≠ j → edge v i ≠ edge v j := by decide +kernel
private def LT (a : ℕ → Bool) (v i j : V) := a (ltLit (edge v i) (edge v j)).1 = true
private def EQ (a : ℕ → Bool) (v i j : V) := a (E982C.enc (E982C.Eq' (edge v i) (edge v j))) = true

private theorem trans_row {a : ℕ → Bool} (h : (E982C.gen 10 4).eval a = true)
    {v i j k : V} (hi : v ≠ i) (hj : v ≠ j) (hk : v ≠ k)
    (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k)
    (h1 : LT a v i j) (h2 : LT a v j k) : LT a v i k := by
  have hc := input_ok a h (E982C.Shape.trans (edge v i) (edge v j) (edge v k)) 0
  simp [input, E982C.block, edge_mem _ _ hi, edge_mem _ _ hj, edge_mem _ _ hk,
    edge_inj _ _ _ hij, edge_inj _ _ _ hjk, edge_inj _ _ _ hik, Holds] at hc
  simp [LT, ltLit] at h1 h2 ⊢
  grind

private theorem sep_row {a : ℕ → Bool} (h : (E982C.gen 10 4).eval a = true)
    {v i j : V} (hi : v ≠ i) (hj : v ≠ j) (hij : i ≠ j)
    (h1 : LT a v i j) : ¬ EQ a v i j := by
  have hc := input_ok a h (E982C.Shape.ord (edge v i) (edge v j)) 0
  simp [input,E982C.block,edge_mem _ _ hi,edge_mem _ _ hj,edge_inj _ _ _ hij,Holds] at hc
  simp [LT,ltLit] at h1
  simp [EQ]
  grind


private theorem chosen_mem {α : Type} {xs ys : List α} (h : xs.Sublist ys) :
    xs ∈ E982C.subsets xs.length ys := by
  induction h with
  | slnil => simp [E982C.subsets]
  | @cons xs ys a h ih =>
    cases xs with
    | nil => simp [E982C.subsets]
    | cons x xs => exact List.mem_append_right _ ih
  | cons_cons a h ih =>
    exact List.mem_append_left _ (List.mem_map.mpr ⟨_,ih,rfl⟩)

private theorem eq_swap : ∀ v i j : V, E982C.Eq' (edge v i) (edge v j) =
    E982C.Eq' (edge v j) (edge v i) := by decide +kernel

private def eligible (v : V) (xs : List V) := (E982C.others v).filter fun x => xs.contains x
private def conditions (v i j k l m : V) : Bool :=
  decide ([v,i,j,k,l,m].Nodup ∧ (eligible v [i,j,k,l,m]).length = 5)

/-- A five-spoke increasing chain excludes all ten equalities in its class clause. -/
private theorem chain_ok {a : ℕ → Bool} (ha : (E982C.gen 10 4).eval a = true)
    {v i j k l m : V} (hc : conditions v i j k l m = true) : Holds a (chain v i j k l m) := by
  simp only [conditions, decide_eq_true_eq] at hc
  obtain ⟨hd,hp⟩ := hc
  simp only [List.nodup_cons,List.mem_cons,List.not_mem_nil,or_false,not_or,
    List.nodup_nil,and_true] at hd
  by_contra hn
  simp [Holds,chain,ltLit] at hn
  have h1 : LT a v i j := hn.1
  have h2 : LT a v j k := hn.2.1
  have h3 : LT a v k l := hn.2.2.1
  have h4 : LT a v l m := hn.2.2.2
  have h13 : LT a v i k := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h1 h2
  have h24 : LT a v j l := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h2 h3
  have h35 : LT a v k m := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h3 h4
  have h14 : LT a v i l := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h13 h3
  have h25 : LT a v j m := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h24 h4
  have h15 : LT a v i m := trans_row ha (by grind) (by grind) (by grind)
    (by grind) (by grind) (by grind) h14 h4
  let s := eligible v [i,j,k,l,m]
  have hsub : s.Sublist (E982C.others v) := List.filter_sublist
  have hmem := chosen_mem hsub
  change s.length = 5 at hp
  rw [hp] at hmem
  have hv : v ∈ E982C.vs 10 := by simp [E982C.vs]
  have hcl := input_ok a ha (E982C.Shape.classes v s) 0
  simp [input, E982C.block, hv, hmem, Holds] at hcl
  obtain ⟨x,y,hm,ht⟩ := hcl
  have nd : s.Nodup := by
    apply hsub.nodup
    unfold E982C.others E982C.vs
    exact List.Nodup.filter _ (List.nodup_finRange _)
  have hxy := E982C.mem_pairsOf hm
  have hne := hxy.2.2 nd
  have hx : x ∈ [i,j,k,l,m] := by simpa using (List.mem_filter.mp hxy.1).2
  have hy : y ∈ [i,j,k,l,m] := by simpa using (List.mem_filter.mp hxy.2.1).2
  have hdir : LT a v x y ∨ LT a v y x := by
    simp only [List.mem_cons] at hx hy
    grind
  have hvx : v ≠ x := by simp only [List.mem_cons] at hx; grind
  have hvy : v ≠ y := by simp only [List.mem_cons] at hy; grind
  change EQ a v x y at ht
  rcases hdir with h | h
  · exact (sep_row ha hvx hvy hne h) ht
  · apply sep_row ha hvy hvx hne.symm h
    simpa only [EQ,eq_swap v y x] using ht

private def nyb (x i : Nat) := (x / (10^i)) % 10
private def asV (x i : Nat) : V := Fin.ofNat 10 (nyb x i)
private def shapeOf (x : Nat) : W × ℕ :=
  let a := asV x 1
  let b := asV x 2
  let c := asV x 3
  let d := asV x 4
  let e := asV x 5
  let f := asV x 6
  match nyb x 0 with
  | 0 => (E982C.Shape.eqv (a,b) (c,d) (e,f),0)
  | 1 => (E982C.Shape.trans (a,b) (c,d) (e,f),0)
  | 2 => (E982C.Shape.ord (a,b) (c,d),0)
  | 3 => (E982C.Shape.ord (a,b) (c,d),1)
  | 4 => (E982C.Shape.classes a [b,c,d,e,f],0)
  | 5 => (E982C.Shape.side a b c d,0)
  | 6 => (E982C.Shape.acute a (b,c),0)
  | 7 => (E982C.Shape.acute a (b,c),1)
  | _ => (E982C.Shape.four [a,b,c,d],0)

private def useSix {α : Type} (f : V → V → V → V → V → V → α) (x : Nat) : α :=
  f (asV x 1) (asV x 2) (asV x 3) (asV x 4) (asV x 5) (asV x 6)


private def direct (w : W) (j : ℕ) : Cl :=
  let e := fun (p q : V × V) (b : Bool) => (E982C.enc (E982C.Eq' p q), b)
  let l := fun (p q : V × V) (b : Bool) => (E982C.enc (E982C.Atom.L p q), b)
  let ac := fun (v : V) (b : Bool) => (E982C.enc (E982C.Atom.A v), b)
  match w with
  | E982C.Shape.eqv p q r => [e p q false,e q r false,e p r true]
  | E982C.Shape.ord p q =>
    if j = 0 then [e p q false,l p q false] else [e p q true,l p q true,l q p true]
  | E982C.Shape.trans p q r => [l p q false,l q r false,l p r true]
  | E982C.Shape.classes v s => (E982C.pairsOf s).map fun (i,k) => e (edge v i) (edge v k) true
  | E982C.Shape.side u w z y => [l (edge z w) (edge z u) true,l (edge y u) (edge y w) true]
  | E982C.Shape.acute v s =>
    let p := edge (E982C.pv 10 v) (E982C.nx 10 v)
    [if j = 0 then e p s false else l p s false,ac v true]
  | E982C.Shape.four s => s.map fun v => ac v false

private def base (x : Nat) : Cl :=
  if nyb x 0 = 9 then useSix chain x else
    let w := shapeOf x
    direct w.1 w.2

private def baseCheck (x : Nat) : Bool :=
  if nyb x 0 = 9 then useSix conditions x else
    let w := shapeOf x
    direct w.1 w.2 == input w.1 w.2

private theorem base_ok (a : ℕ → Bool) (ha : (E982C.gen 10 4).eval a = true) {x : ℕ}
    (h : baseCheck x = true) : Holds a (base x) := by
  unfold base baseCheck at *
  split at h
  next hx => rw [if_pos hx]; exact chain_ok ha h
  next hx =>
    rw [if_neg hx]
    exact (eq_of_beq h) ▸ input_ok a ha _ _

private def fields (w num data : ℕ) : List ℕ :=
  (List.range num).map fun i => (data >>> (w*i)) % (2^w)

private def slice (w beginAt endAt data : ℕ) : List ℕ :=
  fields w (endAt - beginAt) (data >>> (w*beginAt))

private def span (f : ℕ → Bool) (s n : ℕ) : Prop := ∀ i < n, f (s+i) = true
private theorem spanOf {f : ℕ → Bool} {s n : ℕ}
    (h : ((List.range n).all (fun i => f (s+i))) = true) : span f s n :=
  fun i hi => List.all_eq_true.mp h i (List.mem_range.mpr hi)
private theorem combine {f : ℕ → Bool} {s n m : ℕ}
    (hl : span f s n) (hr : span f (s+n) m) : span f s (n+m) := by
  intro i hi
  by_cases h : i < n
  · exact hl i h
  · have hh := hr (i-n) (by omega)
    convert hh using 2
    omega

