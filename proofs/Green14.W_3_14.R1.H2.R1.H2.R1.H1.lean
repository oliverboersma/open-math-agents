import OMAReductions.R_Green14_W_3_14_R1_H2_R1_H2_R1

/-! A kernel-reducible search for mixed arithmetic progressions. -/

namespace OMA.W314H3

private def board : Nat := 185
private def stride : Nat := 9

private def point (p : Nat) : Nat := 1 <<< (stride * p)

private structure State where
  candidates : Nat
  marked : Nat
  reflected : Nat
  doubled : Nat
  evenHalf : Nat
  oddHalf : Nat
  deriving DecidableEq

private def erase (s : State) (p : Nat) : State :=
  {s with candidates := s.candidates ^^^ (s.candidates &&& point p)}

private def avoid (s : State) (p : Nat) : Nat :=
  ((s.reflected <<< (2*stride*p)) >>> (stride*(board-1))) |||
    (s.doubled >>> (stride*p)) |||
    ((if p%2=0 then s.evenHalf else s.oddHalf) <<< (stride*((p+1)/2)))

private def choose (s : State) (p : Nat) : State :=
  let q := point p
  let unavailable := avoid s p
  ⟨(s.candidates ^^^ (s.candidates &&& unavailable)) ||| q,
   s.marked ||| q,
   s.reflected ||| point (board-1-p),
   s.doubled ||| point (2*p),
   if p%2=0 then s.evenHalf ||| point (p/2) else s.evenHalf,
   if p%2=1 then s.oddHalf ||| point (p/2) else s.oddHalf⟩

private def rails : Nat := 

private def kernel : Nat := 

private def activeMask (s : State) : Nat :=
  ((s.candidates + 15*s.marked) * kernel) &&& (511*rails)

private def railsHigh : Nat := rails <<< 8

private def flags (m limit : Nat) : Nat :=
  ((railsHigh + limit*rails) - m) &&& railsHigh

private def narrower (m limit : Nat) (otherwise : Unit → Nat) : Nat :=
  let candidate := flags m limit
  if candidate = 0 then otherwise () else candidate

private def leastFlags (m : Nat) : Nat :=
  narrower m 1 fun _ =>
    if flags m 4 ≠ 0 then narrower m 2 fun _ => narrower m 3 fun _ => flags m 4
    else if flags m 8 ≠ 0 then
      if flags m 6 ≠ 0 then narrower m 5 fun _ => flags m 6
      else narrower m 7 fun _ => flags m 8
    else if flags m 11 ≠ 0 then narrower m 9 fun _ => narrower m 10 fun _ => flags m 11
    else narrower m 12 fun _ => narrower m 13 fun _ => flags m 14

private def decode : Nat := 

private def firstBit (x : Nat) : Nat :=
  x ^^^ (x &&& (x-1))

private def findIndex (x : Nat) : Nat :=
  (decode >>> (12*(x % 2621))) % 4096

private def readRow (m : Nat) : Nat × Nat :=
  let i := findIndex (firstBit m)
  let d := i / board + 1
  (i % board - 13*d, d)

private def readPoint (m : Nat) : Nat :=
  findIndex (firstBit m <<< 8)

private def bases : Array Nat := #[0x201008040201008040201008040201,
  0x40001000040001000040001000040001000040001000040001000040001,
  0x8000001000000200000040000008000001000000200000040000008000001000000200000040000008000001,
  0x1000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001000000001,
  0x200000000001000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001000000000008000000000040000000000200000000001,
  0x40000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001000000000000040000000000001,
  0x8000000000000001000000000000000200000000000000040000000000000008000000000000001000000000000000200000000000000040000000000000008000000000000001000000000000000200000000000000040000000000000008000000000000001,
  0x1000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001000000000000000001,
  0x200000000000000000001000000000000000000008000000000000000000040000000000000000000200000000000000000001000000000000000000008000000000000000000040000000000000000000200000000000000000001000000000000000000008000000000000000000040000000000000000000200000000000000000001,
  0x40000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001000000000000000000000040000000000000000000001,
  ,
  ,
  ,
  ]

private def progression (a d : Nat) : Nat := bases[d-1]! <<< (stride*a)

private def remaining (s : State) (a d : Nat) : Nat :=
  s.candidates &&& progression a d

private def getByte (tape : Array Nat) (i : Nat) : Nat :=
  ((tape[i/128]?.getD 0) >>> (8*(i%128))) % 256

private def blankMask : Nat := 

private def initial : State := choose (choose ⟨blankMask, 0,0,0,0,0⟩ 89) 95

private def inspect (s : State) : Option (Nat × Nat) :=
  let vals := activeMask s
  let zeros := flags vals 0
  let bits := if zeros = 0 then flags vals 1 else zeros
  if bits = 0 then none else some (readRow bits)


private def HasRed (c : Nat → Bool) (p : Nat) : Prop := p < board ∧ c p = true

private def NoRedTriples (c : Nat → Bool) : Prop :=
  ∀ a d : Nat, 0 < d → a + 2*d < board →
    ¬(c a = true ∧ c (a+d) = true ∧ c (a+2*d) = true)

private def NoBlueRuns (c : Nat → Bool) : Prop :=
  ∀ a d : Nat, 0 < d → a+13*d < board → ∃ t : Fin 14, c (a+t.val*d) = true

private lemma no_red_middle {c : Nat → Bool} (h : NoRedTriples c)
    {p q r : Nat} (hp : HasRed c p) (hq : HasRed c q) (hr : HasRed c r)
    (he : p + q = 2*r) (hne : p ≠ q) : False := by
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have mid : p + (r-p) = r := by omega
    have last : p + 2*(r-p) = q := by omega
    exact h p (r-p) (by omega) (last.symm ▸ hq.1)
      ⟨hp.2, mid.symm ▸ hr.2, last.symm ▸ hq.2⟩
  · have mid : q + (r-q) = r := by omega
    have last : q + 2*(r-q) = p := by omega
    exact h q (r-q) (by omega) (last.symm ▸ hp.1)
      ⟨hq.2, mid.symm ▸ hr.2, last.symm ▸ hp.2⟩
private lemma pointBit (p i : Nat) : (point p).testBit i = decide (stride*p = i) := by
  simp [point, Nat.shiftLeft_eq, Nat.testBit_two_pow]

private structure Compatible (s : State) (c : Nat → Bool) : Prop where
  possible : ∀ p, HasRed c p → s.candidates.testBit (stride*p) = true
  reflect : ∀ i, s.reflected.testBit i = true →
    ∃ p, HasRed c p ∧ i = stride*(board-1-p)
  double : ∀ i, s.doubled.testBit i = true → ∃ p, HasRed c p ∧ i = stride*(2*p)
  even : ∀ i, s.evenHalf.testBit i = true → ∃ p, HasRed c p ∧ p%2=0 ∧ i = stride*(p/2)
  odd : ∀ i, s.oddHalf.testBit i = true → ∃ p, HasRed c p ∧ p%2=1 ∧ i = stride*(p/2)

private lemma avoid_correct {s : State} {c : Nat → Bool} {p q : Nat}
    (valid : Compatible s c) (h : NoRedTriples c)
    (hp : HasRed c p) (hq : HasRed c q) (hne : p ≠ q) :
    (avoid s p).testBit (stride*q) = false := by
  apply Bool.eq_false_iff.mpr
  intro hbad
  simp only [avoid, Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft,
    Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hbad
  rcases hbad with (⟨hbound, hmark⟩ | hmark) | ⟨hbound, hmark⟩
  · obtain ⟨r, hr, hidx⟩ := valid.reflect _ hmark
    have hrlt := hr.1
    simp only [board, stride] at hidx hbound hrlt
    exact no_red_middle h hq hr hp (by omega) (by intro he; omega)
  · obtain ⟨r, hr, hidx⟩ := valid.double _ hmark
    simp only [stride] at hidx
    exact no_red_middle h hp hq hr (by omega) hne
  · split at hmark
    · rename_i hpEven
      obtain ⟨r, hr, hrEven, hidx⟩ := valid.even _ hmark
      simp only [stride] at hidx hbound
      exact no_red_middle h hp hr hq (by omega) (by intro he; omega)
    · rename_i hpOdd
      obtain ⟨r, hr, hrOdd, hidx⟩ := valid.odd _ hmark
      simp only [stride] at hidx hbound
      exact no_red_middle h hp hr hq (by omega) (by intro he; omega)

private lemma erase_compatible {s : State} {c : Nat → Bool} {p : Nat}
    (valid : Compatible s c) (hp : ¬ HasRed c p) : Compatible (erase s p) c := by
  refine ⟨?_, valid.reflect, valid.double, valid.even, valid.odd⟩
  intro q hq
  have hne : p ≠ q := by intro he; exact hp (he ▸ hq)
  have hd : stride*p ≠ stride*q := by simp [stride]; exact hne
  simp [erase, Nat.testBit_xor, pointBit, valid.possible _ hq, hd]

private lemma choose_compatible {s : State} {c : Nat → Bool} {p : Nat}
    (valid : Compatible s c) (h : NoRedTriples c) (hp : HasRed c p) :
    Compatible (choose s p) c := by
  constructor
  · intro q hq
    by_cases he : p = q
    · simp [choose, he, pointBit]
    · simp [choose, Nat.testBit_xor, avoid_correct valid h hp hq he, valid.possible _ hq]
  · intro i hi
    simp only [choose, Nat.testBit_or, pointBit, Bool.or_eq_true, decide_eq_true_eq] at hi
    exact hi.elim (valid.reflect i) (fun he => ⟨p, hp, he.symm⟩)
  · intro i hi
    simp only [choose, Nat.testBit_or, pointBit, Bool.or_eq_true, decide_eq_true_eq] at hi
    exact hi.elim (valid.double i) (fun he => ⟨p, hp, he.symm⟩)
  · intro i hi
    dsimp [choose] at hi
    split at hi
    · rename_i he
      simp only [Nat.testBit_or, Bool.or_eq_true, pointBit, decide_eq_true_eq] at hi
      exact hi.elim (valid.even i) (fun hi' => ⟨p, hp, he, hi'.symm⟩)
    · exact valid.even i hi
  · intro i hi
    dsimp [choose] at hi
    split at hi
    · rename_i he
      simp only [Nat.testBit_or, Bool.or_eq_true, pointBit, decide_eq_true_eq] at hi
      exact hi.elim (valid.odd i) (fun hi' => ⟨p, hp, he, hi'.symm⟩)
    · exact valid.odd i hi

private lemma base_hit (d : Fin 15) (hd : 0 < d.val) (t : Fin 14) :
    (bases[d.val-1]!).testBit (stride*(t.val*d.val)) = true := by
  revert d t
  decide +kernel

private lemma hits {s : State} {c : Nat → Bool} {a d : Nat}
    (valid : Compatible s c) (h : NoBlueRuns c) (hp : 0 < d)
    (hd : d ≤ 14) (ha : a+13*d < board) :
    ∃ q, HasRed c q ∧ (remaining s a d).testBit (stride*q) = true := by
  obtain ⟨t, ht⟩ := h a d hp ha
  have hb : t.val*d ≤ 13*d := Nat.mul_le_mul_right _ (by omega)
  have hq : HasRed c (a+t.val*d) := ⟨by omega, ht⟩
  refine ⟨_, hq, ?_⟩
  simp only [remaining, progression, Nat.testBit_and, valid.possible _ hq,
    true_and, Nat.testBit_shiftLeft, Bool.and_eq_true, decide_eq_true_eq]
  constructor
  · exact Nat.mul_le_mul_left _ (by omega)
  · rw [Nat.mul_add, Nat.add_sub_cancel_left]
    exact base_hit ⟨d, by omega⟩ hp t

private def Closed (s : State) : Prop :=
  ∀ c, NoRedTriples c → NoBlueRuns c → Compatible s c → False

private structure Gate where
  state : State
  start : Nat
  stop : Nat
  sound : Closed state

private def gateLookup (s : State) (i : Nat) : List Gate → Option Nat
  | [] => none
  | g::gs =>
    if i = g.start ∧ s = g.state then some g.stop else gateLookup s i gs

private lemma lookup_sound (s : State) (i : Nat) (gs : List Gate) (j : Nat)
    (h : gateLookup s i gs = some j) : Closed s := by
  induction gs with
  | nil => simp [gateLookup] at h
  | cons g gs ih =>
    rw [gateLookup] at h
    split at h
    · rename_i he
      exact he.2.symm ▸ g.sound
    · exact ih h

private inductive Action
  | unknown
  | conflict (a d : Nat)
  | forced (a d p : Nat)
  | splitAt (p : Nat)

private def rawAction (s : State) (row : Option (Nat × Nat)) (p : Nat) (allow : Bool) : Action :=
  match row with
  | some (a,d) =>
    if 0 < d ∧ d ≤ 14 ∧ a+13*d < board then
      let left := remaining s a d
      if left = 0 then .conflict a d
      else
        let p := readPoint left
        if p < board ∧ left = point p then .forced a d p
        else .unknown
    else .unknown
  | none => if allow && decide (p < board) then .splitAt p else .unknown

private def Action.Sound (c : Nat → Bool) : Action → Prop
  | .conflict _ _ => False
  | .forced _ _ p => HasRed c p
  | _ => True

private lemma raw_sound (s : State) (row : Option (Nat × Nat)) (p : Nat) (allow : Bool)
    (c : Nat → Bool) (hc : Compatible s c) (hb : NoBlueRuns c) :
    (rawAction s row p allow).Sound c := by
  cases row with
  | none =>
    simp only [rawAction]
    split <;> trivial
  | some row =>
    rcases row with ⟨a,d⟩
    simp only [rawAction]
    by_cases valid : 0 < d ∧ d ≤ 14 ∧ a+13*d < board
    · rw [if_pos valid]
      obtain ⟨q, hq, hbit⟩ := hits hc hb valid.1 valid.2.1 valid.2.2
      by_cases hz : remaining s a d = 0
      · simp [hz] at hbit
      · rw [if_neg hz]
        let t := readPoint (remaining s a d)
        by_cases single : t < board ∧ remaining s a d = point t
        · rw [if_pos single]
          rw [single.2, pointBit, decide_eq_true_eq] at hbit
          have he : t = q := Nat.eq_of_mul_eq_mul_left (by decide : 0 < stride) hbit
          change HasRed c t
          exact he.symm ▸ hq
        · rw [if_neg single]
          trivial
    · rw [if_neg valid]
      trivial


private def actions (word : Nat → Nat) (len : Nat) (s : State) (i : Nat) : Action :=
  rawAction s (inspect s) (word i) (decide (i < len))

private lemma actions_sound (word : Nat → Nat) (len : Nat) (s : State) (i : Nat) (c : Nat → Bool)
    (hs : Compatible s c) (hb : NoBlueRuns c) : (actions word len s i).Sound c :=
  raw_sound s (inspect s) (word i) (decide (i < len)) c hs hb

private def verifyWith (action : State → Nat → Action) (gs : List Gate) (s : State) : Nat → Nat → Nat
  | 0, _ => 0
  | fuel+1, i =>
    match gateLookup s i gs with
    | some j => j
    | none =>
      match action s i with
      | .unknown => 0
      | .conflict _ _ => i+1
      | .forced _ _ p => verifyWith action gs (choose s p) fuel i
      | .splitAt p =>
        match verifyWith action gs (choose s p) fuel (i+1) with
        | 0 => 0
        | j+1 => verifyWith action gs (erase s p) fuel j

private lemma verifyWith_sound (action : State → Nat → Action) (gs : List Gate)
    (sound : ∀ s i c, Compatible s c → NoBlueRuns c → (action s i).Sound c)
    (fuel : Nat) (s : State) (i : Nat)
    (ok : verifyWith action gs s fuel i ≠ 0) : Closed s := by
  intro c hr hb hc
  induction fuel generalizing s i with
  | zero => exact ok rfl
  | succ fuel ih =>
    cases hg : gateLookup s i gs with
    | some j => exact lookup_sound s i gs j hg c hr hb hc
    | none =>
      have hs := sound s i c hc hb
      cases h : action s i with
      | unknown => exact ok (by rw [verifyWith, hg, h])
      | conflict a d =>
        simp only [h, Action.Sound] at hs
      | forced a d p =>
        have hp : HasRed c p := by simpa only [h, Action.Sound] using hs
        exact ih (choose s p) i (by simpa only [verifyWith, hg, h] using ok)
          (choose_compatible hc hr hp)
      | splitAt p =>
        have step : (match verifyWith action gs (choose s p) fuel (i+1) with
            | 0 => 0
            | j+1 => verifyWith action gs (erase s p) fuel j) ≠ 0 := by
          simpa only [verifyWith, hg, h] using ok
        cases hl : verifyWith action gs (choose s p) fuel (i+1) with
        | zero => exact step (by rw [hl])
        | succ j =>
          by_cases hp : HasRed c p
          · exact ih (choose s p) (i+1) (by rw [hl]; exact Nat.succ_ne_zero _)
              (choose_compatible hc hr hp)
          · exact ih (erase s p) j (by simpa only [hl] using step)
              (erase_compatible hc hp)

private def fromBoard (may red : Nat) : State :=
  (List.range board).foldl (fun s p =>
    let b := point p
    let may' := if may.testBit p then s.candidates ||| b else s.candidates
    if red.testBit p then
      ⟨may',s.marked ||| b,s.reflected ||| point (board-1-p),s.doubled ||| point (2*p),
       if p%2=0 then s.evenHalf ||| point (p/2) else s.evenHalf,
       if p%2=1 then s.oddHalf ||| point (p/2) else s.oddHalf⟩
    else {s with candidates := may'}) ⟨0,0,0,0,0,0⟩

private def withSlice (bytes : Array Nat) (len : Nat) :=
  verifyWith (actions (getByte bytes) len) []

private def gateOfSlice (start stop may red : Nat) (bytes : Array Nat) (len : Nat)
    (h : withSlice bytes len (fromBoard may red) 64 0 ≠ 0) : Gate :=
  ⟨fromBoard may red, start, stop,
   verifyWith_sound _ [] (actions_sound (getByte bytes) len) 64 (fromBoard may red) 0 h⟩

private def sparseWord (codes : List (Nat × Nat)) (index : Nat) : Nat :=
  ((codes.find? (fun x => x.1 == index)).getD (0,0)).2

private def Forces (c : Nat → Bool) : Prop :=
  ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < 185 ∧
    ∀ t : Fin 14, t.val ≤ (if b then 2 else 13) → c (a+t.val*d) = b

theorem force95 (c : Nat → Bool)
    (hAnchor : c 89 = true) (hRed : c 95 = true)
    (hBlue : ∀ p : Nat, 89 < p → p < 95 → c p = false)
    (closed : NoRedTriples c → NoBlueRuns c → Compatible initial c → False) : Forces c := by
  by_contra no
  have red : NoRedTriples c := by
    intro a d hd hb hm
    apply no
    refine ⟨true, a, d, hd, hb, ?_⟩
    intro t ht
    have ht' : t.val = 0 ∨ t.val = 1 ∨ t.val = 2 := by simp at ht; omega
    rcases ht' with he | he | he
    · simpa [he] using hm.1
    · simpa [he] using hm.2.1
    · simpa [he] using hm.2.2
  have blue : NoBlueRuns c := by
    intro a d hd hb
    by_contra! h
    apply no
    refine ⟨false, a, d, hd, hb, ?_⟩
    intro t _
    exact Bool.eq_false_iff.mpr (h t)
  have blank : Compatible ⟨blankMask, 0,0,0,0,0⟩ c := by
    constructor
    · intro q hq
      have out : q ≤ 89 ∨ 95 ≤ q := by
        by_contra! inside
        exact Bool.false_ne_true ((hBlue q inside.1 inside.2).symm.trans hq.2)
      have checked : ∀ t : Fin board, t.val ≤ 89 ∨ 95 ≤ t.val →
          blankMask.testBit (stride*t.val) = true := by decide +kernel
      exact checked ⟨q,hq.1⟩ out
    all_goals simp
  have h89 : HasRed c 89 := ⟨by decide, hAnchor⟩
  have h95 : HasRed c 95 := ⟨by decide, hRed⟩
  exact closed red blue (choose_compatible (choose_compatible blank red h89) red h95)

