  have within : ∀ i : Fin 158, (0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421 : Nat).testBit (5*i.val) = true := by decide +kernel
  have start (x : Nat) (hx : S x) : (0x21084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421084210842108421 : Nat).testBit (5*x) = true :=
    within ⟨x, by have := bound157 x hx; omega⟩
