private theorem closeSecondWindow (S : Nat → Prop) (bound157 : ∀ x, S x → x ≤ 157)
    (hn : ∀ a d, 0 < d → S a → S (a+d) → S (a+2*d) → False)
    (hm : ∀ a d, 0 < d → a+12*d < 158 → ∃ t ≤ 12, S (a+t*d))
    (h76 : S 76) (h78 : S 78) (h79 : S 79) : False := by
  have bound (x : Nat) (hx : S x) : x ≤ 160 := by have := bound157 x hx; omega
