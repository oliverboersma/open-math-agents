def reasons (i : ℕ) : List ℕ :=
  let n := hintBits (i-1638)
  (List.range ((n.log2 / 16) + 1)).map fun j => (n >>> (16*j)) % 65536 - 1

def inputClause (i : ℕ) : CNF.Clause ℕ :=
  if i < 1512 then (quadRules (quads.getD (i/12) default)).getD (i%12) []
  else excludeFive (fives.getD (i-1512) default)

lemma getD_mem {α : Type} (xs : List α) (n : ℕ) (a : α) (h : n < xs.length) :
    xs.getD n a ∈ xs := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

lemma input_mem {i : ℕ} (hi : i < 1638) : inputClause i ∈ formula.clauses := by
  simp only [formula, List.mem_toArray, List.mem_append, inputClause]
  split
  · rename_i h
    apply Or.inl
    apply List.mem_flatMap.mpr
    have hq : i/12 < quads.length := by change i/12 < 126; omega
    refine ⟨_, getD_mem _ _ _ hq, getD_mem _ _ _ ?_⟩
    have hl (q : Quad) : (quadRules q).length = 12 := by obtain ⟨a,b,c,d⟩ := q; rfl
    rw [hl]; omega
  · apply Or.inr
    exact List.mem_map.mpr ⟨_, getD_mem _ _ _ (by change i-1512 < 126; omega), rfl⟩

def matchInput (i : ℕ) : Bool := clauseBits i == mask (inputClause i)

lemma extendInput {start n : ℕ} (prev : ∀ i < start, matchInput i = true)
    (ok : (List.range n).all (fun j => matchInput (start+j)) = true) :
    ∀ i < start+n, matchInput i = true := by
  intro i hi
  by_cases h : i < start
  · exact prev _ h
  · have hh := List.all_eq_true.mp ok (i-start) (List.mem_range.mpr (by omega))
    simpa [show start+(i-start)=i by omega] using hh


