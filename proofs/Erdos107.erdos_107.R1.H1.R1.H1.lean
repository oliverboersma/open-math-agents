open OMA.Pentagon Std.Sat in
theorem OMA.solution : OMA.R_Erdos107_erdos_107_R1_H1_R1.H1 := by
  intro col
  dsimp only
  intro orient
  by_contra hno
  have sat : formula.eval (label col) = true := by
    simp only [formula, CNF.eval, List.all_toArray, List.all_eq_true, List.mem_append,
      List.mem_flatMap, List.mem_map]
    intro cl hcl
    rcases hcl with ⟨⟨a,b,c,d⟩, hq, hcl⟩ | ⟨f, hf, rfl⟩
    · obtain ⟨hab,hbc,hcd,h₁,h₂,h₃,h₄⟩ := quadTable _ hq
      apply localRules_hold _ _ _ _ _ _ _ _ cl hcl
      · rw [onTri col h₁, onTri col h₂, onTri col h₃, onTri col h₄]
        exact orient a b c d hab hbc hcd
      · rw [onQuad col hq, onTri col h₁, onTri col h₂, onTri col h₃, onTri col h₄]
        rfl
    · obtain ⟨hc, hfaces, hsub⟩ := fiveTable _ hf
      simp only [excludeFive, CNF.Clause.eval, List.any_map, Function.comp_def, List.any_eq_true]
      by_contra! hall
      apply hno
      refine ⟨vertices f, hc, ?_⟩
      intro a ha b hb c hcv d hd hab hbc hcd
      have hq := hsub a ha b hb c hcv d hd hab hbc hcd
      have h := hall (a,b,c,d) hq
      rw [onQuad col (hfaces _ hq)] at h
      simpa [quadColor, convex] using h
  exact Bool.noConfusion (sat.symm.trans (checked (label col)))
