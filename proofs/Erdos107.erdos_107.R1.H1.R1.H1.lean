def convex (a b c d : Bool) := (a == b) && (c == d)
def valid (a b c d : Bool) : Prop :=
  (a = b ∧ b = c) ∨ (a = b ∧ c = d) ∨ (b = c ∧ c = d)

def quadColor (col : P → P → P → Bool) : Quad → Bool
  | (a,b,c,d) => convex (col a b c) (col a b d) (col a c d) (col b c d)

def label (col : P → P → P → Bool) (i : ℕ) : Bool :=
  if i < triples.length then
    let (a,b,c) := triples.getD i default
    col a b c
  else quadColor col (quads.getD (i-triples.length) default)

def tv (a b c : P) := triples.idxOf (a,b,c)
def qv (q : Quad) := triples.length + quads.idxOf q

lemma onTri (col : P → P → P → Bool) {a b c : P} (h : (a,b,c) ∈ triples) :
    label col (tv a b c) = col a b c := by
  simp [label,tv,List.idxOf_lt_length_iff.mpr h,List.getD_eq_getElem?_getD,List.getElem?_idxOf h]

lemma onQuad (col : P → P → P → Bool) {q : Quad} (h : q ∈ quads) :
    label col (qv q) = quadColor col q := by
  simp [label,qv,List.getD_eq_getElem?_getD,List.getElem?_idxOf h]

def localRules (a b c d q : ℕ) : List (CNF.Clause ℕ) := [

  [(a, true), (b, true), (c, true), (d, true), (q, true)],

  [(a, true), (b, true), (c, false), (d, true)],

  [(a, true), (b, true), (c, false), (d, false), (q, true)],

  [(a, true), (b, false), (c, true), (d, true)],

  [(a, true), (b, false), (c, true), (d, false)],

  [(a, true), (b, false), (c, false), (d, true)],

  [(a, false), (b, true), (c, true), (d, false)],

  [(a, false), (b, true), (c, false), (d, true)],

  [(a, false), (b, true), (c, false), (d, false)],

  [(a, false), (b, false), (c, true), (d, true), (q, true)],

  [(a, false), (b, false), (c, true), (d, false)],

  [(a, false), (b, false), (c, false), (d, false), (q, true)]]

lemma localRules_hold (s : ℕ → Bool) (a b c d q : ℕ)
    (hs : valid (s a) (s b) (s c) (s d)) (hq : s q = convex (s a) (s b) (s c) (s d)) :
    ∀ cl ∈ localRules a b c d q, cl.eval s = true := by
  simp only [localRules, List.mem_cons, List.mem_singleton, List.not_mem_nil,
    or_false, forall_eq_or_imp, forall_eq, CNF.Clause.eval_cons, CNF.Clause.eval_nil]
  rw [hq]
  cases ha : s a <;> cases hb : s b <;> cases hc : s c <;> cases hd : s d <;>
    simp_all [valid, convex]

def quadRules : Quad → List (CNF.Clause ℕ)
  | (a,b,c,d) => localRules (tv a b c) (tv a b d) (tv a c d) (tv b c d) (qv (a,b,c,d))

def faces : Five → List Quad
  | (a,b,c,d,e) => [(a,b,c,d),(a,b,c,e),(a,b,d,e),(a,c,d,e),(b,c,d,e)]

def vertices : Five → Finset P
  | (a,b,c,d,e) => {a,b,c,d,e}

def excludeFive (f : Five) : CNF.Clause ℕ := (faces f).map (fun q => (qv q,false))

def formula : CNF ℕ := ⟨((quads.flatMap quadRules) ++ (fives.map excludeFive)).toArray⟩
def mask (c : CNF.Clause ℕ) : ℕ :=
  c.foldr (fun l bits => (1 <<< (2*l.1 + l.2.toNat)) ||| bits) 0

def TrueLit (s : ℕ → Bool) (i : ℕ) : Prop := (s (i/2)).toNat = i % 2
def Holds (s : ℕ → Bool) (m : ℕ) : Prop := ∃ i, m.testBit i = true ∧ TrueLit s i

lemma holds_of_eval {s : ℕ → Bool} {c : CNF.Clause ℕ} (h : c.eval s = true) : Holds s (mask c) := by
  induction c with
  | nil => simp at h
  | cons l c ih =>
    obtain ⟨v,b⟩ := l
    simp only [CNF.Clause.eval_cons, Bool.or_eq_true, beq_iff_eq] at h
    rcases h with h | h
    · refine ⟨2*v + b.toNat, ?_, ?_⟩
      · simp [mask,Nat.testBit_or,Nat.shiftLeft_eq,Nat.testBit_two_pow]
      · unfold TrueLit
        cases b <;> simp_all [Nat.mul_comm 2, show (v*2+1)/2 = v by omega]
    · obtain ⟨i,hi,hs⟩ := ih h
      exact ⟨i, by simpa [mask,Nat.testBit_or] using Or.inr hi, hs⟩

def flip (i : ℕ) := if i % 2 = 0 then i+1 else i-1

lemma flip_false {s : ℕ → Bool} {i : ℕ} (h : TrueLit s i) : ¬ TrueLit s (flip i) := by
  unfold TrueLit at *
  unfold flip
  split <;> rename_i he
  · rw [show (i+1)/2=i/2 by omega, show (i+1)%2=1 by omega, h, he]
    decide
  · rw [show (i-1)/2=i/2 by omega, show (i-1)%2=0 by omega, h]
    exact he

def stepCheck (db : ℕ → ℕ) (limit blocked : ℕ) : List ℕ → Bool
  | [] => false
  | h :: hs =>
    let cl := db h
    let rem := cl ^^^ (cl &&& blocked)
    h < limit && (rem == 0 ||
      (rem == 1 <<< rem.log2 && stepCheck db limit (blocked ||| (1 <<< flip rem.log2)) hs))

lemma step_sound {s : ℕ → Bool} {db : ℕ → ℕ} {limit : ℕ}
    (valid : ∀ i < limit, Holds s (db i)) (hs : List ℕ) (blocked : ℕ)
    (h : stepCheck db limit blocked hs = true) : Holds s blocked := by
  induction hs generalizing blocked with
  | nil => simp [stepCheck] at h
  | cons i hs ih =>
    by_contra bad
    simp only [stepCheck, Bool.and_eq_true, decide_eq_true_eq, Bool.or_eq_true, beq_iff_eq] at h
    obtain ⟨hi,h⟩ := h
    obtain ⟨k,hk,ht⟩ := valid i hi
    have hb : blocked.testBit k = false := Bool.eq_false_iff.mpr fun hh => bad ⟨k,hh,ht⟩
    let rem := db i ^^^ (db i &&& blocked)
    have hr : rem.testBit k = true := by simp [rem,Nat.testBit_xor,hk,hb]
    rcases h with h | ⟨h,hh⟩
    · change rem = 0 at h
      simp [h] at hr
    · change rem = 1 <<< rem.log2 at h
      have hp : k = rem.log2 := by
        have hh' := congrArg (fun z : ℕ => z.testBit k) h
        simpa [hr,Nat.shiftLeft_eq,Nat.testBit_two_pow,eq_comm] using hh'
      obtain ⟨t, htbit, htrue⟩ := ih _ hh
      simp only [Nat.testBit_or, Bool.or_eq_true, Nat.shiftLeft_eq, one_mul, Nat.testBit_two_pow,
        decide_eq_true_eq] at htbit
      rcases htbit with hb | he
      · exact bad ⟨t,hb,htrue⟩
      · apply flip_false ht
        convert htrue using 1
        rw [hp]
        omega

def verifyBlock (db : ℕ → ℕ) (hints : ℕ → List ℕ) (start : ℕ) : ℕ → Bool
  | 0 => true
  | n+1 => verifyBlock db hints start n && stepCheck db (start+n) (db (start+n)) (hints (start+n))

lemma extend {s : ℕ → Bool} {db : ℕ → ℕ} {hints : ℕ → List ℕ} {start : ℕ}
    (prev : ∀ i < start, Holds s (db i)) (n : ℕ) (ok : verifyBlock db hints start n = true) :
    ∀ i < start+n, Holds s (db i) := by
  induction n with
  | zero => simpa using prev
  | succ n ih =>
    simp only [verifyBlock, Bool.and_eq_true] at ok
    obtain ⟨hl,hh⟩ := ok
    intro i hi
    rcases Nat.lt_or_eq_of_le (show i ≤ start+n by omega) with h | rfl
    · exact ih hl _ h
    · exact step_sound (ih hl) _ _ hh

