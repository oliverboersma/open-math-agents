def goodQuad : Quad → Prop
  | (a,b,c,d) => a < b ∧ b < c ∧ c < d ∧
    (a,b,c) ∈ triples ∧ (a,b,d) ∈ triples ∧ (a,c,d) ∈ triples ∧ (b,c,d) ∈ triples

instance (q : Quad) : Decidable (goodQuad q) := by unfold goodQuad; infer_instance

lemma quadTable : ∀ q ∈ quads, goodQuad q := by
  intro q hq
  exact of_decide_eq_true (List.all_eq_true.mp (show quads.all (fun q => decide (goodQuad q)) = true by decide +kernel) q hq)

def ascFive : Five → Prop
  | (a,b,c,d,e) => a < b ∧ b < c ∧ c < d ∧ d < e
instance (f : Five) : Decidable (ascFive f) := by unfold ascFive; infer_instance

lemma fiveTable (f : Five) (hf : f ∈ fives) : (vertices f).card = 5 ∧
    (∀ q ∈ faces f, q ∈ quads) ∧
    (∀ a ∈ vertices f, ∀ b ∈ vertices f, ∀ c ∈ vertices f, ∀ d ∈ vertices f,
      a < b → b < c → c < d → (a,b,c,d) ∈ faces f) := by
  have good := List.all_eq_true.mp (show fives.all (fun f => (decide (ascFive f) && ((vertices f).card == 5)) &&
    (faces f).all (fun q => quads.contains q)) = true by decide +kernel) f hf
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.contains_iff_mem, beq_iff_eq] at good
  obtain ⟨⟨hs,hcard⟩, hq⟩ := good
  refine ⟨hcard, hq, ?_⟩
  · obtain ⟨u,v,w,x,y⟩ := f
    change u < v ∧ v < w ∧ w < x ∧ x < y at hs
    intro a ha b hb c hc d hd hab hbc hcd
    simp only [vertices, Finset.mem_insert, Finset.mem_singleton] at ha hb hc hd
    simp only [faces, List.mem_cons, List.not_mem_nil, or_false, Prod.mk.injEq]
    grind (splits := 40)

