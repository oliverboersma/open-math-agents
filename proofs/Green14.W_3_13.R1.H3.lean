theorem OMA.solution : OMA.R_Green14_W_3_13_R1.H3 := by
  intro r j hlo hhi hr hb
  have mid (x : ℕ) (hx : x < 160) (hl : 79-j.val < x) (hu : x < 80+j.val) :
      r (Fin.ofNat 160 x) = false := by
    apply hb
    · simpa only [Fin.val_ofNat, Nat.mod_eq_of_lt hx] using hl
    · simpa only [Fin.val_ofNat, Nat.mod_eq_of_lt hx] using hu
  rcases (show j.val = 4 ∨ j.val = 5 ∨ j.val = 6 by omega) with h|h|h
  · apply from45 r 1 (by decide) (by simpa [h] using hr)
    intro x hl hu
    apply mid <;> omega
  · apply from45 r 0 (by decide) (by simpa [h] using hr)
    intro x hl hu
    apply mid <;> omega
  · apply from6 r (by simpa [h] using hr)
    intro x hl hu
    apply mid <;> omega
