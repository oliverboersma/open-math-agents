theorem gap (r : Nat → Bool) (hr : r 74 = false)
    (hb : ∀ x, 74 < x → x ≤ 82 → r x = true) : Mono r := by
  by_contra hn
  have ht := triple_free hn
  apply complete (Red r) (fun x h => by have := h.1; omega) ht (hit_all hn)
  · exact mark_good ht (show Red r 74 from ⟨by decide, hr⟩) (by decide)
  · intro x hx
    have outside : x ≤ 74 ∨ 82 < x := by
      by_contra! h
      have := hb x h.1 h.2
      simp [Red, this] at hx
    have mask : ∀ i : Fin 159, i.val ≤ 74 ∨ 82 < i.val →
        ( : Nat).testBit (9*i.val) = true := by decide +kernel
    exact mask ⟨x,hx.1⟩ outside

