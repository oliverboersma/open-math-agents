theorem gap (r : Nat → Bool) (hr : r 73 = false)
    (hb : ∀ x, 73 < x → x ≤ 85 → r x = true) : Mono r := by
  by_contra hn
  have ht := triple_free hn
  apply complete (Red r) (fun x h => by have := h.1; omega) ht (hit_all hn)
  · exact mark_good ht (show Red r 73 from ⟨by decide, hr⟩) (by decide)
  · intro x hx
    have outside : x ≤ 73 ∨ 85 < x := by
      by_contra! h
      have := hb x h.1 h.2
      simp [Red, this] at hx
    have mask : ∀ i : Fin 160, i.val ≤ 73 ∨ 85 < i.val →
        ( : Nat).testBit (9*i.val) = true := by decide +kernel
    exact mask ⟨x,hx.1⟩ outside

end Window160

private def Goal (r : Fin 160 → Bool) :=
  ∃ (b : Bool) (a d : Fin 160), 0 < d.val ∧ a.val + (if b then 2 else 12)*d.val < 160 ∧
    ∀ t : Fin 13, t.val ≤ (if b then 2 else 12) → r (Fin.ofNat 160 (a.val + t.val*d.val)) = b

private lemma shift {width o : ℕ} (hw : o + width ≤ 160) (r : Fin 160 → Bool)
    (h : ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 12 else 2)*d < width ∧
      ∀ t ≤ (if b then 12 else 2), (!r (Fin.ofNat 160 (o+(a+t*d)))) = b) : Goal r := by
  obtain ⟨b,a,d,hd,he,hh⟩ := h
  have hlen : (if b then 12 else 2 : ℕ) ≥ 1 := by cases b <;> decide
  have hdb := Nat.mul_le_mul_right d hlen
  refine ⟨!b, ⟨o+a, by omega⟩, ⟨d, by omega⟩, hd, ?_, ?_⟩
  · have hend : o + (a + (if b then 12 else 2)*d) < 160 := by omega
    cases b <;> simpa [Nat.add_assoc] using hend
  · intro t ht
    cases b <;> simp_all [Nat.add_assoc]

private lemma from45 (r : Fin 160 → Bool) (o : ℕ) (ho : o ≤ 1)
    (hr : r (Fin.ofNat 160 (o+74)) = true)
    (hb : ∀ x, 74 < x → x ≤ 82 → r (Fin.ofNat 160 (o+x)) = false) : Goal r := by
  apply shift (width := 159) (o := o) (by omega)
  exact Window159.gap (fun x => !r (Fin.ofNat 160 (o+x))) (by simp only [hr, Bool.not_true])
    (fun x hlo hhi => by simp only [hb x hlo hhi, Bool.not_false])

private lemma from6 (r : Fin 160 → Bool) (hr : r (Fin.ofNat 160 73) = true)
    (hb : ∀ x, 73 < x → x ≤ 85 → r (Fin.ofNat 160 x) = false) : Goal r := by
  apply shift (width := 160) (o := 0) (by decide)
  simpa only [Window160.Mono, Nat.zero_add] using
    Window160.gap (fun x => !r (Fin.ofNat 160 x)) (by simp only [hr, Bool.not_true])
      (fun x hlo hhi => by simp only [hb x hlo hhi, Bool.not_false])

end OMA.W313

