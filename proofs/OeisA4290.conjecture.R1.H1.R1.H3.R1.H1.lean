import OMAReductions.R_OeisA4290_conjecture_R1_H1_R1_H3_R1

-- Every n below 9999 has a positive 0/1 multiple below the repunit with 9k digits (k at most 4).
-- Original proof: a table of least 0/1 multiples, each entry checked by the kernel (divisibility, digits, size).
-- Small cases of the open question on OEIS A004290, not the question itself.

namespace OMA.A4290fin

/-- Reads a bit mask as a decimal number with digits 0 and 1. -/
def decOf : ℕ → ℕ → ℕ
  | 0, _ => 0
  | f + 1, b => b % 2 + 10 * decOf f (b / 2)

/-- The repunit with 9k digits, for the least k with n < 10^k - 1 (k at most 4). -/
def bound (n : ℕ) : ℕ :=
  if n < 9 then 111111111
  else if n < 99 then 111111111111111111
  else if n < 999 then 111111111111111111111111111
  else 111111111111111111111111111111111111

def ok (n b : ℕ) : Bool :=
  decide (0 < decOf 36 b) && (decOf 36 b % n == 0) && decide (decOf 36 b < bound n)

def loop : ℕ → ℕ → ℕ → Bool
  | 0, _, _ => true
  | f + 1, n, W => ok n (W % 2 ^ 36) && loop f (n + 1) (W / 2 ^ 36)

/-- Packed table: bits 36 (n - 1) .. 36 n - 1 hold the least 0/1 multiple of n, read in base 2. -/
def table : ℕ := 

lemma digits01_decOf : ∀ (f b : ℕ), ∀ d ∈ Nat.digits 10 (decOf f b), d = 0 ∨ d = 1 := by
  intro f
  induction f with
  | zero => intro b d hd; simp [decOf] at hd
  | succ f ih =>
    intro b d hd
    rw [decOf] at hd
    by_cases h0 : b % 2 + 10 * decOf f (b / 2) = 0
    · rw [h0] at hd; simp at hd
    · rw [Nat.digits_def' (by norm_num) (Nat.pos_of_ne_zero h0)] at hd
      have hb : b % 2 < 2 := Nat.mod_lt _ (by norm_num)
      have e1 : (b % 2 + 10 * decOf f (b / 2)) % 10 = b % 2 := by omega
      have e2 : (b % 2 + 10 * decOf f (b / 2)) / 10 = decOf f (b / 2) := by omega
      rw [e1, e2] at hd
      rcases List.mem_cons.mp hd with h | h
      · omega
      · exact ih (b / 2) d h

lemma loop_spec : ∀ (f n W : ℕ), loop f n W = true →
    ∀ j, j < f → ok (n + j) (W / 2 ^ (36 * j) % 2 ^ 36) = true := by
  intro f
  induction f with
  | zero => intro n W _ j hj; omega
  | succ f ih =>
    intro n W h j hj
    rw [loop, Bool.and_eq_true] at h
    cases j with
    | zero => simpa using h.1
    | succ j =>
      have := ih (n + 1) (W / 2 ^ 36) h.2 j (by omega)
      rw [Nat.div_div_eq_div_mul, ← pow_add] at this
      rw [show n + (j + 1) = n + 1 + j by omega, show 36 * (j + 1) = 36 + 36 * j by ring]
      exact this

set_option maxRecDepth 100000 in
theorem all_ok : loop 9998 1 table = true := by decide +kernel

theorem finite_slice (k n : ℕ) (hk : k ≤ 4) (hn : 0 < n) (hlt : n < 10 ^ k - 1) :
    ∃ m < (10 ^ (9 * k) - 1) / 9, 0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1 := by
  have hn4 : n < 9999 := by
    have : 10 ^ k ≤ 10 ^ 4 := Nat.pow_le_pow_right (by norm_num) hk
    omega
  have h := loop_spec 9998 1 table all_ok (n - 1) (by omega)
  rw [show 1 + (n - 1) = n by omega] at h
  simp only [ok, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h
  obtain ⟨⟨hpos, hmod⟩, hb⟩ := h
  refine ⟨decOf 36 (table / 2 ^ (36 * (n - 1)) % 2 ^ 36), ?_, hpos, Nat.dvd_of_mod_eq_zero hmod,
    digits01_decOf _ _⟩
  refine lt_of_lt_of_le hb ?_
  unfold bound
  interval_cases k
  · simp at hlt
  · have h9 : n < 9 := by norm_num at hlt; omega
    rw [if_pos h9]; norm_num
  · have h99 : n < 99 := by norm_num at hlt; omega
    split_ifs <;> norm_num
  · have h999 : n < 999 := by norm_num at hlt; omega
    split_ifs <;> norm_num
  · split_ifs <;> norm_num

end OMA.A4290fin

theorem OMA.solution : OMA.R_OeisA4290_conjecture_R1_H1_R1_H3_R1.H1 := by
  intro k n hk hn hlt
  exact OMA.A4290fin.finite_slice k n hk hn hlt
