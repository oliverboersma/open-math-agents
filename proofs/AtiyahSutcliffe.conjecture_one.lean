noncomputable def slope (h w : ℝ) : ℝ :=
  w / (Real.sqrt (h^2+w^2)+h)

noncomputable def alpha (j : ℕ) (t : ℝ) : ℝ :=
  slope (19+(37-(j : ℝ))*(t*(1-t))) t
noncomputable def beta (j : ℕ) (t : ℝ) : ℝ :=
  slope (20+(37-(j : ℝ))*(t*(1-t))) (20*t)
noncomputable def gamma (j : ℕ) (t : ℝ) : ℝ :=
  slope (2-t+j*(t*(1-t))) t
noncomputable def delta (j : ℕ) (t : ℝ) : ℝ :=
  slope (1-t+j*(t*(1-t))) (20*t)
noncomputable def tau (t : ℝ) : ℝ := slope 1 (19*t)

theorem continuousOn_slope {h w : ℝ → ℝ} {s : Set ℝ}
    (ch : Continuous h) (cw : Continuous w) (hp : ∀ t ∈ s, 0 ≤ h t)
    (hn : ∀ t ∈ s, h t ≠ 0 ∨ w t ≠ 0) :
    ContinuousOn (fun t => slope (h t) (w t)) s := by
  have hc : Continuous (fun t => Real.sqrt (h t ^ 2 + w t ^ 2) + h t) :=
    (Real.continuous_sqrt.comp ((ch.pow _).add (cw.pow _))).add ch
  apply cw.continuousOn.div hc.continuousOn
  intro t ht
  have hh := hp t ht
  rcases hn t ht with hhz | hwz
  · exact (add_pos_of_nonneg_of_pos (Real.sqrt_nonneg _) (lt_of_le_of_ne hh hhz.symm)).ne'
  · exact (add_pos_of_pos_of_nonneg (Real.sqrt_pos.2 (by positivity)) hh).ne'


theorem continuousOn_alpha (j : Fin 38) : ContinuousOn (alpha j) (Set.Icc (0 : ℝ) 1) := by
  have hj : (j.val : ℝ) ≤ 37 := by exact_mod_cast (show j.val ≤ 37 by omega)
  unfold alpha
  refine continuousOn_slope (by fun_prop) (by fun_prop) ?_ ?_
  all_goals intro t ht
  all_goals
    have hg := mul_nonneg (show 0 ≤ 37 - (j.val : ℝ) by linarith)
      (mul_nonneg ht.1 (sub_nonneg.mpr ht.2))
  · linarith
  · exact Or.inl (by linarith)

theorem continuousOn_beta (j : Fin 38) : ContinuousOn (beta j) (Set.Icc (0 : ℝ) 1) := by
  have hj : (j.val : ℝ) ≤ 37 := by exact_mod_cast (show j.val ≤ 37 by omega)
  unfold beta
  refine continuousOn_slope (by fun_prop) (by fun_prop) ?_ ?_
  all_goals intro t ht
  all_goals
    have hg := mul_nonneg (show 0 ≤ 37 - (j.val : ℝ) by linarith)
      (mul_nonneg ht.1 (sub_nonneg.mpr ht.2))
  · linarith
  · exact Or.inl (by linarith)

theorem continuousOn_gamma (j : ℕ) : ContinuousOn (gamma j) (Set.Icc (0 : ℝ) 1) := by
  unfold gamma
  refine continuousOn_slope (by fun_prop) (by fun_prop) ?_ ?_
  all_goals intro t ht
  all_goals
    have hj := mul_nonneg (Nat.cast_nonneg (α := ℝ) j)
      (mul_nonneg ht.1 (sub_nonneg.mpr ht.2))
  · linarith [ht.2]
  · exact Or.inl (by linarith [ht.2])

theorem continuousOn_delta (j : ℕ) : ContinuousOn (delta j) (Set.Icc (0 : ℝ) 1) := by
  unfold delta
  refine continuousOn_slope (by fun_prop) (by fun_prop) ?_ ?_
  all_goals intro t ht
  · have hj := mul_nonneg (Nat.cast_nonneg (α := ℝ) j)
      (mul_nonneg ht.1 (sub_nonneg.mpr ht.2))
    linarith [ht.2]
  · by_cases hz : t = 0
    · exact Or.inl (by norm_num [hz])
    · exact Or.inr (by exact mul_ne_zero (by norm_num) hz)

theorem continuousOn_tau : ContinuousOn tau (Set.Icc (0 : ℝ) 1) := by
  unfold tau
  refine continuousOn_slope (by fun_prop) (by fun_prop) ?_ ?_
  · intros; norm_num
  · intros; left; norm_num


theorem alpha_atZero (j : ℕ) : alpha j 0 = 0 := by simp [alpha,slope]
theorem beta_atZero (j : ℕ) : beta j 0 = 0 := by simp [beta,slope]
theorem gamma_atZero (j : ℕ) : gamma j 0 = 0 := by simp [gamma,slope]
theorem delta_atZero (j : ℕ) : delta j 0 = 0 := by simp [delta,slope]
theorem tau_atZero : tau 0 = 0 := by simp [tau,slope]

theorem alpha_atOne (j : ℕ) : alpha j 1 = Real.sqrt 362 - 19 := by
  simp only [alpha,slope,sub_self,mul_zero,add_zero]
  norm_num
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 362 by norm_num)
  have hd : (Real.sqrt 362 + 19 : ℝ) ≠ 0 := by positivity
  rw [← one_div]
  apply (div_eq_iff hd).2
  nlinarith

theorem beta_atOne (j : ℕ) : beta j 1 = Real.sqrt 2 - 1 := by
  simp only [beta,slope,sub_self,mul_zero,add_zero,mul_one]
  norm_num
  have h : Real.sqrt (800 : ℝ) = 20 * Real.sqrt 2 := by
    rw [show (800 : ℝ) = 400*2 by norm_num, Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 400)]
    rw [show (400 : ℝ) = 20 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 20)]
  rw [h]
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  apply (div_eq_iff (show (20 * Real.sqrt 2 + 20 : ℝ) ≠ 0 by positivity)).2
  nlinarith

theorem gamma_atOne (j : ℕ) : gamma j 1 = Real.sqrt 2 - 1 := by
  simp only [gamma,slope,sub_self,mul_zero,add_zero]
  norm_num
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  rw [← one_div]
  apply (div_eq_iff (show (Real.sqrt 2 + 1 : ℝ) ≠ 0 by positivity)).2
  nlinarith

theorem delta_atOne (j : ℕ) : delta j 1 = 1 := by
  have hs : Real.sqrt (400 : ℝ) = 20 := by
    rw [show (400 : ℝ) = 20 ^ 2 by norm_num, Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 20)]
  norm_num [delta,slope,hs]

theorem tau_atOne : 19 * tau 1 = Real.sqrt 362 - 1 := by
  norm_num [tau,slope]
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 362 by norm_num)
  have hd : (Real.sqrt 362 + 1 : ℝ) ≠ 0 := by positivity
  rw [← mul_div_assoc]
  apply (div_eq_iff hd).2
  nlinarith

