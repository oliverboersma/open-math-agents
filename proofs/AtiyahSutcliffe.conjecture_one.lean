    eval (expanded68 qadd qsub qmul z o alpha x y z' n t) =
      expanded68 (·+·) (·-·) (·*·) (eval z) (eval o) (eval alpha)
      (eval x) (eval y) (eval z') (eval n) (eval t) := by
  simp only [expanded68, eval_sub, eval_mul, eval_dp, eval_timesLinear, eval_repeatLinear,
    eval_projection, List.map_cons, List.map_nil]

