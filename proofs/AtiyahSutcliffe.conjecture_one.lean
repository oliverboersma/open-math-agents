theorem mapZip {A B : Type} (f : A → B) (g : A → A → A) (h : B → B → B)
    (hom : ∀ x y, f (g x y) = h (f x) (f y)) (xs ys : List A) :
    (List.zipWith g xs ys).map f = List.zipWith h (xs.map f) (ys.map f) := by
  induction xs generalizing ys with
  | nil => cases ys <;> rfl
  | cons x xs ih => cases ys with
    | nil => rfl
    | cons y ys => simp [List.zipWith, hom, ih]

theorem mapFold {A B : Type} (f : A → B) (g : A → A → A) (h : B → B → B)
    (hom : ∀ x y, f (g x y) = h (f x) (f y)) (xs : List A) (z : A) :
    f (xs.foldl g z) = (xs.map f).foldl h (f z) := by
  induction xs generalizing z with
  | nil => rfl
  | cons x xs ih => simp [List.foldl, ih, hom]

theorem eval_timesLinear (z c d : Quad) (p : List Quad) :
    (timesLinear qadd qmul z c d p).map eval =
    timesLinear (·+·) (·*·) (eval z) (eval c) (eval d) (p.map eval) := by
  unfold timesLinear
  rw [mapZip eval _ (fun x y => eval c*x + eval d*y) (by intro x y; simp only [eval_add,eval_mul])]
  simp

theorem eval_repeatLinear (z c d : Quad) (n : ℕ) (p : List Quad) :
    (repeatLinear qadd qmul z c d n p).map eval =
    repeatLinear (·+·) (·*·) (eval z) (eval c) (eval d) n (p.map eval) := by
  induction n generalizing p with
  | zero => rfl
  | succ n ih => simp only [repeatLinear, ih, eval_timesLinear]

theorem eval_extendRec (s p : Quad) (n : ℕ) (x y : Quad) :
    (extendRec qsub qmul s p n x y).map eval =
    extendRec (·-·) (·*·) (eval s) (eval p) n (eval x) (eval y) := by
  induction n generalizing x y with
  | zero => rfl
  | succ n ih => simp only [extendRec, List.map_cons, ih, eval_sub, eval_mul]

theorem eval_projection (zero one alpha x y z a b : Quad) :
    (projection qadd qsub qmul zero one alpha x y z a b).map eval =
    projection (·+·) (·-·) (·*·) (eval zero) (eval one)
      (eval alpha) (eval x) (eval y) (eval z) (eval a) (eval b) := by
  simp only [projection, List.map_append, List.map_reverse, List.map_cons, List.map_nil,
    eval_extendRec, eval_add, eval_mul]

theorem eval_dp (z : Quad) (a b : List Quad) :
    eval (dp qadd qmul z a b) = dp (·+·) (·*·) (eval z) (a.map eval) (b.map eval) := by
  rw [dp, dp, mapFold eval _ _ eval_add, mapZip eval _ _ eval_mul]

