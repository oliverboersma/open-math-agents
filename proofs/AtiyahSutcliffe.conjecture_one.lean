open scoped BigOperators

variable {K : Type*} [Field K] {n : ℕ}

def dotMap (q : Fin n → K) : (Fin n → K) →ₗ[K] K where
  toFun v := ∑ j, v j * q j
  map_add' v w := by simp [add_mul, Finset.sum_add_distrib]
  map_smul' a v := by
    simp [Finset.mul_sum, mul_assoc]

theorem dotMap_ker_proper {q : Fin n → K} {j : Fin n} (hq : q j ≠ 0) :
    (dotMap q).ker ≠ ⊤ := by
  intro ht
  have hm : (fun k : Fin n => if k = j then (1 : K) else 0) ∈
      (dotMap q).ker := by rw [ht]; exact Submodule.mem_top
  apply hq
  change (∑ k : Fin n, (if k = j then (1 : K) else 0) * q k) = 0 at hm
  simpa [ite_mul] using hm

theorem not_independent_of_kernel {rows : Fin n → Fin n → K} {q : Fin n → K}
    {j : Fin n} (hq : q j ≠ 0) (hrows : ∀ i, dotMap q (rows i) = 0) :
    ¬ LinearIndependent K rows := by
  intro hi
  have hb : Submodule.span K (Set.range rows) = ⊤ :=
    hi.span_eq_top_of_card_eq_finrank' (by simp)
  have hle : Submodule.span K (Set.range rows) ≤ (dotMap q).ker :=
    Submodule.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hrows i)
  rw [hb] at hle
  exact dotMap_ker_proper hq (top_le_iff.mp hle)

-- q and r are the two quotient coordinate functionals, with pivot columns j,k.
theorem not_independent_of_two_projections {rows : Fin n → Fin n → K}
    (q r : Fin n → K) (u v j k : Fin n)
    (hqj : q j = 1) (hrj : r j = 0) (hqk : q k = 0) (hrk : r k = 1)
    (hax : ∀ i, i ≠ u → i ≠ v → dotMap q (rows i) = 0 ∧ dotMap r (rows i) = 0)
    (hd : dotMap q (rows u) * dotMap r (rows v) -
      dotMap r (rows u) * dotMap q (rows v) = 0) :
    ¬ LinearIndependent K rows := by
  have comb (a b : K) (i : Fin n) : dotMap (fun l => a * q l + b * r l) (rows i) =
      a * dotMap q (rows i) + b * dotMap r (rows i) := by
    simp only [dotMap, LinearMap.coe_mk, AddHom.coe_mk, mul_add, Finset.sum_add_distrib,
      Finset.mul_sum]
    congr 1
    all_goals apply Finset.sum_congr rfl; intro l _; ring
  suffices h : ∃ a b : K, (a ≠ 0 ∨ b ≠ 0) ∧
      (a * dotMap q (rows u) + b * dotMap r (rows u) = 0) ∧
      (a * dotMap q (rows v) + b * dotMap r (rows v) = 0) by
    obtain ⟨a, b, hn, hu, hv⟩ := h
    have hw (i : Fin n) : dotMap (fun l => a * q l + b * r l) (rows i) = 0 := by
      rw [comb]
      by_cases hiu : i = u
      · simpa [hiu] using hu
      by_cases hiv : i = v
      · simpa [hiv] using hv
      rw [(hax i hiu hiv).1, (hax i hiu hiv).2]
      simp
    rcases hn with ha | hb
    · exact not_independent_of_kernel (j := j) (by simpa [hqj, hrj] using ha) hw
    · exact not_independent_of_kernel (j := k) (by simpa [hqk, hrk] using hb) hw
  by_cases ha : dotMap q (rows u) = 0
  · by_cases hb : dotMap r (rows u) = 0
    · by_cases hc : dotMap q (rows v) = 0
      · exact ⟨1, 0, Or.inl one_ne_zero, by simp [ha], by simp [hc]⟩
      · refine ⟨-dotMap r (rows v), dotMap q (rows v), Or.inr hc, by simp [ha,hb], ?_⟩
        ring
    · refine ⟨-dotMap r (rows u), dotMap q (rows u), Or.inl (neg_ne_zero.mpr hb),
        by ring, ?_⟩
      convert hd using 1 <;> ring
  · refine ⟨-dotMap r (rows u), dotMap q (rows u), Or.inr ha, by ring, ?_⟩
    convert hd using 1 <;> ring

end AtiyahBoundary

namespace AtiyahBoundary

noncomputable def basisAt (j : Fin 69) : Fin 69 → ℝ :=
  fun k => if k = j then 1 else 0

theorem dotMap_basisAt (q : Fin 69 → ℝ) (j : Fin 69) :
    dotMap q (basisAt j) = q j := by
  change (∑ k : Fin 69, (if k = j then (1 : ℝ) else 0)*q k) = q j
  simp [ite_mul]

noncomputable def lowerRow (t : ℝ) (j : Fin 38) : Fin 69 → ℝ :=
  basisAt ⟨j.val,by omega⟩ -
    (alpha j t + beta j t) • basisAt ⟨j.val+1,by omega⟩ +
    (alpha j t * beta j t) • basisAt ⟨j.val+2,by omega⟩

noncomputable def upperRow (t : ℝ) (j : Fin 29) : Fin 69 → ℝ :=
  basisAt ⟨j.val+40,by omega⟩ -
    (gamma j t + delta j t) • basisAt ⟨j.val+39,by omega⟩ +
    (gamma j t * delta j t) • basisAt ⟨j.val+38,by omega⟩

theorem axialLower_zero (l r t : ℝ) (j : Fin 38) :
    dotMap (fun k => weights l r t k) (lowerRow t j) = 0 := by
  simp only [lowerRow, map_add, map_sub, LinearMap.map_smul, dotMap_basisAt, smul_eq_mul]
  rw [weights_left l r t j j.isLt]
  ring

theorem axialUpper_zero (l r t : ℝ) (j : Fin 29) :
    dotMap (fun k => weights l r t k) (upperRow t j) = 0 := by
  simp only [upperRow, map_add, map_sub, LinearMap.map_smul, dotMap_basisAt, smul_eq_mul]
  rw [weights_right l r t (j.val+40) (by omega)]
  have h₀ : j.val+40-40 = j.val := by omega
  have h₁ : j.val+40-1 = j.val+39 := by omega
  have h₂ : j.val+40-2 = j.val+38 := by omega
  rw [h₀,h₁,h₂]
  ring

end AtiyahBoundary


namespace AtiyahBoundary

open Polynomial

noncomputable def orbitA (t : ℝ) : Polynomial ℝ :=
  (C 19 + C (-(19 * tau t)) * X) *
    (∏ j : Fin 38, (C (alpha j t) + X)) *
    (∏ j : Fin 29, (1 + C (gamma j t) * X))

noncomputable def orbitB (t : ℝ) : Polynomial ℝ :=
  (C (19 * tau t) + C 19 * X) *
    (∏ j : Fin 38, (C (beta j t) + X)) *
    (∏ j : Fin 29, (1 + C (delta j t) * X))

theorem coeff_mult_cont {f g : ℝ → Polynomial ℝ} {D : Set ℝ}
    (hf : ∀ k, ContinuousOn (fun t => (f t).coeff k) D)
    (hg : ∀ k, ContinuousOn (fun t => (g t).coeff k) D) (k : ℕ) :
    ContinuousOn (fun t => ((f t)*(g t)).coeff k) D := by
  simp only [Polynomial.coeff_mul]
  exact continuousOn_finset_sum _ (fun i _ => (hf i.1).mul (hg i.2))

theorem coeff_prod_cont {ι : Type*} {f : ι → ℝ → Polynomial ℝ} {D : Set ℝ}
    (F : Finset ι) (hf : ∀ i ∈ F, ∀ k, ContinuousOn (fun t => (f i t).coeff k) D)
    (k : ℕ) : ContinuousOn (fun t => (∏ i ∈ F, f i t).coeff k) D := by
  classical
  induction F using Finset.induction_on generalizing k with
  | empty => simpa using (continuousOn_const (c := (1 : Polynomial ℝ).coeff k) (s := D))
  | @insert i F hi ih =>
    simp only [Finset.prod_insert hi]
    apply coeff_mult_cont (hf i (Finset.mem_insert_self ..))
    intro l
    exact ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)) l

theorem coeff_linear_cont {a b : ℝ → ℝ} {D : Set ℝ}
    (ha : ContinuousOn a D) (hb : ContinuousOn b D) (k : ℕ) :
    ContinuousOn (fun t => (C (a t) + C (b t)*X).coeff k) D := by
  rcases k with _ | k
  · simpa [Polynomial.coeff_add, Polynomial.coeff_mul_X] using ha
  rcases k with _ | k
  · simpa [Polynomial.coeff_add, Polynomial.coeff_mul_X] using hb
  · simpa [Polynomial.coeff_add, Polynomial.coeff_mul_X] using
      (continuousOn_const (c := (0 : ℝ)) (s := D))

theorem coeffA_cont (k : ℕ) :
    ContinuousOn (fun t => (orbitA t).coeff k) (Set.Icc 0 1) := by
  unfold orbitA
  apply coeff_mult_cont
  · intro n
    apply coeff_mult_cont
    · intro m
      exact coeff_linear_cont continuousOn_const ((continuousOn_const.mul continuousOn_tau).neg) m
    · intro l
      apply coeff_prod_cont
      intro j _ m
      simpa using coeff_linear_cont (continuousOn_alpha j) (continuousOn_const (c := (1 : ℝ))) m
  · intro l
    apply coeff_prod_cont
    intro j _ m
    simpa using coeff_linear_cont (continuousOn_const (c := (1 : ℝ))) (continuousOn_gamma j.val) m

theorem coeffB_cont (k : ℕ) :
    ContinuousOn (fun t => (orbitB t).coeff k) (Set.Icc 0 1) := by
  unfold orbitB
  apply coeff_mult_cont
  · intro n
    apply coeff_mult_cont
    · intro m
      exact coeff_linear_cont (continuousOn_const.mul continuousOn_tau) continuousOn_const m
    · intro l
      apply coeff_prod_cont
      intro j _ m
      simpa using coeff_linear_cont (continuousOn_beta j) (continuousOn_const (c := (1 : ℝ))) m
  · intro l
    apply coeff_prod_cont
    intro j _ m
    simpa using coeff_linear_cont (continuousOn_const (c := (1 : ℝ))) (continuousOn_delta j.val) m

noncomputable def wDot (l r t : ℝ) (p : Polynomial ℝ) : ℝ :=
  dotMap (fun j : Fin 69 => weights l r t j) (fun j : Fin 69 => p.coeff j)

theorem wDot_cont (l r : ℝ) (p : ℝ → Polynomial ℝ)
    (hp : ∀ k, ContinuousOn (fun t => (p t).coeff k) (Set.Icc 0 1)) :
    ContinuousOn (fun t => wDot l r t (p t)) (Set.Icc 0 1) := by
  change ContinuousOn (fun t => ∑ j : Fin 69, (p t).coeff j * weights l r t j) _
  exact continuousOn_finset_sum _ (fun j _ => (hp j).mul (weights_cont l r j.val))

noncomputable def pathDet (t : ℝ) : ℝ :=
  wDot 1 0 t (orbitA t)*wDot 0 1 t (orbitB t) -
  wDot 0 1 t (orbitA t)*wDot 1 0 t (orbitB t)

theorem pathDet_cont : ContinuousOn pathDet (Set.Icc 0 1) :=
  ((wDot_cont 1 0 orbitA coeffA_cont).mul (wDot_cont 0 1 orbitB coeffB_cont)).sub
    ((wDot_cont 0 1 orbitA coeffA_cont).mul (wDot_cont 1 0 orbitB coeffB_cont))

theorem orbitA_zero : orbitA 0 = C 19 * X^38 := by
  simp [orbitA,alpha_atZero,gamma_atZero,tau_atZero]

theorem orbitB_zero : orbitB 0 = C 19 * X^39 := by
  simp [orbitB,beta_atZero,delta_atZero,tau_atZero, mul_assoc, ← pow_succ']

theorem wDot_monomial (l r t v : ℝ) (j : Fin 69) :
    wDot l r t (monomial j v) = v * weights l r t j := by
  classical
  change (∑ k : Fin 69, (monomial (j : ℕ) v).coeff k * weights l r t k) = _
  simp [Polynomial.coeff_monomial, Fin.val_inj, ite_mul]

theorem pathDet_pos : 0 < pathDet 0 := by
  rw [pathDet,orbitA_zero,orbitB_zero,Polynomial.C_mul_X_pow_eq_monomial,
    Polynomial.C_mul_X_pow_eq_monomial]
  change 0 < wDot 1 0 0 (monomial (38 : Fin 69).val 19) *
    wDot 0 1 0 (monomial (39 : Fin 69).val 19) -
    wDot 0 1 0 (monomial (38 : Fin 69).val 19) *
    wDot 1 0 0 (monomial (39 : Fin 69).val 19)
  rw [wDot_monomial 1 0 0 19 (38 : Fin 69), wDot_monomial 0 1 0 19 (39 : Fin 69),
    wDot_monomial 0 1 0 19 (38 : Fin 69), wDot_monomial 1 0 0 19 (39 : Fin 69)]
  change 0 < (19 * weights 1 0 0 38) * (19 * weights 0 1 0 39) -
    (19 * weights 0 1 0 38) * (19 * weights 1 0 0 39)
  norm_num [weights_seed₁,weights_seed₂]

end AtiyahBoundary


namespace AtiyahBoundary
noncomputable def cs (s p a b : ℝ) (n : ℕ) : ℝ :=
  seq (fun _ _ => s) (fun _ _ => p) a b n 1

theorem cs_shift (s p a b : ℝ) (n : ℕ) :
    cs s p b (s*b-p*a) n = cs s p a b (n+1) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · rfl
    rcases n with _ | n
    · rfl
    · change s * cs s p b (s*b-p*a) (n+1) -
        p * cs s p b (s*b-p*a) n =
        s * cs s p a b (n+2) - p * cs s p a b (n+1)
      rw [ih (n+1) (by omega),ih n (by omega)]

theorem extendRec_length {A : Type} (sub mul : A → A → A) (s p a b : A) (n : ℕ) :
    (extendRec sub mul s p n a b).length = n := by
  induction n generalizing a b with
  | zero => rfl
  | succ n ih => simp only [extendRec,List.length_cons,ih]

theorem extendRec_at (s p a b : ℝ) (n k : ℕ) (hk : k<n) :
    (extendRec (·-·) (·*·) s p n b a)[k]'(by rwa [extendRec_length]) =
      cs s p a b (k+2) := by
  induction k generalizing a b n with
  | zero =>
    rcases n with _ | n
    · omega
    rfl
  | succ k ih =>
    rcases n with _ | n
    · omega
    change (extendRec (·-·) (·*·) s p n (s*b-p*a) b)[k]'(by rw [extendRec_length]; omega) = _
    rw [ih b (s*b-p*a) n (by omega),cs_shift]

theorem seq_eval_eq_cs (S P : ℕ → ℝ → ℝ) (s p a b : ℝ)
    (hs : ∀ k,S k 1=s) (hp : ∀ k,P k 1=p) (n : ℕ) :
    seq S P a b n 1 = cs s p a b n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · rfl
    rcases n with _ | n
    · rfl
    · change S n 1 * seq S P a b (n+1) 1 - P n 1 * seq S P a b n 1 =
        s * cs s p a b (n+1) - p * cs s p a b n
      rw [hs n,hp n,ih (n+1) (by omega),ih n (by omega)]

noncomputable def aa : ℝ := Real.sqrt 362 - 19
noncomputable def bb : ℝ := Real.sqrt 2 - 1

theorem left_at_one (l r : ℝ) (n : ℕ) :
    seq leftSum leftProd r l n 1 = cs (aa+bb) (aa*bb) r l n :=
  seq_eval_eq_cs _ _ _ _ _ _ (fun _ => by simp [leftSum,alpha_atOne,beta_atOne,aa,bb])
    (fun _ => by simp [leftProd,alpha_atOne,beta_atOne,aa,bb]) n

theorem right_at_one (l r : ℝ) (n : ℕ) :
    seq rightSum rightProd l r n 1 = cs (bb+1) (bb*1) l r n :=
  seq_eval_eq_cs _ _ _ _ _ _ (fun _ => by simp [rightSum,gamma_atOne,delta_atOne,bb])
    (fun _ => by simp [rightProd,gamma_atOne,delta_atOne,bb]) n

noncomputable def endpointWeights (l r : ℝ) : List ℝ :=
  projection (·+·) (·-·) (·*·) 0 1 aa bb bb 1 l r

theorem ew_len (l r : ℝ) : (endpointWeights l r).length = 69 := by
  norm_num [endpointWeights, projection, extendRec_length]

theorem endpointWeights_get (l r : ℝ) (j : Nat) (hj : j < 69) :
    (endpointWeights l r)[j]'(by rwa [ew_len]) = weights l r 1 j := by
  unfold endpointWeights projection
  let L := (extendRec (·-·) (·*·) (aa+bb) (aa*bb) 38 l r)
  let R := (extendRec (·-·) (·*·) (bb+1) (bb*1) 29 r l)
  have hL : L.length = 38 := by simp [L,extendRec_length]
  have hLR : L.reverse.length = 38 := by simpa using hL
  have hR : R.length = 29 := by simp [R,extendRec_length]
  change (L.reverse ++ [l,r] ++ R)[j]'(by simp [hLR,hR]; omega) = _
  by_cases jlt : j < 38
  · rw [List.getElem_append_left (by simp [hLR,jlt]; omega)]
    rw [List.getElem_append_left (by simpa [hLR] using jlt),List.getElem_reverse]
    have hidx : L.length - 1 - j < 38 := by omega
    rw [show L[L.length - 1 - j]'(by omega) =
      cs (aa+bb) (aa*bb) r l ((L.length-1-j)+2) from extendRec_at _ _ _ _ _ _ hidx]
    rw [weights,if_pos (by omega),left_at_one]
    congr 1
    omega
  · by_cases jmid : j < 40
    · have hjcases : j = 38 ∨ j = 39 := by omega
      rcases hjcases with rfl|rfl
      · rw [weights_seed₁]
        rw [List.getElem_append_left (by simp [hLR])]
        rw [List.getElem_append_right (by rw [hLR])]
        simp [hLR]
      · rw [weights_seed₂]
        rw [List.getElem_append_left (by simp [hLR])]
        rw [List.getElem_append_right (by rw [hLR] <;> omega)]
        simp [hLR]
    · have hX : (L.reverse ++ [l,r]).length = 40 := by simp [hLR]
      rw [List.getElem_append_right (by rw [hX]; omega)]
      have hk : j - (L.reverse ++ [l,r]).length < 29 := by omega
      rw [show R[j-(L.reverse++[l,r]).length]'(by omega) =
        cs (bb+1) (bb*1) l r (j-(L.reverse++[l,r]).length+2) from extendRec_at _ _ _ _ _ _ hk]
      rw [weights,if_neg (by omega),right_at_one]
      congr 1
      omega

end AtiyahBoundary





namespace AtiyahBoundary

open Polynomial

variable {K : Type} [CommRing K]

noncomputable def asPoly : List K → Polynomial K
  | [] => 0
  | c :: p => C c + X * asPoly p

theorem asPoly_append_zero (p : List K) : asPoly (p ++ [0]) = asPoly p := by
  induction p with
  | nil => simp [asPoly]
  | cons a p ih => simp [asPoly,ih]

theorem asPoly_map_mul (c : K) (p : List K) :
    asPoly (p.map (fun x => c*x)) = C c * asPoly p := by
  induction p with
  | nil => simp [asPoly]
  | cons a p ih =>
    simp only [List.map_cons, asPoly, map_mul, ih]
    ring

theorem asPoly_zip_add (p q : List K) (h : p.length = q.length) :
    asPoly (List.zipWith (·+·) p q) = asPoly p + asPoly q := by
  induction p generalizing q with
  | nil =>
    have h' : q = [] := List.length_eq_zero_iff.mp h.symm
    simp [asPoly,h']
  | cons a p ih =>
    cases q with
    | nil => simp at h
    | cons b q =>
      have h' : p.length = q.length := by simpa using h
      simp only [List.zipWith_cons_cons, asPoly, map_add, ih q h']
      ring

theorem zip_map_fact (c d : K) (p q : List K) :
    (List.zipWith (fun x y => c*x + d*y) p q) =
      List.zipWith (·+·) (p.map (fun x => c*x)) (q.map (fun y => d*y)) := by
  induction p generalizing q with
  | nil => rfl
  | cons x p ih =>
    cases q with
    | nil => simp only [List.zipWith_nil_right, List.map_nil]
    | cons y q => simp only [List.zipWith_cons_cons, List.map_cons, ih]

theorem asPoly_timesLinear (c d : K) (p : List K) :
    asPoly (timesLinear (·+·) (·*·) 0 c d p) = (C c+C d*X)*asPoly p := by
  unfold timesLinear
  rw [zip_map_fact,asPoly_zip_add]
  · rw [asPoly_map_mul,asPoly_map_mul,asPoly_append_zero]
    simp only [asPoly, map_zero, zero_add]
    ring
  · simp

theorem timesLinear_length (c d : K) (p : List K) :
    (timesLinear (·+·) (·*·) 0 c d p).length = p.length+1 := by
  simp [timesLinear, Nat.add_comm]

theorem asPoly_coeff (p : List K) (n : ℕ) : (asPoly p).coeff n = p[n]?.getD 0 := by
  induction p generalizing n with
  | nil => simp [asPoly]
  | cons x xs ih =>
    cases n with
    | zero => simp [asPoly]
    | succ n => simp [asPoly,ih,Polynomial.coeff_X_mul]

def varyingLinear {A : Type} (add mul : A → A → A) (zero : A) (c d : ℕ → A) :
    ℕ → List A → List A
  | 0, p => p
  | n+1, p => timesLinear add mul zero (c n) (d n) (varyingLinear add mul zero c d n p)

theorem asPoly_varyingLinear (c d : ℕ → K) (n : ℕ) (p : List K) :
    asPoly (varyingLinear (·+·) (·*·) 0 c d n p) =
      (∏ i ∈ Finset.range n, (C (c i)+C (d i)*X)) * asPoly p := by
  induction n with
  | zero => simp [varyingLinear]
  | succ n ih =>
    rw [varyingLinear, asPoly_timesLinear, ih, Finset.prod_range_succ]
    ring

theorem varyingLinear_length (c d : ℕ → K) (n : ℕ) (p : List K) :
    (varyingLinear (·+·) (·*·) 0 c d n p).length = p.length+n := by
  induction n with
  | zero => simp [varyingLinear]
  | succ n ih => rw [varyingLinear,timesLinear_length,ih]; omega

end AtiyahBoundary




namespace AtiyahBoundary

open Polynomial

theorem poly_repeatLinear (a b : ℝ) (n : ℕ) (p : List ℝ) :
    asPoly (repeatLinear (·+·) (·*·) 0 a b n p) =
      (C a + C b*X)^n * asPoly p := by
  induction n generalizing p with
  | zero => simp [repeatLinear]
  | succ n ih =>
    rw [repeatLinear,ih,asPoly_timesLinear,pow_succ]
    ring

theorem len_repeatLinear (a b : ℝ) (n : ℕ) (p : List ℝ) :
    (repeatLinear (·+·) (·*·) 0 a b n p).length = p.length+n := by
  induction n generalizing p with
  | zero => simp [repeatLinear]
  | succ n ih =>
    rw [repeatLinear, ih, timesLinear_length]
    omega

noncomputable def eA : List ℝ :=
  timesLinear (·+·) (·*·) 0 19 (-(Real.sqrt 362 - 1)) <|
    repeatLinear (·+·) (·*·) 0 1 bb 29 <|
      repeatLinear (·+·) (·*·) 0 aa 1 38 [1]
noncomputable def eB : List ℝ :=
  timesLinear (·+·) (·*·) 0 (Real.sqrt 362 - 1) 19 <|
    repeatLinear (·+·) (·*·) 0 1 1 29 <|
      repeatLinear (·+·) (·*·) 0 bb 1 38 [1]

theorem eA_len : eA.length = 69 := by norm_num [eA, timesLinear_length, len_repeatLinear]
theorem eB_len : eB.length = 69 := by norm_num [eB, timesLinear_length, len_repeatLinear]

theorem orbitA_one : orbitA 1 = asPoly eA := by
  unfold eA orbitA
  rw [asPoly_timesLinear,poly_repeatLinear,poly_repeatLinear]
  simp only [alpha_atOne,gamma_atOne,tau_atOne,asPoly,mul_zero,add_zero,map_one,
    one_mul, mul_one, Finset.prod_const, Finset.card_univ, Fintype.card_fin,aa,bb]
  ring

theorem orbitB_one : orbitB 1 = asPoly eB := by
  unfold eB orbitB
  rw [asPoly_timesLinear,poly_repeatLinear,poly_repeatLinear]
  simp only [beta_atOne,delta_atOne,tau_atOne,asPoly,mul_zero,add_zero,map_one,
    one_mul, mul_one, Finset.prod_const, Finset.card_univ, Fintype.card_fin,aa,bb]
  ring

theorem list_of_coeff (p : List ℝ) (h : p.length = 69) :
    (List.ofFn fun j : Fin 69 => (asPoly p).coeff j) = p := by
  apply List.ext_getElem (by simp [h])
  intro j h₁ h₂
  simp only [List.getElem_ofFn, asPoly_coeff, List.getElem?_eq_getElem h₂, Option.getD_some]

theorem list_of_weights (l r : ℝ) :
    (List.ofFn fun j : Fin 69 => weights l r 1 j) = endpointWeights l r := by
  apply List.ext_getElem (by simp [ew_len])
  intro j h₁ h₂
  simp only [List.getElem_ofFn]
  exact (endpointWeights_get l r j (by rwa [ew_len] at h₂)).symm

theorem foldl_real_sum (xs : List ℝ) (t : ℝ) :
    xs.foldl (·+·) t = t + xs.sum := by
  induction xs generalizing t with
  | nil => simp
  | cons x xs ih => simp only [List.foldl_cons, ih, List.sum_cons, add_assoc]

theorem zip_ofFn_real {n : ℕ} (f g : Fin n → ℝ) :
    List.zipWith (·*·) (List.ofFn f) (List.ofFn g) = List.ofFn (fun i => f i*g i) := by
  apply List.ext_getElem (by simp)
  intro i hi hi'
  simp only [List.getElem_zipWith, List.getElem_ofFn]

theorem wDot_endpoint (l r : ℝ) (p : List ℝ) (h : p.length = 69) :
    wDot l r 1 (asPoly p) = dp (·+·) (·*·) 0 p (endpointWeights l r) := by
  change (∑ j : Fin 69, (asPoly p).coeff j * weights l r 1 j) = _
  calc
    _ = dp (·+·) (·*·) 0
        (List.ofFn fun j : Fin 69 => (asPoly p).coeff j)
        (List.ofFn fun j : Fin 69 => weights l r 1 j) := by
      rw [dp,zip_ofFn_real,foldl_real_sum,zero_add,List.sum_ofFn]
    _ = _ := by rw [list_of_coeff p h,list_of_weights]

set_option maxRecDepth 2000 in
theorem pathDet_neg : pathDet 1 < 0 := by
  rw [pathDet,orbitA_one,orbitB_one]
  rw [wDot_endpoint 1 0 eA eA_len, wDot_endpoint 0 1 eA eA_len,
    wDot_endpoint 1 0 eB eB_len, wDot_endpoint 0 1 eB eB_len]
  simp only [eA,eB,endpointWeights,aa,bb]
  simpa only [expanded68,zero_sub] using endpointRecurrenceNeg

end AtiyahBoundary



























namespace AtiyahBoundary

noncomputable def planarVec (x z : ℝ) : EuclideanSpace ℝ (Fin 3) :=
  WithLp.toLp 2 ![x, 0, z]

theorem planarVec_zero (x z : ℝ) : planarVec x z 0 = x := rfl
theorem planarVec_one (x z : ℝ) : planarVec x z 1 = 0 := rfl
theorem planarVec_two (x z : ℝ) : planarVec x z 2 = z := rfl

theorem planarVec_sub (x₁ z₁ x₂ z₂ : ℝ) :
    planarVec x₂ z₂ - planarVec x₁ z₁ = planarVec (x₂-x₁) (z₂-z₁) := by
  ext i
  fin_cases i
  · simp [planarVec]
  · simp [planarVec]
  · simp [planarVec]

theorem planarVec_norm (x z : ℝ) : ‖planarVec x z‖ = Real.sqrt (z^2+x^2) := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_three, planarVec_zero, planarVec_one, planarVec_two]
  simp only [RCLike.norm_ofReal, Real.norm_eq_abs, abs_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
    zero_pow, add_zero, sq_abs]
  rw [add_comm]

end AtiyahBoundary

namespace AtiyahBoundary

noncomputable def zCoord (t : ℝ) (i : Fin 69) : ℝ :=
  let h : ℝ := 20
  let s := t * (1-t)
  if (i : ℕ) < 38 then ((i : ℝ) - 37) * s
  else if (i : ℕ) = 38 then h - 1
  else if (i : ℕ) = 39 then h
  else h + (1 - t) + ((i : ℝ) - 40) * s

noncomputable def xCoord (t : ℝ) (i : Fin 69) : ℝ :=
  if (i : ℕ) = 38 then t else if (i : ℕ) = 39 then 20*t else 0

theorem zCoord_strict {t : ℝ} (h0 : 0 < t) (h1 : t < 1) :
    StrictMono (zCoord t) := by
  intro i j hij
  have hspacing : 0 < t * (1-t) := mul_pos h0 (sub_pos.mpr h1)
  have hij' : (i : ℕ) < (j : ℕ) := hij
  have hir : (i : ℝ) < (j : ℝ) := by exact_mod_cast hij'
  have hi37 : (i : ℕ) < 38 → (i : ℝ) - 37 ≤ 0 := by
    intro hi
    have hil : (i : ℕ) ≤ 37 := by omega
    have hil' : (i : ℝ) ≤ 37 := by exact_mod_cast hil
    linarith
  have hj40 : ¬ (j : ℕ) < 38 → (j : ℕ) ≠ 38 → (j : ℕ) ≠ 39 →
      0 ≤ (j : ℝ) - 40 := by
    intro hj hj2 hj3
    have hju : 40 ≤ (j : ℕ) := by omega
    have hjr : (40 : ℝ) ≤ (j : ℝ) := by exact_mod_cast hju
    linarith
  have ha : ((i : ℝ) - 37) * (t*(1-t)) < ((j : ℝ) - 37) * (t*(1-t)) :=
    mul_lt_mul_of_pos_right (by linarith) hspacing
  have hb : ((i : ℝ) - 40) * (t*(1-t)) < ((j : ℝ) - 40) * (t*(1-t)) :=
    mul_lt_mul_of_pos_right (by linarith) hspacing
  unfold zCoord
  split_ifs
  all_goals try omega
  all_goals try linarith
  all_goals try have hlow := mul_nonpos_of_nonpos_of_nonneg (hi37 (by assumption)) hspacing.le
  all_goals try have hhigh := mul_nonneg (hj40 (by assumption) (by assumption) (by assumption)) hspacing.le
  all_goals linarith

theorem signChangeHasRoot {f : ℝ → ℝ}
    (hc : ContinuousOn f (Set.Icc 0 1))
    (hlo : 0 < f 0) (hhi : f 1 < 0) :
    ∃ t ∈ Set.Ioo (0 : ℝ) 1, f t = 0 := by
  have h := intermediate_value_Icc' (show (0 : ℝ) ≤ 1 by norm_num) hc
  obtain ⟨t, ht, heq⟩ := h ⟨hhi.le,hlo.le⟩
  refine ⟨t, ⟨lt_of_le_of_ne ht.1 ?_, lt_of_le_of_ne ht.2 ?_⟩, heq⟩
  · rintro rfl
    linarith
  · rintro rfl
    linarith

end AtiyahBoundary

namespace AtiyahBoundary

theorem sqrt_den_pos (h w : ℝ) (hh : 0 ≤ h) (hn : h ≠ 0 ∨ w ≠ 0) :
    0 < Real.sqrt (h^2 + w^2) + h := by
  rcases hn with hn | hn
  · exact add_pos_of_nonneg_of_pos (Real.sqrt_nonneg _) (lt_of_le_of_ne hh (Ne.symm hn))
  · exact add_pos_of_pos_of_nonneg (Real.sqrt_pos.2 (by positivity)) hh

theorem north_pole_iff (h w : ℝ) (hh : 0 ≤ h) :
    Real.sqrt (h^2 + w^2) - h = 0 ↔ w = 0 := by
  have hr : (Real.sqrt (h^2+w^2))^2 = h^2+w^2 := Real.sq_sqrt (by positivity)
  constructor
  · intro he
    have he' : Real.sqrt (h^2+w^2) = h := sub_eq_zero.mp he
    rw [he'] at hr
    nlinarith
  · intro he
    rw [he, zero_pow (by norm_num : (2 : ℕ) ≠ 0), add_zero,
      Real.sqrt_sq hh, sub_self]

theorem forwardRescale (h w : ℝ) (hh : 0 ≤ h) (hw : w ≠ 0) :
    w / (Real.sqrt (h^2+w^2) - h) = (Real.sqrt (h^2+w^2) + h) / w := by
  have hn := ((north_pole_iff h w hh).not).mpr hw
  have hr := Real.sq_sqrt (show 0 ≤ h^2+w^2 by positivity)
  apply (div_eq_div_iff hn hw).2
  nlinarith

theorem forward_coeff₂ (h w : ℝ) (hh : 0 ≤ h) (hw : w ≠ 0) :
    ((Real.sqrt (h^2+w^2)+h)/w) * (-(w/(Real.sqrt (h^2+w^2)+h))) = -1 := by
  have hp := sqrt_den_pos h w hh (Or.inr hw)
  field_simp
  <;> ring

end AtiyahBoundary

namespace AtiyahBoundary

noncomputable def points (t : ℝ) (i : Fin 69) : EuclideanSpace ℝ (Fin 3) :=
  planarVec (xCoord t i) (zCoord t i)

theorem points_injective {t : ℝ} (h0 : 0 < t) (h1 : t < 1) :
    Function.Injective (points t) := by
  intro i j he
  exact (zCoord_strict h0 h1).injective (congrArg (fun v : EuclideanSpace ℝ (Fin 3) => v 2) he)

noncomputable def normalizedSlope (h w : ℝ) : ℝ := w / (Real.sqrt (h^2+w^2)+h)

theorem liftForward (h w : ℝ) (hh : 0 < h) :
    ∃ c : ℂ, c ≠ 0 ∧ AtiyahSutcliffe.directionLift (planarVec w h) = (c, c * (normalizedSlope h w : ℂ)) := by
  rw [AtiyahSutcliffe.directionLift,planarVec_norm,planarVec_zero,planarVec_one,planarVec_two]
  by_cases hw : w = 0
  · refine ⟨1, one_ne_zero, ?_⟩
    rw [if_pos ((north_pole_iff h w hh.le).2 hw)]
    simp [normalizedSlope,hw]
  · have hD := sqrt_den_pos h w hh.le (Or.inl hh.ne')
    refine ⟨((Real.sqrt (h^2+w^2)+h)/w : ℝ), ?_, ?_⟩
    · exact_mod_cast (div_ne_zero hD.ne' hw)
    rw [if_neg ((north_pole_iff h w hh.le).not.mpr hw)]
    apply Prod.ext
    · push_cast
      simp only [zero_mul,add_zero]
      exact_mod_cast forwardRescale h w hh.le hw
    · norm_cast
      unfold normalizedSlope
      field_simp <;> norm_num

theorem liftReverse (h w : ℝ) (hh : 0 < h) :
    AtiyahSutcliffe.directionLift (planarVec (-w) (-h)) = (-(normalizedSlope h w : ℂ), 1) := by
  rw [AtiyahSutcliffe.directionLift,planarVec_norm,planarVec_zero,planarVec_one,planarVec_two]
  simp only [neg_sq,sub_neg_eq_add]
  rw [if_neg (sqrt_den_pos h w hh.le (Or.inl hh.ne')).ne']
  simp [normalizedSlope,neg_div]

end AtiyahBoundary


namespace AtiyahBoundary

open MvPolynomial

noncomputable def form (a b : ℂ) : MvPolynomial (Fin 2) ℂ :=
  C a * X 0 + C b * X 1

noncomputable def gapSlope (t : ℝ) (i j : Fin 69) : ℝ :=
  normalizedSlope (zCoord t j-zCoord t i) (xCoord t j-xCoord t i)

noncomputable def normalizedFactor (t : ℝ) (i j : Fin 69) : MvPolynomial (Fin 2) ℂ :=
  if i < j then form 1 (-(gapSlope t i j : ℂ)) else form (gapSlope t j i : ℂ) 1

theorem factor_proportional {t : ℝ} (h0 : 0 < t) (h1 : t < 1)
    {i j : Fin 69} (hne : i ≠ j) :
    ∃ c : ℂ, c ≠ 0 ∧ AtiyahSutcliffe.linearFactor (AtiyahSutcliffe.directionLift (points t j-points t i)) =
      C c * normalizedFactor t i j := by
  rcases lt_or_gt_of_ne hne with h | h
  · have hh : 0 < zCoord t j-zCoord t i := sub_pos.mpr (zCoord_strict h0 h1 h)
    obtain ⟨c, hc, he⟩ := liftForward _ _ hh
    refine ⟨c,hc,?_⟩
    rw [points,points,planarVec_sub,he,normalizedFactor,if_pos h]
    simp only [AtiyahSutcliffe.linearFactor,form,gapSlope,map_neg,map_one,one_mul,map_mul]
    ring
  · have hh : 0 < zCoord t i-zCoord t j := sub_pos.mpr (zCoord_strict h0 h1 h)
    refine ⟨-1,by norm_num,?_⟩
    have hxy : xCoord t j-xCoord t i = -(xCoord t i-xCoord t j) := by ring
    have hzy : zCoord t j-zCoord t i = -(zCoord t i-zCoord t j) := by ring
    rw [points,points,planarVec_sub,hxy,hzy,liftReverse _ _ hh,normalizedFactor,if_neg (not_lt_of_ge h.le)]
    simp only [AtiyahSutcliffe.linearFactor,form,gapSlope,map_neg,map_one,one_mul]
    ring

noncomputable def normalizedPoint (t : ℝ) (i : Fin 69) : MvPolynomial (Fin 2) ℂ :=
  ∏ j ∈ Finset.univ.erase i, normalizedFactor t i j

theorem point_proportional {t : ℝ} (h0 : 0 < t) (h1 : t < 1) (i : Fin 69) :
    ∃ c : ℂ, c ≠ 0 ∧ (AtiyahSutcliffe.pointPolynomial (points t)) i = c • normalizedPoint t i := by
  classical
  let c (j : Fin 69) : ℂ := if hj : i ≠ j then Classical.choose (factor_proportional h0 h1 hj) else 1
  have hc (j : Fin 69) (hj : j ∈ Finset.univ.erase i) :
      c j ≠ 0 ∧ AtiyahSutcliffe.linearFactor (AtiyahSutcliffe.directionLift (points t j-points t i)) =
        C (c j) * normalizedFactor t i j := by
    have hn := Ne.symm (Finset.ne_of_mem_erase hj)
    simpa only [c,dif_pos hn] using (Classical.choose_spec (factor_proportional h0 h1 hn))
  refine ⟨∏ j ∈ Finset.univ.erase i, c j, Finset.prod_ne_zero_iff.mpr (fun j hj => (hc j hj).1), ?_⟩
  unfold AtiyahSutcliffe.pointPolynomial normalizedPoint
  calc
    _ = ∏ j ∈ Finset.univ.erase i, C (c j) * normalizedFactor t i j :=
      Finset.prod_congr rfl (fun j hj => (hc j hj).2)
    _ = _ := by rw [Finset.prod_mul_distrib, ← map_prod, C_mul']

end AtiyahBoundary


namespace AtiyahBoundary

open MvPolynomial

noncomputable def swapVars : Fin 2 → Fin 2 := ![1,0]
noncomputable def swappedHom (n : ℕ) : Polynomial ℂ →ₗ[ℂ] MvPolynomial (Fin 2) ℂ :=
  (rename swapVars).toLinearMap.comp (Polynomial.homogenizeLM n)

noncomputable def pairPoly (a b : ℂ) : Polynomial ℂ :=
  Polynomial.C a + Polynomial.C b * Polynomial.X

theorem pairPoly_degree (a b : ℂ) : (pairPoly a b).natDegree ≤ 1 := by
  unfold pairPoly
  exact (Polynomial.natDegree_add_le _ _).trans
    (max_le (by simp) (by
      exact (Polynomial.natDegree_mul_le).trans (by simp)))

theorem swappedHom_pair (a b : ℂ) : swappedHom 1 (pairPoly a b) = form a b := by
  simp [pairPoly,swappedHom,form,swapVars,Polynomial.homogenize_X]

noncomputable def uniFactor (t : ℝ) (i j : Fin 69) : Polynomial ℂ :=
  if i < j then pairPoly 1 (-(gapSlope t i j : ℂ)) else pairPoly (gapSlope t j i : ℂ) 1

noncomputable def uniRow (t : ℝ) (i : Fin 69) : Polynomial ℂ :=
  ∏ j ∈ Finset.univ.erase i, uniFactor t i j

theorem uniFactor_degree (t : ℝ) (i j : Fin 69) : (uniFactor t i j).natDegree ≤ 1 := by
  unfold uniFactor
  split <;> apply pairPoly_degree

theorem uniRow_degree (t : ℝ) (i : Fin 69) : (uniRow t i).natDegree ≤ 68 := by
  unfold uniRow
  refine (Polynomial.natDegree_prod_le _ _).trans ?_
  exact (Finset.sum_le_sum (fun j _ => uniFactor_degree t i j)).trans (by simp)

theorem swappedHom_row (t : ℝ) (i : Fin 69) : swappedHom 68 (uniRow t i) = normalizedPoint t i := by
  have hsize : (∑ _j ∈ (Finset.univ : Finset (Fin 69)).erase i, (1 : ℕ)) = 68 := by simp
  unfold swappedHom uniRow normalizedPoint
  change rename swapVars (Polynomial.homogenize (∏ j ∈ Finset.univ.erase i, uniFactor t i j) 68) = _
  rw [← hsize, Polynomial.homogenize_finsetProd (fun j _ => uniFactor_degree t i j), map_prod]
  apply Finset.prod_congr rfl
  intro j _
  change swappedHom 1 (uniFactor t i j) = normalizedFactor t i j
  unfold uniFactor normalizedFactor
  split <;> exact swappedHom_pair _ _

theorem normalized_notIndependent {t : ℝ} (h : ¬ LinearIndependent ℂ (uniRow t)) :
    ¬ LinearIndependent ℂ (normalizedPoint t) := by
  intro hl
  apply h
  apply LinearIndependent.of_comp (swappedHom 68)
  change LinearIndependent ℂ (fun i => swappedHom 68 (uniRow t i))
  have he : (fun i => swappedHom 68 (uniRow t i)) = normalizedPoint t := by
    funext i; exact swappedHom_row t i
  exact he.symm ▸ hl

theorem mirror_notIndependent {t : ℝ} (h0 : 0 < t) (h1 : t < 1)
    (h : ¬ LinearIndependent ℂ (normalizedPoint t)) :
    ¬ LinearIndependent ℂ ((AtiyahSutcliffe.pointPolynomial (points t))) := by
  classical
  intro hm
  let c (i : Fin 69) : ℂ := Classical.choose (point_proportional h0 h1 i)
  have hc (i : Fin 69) := Classical.choose_spec (point_proportional h0 h1 i)
  have h_eq : (fun i => c i • normalizedPoint t i) = (AtiyahSutcliffe.pointPolynomial (points t)) := by
    funext i
    exact (hc i).2.symm
  apply h
  let u (i : Fin 69) : ℂˣ := Units.mk0 (c i) (hc i).1
  apply (LinearIndependent.units_smul_iff (normalizedPoint t) u).1
  change LinearIndependent ℂ (fun i => c i • normalizedPoint t i)
  exact h_eq.symm ▸ hm

end AtiyahBoundary









namespace AtiyahBoundary

def leftIdx (i : Fin 38) : Fin 69 := ⟨i.val,by omega⟩
def rightIdx (i : Fin 29) : Fin 69 := ⟨40+i.val,by omega⟩
def Aidx : Fin 69 := 38
def Bidx : Fin 69 := 39

theorem x_left (t : ℝ) (i : Fin 38) : xCoord t (leftIdx i) = 0 := by
  unfold xCoord leftIdx
  simp [show i.val ≠ 38 by omega, show i.val ≠ 39 by omega]
theorem z_left (t : ℝ) (i : Fin 38) :
    zCoord t (leftIdx i) = ((i.val : ℝ)-37)*(t*(1-t)) := by
  simp [zCoord,leftIdx,i.isLt]
theorem x_right (t : ℝ) (i : Fin 29) : xCoord t (rightIdx i) = 0 := by
  unfold xCoord rightIdx
  simp [show 40+i.val ≠ 38 by omega, show 40+i.val ≠ 39 by omega]
theorem z_right (t : ℝ) (i : Fin 29) :
    zCoord t (rightIdx i) = 20+(1-t)+(i.val : ℝ)*(t*(1-t)) := by
  unfold zCoord rightIdx
  simp [show ¬ 40+i.val < 38 by omega, show 40+i.val ≠ 38 by omega, show 40+i.val ≠ 39 by omega]

theorem x_A (t : ℝ) : xCoord t Aidx = t := rfl
theorem x_B (t : ℝ) : xCoord t Bidx = 20*t := rfl
theorem z_A (t : ℝ) : zCoord t Aidx = 19 := by norm_num [zCoord,Aidx]
theorem z_B (t : ℝ) : zCoord t Bidx = 20 := rfl

theorem gap_alpha (t : ℝ) (i : Fin 38) : gapSlope t (leftIdx i) Aidx = alpha i t := by
  unfold gapSlope alpha
  rw [z_A,z_left,x_A,x_left,sub_zero]
  change normalizedSlope _ _ = normalizedSlope _ _
  congr 1
  ring

theorem gap_beta (t : ℝ) (i : Fin 38) : gapSlope t (leftIdx i) Bidx = beta i t := by
  unfold gapSlope beta
  rw [z_B,z_left,x_B,x_left,sub_zero]
  change normalizedSlope _ _ = normalizedSlope _ _
  congr 1
  ring

theorem normalizedSlope_neg (h w : ℝ) : normalizedSlope h (-w) = -normalizedSlope h w := by
  simp [normalizedSlope, neg_div]

theorem gap_gamma (t : ℝ) (i : Fin 29) : gapSlope t Aidx (rightIdx i) = -gamma i t := by
  unfold gapSlope gamma
  rw [z_A,z_right,x_A,x_right,zero_sub,normalizedSlope_neg]
  change -normalizedSlope _ _ = -normalizedSlope _ _
  congr 2
  ring

theorem gap_delta (t : ℝ) (i : Fin 29) : gapSlope t Bidx (rightIdx i) = -delta i t := by
  unfold gapSlope delta
  rw [z_B,z_right,x_B,x_right,zero_sub,normalizedSlope_neg]
  change -normalizedSlope _ _ = -normalizedSlope _ _
  congr 2
  ring

theorem gap_tau (t : ℝ) : gapSlope t Aidx Bidx = tau t := by
  unfold gapSlope tau
  rw [z_A,z_B,x_A,x_B]
  change normalizedSlope _ _ = normalizedSlope _ _
  congr 1 <;> ring

theorem gap_axis (t : ℝ) (i j : Fin 69) (hi : xCoord t i = 0) (hj : xCoord t j = 0) :
    gapSlope t i j = 0 := by simp [gapSlope,normalizedSlope,hi,hj]

end AtiyahBoundary


namespace AtiyahBoundary

open Polynomial

def leftEmb : Fin 38 ↪ Fin 69 := ⟨leftIdx, fun _ _ h => Fin.ext (congrArg (fun k : Fin 69 => k.val) h)⟩
def rightEmb : Fin 29 ↪ Fin 69 :=
  ⟨rightIdx, fun _ _ h => Fin.ext (Nat.add_left_cancel (congrArg (fun k : Fin 69 => k.val) h))⟩
def leftSet : Finset (Fin 69) := Finset.univ.map leftEmb
def rightSet : Finset (Fin 69) := Finset.univ.map rightEmb

theorem mem_leftSet (i : Fin 69) : i ∈ leftSet ↔ i.val < 38 := by
  simp only [leftSet,Finset.mem_map,Finset.mem_univ,true_and]
  constructor
  · rintro ⟨j,rfl⟩
    exact j.isLt
  · intro h
    exact ⟨⟨i.val,h⟩,Fin.ext rfl⟩

theorem mem_rightSet (i : Fin 69) : i ∈ rightSet ↔ 40 ≤ i.val := by
  simp only [rightSet,Finset.mem_map,Finset.mem_univ,true_and]
  constructor
  · rintro ⟨j,rfl⟩
    change 40 ≤ 40+j.val
    omega
  · intro h
    refine ⟨⟨i.val-40,by omega⟩,Fin.ext ?_⟩
    change 40+(i.val-40) = i.val
    omega

theorem axial_sets_disjoint : Disjoint leftSet rightSet := by
  rw [Finset.disjoint_left]
  intro i hl hr
  have a := (mem_leftSet i).1 hl
  have b := (mem_rightSet i).1 hr
  omega

theorem group_A : Finset.univ.erase Aidx = (leftSet ∪ rightSet) ∪ {Bidx} := by
  ext i
  simp only [Finset.mem_erase,Finset.mem_univ,and_true,Finset.mem_union,mem_leftSet,mem_rightSet,
    Finset.mem_singleton,Fin.ext_iff,Aidx,Bidx]
  rw [ne_eq,Fin.ext_iff]
  change i.val ≠ 38 ↔ (i.val < 38 ∨ 40 ≤ i.val) ∨ i.val = 39
  omega

theorem group_B : Finset.univ.erase Bidx = (leftSet ∪ rightSet) ∪ {Aidx} := by
  ext i
  simp only [Finset.mem_erase,Finset.mem_univ,and_true,Finset.mem_union,mem_leftSet,mem_rightSet,
    Finset.mem_singleton,Fin.ext_iff,Aidx,Bidx]
  rw [ne_eq,Fin.ext_iff]
  change i.val ≠ 39 ↔ (i.val < 38 ∨ 40 ≤ i.val) ∨ i.val = 38
  omega

theorem atomic_A : Disjoint (leftSet ∪ rightSet) ({Aidx} : Finset (Fin 69)) := by
  rw [Finset.disjoint_left]
  intro i hu hm
  rw [Finset.mem_singleton] at hm
  subst i
  simpa [mem_leftSet,mem_rightSet,Aidx] using hu
theorem atomic_B : Disjoint (leftSet ∪ rightSet) ({Bidx} : Finset (Fin 69)) := by
  rw [Finset.disjoint_left]
  intro i hu hm
  rw [Finset.mem_singleton] at hm
  subst i
  simpa [mem_leftSet,mem_rightSet,Bidx] using hu

theorem uniRow_A (t : ℝ) :
    uniRow t Aidx =
    (∏ j : Fin 38, pairPoly (alpha j t : ℂ) 1) *
    (∏ j : Fin 29, pairPoly 1 (gamma j t : ℂ)) *
    pairPoly 1 (-(tau t : ℂ)) := by
  unfold uniRow
  rw [group_A, Finset.prod_union atomic_B, Finset.prod_union axial_sets_disjoint,Finset.prod_singleton]
  rw [leftSet,rightSet,Finset.prod_map,Finset.prod_map]
  have fl (j : Fin 38) : uniFactor t Aidx (leftEmb j) = pairPoly (alpha j t : ℂ) 1 := by
    change uniFactor t Aidx (leftIdx j) = _
    rw [uniFactor,if_neg (by change ¬ 38 < j.val; omega),gap_alpha]
  have fr (j : Fin 29) : uniFactor t Aidx (rightEmb j) = pairPoly 1 (gamma j t : ℂ) := by
    change uniFactor t Aidx (rightIdx j) = _
    rw [uniFactor,if_pos (by change 38 < 40+j.val; omega),gap_gamma]
    simp
  have hb : uniFactor t Aidx Bidx = pairPoly 1 (-(tau t : ℂ)) := by
    rw [uniFactor,if_pos (by decide : Aidx < Bidx),gap_tau]
  simp only [fl,fr,hb]

theorem uniRow_B (t : ℝ) :
    uniRow t Bidx =
    (∏ j : Fin 38, pairPoly (beta j t : ℂ) 1) *
    (∏ j : Fin 29, pairPoly 1 (delta j t : ℂ)) *
    pairPoly (tau t : ℂ) 1 := by
  unfold uniRow
  rw [group_B, Finset.prod_union atomic_A, Finset.prod_union axial_sets_disjoint,Finset.prod_singleton]
  rw [leftSet,rightSet,Finset.prod_map,Finset.prod_map]
  have fl (j : Fin 38) : uniFactor t Bidx (leftEmb j) = pairPoly (beta j t : ℂ) 1 := by
    change uniFactor t Bidx (leftIdx j) = _
    rw [uniFactor,if_neg (by change ¬ 39 < j.val; omega),gap_beta]
  have fr (j : Fin 29) : uniFactor t Bidx (rightEmb j) = pairPoly 1 (delta j t : ℂ) := by
    change uniFactor t Bidx (rightIdx j) = _
    rw [uniFactor,if_pos (by change 39 < 40+j.val; omega),gap_delta]
    simp
  have ha : uniFactor t Bidx Aidx = pairPoly (tau t : ℂ) 1 := by
    rw [uniFactor,if_neg (by decide : ¬ Bidx < Aidx),gap_tau]
  simp only [fl,fr,ha]

end AtiyahBoundary


namespace AtiyahBoundary

open Polynomial

theorem left_ne_A (j : Fin 38) : leftIdx j ≠ Aidx := by
  intro e
  have he : j.val = 38 := congrArg Fin.val e
  omega
theorem left_ne_B (j : Fin 38) : leftIdx j ≠ Bidx := by
  intro e
  have he : j.val = 39 := congrArg Fin.val e
  omega
theorem right_ne_A (j : Fin 29) : rightIdx j ≠ Aidx := by
  intro e
  have he : 40+j.val = 38 := congrArg Fin.val e
  omega
theorem right_ne_B (j : Fin 29) : rightIdx j ≠ Bidx := by
  intro e
  have he : 40+j.val = 39 := congrArg Fin.val e
  omega

theorem axis_of_ne {t : ℝ} {i : Fin 69} (ha : i ≠ Aidx) (hb : i ≠ Bidx) :
    xCoord t i = 0 := by
  have ha' : i.val ≠ 38 := by intro hh; exact ha (Fin.ext hh)
  have hb' : i.val ≠ 39 := by intro hh; exact hb (Fin.ext hh)
  simp [xCoord,ha',hb']

theorem uniFactor_axis {t : ℝ} {i k : Fin 69} (hi : xCoord t i = 0)
    (hk : xCoord t k = 0) (hne : k ≠ i) :
    uniFactor t i k = (if k < i then X else 1) := by
  by_cases hik : i < k
  · have hki : ¬ k < i := not_lt_of_ge hik.le
    simp [uniFactor, hik, hki, gap_axis t i k hi hk, pairPoly]
  · have hki : k < i := lt_of_le_of_ne (le_of_not_gt hik) hne
    simp [uniFactor,hik,hki,gap_axis t k i hk hi,pairPoly]

theorem uniRow_axis_inner (t : ℝ) (i : Fin 69)
    (hia : i ≠ Aidx) (hib : i ≠ Bidx) :
    uniRow t i =
    X ^ (Finset.card (Finset.filter (fun k : Fin 69 => k < i) (((Finset.univ.erase i).erase Aidx).erase Bidx))) *
    uniFactor t i Bidx * uniFactor t i Aidx := by
  classical
  let s : Finset (Fin 69) := Finset.univ.erase i
  have hA : Aidx ∈ s := Finset.mem_erase.mpr ⟨Ne.symm hia,Finset.mem_univ _⟩
  have hB : Bidx ∈ s.erase Aidx := Finset.mem_erase.mpr
    ⟨by decide,Finset.mem_erase.mpr ⟨Ne.symm hib,Finset.mem_univ _⟩⟩
  unfold uniRow
  change (∏ k ∈ s, uniFactor t i k) = _
  rw [← Finset.prod_erase_mul s _ hA, ← Finset.prod_erase_mul (s.erase Aidx) _ hB]
  congr 2
  have eqf (k : Fin 69) (hk : k ∈ (s.erase Aidx).erase Bidx) :
      uniFactor t i k = (if k < i then X else 1) :=
    uniFactor_axis (axis_of_ne hia hib)
      (axis_of_ne (Finset.ne_of_mem_erase (Finset.mem_of_mem_erase hk)) (Finset.ne_of_mem_erase hk))
      (Finset.ne_of_mem_erase (Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hk)))
  rw [Finset.prod_congr rfl eqf, Finset.prod_ite]
  simp [s]

theorem left_count (j : Fin 38) :
    ((((Finset.univ.erase (leftIdx j)).erase Aidx).erase Bidx).filter
      (fun k => k < leftIdx j)).card = j.val := by
  have hs : (((Finset.univ.erase (leftIdx j)).erase Aidx).erase Bidx).filter
      (fun k => k < leftIdx j) = Finset.Iio (leftIdx j) := by
    ext k
    simp only [Finset.mem_filter,Finset.mem_erase,Finset.mem_univ,and_true,Finset.mem_Iio]
    constructor
    · exact And.right
    · intro h
      have hv : k.val < j.val := h
      refine ⟨⟨?_,?_,ne_of_lt h⟩,h⟩
      · intro e
        have h39 : k.val = 39 := congrArg Fin.val e
        omega
      · intro e
        have h38 : k.val = 38 := congrArg Fin.val e
        omega
  rw [hs,Fin.card_Iio]
  rfl

theorem right_count (j : Fin 29) :
    ((((Finset.univ.erase (rightIdx j)).erase Aidx).erase Bidx).filter
      (fun k => k < rightIdx j)).card = j.val+38 := by
  have hs : (((Finset.univ.erase (rightIdx j)).erase Aidx).erase Bidx).filter
      (fun k => k < rightIdx j) = ((Finset.Iio (rightIdx j)).erase Aidx).erase Bidx := by
    ext k
    simp only [Finset.mem_filter,Finset.mem_erase,Finset.mem_univ,and_true,Finset.mem_Iio]
    constructor
    · rintro ⟨⟨a,b,c⟩,h⟩
      exact ⟨a,b,h⟩
    · rintro ⟨a,b,h⟩
      exact ⟨⟨a,b,ne_of_lt h⟩,h⟩
  have hmA : Aidx ∈ Finset.Iio (rightIdx j) := by
    rw [Finset.mem_Iio]
    change 38 < 40+j.val
    omega
  have hmB : Bidx ∈ (Finset.Iio (rightIdx j)).erase Aidx := by
    refine Finset.mem_erase.mpr ⟨by decide, Finset.mem_Iio.mpr ?_⟩
    change 39 < 40+j.val
    omega
  rw [hs,Finset.card_erase_of_mem hmB,Finset.card_erase_of_mem hmA,Fin.card_Iio]
  change 40+j.val-1-1 = j.val+38
  omega

theorem uniRow_L (t : ℝ) (j : Fin 38) :
    uniRow t (leftIdx j) = X^j.val *
      pairPoly 1 (-(alpha j t : ℂ)) * pairPoly 1 (-(beta j t : ℂ)) := by
  rw [uniRow_axis_inner t _ (left_ne_A j) (left_ne_B j), left_count]
  have hA : leftIdx j < Aidx := j.isLt
  have hB : leftIdx j < Bidx := by change j.val < 39; omega
  rw [uniFactor,if_pos hB,gap_beta,uniFactor,if_pos hA,gap_alpha]
  ring

theorem uniRow_U (t : ℝ) (j : Fin 29) :
    uniRow t (rightIdx j) = X^(j.val+38) *
      pairPoly (-(gamma j t : ℂ)) 1 * pairPoly (-(delta j t : ℂ)) 1 := by
  rw [uniRow_axis_inner t _ (right_ne_A j) (right_ne_B j), right_count]
  have hA : ¬ rightIdx j < Aidx := by change ¬ 40+j.val < 38; omega
  have hB : ¬ rightIdx j < Bidx := by change ¬ 40+j.val < 39; omega
  rw [uniFactor,if_neg hB,gap_delta,uniFactor,if_neg hA,gap_gamma]
  push_cast
  ring

end AtiyahBoundary









namespace AtiyahBoundary

noncomputable def complexPolyMap : Polynomial ℝ →ₐ[ℝ] Polynomial ℂ :=
  Polynomial.mapAlgHom (Algebra.ofId ℝ ℂ)

theorem complexPolyMap_ap (p : Polynomial ℝ) :
    complexPolyMap p = p.map (algebraMap ℝ ℂ) := rfl

theorem complex_rows_notIndependent {ι : Type*} {n : ℕ} {p : ι → Polynomial ℝ}
    (hdegree : ∀ i, (p i).natDegree < n)
    (h : ¬ LinearIndependent ℝ (fun i => Polynomial.toFn n (p i))) :
    ¬ LinearIndependent ℂ (fun i => (p i).map (algebraMap ℝ ℂ)) := by
  intro hc
  have hr := hc.restrict_scalars' ℝ
  have hp : LinearIndependent ℝ p :=
    LinearIndependent.of_comp complexPolyMap.toLinearMap hr
  apply h
  classical
  apply LinearIndependent.of_comp (Polynomial.ofFn n)
  change LinearIndependent ℝ (fun i => Polynomial.ofFn n (Polynomial.toFn n (p i)))
  have he : (fun i => Polynomial.ofFn n (Polynomial.toFn n (p i))) = p := by
    funext i
    exact Polynomial.ofFn_comp_toFn_eq_id_of_natDegree_lt (hdegree i)
  exact he.symm ▸ hp

end AtiyahBoundary




namespace AtiyahBoundary

open Polynomial

noncomputable def pairReal (a b : ℝ) : Polynomial ℝ := C a+C b*X

noncomputable def realFactor (t : ℝ) (i j : Fin 69) : Polynomial ℝ :=
  if i<j then pairReal 1 (-(gapSlope t i j)) else pairReal (gapSlope t j i) 1

noncomputable def realRow (t : ℝ) (i : Fin 69) : Polynomial ℝ :=
  ∏ j ∈ Finset.univ.erase i, realFactor t i j

theorem cMap_pair (a b : ℝ) : complexPolyMap (pairReal a b) = pairPoly (a : ℂ) (b : ℂ) := by
  simp [complexPolyMap_ap,pairPoly,pairReal]

theorem cMap_realRow (t : ℝ) (i : Fin 69) : complexPolyMap (realRow t i) = uniRow t i := by
  unfold realRow uniRow
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro j _
  unfold realFactor uniFactor
  split <;> simp [cMap_pair]

theorem cMap_inj : Function.Injective complexPolyMap := by
  have h : Function.Injective (algebraMap ℝ ℂ) := Complex.ofReal_injective
  exact Polynomial.map_injective _ h

theorem cMap_degree (p : Polynomial ℝ) :
    (complexPolyMap p).natDegree = p.natDegree := by
  rw [complexPolyMap_ap,Polynomial.natDegree_map_eq_of_injective Complex.ofReal_injective]

theorem realRow_degree (t : ℝ) (i : Fin 69) : (realRow t i).natDegree < 69 := by
  have hd := uniRow_degree t i
  rw [← cMap_realRow,cMap_degree] at hd
  omega

theorem scaledA (t : ℝ) : orbitA t = C 19 * realRow t Aidx := by
  apply cMap_inj
  unfold orbitA
  simp only [map_mul,map_prod,cMap_realRow,uniRow_A]
  simp [complexPolyMap_ap,pairPoly,Polynomial.map_C,Polynomial.map_X]
  ring

theorem scaledB (t : ℝ) : orbitB t = C 19 * realRow t Bidx := by
  apply cMap_inj
  unfold orbitB
  simp only [map_mul,map_prod,cMap_realRow,uniRow_B]
  simp [complexPolyMap_ap,pairPoly,Polynomial.map_C,Polynomial.map_X]
  ring

theorem eqRealL (t : ℝ) (j : Fin 38) :
    realRow t (leftIdx j) = monomial j.val 1 -
      monomial (j.val+1) (alpha j t+beta j t) +
      monomial (j.val+2) (alpha j t*beta j t) := by
  apply cMap_inj
  rw [cMap_realRow,uniRow_L]
  simp [complexPolyMap_ap,pairPoly, ← C_mul_X_pow_eq_monomial]
  ring

theorem eqRealU (t : ℝ) (j : Fin 29) :
    realRow t (rightIdx j) = monomial (j.val+40) 1 -
      monomial (j.val+39) (gamma j t+delta j t) +
      monomial (j.val+38) (gamma j t*delta j t) := by
  apply cMap_inj
  rw [cMap_realRow,uniRow_U]
  simp [complexPolyMap_ap,pairPoly, ← C_mul_X_pow_eq_monomial]
  ring

noncomputable def realCoeffs (t : ℝ) (i : Fin 69) : Fin 69 → ℝ :=
  fun j => (realRow t i).coeff j

theorem wDot_smul (l r t c : ℝ) (p : Polynomial ℝ) :
    wDot l r t (C c * p) = c * wDot l r t p := by
  change (∑ j : Fin 69, (C c * p).coeff j * weights l r t j) =
    c * ∑ j : Fin 69, p.coeff j * weights l r t j
  simp only [Polynomial.coeff_C_mul,Finset.mul_sum,mul_assoc]

theorem realCoeffs_L (t : ℝ) (j : Fin 38) : realCoeffs t (leftIdx j) = lowerRow t j := by
  funext k
  unfold realCoeffs
  rw [eqRealL]
  simp [Polynomial.coeff_monomial,lowerRow,basisAt,Fin.ext_iff,eq_comm,Pi.smul_apply]
  split_ifs <;> simp

theorem realCoeffs_U (t : ℝ) (j : Fin 29) : realCoeffs t (rightIdx j) = upperRow t j := by
  funext k
  unfold realCoeffs
  rw [eqRealU]
  simp [Polynomial.coeff_monomial,upperRow,basisAt,Fin.ext_iff,eq_comm,Pi.smul_apply]
  split_ifs <;> simp

theorem realDependent {t : ℝ} (ht : pathDet t = 0) : ¬ LinearIndependent ℝ (realCoeffs t) := by
  have hdet :
      wDot 1 0 t (realRow t Aidx)*wDot 0 1 t (realRow t Bidx) -
      wDot 0 1 t (realRow t Aidx)*wDot 1 0 t (realRow t Bidx) = 0 := by
    have he : pathDet t = 19^2 *
        (wDot 1 0 t (realRow t Aidx)*wDot 0 1 t (realRow t Bidx) -
        wDot 0 1 t (realRow t Aidx)*wDot 1 0 t (realRow t Bidx)) := by
      simp only [pathDet,scaledA,scaledB,wDot_smul]
      ring
    rw [he, mul_eq_zero] at ht
    exact ht.resolve_left (by norm_num)
  apply not_independent_of_two_projections
    (fun j => weights 1 0 t j) (fun j => weights 0 1 t j) Aidx Bidx Aidx Bidx
    (weights_seed₁ 1 0 t) (weights_seed₁ 0 1 t)
    (weights_seed₂ 1 0 t) (weights_seed₂ 0 1 t)
  · intro i ha hb
    have hav : i.val ≠ 38 := by intro e; exact ha (Fin.ext e)
    have hbv : i.val ≠ 39 := by intro e; exact hb (Fin.ext e)
    by_cases hL : i.val < 38
    · let j : Fin 38 := ⟨i.val,hL⟩
      have e : i = leftIdx j := Fin.ext rfl
      rw [e,realCoeffs_L]
      exact ⟨axialLower_zero 1 0 t j,axialLower_zero 0 1 t j⟩
    · let j : Fin 29 := ⟨i.val-40,by omega⟩
      have e : i = rightIdx j := Fin.ext (by change i.val = 40+(i.val-40); omega)
      rw [e,realCoeffs_U]
      exact ⟨axialUpper_zero 1 0 t j,axialUpper_zero 0 1 t j⟩
  · exact hdet

theorem final_bridge {t : ℝ} (h0 : 0 < t) (h1 : t < 1)
    (hdet : pathDet t = 0) : ¬ LinearIndependent ℂ ((AtiyahSutcliffe.pointPolynomial (points t))) := by
  apply mirror_notIndependent h0 h1
  apply normalized_notIndependent
  have hp : ¬ LinearIndependent ℂ (fun i => (realRow t i).map (algebraMap ℝ ℂ)) :=
    complex_rows_notIndependent (realRow_degree t) (realDependent hdet)
  have he : (fun i => (realRow t i).map (algebraMap ℝ ℂ)) = uniRow t := by
    funext i
    exact cMap_realRow t i
  exact he ▸ hp

end AtiyahBoundary





theorem OMA.disproof : ¬ (type_of% @AtiyahSutcliffe.conjecture_one) := by
  intro h
  obtain ⟨t, ht, hz⟩ := AtiyahBoundary.signChangeHasRoot AtiyahBoundary.pathDet_cont
    AtiyahBoundary.pathDet_pos AtiyahBoundary.pathDet_neg
  exact AtiyahBoundary.final_bridge ht.1 ht.2 hz
    (h (AtiyahBoundary.points t) (AtiyahBoundary.points_injective ht.1 ht.2))
