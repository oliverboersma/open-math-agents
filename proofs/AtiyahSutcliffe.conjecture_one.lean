noncomputable def seq (S P : ℕ → ℝ → ℝ) (a b : ℝ) : ℕ → ℝ → ℝ
  | 0 => fun _ => a
  | 1 => fun _ => b
  | k+2 => fun t => S k t * seq S P a b (k+1) t - P k t * seq S P a b k t

theorem seq_cont {S P : ℕ → ℝ → ℝ} {a b : ℝ} {r : Set ℝ} (n : ℕ)
    (hc : ∀ k, k + 2 ≤ n → ContinuousOn (S k) r ∧ ContinuousOn (P k) r) :
    ContinuousOn (seq S P a b n) r := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    rcases n with _ | n
    · simpa [seq] using continuousOn_const (c := a) (s := r)
    rcases n with _ | n
    · simpa [seq] using continuousOn_const (c := b) (s := r)
    · have h1 := ih (n + 1) (by omega) (fun k hk => hc k (by omega))
      have h2 := ih n (by omega) (fun k hk => hc k (by omega))
      exact ((hc n le_rfl).1.mul h1).sub ((hc n le_rfl).2.mul h2)

noncomputable def leftSum (k : ℕ) (t : ℝ) : ℝ := alpha (37-k) t + beta (37-k) t
noncomputable def leftProd (k : ℕ) (t : ℝ) : ℝ := alpha (37-k) t * beta (37-k) t
noncomputable def rightSum (k : ℕ) (t : ℝ) : ℝ := gamma k t + delta k t
noncomputable def rightProd (k : ℕ) (t : ℝ) : ℝ := gamma k t * delta k t

noncomputable def weights (l r : ℝ) (t : ℝ) (j : ℕ) : ℝ :=
  if j ≤ 38 then seq leftSum leftProd r l (39-j) t
  else seq rightSum rightProd l r (j-38) t

theorem weights_seed₁ (l r t : ℝ) : weights l r t 38 = l := rfl
theorem weights_seed₂ (l r t : ℝ) : weights l r t 39 = r := rfl

theorem weights_left (l r t : ℝ) (j : ℕ) (hj : j < 38) :
    weights l r t j = (alpha j t + beta j t) * weights l r t (j+1) -
      (alpha j t * beta j t) * weights l r t (j+2) := by
  have e0 : 39-j = (37-j)+2 := by omega
  have e1 : 39-(j+1) = (37-j)+1 := by omega
  have e2 : 39-(j+2) = 37-j := by omega
  have e3 : 37-(37-j) = j := by omega
  rw [weights, if_pos (by omega), e0]
  change leftSum (37-j) t * seq leftSum leftProd r l ((37-j)+1) t -
    leftProd (37-j) t * seq leftSum leftProd r l (37-j) t = _
  simp only [leftSum, leftProd, e3]
  rw [show weights l r t (j+1) = seq leftSum leftProd r l ((37-j)+1) t by
    rw [weights, if_pos (by omega), e1]]
  by_cases h : j+2 ≤ 38
  · rw [weights, if_pos h, e2]
  · have h37 : j = 37 := by omega
    subst j
    rfl

theorem weights_right (l r t : ℝ) (j : ℕ) (hj : 40 ≤ j) :
    weights l r t j = (gamma (j-40) t + delta (j-40) t) * weights l r t (j-1) -
      (gamma (j-40) t * delta (j-40) t) * weights l r t (j-2) := by
  have e0 : j-38 = (j-40)+2 := by omega
  have e1 : (j-1)-38 = (j-40)+1 := by omega
  have e2 : (j-2)-38 = j-40 := by omega
  rw [weights, if_neg (by omega), e0]
  change rightSum (j-40) t * seq rightSum rightProd l r ((j-40)+1) t -
    rightProd (j-40) t * seq rightSum rightProd l r (j-40) t = _
  simp only [rightSum, rightProd]
  rw [show weights l r t (j-1) = seq rightSum rightProd l r ((j-40)+1) t by
    rw [weights, if_neg (by omega), e1]]
  by_cases h : j-2 ≤ 38
  · have h40 : j = 40 := by omega
    subst j
    rfl
  · rw [weights, if_neg h, e2]

theorem weights_cont (l r : ℝ) (j : ℕ) :
    ContinuousOn (fun t => weights l r t j) (Set.Icc 0 1) := by
  unfold weights
  split
  · apply seq_cont
    intro k hk
    let v : Fin 38 := ⟨37-k, by omega⟩
    exact ⟨(continuousOn_alpha v).add (continuousOn_beta v), (continuousOn_alpha v).mul (continuousOn_beta v)⟩
  · apply seq_cont
    intro k _
    exact ⟨(continuousOn_gamma k).add (continuousOn_delta k), (continuousOn_gamma k).mul (continuousOn_delta k)⟩

end AtiyahBoundary


