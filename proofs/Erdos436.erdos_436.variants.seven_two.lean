theorem jW (f : Nat → ZMod 7) : Goal f := by
  by_cases h : f 2 = 0
  · exact ⟨1, by decide, by decide, by simp [weight], by simp [weight,h]⟩
  · apply kS f h
    apply jQ [2] s1 _ jL
    have hval : (1 : ZMod 7).val = 1 := by decide
    simpa [encode,div_self h,hval] using b1.down
