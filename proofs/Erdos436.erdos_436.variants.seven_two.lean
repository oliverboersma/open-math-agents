namespace OMA.R1
theorem transfer (p : ℕ) (hp : p.Prime) :
    ∃ f : ℕ → ZMod 7, ∀ n : ℕ, 0 < n → n < p →
      (∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7) * f q) = 0 →
      Erdos436.IsPowerResidue 7 p n := by
  classical
  let _ : Fact p.Prime := ⟨hp⟩
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
  have jF (n : ℕ) (hn : 0 < n) (hpn : n < p) : (n : ZMod p) ≠ 0 := by
    intro he
    exact (not_le_of_gt hpn) (Nat.le_of_dvd hn ((ZMod.natCast_eq_zero_iff n p).1 he))
  have hnth (q : ℕ) : ∃ e : ℕ, 0 < q → q < p → (g : ZMod p) ^ e = (q : ZMod p) := by
    by_cases hq : 0 < q ∧ q < p
    · let u : (ZMod p)ˣ := Units.mk0 (q : ZMod p) (jF q hq.1 hq.2)
      obtain ⟨e, he⟩ := (mem_powers_iff_mem_zpowers.2 (hg u) : u ∈ Submonoid.powers g)
      refine ⟨e, fun _ _ => ?_⟩
      simpa [u] using congrArg (fun a : (ZMod p)ˣ => (a : ZMod p)) he
    · exact ⟨0, fun hq₀ hqp => (hq ⟨hq₀, hqp⟩).elim⟩
  choose e he using hnth
  refine ⟨fun q => (e q : ZMod 7), fun n hn hnp hz => ?_⟩
  let E : ℕ := ∑ q ∈ n.primeFactors, e q * n.factorization q
  have hE : (E : ZMod 7) = 0 := by
    simpa only [E, Nat.cast_sum, Nat.cast_mul, mul_comm] using hz
  have hexp : (g : ZMod p) ^ E = (n : ZMod p) := by
    rw [← prod_pow_eq_pow_sum]
    calc
      _ = ∏ q ∈ n.primeFactors, (q : ZMod p) ^ n.factorization q := by
        apply prod_congr rfl
        intro q hq
        rw [pow_mul, he q (Nat.prime_of_mem_primeFactors hq).pos
          ((Nat.le_of_mem_primeFactors hq).trans_lt hnp)]
      _ = _ := by
        have hs := congrArg (fun m : ℕ => (m : ZMod p))
          (Nat.prod_primeFactors_pow_factorization (Nat.ne_of_gt hn)).symm
        simpa only [Nat.cast_prod, Nat.cast_pow] using hs
  obtain ⟨j, hj⟩ := (ZMod.natCast_eq_zero_iff E 7).1 hE
  refine ⟨jF n hn hnp, (g : ZMod p) ^ j, ?_⟩
  rw [← pow_mul, mul_comm j, ← hj, hexp]
def H1 : Prop :=
  ∀ f : ℕ → ZMod 7, ∃ n : ℕ, 1 ≤ n ∧ n ≤ 1649375 ∧
    (∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7) * f q) = 0 ∧
    (∑ q ∈ (n + 1).primeFactors, ((n + 1).factorization q : ZMod 7) * f q) = 0
def H2 : Prop :=
  let f (q : ℕ) : ZMod 7 := if q ∈ ([3, 41] : List ℕ) then 0 else
    if q ∈ ([79, 137, 197, 233, 269, 277, 463, 467, 797, 1709, 2647, 2903, 15791] : List ℕ)
    then 2 else 1
  ∀ n : ℕ, 1 ≤ n → n < 1649375 →
    (∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7) * f q) ≠ 0 ∨
    (∑ q ∈ (n + 1).primeFactors, ((n + 1).factorization q : ZMod 7) * f q) ≠ 0
def H3 : Prop :=
  let f (q : ℕ) : ZMod 7 := if q ∈ ([3, 41] : List ℕ) then 0 else
    if q ∈ ([79, 137, 197, 233, 269, 277, 463, 467, 797, 1709, 2647, 2903, 15791] : List ℕ)
    then 2 else 1
  ∀ X : ℕ, ∃ p : ℕ, X ≤ p ∧ p.Prime ∧ ∀ n : ℕ, 1 ≤ n → n ≤ 1649375 →
    (Erdos436.IsPowerResidue 7 p n ↔
      (∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7) * f q) = 0)
theorem main : H1 → H2 → H3 → type_of% @Erdos436.erdos_436.variants.seven_two := by
  classical
  intro upper maximal realization
  change limsup (Erdos436.r 7 2) (atTop ⊓ 𝓟 {p : ℕ | p.Prime}) = (1649375 : ℕ∞)
  apply le_antisymm
  · apply limsup_le_of_le (by isBoundedDefault)
    apply eventually_inf_principal.2
    filter_upwards [eventually_ge_atTop (1649377 : ℕ)] with p hpL hp
    obtain ⟨f, hf⟩ := transfer p hp
    obtain ⟨n, hn, hnL, h₁, h₂⟩ := upper f
    have hrun : 1 ≤ n ∧ ∀ i < 2, Erdos436.IsPowerResidue 7 p (n + i) := by
      refine ⟨hn, fun i hi => ?_⟩
      have hi' : i = 0 ∨ i = 1 := by omega
      rcases hi' with rfl | rfl
      · simpa only [Nat.add_zero] using hf n (by omega) (by omega) h₁
      · exact hf (n + 1) (by omega) (by omega) h₂
    exact (iInf₂_le n hrun).trans (by exact_mod_cast hnL)
  · apply le_limsup_of_frequently_le'
    rw [frequently_inf_principal, frequently_atTop]
    intro X
    obtain ⟨p, hpX, hp, hres⟩ := realization X
    refine ⟨p, hpX, hp, ?_⟩
    apply le_iInf₂
    rintro n ⟨hn, hh⟩
    have hL : 1649375 ≤ n := by
      by_contra! hlt
      have h₁ := (hres n hn hlt.le).1 (hh 0 (by omega))
      have h₂ := (hres (n + 1) (by omega) (by omega)).1 (hh 1 (by omega))
      exact (maximal n hn hlt).elim (fun h => h h₁) (fun h => h h₂)
    exact_mod_cast hL
end OMA.R1
namespace OMA.L1
namespace BLL
structure W where
  x : Nat
  y : Nat
  z : Nat
deriving Inhabited
def W.get (w : W) (i : Nat) : Nat :=
  (w.x.testBit i).toNat + 2*(w.y.testBit i).toNat + 4*(w.z.testBit i).toNat
def W.add (a b : W) : W :=
  let x := a.x ^^^ b.x
  let y := a.y ^^^ b.y
  let z := a.z ^^^ b.z
  let u := a.x &&& b.x
  let v := a.y &&& b.y
  let c := (a.z &&& b.z) ||| (z &&& (v ||| (y &&& u)))
  let d := u ||| (x &&& c)
  let e := v ||| (y &&& d)
  ⟨x ^^^ c, y ^^^ d, z ^^^ e⟩
def W.neg (a : W) (m : Nat) : W := ⟨m ^^^ a.x,m ^^^ a.y,m ^^^ a.z⟩
def W.rot (a : W) : W := ⟨a.z,a.x,a.y⟩
def W.scale (m : Nat) (a : W) : Nat → W
  | 0 => ⟨0,0,0⟩
  | 1 => a
  | 2 => a.rot
  | 3 => (a.rot.rot).neg m
  | 4 => a.rot.rot
  | 5 => a.rot.neg m
  | _ => a.neg m
def dot (mask : Nat) : List W → Nat → W
  | [],_ => ⟨0,0,0⟩
  | c::cs,v =>
    let w := dot mask cs (v/8)
    if v%8 == 0 then w else w.add (c.scale mask (v%8))
structure Batch where
  even : Nat
  cols : List W
def W.nz (a : W) := (a.x ^^^ a.y) ||| (a.y ^^^ a.z)
def W.different (a : W) (m : Nat) : Nat → Nat
  | 0 => a.nz
  | 1 => (m ^^^ a.x) ||| a.y ||| a.z
  | 2 => a.x ||| (m ^^^ a.y) ||| a.z
  | 3 => (m ^^^ a.x) ||| (m ^^^ a.y) ||| a.z
  | 4 => a.x ||| a.y ||| (m ^^^ a.z)
  | 5 => (m ^^^ a.x) ||| a.y ||| (m ^^^ a.z)
  | _ => a.x ||| (m ^^^ a.y) ||| (m ^^^ a.z)
def cZ (e : Nat) := e ||| (e <<< 1)
def gate (w : W) (e a : Nat) : Bool :=
  (((w.different (cZ e) a ||| (w.nz >>> 1)) &&& e) != e)
def run : List Batch → Nat → Bool
  | [],_ => false
  | g::gs,v =>
    let w := dot (cZ g.even) g.cols v
    let ok := fun a => gate w g.even a || run gs (8*v+a)
    ok 0 && ok 1 && ok 2 && ok 3 && ok 4 && ok 5 && ok 6
theorem add_get (a b : W) (i : Nat) :
    ((a.add b).get i : ZMod 7) = (a.get i : ZMod 7) + (b.get i : ZMod 7) := by
  simp only [W.get,W.add,Nat.testBit_xor,Nat.testBit_or,Nat.testBit_and]
  generalize a.x.testBit i = x
  generalize a.y.testBit i = y
  generalize a.z.testBit i = z
  generalize b.x.testBit i = u
  generalize b.y.testBit i = v
  generalize b.z.testBit i = w
  revert x y z u v w
  decide +kernel
theorem jP (c : W) (m i a : Nat) (hm : m.testBit i = true) (ha : a < 7) :
    ((c.scale m a).get i : ZMod 7) = (a : ZMod 7) * (c.get i : ZMod 7) := by
  interval_cases a <;> simp only [W.scale,W.rot,W.neg,W.get,Nat.testBit_xor,hm,
    Nat.zero_testBit,Bool.true_xor] <;>
    generalize c.x.testBit i = x <;> generalize c.y.testBit i = y <;>
    generalize c.z.testBit i = z <;> revert x y z <;> decide +kernel
theorem mismatch (w : W) (m i a : Nat) (hm : m.testBit i = true) (ha : a < 7) :
    (w.different m a).testBit i = false ↔ (w.get i : ZMod 7) = a := by
  interval_cases a <;> simp only [W.different,W.nz,W.get,Nat.testBit_xor,
    Nat.testBit_or,hm] <;> generalize w.x.testBit i = x <;>
    generalize w.y.testBit i = y <;> generalize w.z.testBit i = z <;>
    revert x y z <;> decide +kernel
theorem kP (w : W) (i : Nat) :
    w.nz.testBit i = false ↔ (w.get i : ZMod 7) = 0 := by
  simp only [W.nz,W.get,Nat.testBit_xor,Nat.testBit_or]
  generalize w.x.testBit i = x
  generalize w.y.testBit i = y
  generalize w.z.testBit i = z
  revert x y z
  decide +kernel
def encode (f : Nat → ZMod 7) : List Nat → Nat
  | [] => 0
  | q :: qs => (f q).val + 8 * encode f qs
theorem kQ (f : Nat → ZMod 7) (q : Nat) (qs : List Nat) :
    encode f (q::qs) % 8 = (f q).val := by
  simp only [encode]
  have := (f q).val_lt
  omega
theorem kR (f : Nat → ZMod 7) (q : Nat) (qs : List Nat) :
    encode f (q::qs) / 8 = encode f qs := by
  simp only [encode]
  have := (f q).val_lt
  omega
theorem gR (m i : Nat) (hm : m.testBit i = true) (w : W)
    (ws : List W) (f : Nat → ZMod 7) (q : Nat) (qs : List Nat) :
    ((dot m (w::ws) (encode f (q::qs))).get i : ZMod 7) =
    (f q) * (w.get i : ZMod 7) + ((dot m ws (encode f qs)).get i : ZMod 7) := by
  simp only [dot,kQ,kR]
  split
  · rename_i h
    simp only [beq_iff_eq] at h
    have hz : f q = 0 := by rw [← ZMod.natCast_zmod_val (f q), h]; rfl
    simp [hz]
  · rw [add_get,jP _ _ _ _ hm (f q).val_lt,ZMod.natCast_zmod_val,add_comm]
def linear (n : List Nat) (f : Nat → ZMod 7) : List Nat → ZMod 7
  | [] => 0
  | q::qs => (n.count q : ZMod 7) * f q + linear n f qs
def flags (i e : Nat) (A B : List Nat) : List W → List Nat → Bool
  | [],[] => true
  | w::ws,q::qs => ((w.get (2*i) * e + A.count q)%7 == 0) &&
      (w.get (2*i+1)%7 == B.count q %7) && flags i e A B ws qs
  | _,_ => false
theorem jB (i e m : Nat) (A B : List Nat) (ha : m.testBit (2*i) = true)
    (hb : m.testBit (2*i+1) = true) (f : Nat → ZMod 7) (ws : List W) (qs : List Nat)
    (hf : flags i e A B ws qs = true) :
    ((dot m ws (encode f qs)).get (2*i) : ZMod 7) * e + linear A f qs = 0 ∧
    ((dot m ws (encode f qs)).get (2*i+1) : ZMod 7) = linear B f qs := by
  induction ws generalizing qs with
  | nil => cases qs <;> simp_all [dot,W.get,linear,flags]
  | cons w ws ih =>
    cases qs with
    | nil => simp [flags] at hf
    | cons q qs =>
      simp only [flags,Bool.and_eq_true,beq_iff_eq] at hf
      obtain ⟨⟨hl,hr⟩,ht⟩ := hf
      have hleft : (w.get (2*i) : ZMod 7) * e + A.count q = 0 := by
        exact_mod_cast (ZMod.natCast_eq_zero_iff _ _).mpr (Nat.dvd_of_mod_eq_zero hl)
      have hright : (w.get (2*i+1) : ZMod 7) = B.count q := by
        exact (ZMod.natCast_eq_natCast_iff _ _ _).mpr hr
      obtain ⟨al,bl⟩ := ih qs ht
      rw [gR _ _ ha, gR _ _ hb, linear,linear,hright,bl]
      exact ⟨by linear_combination (f q) * hleft + al,by ring⟩
def weight (f : Nat → ZMod 7) (n : Nat) : ZMod 7 :=
  ∑ q ∈ n.primeFactors, (n.factorization q : ZMod 7) * f q
def Goal (f : Nat → ZMod 7) : Prop :=
  ∃ n : Nat, 1 ≤ n ∧ n ≤ 1649375 ∧ weight f n = 0 ∧ weight f (n+1) = 0
theorem jh (A ps : List Nat) (f : Nat → ZMod 7) (h : ps.Nodup) :
    linear A f ps = ∑ q ∈ ps.toFinset, (A.count q : ZMod 7) * f q := by
  induction ps with
  | nil => simp [linear]
  | cons q qs ih =>
    obtain ⟨hn, hu⟩ := List.nodup_cons.mp h
    simp [linear, Finset.sum_insert, hn, ih hu]
theorem gN (A ps : List Nat) (f : Nat → ZMod 7)
    (h : ps.Nodup) (hp : ∀ q ∈ A, Nat.Prime q) (hs : ∀ q ∈ A, q ∈ ps) :
    linear A f ps = weight f A.prod := by
  have perm := Nat.primeFactorsList_unique (n := A.prod) rfl hp
  have hcnt (q : Nat) : A.count q = A.prod.factorization q :=
    (perm.count_eq q).trans Nat.primeFactorsList_count_eq
  rw [jh _ _ _ h, weight]
  simp only [hcnt]
  apply Eq.symm
  apply Finset.sum_subset
  · intro q hq
    apply List.mem_toFinset.mpr
    apply hs q
    exact perm.mem_iff.mpr (Nat.mem_primeFactors_iff_mem_primeFactorsList.mp hq)
  · intro q _ hn
    have he : A.prod.factorization q = 0 := by
      exact Finsupp.notMem_support_iff.mp hn
    simp [he]
abbrev R := List Nat × List Nat
def jf (g : Batch) (q : Nat) (ps : List Nat) (i : Nat) (r : R) : Prop :=
  let A := r.1
  let B := r.2
  g.even.testBit (2*i+1) = false ∧
  (cZ g.even).testBit (2*i) = true ∧
  (cZ g.even).testBit (2*i+1) = true ∧
  (A.prod + 1 = B.prod ∨ B.prod + 1 = A.prod) ∧
  1 ≤ A.prod ∧ 1 ≤ B.prod ∧ min A.prod B.prod ≤ 1649375 ∧
  (∀ p ∈ A, Nat.Prime p ∧ p ∈ q::ps) ∧ (∀ p ∈ B, Nat.Prime p ∧ p ∈ q::ps) ∧
  B.count q = 0 ∧ flags i (A.count q) A B g.cols ps = true
instance (g : Batch) (q : Nat) (ps : List Nat) (i : Nat) (r : R) :
    Decidable (jf g q ps i r) := by unfold jf; infer_instance
def certified (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R) : Prop :=
  (q::ps).Nodup ∧ g.even < 2^(2*rs.size) ∧ ∀ i : Fin rs.size, jf g q ps i.val rs[i]
instance (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R) :
    Decidable (certified g q ps rs) := by unfold certified; infer_instance
theorem jK (g : Batch) (q : Nat) (ps : List Nat) (rs : Array R)
    (hv : certified g q ps rs) (f : Nat → ZMod 7)
    (hit : gate (dot (cZ g.even) g.cols (encode f ps)) g.even (f q).val = true) : Goal f := by
  let w := dot (cZ g.even) g.cols (encode f ps)
  change (((w.different (cZ g.even) (f q).val ||| (w.nz >>> 1)) &&& g.even) != g.even) = true at hit
  simp only [bne_iff_ne] at hit
  have hx := mt Nat.eq_of_testBit_eq hit
  push Not at hx
  obtain ⟨k,hk⟩ := hx
  simp only [Nat.testBit_and, Nat.testBit_or, Nat.testBit_shiftRight] at hk
  have he : g.even.testBit k = true := by
    cases h : g.even.testBit k <;> simp_all
  have ajL : k < 2*rs.size := by
    by_contra! h
    have hzero := Nat.testBit_lt_two_pow (hv.2.1.trans_le (Nat.pow_le_pow_right (by decide : 0 < 2) h))
    rw [hzero] at he; contradiction
  let i : Fin rs.size := ⟨k/2, by omega⟩
  obtain ⟨ho,ma,mb,adj,pa,pb,bnd,aps,bps,uj,lJ⟩ := hv.2.2 i
  have hke : k = 2*i.val := by
    change g.even.testBit (2*(k/2)+1) = false at ho
    change k = 2*(k/2)
    by_contra h
    have eq : 2*(k/2)+1 = k := by omega
    rw [eq,he] at ho; contradiction
  rw [hke] at hk he
  simp only [he,Bool.and_true,← Bool.eq_false_iff,Bool.or_eq_false_iff] at hk
  have ha := (mismatch w _ _ _ ma (f q).val_lt).mp hk.1
  have hb := (kP w (2*i.val+1)).mp (by simpa [Nat.add_comm] using hk.2)
  rw [ZMod.natCast_zmod_val] at ha
  obtain ⟨l,r⟩ := jB i _ _ _ _ ma mb f _ _ lJ
  change (w.get _ : ZMod 7) * _ + _ = 0 at l
  change (w.get _ : ZMod 7) = _ at r
  rw [ha] at l
  rw [hb] at r
  have hA : weight f rs[i].1.prod = 0 := by
    rw [← gN rs[i].1 (q::ps) f hv.1 (fun p h => (aps p h).1) (fun p h => (aps p h).2),linear]
    linear_combination l
  have hB : weight f rs[i].2.prod = 0 := by
    rw [← gN rs[i].2 (q::ps) f hv.1 (fun p h => (bps p h).1) (fun p h => (bps p h).2),linear,uj]
    simpa using r.symm
  rcases adj with a | b
  · exact ⟨_,pa,by omega,hA,a.symm ▸ hB⟩
  · exact ⟨_,pb,by omega,hB,b.symm ▸ hA⟩
def valid (ps : List Nat) : List Batch → Prop
  | [] => True
  | g::gs => ∃ q rs, certified g q ps rs ∧ valid (q::ps) gs
theorem jQ (ps : List Nat) (gs : List Batch) (f : Nat → ZMod 7)
    (hv : valid ps gs) (hc : run gs (encode f ps) = true) : Goal f := by
  induction gs generalizing ps with
  | nil => simp [run] at hc
  | cons g gs ih =>
    obtain ⟨q,rs,hq,ht⟩ := hv
    let w := dot (cZ g.even) g.cols (encode f ps)
    let ok := fun a => gate w g.even a || run gs (8*encode f ps+a)
    change (ok 0 && ok 1 && ok 2 && ok 3 && ok 4 && ok 5 && ok 6) = true at hc
    simp only [Bool.and_eq_true] at hc
    have t : ok (f q).val = true := by
      have h := (f q).val_lt
      interval_cases v : (f q).val <;> tauto
    rcases Bool.or_eq_true_iff.mp t with h | h
    · exact jK g q ps rs hq f h
    · exact ih (q::ps) ht (by simpa only [encode,Nat.add_comm] using h)
def children (g : Batch) (v : Nat) : List Nat :=
  let w := dot (cZ g.even) g.cols v
  (List.range 7).filter (fun a => !(gate w g.even a))
def every (gs : List Batch) (v : Nat) : List Nat → Prop
  | [] => True
  | a::as => run gs (8*v+a) = true ∧ every gs v as
theorem jR (gs : List Batch) (v a : Nat) (l : List Nat)
    (h : every gs v l) (ha : a ∈ l) : run gs (8*v+a) = true := by
  induction l with
  | nil => simp at ha
  | cons b bs ih =>
    rcases List.mem_cons.mp ha with rfl | h'
    · exact h.1
    · exact ih h.2 h'
theorem branch (g : Batch) (gs : List Batch) (v : Nat) (l : List Nat)
    (he : children g v = l) (hc : every gs v l) : run (g::gs) v = true := by
  let w := dot (cZ g.even) g.cols v
  have ok (a : Nat) (ha : a < 7) : gate w g.even a || run gs (8*v+a) := by
    by_cases hg : gate w g.even a = true
    · simp [hg]
    · apply Bool.or_eq_true_iff.mpr
      apply Or.inr
      apply jR _ _ _ l hc
      rw [← he]
      exact List.mem_filter.mpr ⟨List.mem_range.mpr ha,by simpa [Bool.not_eq_true'] using hg⟩
  simp only [run,Bool.and_eq_true]
  exact ⟨⟨⟨⟨⟨⟨ok 0 (by decide),ok 1 (by decide)⟩,ok 2 (by decide)⟩,
    ok 3 (by decide)⟩,ok 4 (by decide)⟩,ok 5 (by decide)⟩,ok 6 (by decide)⟩
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
theorem kS (f : Nat → ZMod 7) (h : f 2 ≠ 0)
    (hg : Goal (fun p => f p / f 2)) : Goal f := by
  obtain ⟨n,h1,h2,ha,hb⟩ := hg
  have conv (m : Nat) : weight (fun p => f p / f 2) m = weight f m / f 2 := by
    unfold weight
    rw [Finset.sum_div]
    apply Finset.sum_congr rfl
    intro p _
    ring
  rw [conv] at ha hb
