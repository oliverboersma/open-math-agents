  have hre : (NumberField.dedekindZeta L (s : ℂ)).re = ∑' n : ℕ, g n := by
    rw [bF L hs']
    simp_rw [key]
    rw [Complex.re_tsum (by simpa only [key] using kM)]
    simp
  rw [hre]
  refine ac2.tsum_pos (fun n ↦ ?_) 1 ?_
  · exact mul_nonneg (Nat.cast_nonneg _) (Real.rpow_nonneg (Nat.cast_nonneg _) _)
  · rw [hg]
    simp [fF]
end fO
