lemma jO {I : Type} [Fintype I] (p : I → ℕ) (hp : ∀ i, (p i).Prime)
    (hinj : Function.Injective p) (v : I → ℕ) :
    ∃ (L : Type) (_ : Field L) (_ : CharZero L) (_ : NumberField L) (_ : IsGalois ℚ L)
      (σ : (𝓞 L) ≃+* (𝓞 L)) (u : 𝓞 L), u^6+u^5+u^4+u^3+u^2+u+1=0 ∧ σ u=u ∧ (∃ m : ℕ, 0 < m ∧ ∀ x, (σ : 𝓞 L → 𝓞 L)^[m] x = x) ∧
      ∀ i, ∃ r : 𝓞 L, r^7 = p i ∧ σ r=r*u^(v i) := by
  classical
  letI : Fact (Nat.Prime 7) := ⟨by decide⟩
  let g (i : I) : ℚ[X] := X^7 - C (p i : ℚ)
  let P := cyclotomic 7 ℚ * ∏ i, g i
  let L := P.SplittingField
  letI : Polynomial.IsSplittingField ℚ L P := Polynomial.IsSplittingField.splittingField P
  letI : NumberField L := ⟨⟩
  letI : IsGalois ℚ L := isGalois_iff.mpr ⟨inferInstance,Polynomial.SplittingField.instNormal P⟩
  have pg (i : I) : (g i).natDegree = 7 := natDegree_X_pow_sub_C
  have neP : P ≠ 0 := mul_ne_zero (cyclotomic_ne_zero 7 ℚ) (Finset.prod_ne_zero_iff.mpr
    (fun i _ h => by have := pg i; simp [h] at this))
  have root (f : ℚ[X]) (hf : f ∣ P) (hd : 0 < f.natDegree) : ∃ y : L, f.aeval y = 0 := by
    let j := algebraMap ℚ L
    have h := (IsSplittingField.splits L P).of_dvd (map_ne_zero (f := j) neP)
      (map_dvd (mapRingHom j) hf)
    have hd0 : (f.map j).natDegree ≠ 0 := by rw [natDegree_map]; exact hd.ne'
    obtain ⟨y,hy⟩ := h.exists_eval_eq_zero (degree_ne_of_natDegree_ne (n := 0) hd0)
    refine ⟨y,?_⟩
    rw [aeval_def,eval₂_eq_eval_map]
    exact hy
  obtain ⟨u,hu⟩ := root (cyclotomic 7 ℚ) (dvd_mul_right ..) (by rw [natDegree_cyclotomic]; decide)
  have prim : IsPrimitiveRoot u 7 := by
    apply isRoot_cyclotomic_iff.mp
    simpa [Polynomial.IsRoot.def,aeval_def,eval₂_eq_eval_map] using hu
  have cu : u^6+u^5+u^4+u^3+u^2+u+1=0 := by
    have hcy : cyclotomic 7 ℚ = X^6 + X^5 + X^4 + X^3 + X^2 + X + 1 := by
      rw [cyclotomic_prime ℚ 7]; norm_num [Finset.sum_range_succ] <;> ring
    simpa [hcy] using hu
  have each (i : I) : ∃ r : L, r^7 = p i := by
    obtain ⟨r,hr⟩ := root (g i) (dvd_trans (Finset.dvd_prod_of_mem _ (Finset.mem_univ i)) (dvd_mul_left ..))
      (by rw [pg]; decide)
    exact ⟨r,by simpa [g,sub_eq_zero] using hr⟩
  choose r hr using each
  let F : IntermediateField ℚ L := ℚ⟮u⟯
  let u' : F := ⟨u,IntermediateField.mem_adjoin_simple_self ℚ u⟩
  have hu' : IsPrimitiveRoot u' 7 := prim.of_map_of_injective (f := F.subtype) Subtype.val_injective
  have deg : Module.finrank ℚ F ≤ 6 := by
    rw [show Module.finrank ℚ F = (minpoly ℚ u).natDegree from IntermediateField.adjoin.finrank (IsIntegral.of_finite ℚ u),
      ← cyclotomic_eq_minpoly_rat prim (by decide),natDegree_cyclotomic]
    decide
  have rn (i : I) : r i ≠ 0 := by
    intro hz
    have h := hr i
    rw [hz,zero_pow (by decide : 7 ≠ 0)] at h
    exact (Nat.cast_ne_zero.mpr (hp i).ne_zero) h.symm
  obtain ⟨σ,hσ⟩ := prescribe u' hu' (fun i => (p i : F)) r (fun i => by simpa using hr i) rn
    (iw deg p hinj hp) (fun i => (v i : ZMod 7))
  let τ := RingOfIntegers.mapRingEquiv σ.toRingEquiv
  let U : 𝓞 L := ⟨u,prim.isIntegral (by decide)⟩
  refine ⟨L,inferInstance,inferInstance,inferInstance,inferInstance,τ,U,?_,?_,?_,?_⟩
  · exact Subtype.ext cu
  · exact Subtype.ext (σ.commutes u')
  · refine ⟨orderOf σ,orderOf_pos _,fun x => Subtype.ext ?_⟩
    have it (j : ℕ) : (((τ : 𝓞 L → 𝓞 L)^[j] x : 𝓞 L) : L) = (σ^j) (x : L) := by
      induction j with
      | zero => rfl
      | succ j ih =>
        rw [Function.iterate_succ_apply',pow_succ']
        exact congrArg σ ih
    exact (it _).trans (by rw [pow_orderOf_eq_one]; rfl)
  · intro i
    have integral : IsIntegral ℤ (r i) := IsIntegral.of_pow (by decide : 0 < 7)
      ((hr i).symm ▸ (isIntegral_algebraMap : IsIntegral ℤ (algebraMap ℤ L (p i : ℤ))))
    refine ⟨⟨r i,integral⟩,Subtype.ext (hr i),?_⟩
    apply Subtype.ext
    change σ (r i) = r i*u^(v i)
    have e := hσ i
    change σ (r i) = r i*u^((v i : ZMod 7).val) at e
    simpa only [ZMod.val_natCast,prim.eq_orderOf,pow_mod_orderOf] using e
end d7
open NumberField
lemma f9 {R : Type} [CommRing R] (σ : R ≃+* R) (u : R) (hu : σ u=u)
    (r : R) (k : ℕ) (hr : σ r=r*u^k) (t : ℕ) :
    (σ : R → R)^[t] r=r*(u^t)^k := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Function.iterate_succ_apply',ih,map_mul,map_pow,map_pow,hu,hr,pow_succ,mul_pow]
    ring
lemma descend {p : ℕ} [Fact p.Prime] {F : Type} [Field F] [CharP F p]
    (y : F) (hy : y^p=y) : ∃ z : ZMod p, ZMod.castHom (m := p) dvd_rfl F z = y := by
  have h := (Subfield.mem_bot_iff_pow_eq_self F p).mpr hy
  rw [← ZMod.fieldRange_castHom_eq_bot p] at h
  exact h
theorem solve : OMA.R3.H1 := by
  classical
  intro B
  let w (q : ℕ) : ℕ := if q ∈ ([3,41] : List ℕ) then 0 else
    if q ∈ ([79,137,197,233,269,277,463,467,797,1709,2647,2903,15791] : List ℕ) then 2 else 1
  let T := (Finset.range 1649376).filter Nat.Prime
  obtain ⟨L,_,_,_,_,σ,u,hu,hs,⟨m,hm,hit⟩,roots⟩ := d7.jO
    (fun i : T => i.val) (fun i => (Finset.mem_filter.mp i.property).2) Subtype.val_injective (fun i => w i.val)
  have jA (q : ℕ) (hq : q.Prime) (h : q≤1649375) :
      ∃ r : 𝓞 L, r^7=q ∧ σ r=r*u^(w q) :=
    roots ⟨q,Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega),hq⟩⟩
  obtain ⟨r0,r5,rs⟩ := jA 2 (by decide) (by decide)
  have rne : r0≠0 := by intro he; rw [he] at r5; norm_num at r5
  have w2 : w 2=1 := by decide
  rw [w2,pow_one] at rs
  have moved : σ r0≠r0 := by
    intro he
    have u1 : u=1 := mul_left_cancel₀ rne (rs.symm.trans (he.trans (mul_one r0).symm))
    rw [u1] at hu
    norm_num at hu
  obtain ⟨p,hpB,hp,F,_,_,φ,fixed,moves⟩ := dQ.main dG.compare gX.maximal L σ r0 moved (max (max B 1649375) (m*m))
  letI : Fact p.Prime := ⟨hp⟩
  obtain ⟨t,hF⟩ := gY.orbit σ m p hm hit (by omega) hp F φ fixed
  let j := ZMod.castHom (m := p) dvd_rfl F
  obtain ⟨z,hz⟩ := descend (φ u) (fixed u hs)
  change j z=φ u at hz
  have eqz : z^6+z^5+z^4+z^3+z^2+z+1=0 := j.injective (by simpa only [map_add,map_pow,map_one,map_zero,hz] using congrArg φ hu)
  have z5 : z^7=1 := by linear_combination (z-1)*eqz
  have wt : z^t≠1 := by
    intro he
    apply moves
    rw [hF,f9 σ u hs r0 1 (by simpa using rs) t,pow_one,map_mul,map_pow,←hz,←map_pow,he,map_one,mul_one]
  have zt5 : (z^t)^7=1 := by rw [←pow_mul,Nat.mul_comm,pow_mul,z5,one_pow]
  have prim : IsPrimitiveRoot (z^t) 7 := isPrimitiveRoot_of_mem_nthRootsFinset (by decide)
    ((Polynomial.mem_nthRootsFinset (by decide : 0<7) 1).mpr zt5) wt
  have zne : z^t ≠ 0 := by intro he; simp [he] at zt5
  have pd := prim.dvd_of_pow_eq_one (p-1) (ZMod.pow_card_sub_one_eq_one zne)
  refine ⟨p,by omega,hp,pd,z^t,prim,fun q hq hM => ?_⟩
  obtain ⟨r,rc,rσ⟩ := jA q hq hM
  have ec : (φ r)^7 = (q : F) := by simpa only [map_pow,map_natCast] using congrArg φ rc
  have en : (q : ZMod p) ≠ 0 := by
    intro he
    have := Nat.le_of_dvd hq.pos ((ZMod.natCast_eq_zero_iff _ _).mp he)
    omega
  have nz : φ r ≠ 0 := by
    intro er
    apply en
    apply j.injective
    simpa [er] using ec.symm
  have ep : (φ r)^(p-1) = ((φ u)^t)^(w q) := by
    apply mul_left_cancel₀ nz
    calc
      φ r*(φ r)^(p-1) = (φ r)^p := by rw [←pow_succ',Nat.sub_add_cancel hp.pos]
      _ = φ ((σ : 𝓞 L → 𝓞 L)^[t] r) := hF r
      _ = _ := by rw [f9 σ u hs r (w q) rσ t,map_mul,map_pow,map_pow]
  apply j.injective
  simp only [map_pow,map_natCast,hz,← ec,← pow_mul,Nat.mul_div_cancel' pd,ep]
  rfl
end OMA.L3
namespace OMA.L4
theorem solve : OMA.R3.H2 := by
  intro p hp h7 a ha
  haveI : Fact p.Prime := ⟨hp⟩
  obtain ⟨m, hm⟩ := h7
  have hm0 : 0 < m := by
    have h2 := hp.two_le
    rcases Nat.eq_zero_or_pos m with h | h
    · rw [h] at hm
      omega
    · exact h
  have hdiv : (p - 1) / 7 = m := by
    rw [hm]
    exact Nat.mul_div_cancel_left m (by norm_num)
  rw [hdiv]
  constructor
  · rintro ⟨x, rfl⟩
    have hx : x ≠ 0 := by
      rintro rfl
      simp at ha
    rw [← pow_mul, ← hm]
    exact ZMod.pow_card_sub_one_eq_one hx
  · intro h
    obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := (ZMod p)ˣ)
    have hord : orderOf g = p - 1 := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hg, Nat.card_eq_fintype_card, ZMod.card_units]
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hg (Units.mk0 a ha))
    have hu1 : (Units.mk0 a ha) ^ m = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_mk0, h, Units.val_one]
    have h2 : g ^ (k * (m : ℤ)) = 1 := by
      rw [zpow_mul, hk, zpow_natCast, hu1]
    have h3 : ((orderOf g : ℕ) : ℤ) ∣ k * m := orderOf_dvd_iff_zpow_eq_one.2 h2
    rw [hord, hm] at h3
    push_cast at h3
    have hmz : (m : ℤ) ≠ 0 := by exact_mod_cast hm0.ne'
    have h4 : (7 : ℤ) ∣ k := (mul_dvd_mul_iff_right hmz).1 h3
    obtain ⟨j, rfl⟩ := h4
    refine ⟨((g ^ j : (ZMod p)ˣ) : ZMod p), ?_⟩
    have h5 : (g ^ j) ^ 7 = Units.mk0 a ha := by
      rw [← hk, ← zpow_natCast (g ^ j) 7, ← zpow_mul]
      congr 1
      push_cast
      ring
    have h6 := congrArg (fun v : (ZMod p)ˣ => (v : ZMod p)) h5
    simpa using h6
end OMA.L4
theorem OMA.solution : type_of% @Erdos436.erdos_436.variants.seven_two :=
  OMA.R1.main OMA.L1.solve OMA.L2.solve
    (OMA.R3.main OMA.L3.solve OMA.L4.solve)
