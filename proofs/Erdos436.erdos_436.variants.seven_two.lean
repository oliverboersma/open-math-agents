lemma prescribe {I F E : Type} [Fintype I] [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] (z : F) (hz : IsPrimitiveRoot z 7)
    (b : I → F) (r : I → E) (hr : ∀ i, (r i)^7 = algebraMap F E (b i)) (hne : ∀ i, r i ≠ 0)
    (hind : ∀ (a : I → ZMod 7) (x : F), x^7 = ∏ i, (b i)^(a i).val → a=0)
    (v : I → ZMod 7) : ∃ σ : E ≃ₐ[F] E, ∀ i, σ (r i) = r i * (algebraMap F E z)^(v i).val := by
  classical
  letI : Fact (Nat.Prime 7) := ⟨by decide⟩
  let u := algebraMap F E z
  have hu : IsPrimitiveRoot u 7 := hz.map_of_injective (algebraMap F E).injective
  have fixed (σ : E ≃ₐ[F] E) : σ u = u := σ.commutes z
  let S : AddSubmonoid (I → ZMod 7) := {
    carrier := {a | ∃ σ : E ≃ₐ[F] E, ∀ i, σ (r i) = r i * u^(a i).val}
    zero_mem' := ⟨AlgEquiv.refl,fun i => by simp⟩
    add_mem' := by
      rintro a b ⟨σ,hσ⟩ ⟨τ,hτ⟩
      refine ⟨τ.trans σ,fun i => ?_⟩
      simp only [AlgEquiv.trans_apply,hτ,map_mul,map_pow,hσ,fixed,Pi.add_apply,ZMod.val_add]
      have cyc (n : ℕ) : u^(n%7) = u^n := hu.eq_orderOf ▸ pow_mod_orderOf u n
      rw [cyc,pow_add,mul_assoc] }
  let W : Submodule (ZMod 7) (I → ZMod 7) := {
    S with
    smul_mem' := fun c a ha => by
      change c • a ∈ S
      have h := S.nsmul_mem ha c.val
      simpa only [← Nat.cast_smul_eq_nsmul (ZMod 7),ZMod.natCast_zmod_val] using h }
  suffices W = ⊤ from (show v ∈ W by rw [this]; trivial)
  by_contra lH
  obtain ⟨g,hg,hker⟩ := W.exists_le_ker_of_lt_top (lt_top_iff_ne_top.mpr lH)
  let a (i : I) := g (Pi.single i 1)
  have repr (t : I → ZMod 7) : g t = ∑ i, t i * a i := by
    have eqv : t = ∑ i, t i • Pi.single i (1 : ZMod 7) := by
      funext j
      simp [Finset.sum_apply,Pi.single_apply,ite_mul,mul_ite]
    conv_lhs => rw [eqv]
    simp [a]
  let w := ∏ i, (r i)^(a i).val
  have tZ (σ : E ≃ₐ[F] E) : σ w = w := by
    have character (i : I) : ∃ c : ZMod 7, σ (r i) = r i*u^c.val := by
      have root : (σ (r i)/r i)^7 = 1 := by
        rw [div_pow,← map_pow,hr,σ.commutes,div_self]
        exact (hr i ▸ pow_ne_zero 7 (hne i))
      obtain ⟨k,hk,he⟩ := hu.eq_pow_of_pow_eq_one root
      refine ⟨k,?_⟩
      rw [ZMod.val_natCast,Nat.mod_eq_of_lt hk]
      exact (div_eq_iff (hne i)).mp he.symm |>.trans (mul_comm ..)
    choose c hc using character
    have hcW : c ∈ W := ⟨σ,hc⟩
    have eqz : ∑ i, c i * a i = 0 := (repr c).symm.trans (hker hcW)
    have hd : 7 ∣ ∑ i, (c i).val * (a i).val := (ZMod.natCast_eq_zero_iff ..).mp (by simpa using eqz)
    change σ (∏ i, (r i)^(a i).val) = _
    simp only [map_prod,map_pow,hc,mul_pow,Finset.prod_mul_distrib,← pow_mul,Finset.prod_pow_eq_pow_sum]
    rw [hu.pow_eq_one_iff_dvd _ |>.mpr hd,mul_one]
  obtain ⟨x,hx⟩ := (IsGalois.mem_range_algebraMap_iff_fixed w).mpr tZ
  have hx3 : x^7 = ∏ i, b i ^ (a i).val := (algebraMap F E).injective (by
    rw [map_pow,hx,map_prod]
    change (∏ i, (r i)^(a i).val)^7 = _
    rw [← Finset.prod_pow]
    apply Finset.prod_congr rfl
    intro i _
    rw [← pow_mul,Nat.mul_comm,pow_mul,hr,map_pow])
  have zero := hind a x hx3
  apply hg
  apply LinearMap.ext
  intro t
  simp [repr t,zero]
end d7
