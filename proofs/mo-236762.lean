import OMAStatements.S_mo_236762
import Mathlib

/-!
# MathOverflow 236762: the flip on the quadratic part of the Cuntz algebra does not extend

Let `S i` be isometries with `star (S i) * S j = δ i j` generating a nonzero C*-algebra `A`
(a copy of the Cuntz algebra with infinitely many generators). We prove that there is no family
`T i` in `A` with `star (T i) * T j = δ i j` and `T i * T j = S j * S i`. Consequently no unital
star-homomorphism `φ` of `A` (in particular no automorphism) satisfies
`φ (S i * S j) = S j * S i`, so the flip does not extend.

Proof idea (the vacuum compression). For every `x` in the star-algebra generated by the `S i`
the compressions `star (S j) * x * S j` are, for all large `j`, equal to one fixed scalar.
Put `Q = T 0 * star (T 0)` and `x j = star (S j) * Q * S j`. The relations give
`x j * S 0 = S 0` and `x j * S 1 = 0` for every `j`. Approximating `Q` within `1/3` by an
element `w` of the generated star-algebra, `x j` is within `1/3` of a scalar `c` for large `j`,
which forces both `‖1 - c‖ < 1/3` and `‖c‖ < 1/3`, a contradiction.
-/

namespace OMA.P_mo_236762
open OMA.S_mo_236762

/-- The product `S i₁ * S i₂ * ... * S iₙ` attached to a list of indices. -/
noncomputable def word {A : Type*} [CStarAlgebra A] (S : ℕ → A) : List ℕ → A
  | [] => 1
  | i :: l => S i * word S l

theorem word_append {A : Type*} [CStarAlgebra A] (S : ℕ → A) (a b : List ℕ) : word S (a ++ b) = word S a * word S b := by
  induction a with
  | nil => simp [word]
  | cons i l ih => simp [word, ih, mul_assoc]

/-- The linear span of all `word μ * star (word ν)`. -/
noncomputable def wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A) : Submodule ℂ A :=
  Submodule.span ℂ (Set.range fun p : List ℕ × List ℕ => word S p.1 * star (word S p.2))

theorem word_mul_star_word_mem {A : Type*} [CStarAlgebra A] (S : ℕ → A) (μ ν : List ℕ) :
    word S μ * star (word S ν) ∈ wordSpan S :=
  Submodule.subset_span ⟨(μ, ν), rfl⟩

theorem one_mem_wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A) : (1 : A) ∈ wordSpan S := by
  have h := word_mul_star_word_mem S [] []
  simpa [word] using h

/-- Left multiplication by a generator preserves the word span. -/
theorem gen_mul_mem_wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A) (i : ℕ) {w : A} (hw : w ∈ wordSpan S) :
    S i * w ∈ wordSpan S := by
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨μ, ν⟩, rfl⟩ := hx
    show S i * (word S μ * star (word S ν)) ∈ wordSpan S
    rw [← mul_assoc]
    exact word_mul_star_word_mem S (i :: μ) ν
  | zero => simp
  | add x y _ _ ihx ihy => rw [mul_add]; exact add_mem ihx ihy
  | smul a x _ ih => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ih

/-- Left multiplication by the adjoint of a generator preserves the word span. -/
theorem star_gen_mul_mem_wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A)
    (hS : ∀ i j, star (S i) * S j = if i = j then 1 else 0) (i : ℕ) {w : A}
    (hw : w ∈ wordSpan S) : star (S i) * w ∈ wordSpan S := by
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨μ, ν⟩, rfl⟩ := hx
    show star (S i) * (word S μ * star (word S ν)) ∈ wordSpan S
    cases μ with
    | nil =>
      have h : star (S i) * (word S [] * star (word S ν)) =
          word S [] * star (word S (ν ++ [i])) := by
        simp [word, word_append]
      rw [h]
      exact word_mul_star_word_mem S _ _
    | cons k μ' =>
      have h : star (S i) * (word S (k :: μ') * star (word S ν)) =
          if i = k then word S μ' * star (word S ν) else 0 := by
        show star (S i) * (S k * word S μ' * star (word S ν)) = _
        rw [← mul_assoc, ← mul_assoc, hS]
        split_ifs <;> simp
      rw [h]
      split_ifs
      · exact word_mul_star_word_mem S _ _
      · exact zero_mem _
  | zero => simp
  | add x y _ _ ihx ihy => rw [mul_add]; exact add_mem ihx ihy
  | smul a x _ ih => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ih

/-- The star-algebra generated by the `S i` lies in the word span. -/
theorem adjoin_le_wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A)
    (hS : ∀ i j, star (S i) * S j = if i = j then 1 else 0) {x : A}
    (hx : x ∈ StarAlgebra.adjoin ℂ (Set.range S)) : x ∈ wordSpan S := by
  have key : ∀ w ∈ wordSpan S, x * w ∈ wordSpan S := by
    rw [← StarSubalgebra.mem_toSubalgebra, StarAlgebra.adjoin_toSubalgebra] at hx
    induction hx using Algebra.adjoin_induction with
    | mem y hy =>
      intro w hw
      rcases hy with ⟨i, rfl⟩ | hy
      · exact gen_mul_mem_wordSpan S i hw
      · obtain ⟨i, hi⟩ := Set.mem_star.mp hy
        have hy' : y = star (S i) := by rw [hi, star_star]
        rw [hy']
        exact star_gen_mul_mem_wordSpan S hS i hw
    | algebraMap r =>
      intro w hw
      rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
      exact Submodule.smul_mem _ _ hw
    | add a b _ _ iha ihb =>
      intro w hw
      rw [add_mul]
      exact add_mem (iha w hw) (ihb w hw)
    | mul a b _ _ iha ihb =>
      intro w hw
      rw [mul_assoc]
      exact iha _ (ihb w hw)
  simpa using key 1 (one_mem_wordSpan S)

/-- The vacuum compression: on the word span, `star (S j) * w * S j` is eventually one scalar. -/
theorem compress_wordSpan {A : Type*} [CStarAlgebra A] (S : ℕ → A)
    (hS : ∀ i j, star (S i) * S j = if i = j then 1 else 0) {w : A} (hw : w ∈ wordSpan S) :
    ∃ (c : ℂ) (N : ℕ), ∀ j, N ≤ j → star (S j) * w * S j = c • (1 : A) := by
  induction hw using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨μ, ν⟩, rfl⟩ := hx
    show ∃ (c : ℂ) (N : ℕ), ∀ j, N ≤ j →
      star (S j) * (word S μ * star (word S ν)) * S j = c • (1 : A)
    cases μ with
    | nil =>
      cases ν with
      | nil => exact ⟨1, 0, fun j _ => by simp [word, hS]⟩
      | cons k ν' =>
        refine ⟨0, k + 1, fun j hj => ?_⟩
        have hkj : k ≠ j := by omega
        have h0 : star (S k) * S j = 0 := by rw [hS, if_neg hkj]
        simp [word, mul_assoc, h0]
    | cons k μ' =>
      refine ⟨0, k + 1, fun j hj => ?_⟩
      have hjk : j ≠ k := by omega
      have h0 : star (S j) * S k = 0 := by rw [hS, if_neg hjk]
      show star (S j) * (S k * word S μ' * star (word S ν)) * S j = (0 : ℂ) • (1 : A)
      rw [← mul_assoc, ← mul_assoc, h0]
      simp
  | zero => exact ⟨0, 0, fun j _ => by simp⟩
  | add x y _ _ ihx ihy =>
    obtain ⟨c, N, h⟩ := ihx
    obtain ⟨d, M, h'⟩ := ihy
    exact ⟨c + d, max N M, fun j hj => by
      rw [mul_add, add_mul, h j (le_trans (le_max_left _ _) hj),
        h' j (le_trans (le_max_right _ _) hj), add_smul]⟩
  | smul a x _ ih =>
    obtain ⟨c, N, h⟩ := ih
    exact ⟨a * c, N, fun j hj => by rw [mul_smul_comm, smul_mul_assoc, h j hj, smul_smul]⟩

/-- Each generator has norm one (in a nonzero algebra). -/
theorem norm_gen {A : Type*} [CStarAlgebra A] [Nontrivial A] (S : ℕ → A)
    (hS : ∀ i j, star (S i) * S j = if i = j then 1 else 0) (i : ℕ) : ‖S i‖ = 1 := by
  have h := CStarRing.norm_star_mul_self (x := S i)
  rw [hS, if_pos rfl, CStarRing.norm_one] at h
  rcases mul_self_eq_one_iff.mp h.symm with h1 | h1
  · exact h1
  · linarith [norm_nonneg (S i)]

/-- The algebraic heart: with `Q = T 0 * star (T 0)`, the compression `star (S n) * Q * S n`
fixes `S 0` and kills `S m` for `m ≠ 0`. This holds in any star ring. -/
theorem flip_compress {R : Type*} [Semiring R] [StarRing R] (S T : ℕ → R)
    (hS : ∀ i j, star (S i) * S j = if i = j then 1 else 0)
    (hT : ∀ i j, star (T i) * T j = if i = j then 1 else 0)
    (hTS : ∀ i j, T i * T j = S j * S i) (n m : ℕ) :
    star (S n) * (T 0 * star (T 0)) * S n * S m = if m = 0 then S 0 else 0 := by
  have h1 : star (S n) * (T 0 * star (T 0)) * S n * S m =
      star (S n) * T 0 * (star (T 0) * T m) * T n := by
    have h := hTS m n
    simp only [mul_assoc]
    rw [← h]
  rw [h1, hT]
  by_cases hm : m = 0
  · subst hm
    rw [if_pos rfl, if_pos rfl, mul_one, mul_assoc, hTS, ← mul_assoc, hS, if_pos rfl, one_mul]
  · rw [if_neg (Ne.symm hm), if_neg hm, mul_zero, zero_mul]

/-- **No flipped family.** In a nonzero C*-algebra generated by a Cuntz family `S`, there is no
family `T` of isometries with orthogonal ranges such that `T i * T j = S j * S i`. -/
theorem no_flip_family {A : Type*} [CStarAlgebra A] [Nontrivial A] (S : ℕ → A) (hS : IsCuntzInfinityFamily S) (T : ℕ → A)
    (hT : ∀ i j, star (T i) * T j = if i = j then 1 else 0)
    (hTS : ∀ i j, T i * T j = S j * S i) : False := by
  obtain ⟨hrel, hgen⟩ := hS
  have hQmem : T 0 * star (T 0) ∈
      closure ((StarAlgebra.adjoin ℂ (Set.range S) : StarSubalgebra ℂ A) : Set A) := by
    rw [← StarSubalgebra.topologicalClosure_coe, hgen]
    simp
  obtain ⟨w, hwadj, hwd⟩ := Metric.mem_closure_iff.mp hQmem (1 / 3) (by norm_num)
  have hw := adjoin_le_wordSpan S hrel hwadj
  obtain ⟨c, N, hc⟩ := compress_wordSpan S hrel hw
  have hcN := hc N le_rfl
  have key0 : star (S N) * (T 0 * star (T 0)) * S N * S 0 = S 0 := by
    rw [flip_compress S T hrel hT hTS, if_pos rfl]
  have key1 : star (S N) * (T 0 * star (T 0)) * S N * S 1 = 0 := by
    rw [flip_compress S T hrel hT hTS, if_neg one_ne_zero]
  have hS1 : ∀ i, ‖S i‖ = 1 := norm_gen S hrel
  have hd : ‖star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A)‖ < 1 / 3 := by
    have e : star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A) =
        star (S N) * (T 0 * star (T 0) - w) * S N := by
      rw [← hcN, mul_sub, sub_mul]
    rw [e]
    calc ‖star (S N) * (T 0 * star (T 0) - w) * S N‖
        ≤ ‖star (S N) * (T 0 * star (T 0) - w)‖ * ‖S N‖ := norm_mul_le _ _
      _ ≤ ‖star (S N)‖ * ‖T 0 * star (T 0) - w‖ * ‖S N‖ := by
          gcongr
          exact norm_mul_le _ _
      _ = ‖T 0 * star (T 0) - w‖ := by rw [norm_star, hS1]; ring
      _ < 1 / 3 := by rwa [← dist_eq_norm]
  have h0 : ‖(1 : ℂ) - c‖ < 1 / 3 := by
    have e : (star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A)) * S 0 = (1 - c) • S 0 := by
      rw [sub_mul, key0, smul_mul_assoc, one_mul, sub_smul, one_smul]
    have h := norm_mul_le (star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A)) (S 0)
    rw [e, norm_smul, hS1, mul_one, mul_one] at h
    linarith
  have h1 : ‖c‖ < 1 / 3 := by
    have e : (star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A)) * S 1 = (-c) • S 1 := by
      rw [sub_mul, key1, smul_mul_assoc, one_mul, zero_sub, neg_smul]
    have h := norm_mul_le (star (S N) * (T 0 * star (T 0)) * S N - c • (1 : A)) (S 1)
    rw [e, norm_smul, norm_neg, hS1, mul_one, mul_one] at h
    linarith
  have h2 : ‖(1 : ℂ)‖ ≤ ‖(1 : ℂ) - c‖ + ‖c‖ := by
    simpa using norm_add_le ((1 : ℂ) - c) c
  rw [norm_one] at h2
  linarith

/-- **The flip does not extend.** No unital star-homomorphism of a nonzero C*-algebra generated by
a Cuntz family `S` sends `S i * S j` to `S j * S i` for all `i`, `j`. -/
theorem no_flip_hom {A : Type*} [CStarAlgebra A] [Nontrivial A] (S : ℕ → A) (hS : IsCuntzInfinityFamily S)
    {F : Type*} [FunLike F A A] [RingHomClass F A A] [StarHomClass F A A] (φ : F)
    (hφ : ∀ i j, φ (S i * S j) = S j * S i) : False := by
  refine no_flip_family S hS (fun i => φ (S i)) (fun i j => ?_) (fun i j => ?_)
  · show star (φ (S i)) * φ (S j) = _
    rw [← map_star, ← map_mul, hS.1 i j]
    split_ifs <;> simp
  · show φ (S i) * φ (S j) = _
    rw [← map_mul, hφ]

/-- **Bridge to the stated question.** Any nonzero model of the Cuntz relations in which the flip
exists as a linear self-equivalence of the quadratic space (preserving the inner product) refutes
the YES answer `main`. -/
theorem not_main_of_model (A : Type) [CStarAlgebra A] [Nontrivial A] (S : ℕ → A)
    (hS : IsCuntzInfinityFamily S) (σ : quadSpace S →L[ℂ] quadSpace S)
    (hσ : ∀ (x : quadSpace S) (i j : ℕ), (x : A) = S i * S j → (σ x : A) = S j * S i)
    (U : quadSpace S ≃ₗ[ℂ] quadSpace S) (hUσ : ∀ x, U x = σ x)
    (hU : ∀ u v : quadSpace S, star (U v : A) * (U u : A) = star (v : A) * (u : A)) :
    ¬ (type_of% @OMA.S_mo_236762.main) := by
  intro h
  obtain ⟨φ, hφ⟩ := h A S hS U hU σ hσ (fun x => by rw [hUσ, hUσ])
  refine no_flip_hom S hS φ (fun i j => ?_)
  have hmem : S i * S j ∈ quadSpace S :=
    Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨(i, j), rfl⟩)
  have h3 := hφ ⟨S i * S j, hmem⟩
  rw [hUσ, hσ ⟨S i * S j, hmem⟩ i j rfl] at h3
  exact h3

end OMA.P_mo_236762


/-!
# MathOverflow 236762: a concrete model, and the negative answer

We build a concrete nonzero C*-algebra generated by a Cuntz family: the closed star-subalgebra of
the bounded operators on `ℓ²(ℕ)` generated by the isometries `gen i` sending the basis vector
`e n` to `e (Nat.pair i n)`. The flip `S i * S j ↦ S j * S i` on the quadratic space is realised
as left multiplication by a permutation unitary `flipOp` (which swaps the first two digits of the
index). Feeding this model to `not_main_of_model` refutes the YES answer of the question.
-/

namespace OMA.P_mo_236762
open OMA.S_mo_236762

/-- The Hilbert space `ℓ²(ℕ)`. -/
abbrev Hil : Type := lp (fun _ : ℕ => ℂ) 2

/-- The standard basis vectors of `ℓ²(ℕ)`. -/
noncomputable def basisVec (n : ℕ) : Hil := lp.single 2 n (1 : ℂ)

theorem basisVec_orthonormal : Orthonormal ℂ basisVec := by
  rw [orthonormal_iff_ite]
  intro i j
  unfold basisVec
  rw [lp.inner_single_left]
  by_cases h : i = j
  · subst h
    simp
  · rw [if_neg h, lp.single_apply_ne (E := fun _ : ℕ => ℂ) 2 j (1 : ℂ) h]
    simp

/-- Continuous linear maps out of `ℓ²(ℕ)` are determined by their values on basis vectors. -/
theorem hil_ext {F : Type*} [NormedAddCommGroup F] [NormedSpace ℂ F] {f g : Hil →L[ℂ] F}
    (h : ∀ n, f (basisVec n) = g (basisVec n)) : f = g := by
  refine lp.ext_continuousLinearMap (by norm_num) (fun i => ?_)
  ext
  simpa [basisVec] using h i

/-- The isometry of `ℓ²(ℕ)` induced by an injective map of the index set. -/
noncomputable def shiftOp (g : ℕ → ℕ) (hg : Function.Injective g) : Hil →L[ℂ] Hil :=
  ((basisVec_orthonormal.comp g hg).orthogonalFamily.linearIsometry).toContinuousLinearMap

theorem shiftOp_basisVec (g : ℕ → ℕ) (hg : Function.Injective g) (n : ℕ) :
    shiftOp g hg (basisVec n) = basisVec (g n) := by
  simp [shiftOp, basisVec, LinearIsometry.toSpanSingleton_apply]

theorem norm_shiftOp_apply (g : ℕ → ℕ) (hg : Function.Injective g) (x : Hil) :
    ‖shiftOp g hg x‖ = ‖x‖ :=
  LinearIsometry.norm_map _ x

theorem star_shiftOp_mul_self (g : ℕ → ℕ) (hg : Function.Injective g) :
    star (shiftOp g hg) * shiftOp g hg = 1 := by
  rw [ContinuousLinearMap.star_eq_adjoint]
  exact (ContinuousLinearMap.norm_map_iff_adjoint_comp_self _).mp (norm_shiftOp_apply g hg)

theorem inner_basisVec_shiftOp (g : ℕ → ℕ) (hg : Function.Injective g) (k : ℕ)
    (hk : ∀ n, g n ≠ k) (y : Hil) : inner ℂ (basisVec k) (shiftOp g hg y) = 0 := by
  have h : (innerSL ℂ (basisVec k)).comp (shiftOp g hg) = 0 := by
    refine hil_ext (fun n => ?_)
    have h1 := (orthonormal_iff_ite.mp basisVec_orthonormal) k (g n)
    rw [if_neg (Ne.symm (hk n))] at h1
    simpa [shiftOp_basisVec] using h1
  have h2 := DFunLike.congr_fun h y
  simpa using h2

theorem star_shiftOp_mul_of_disjoint (g h : ℕ → ℕ) (hg : Function.Injective g)
    (hh : Function.Injective h) (hgh : ∀ n m, g n ≠ h m) :
    star (shiftOp g hg) * shiftOp h hh = 0 := by
  refine hil_ext (fun m => ?_)
  rw [ContinuousLinearMap.star_eq_adjoint]
  refine ext_inner_right ℂ (fun y => ?_)
  have h3 := inner_basisVec_shiftOp g hg (h m) (fun n => hgh n m) y
  simpa [ContinuousLinearMap.adjoint_inner_left, shiftOp_basisVec] using h3

theorem pair_injective (i : ℕ) : Function.Injective (Nat.pair i) := by
  intro a b hab
  exact (Nat.pair_eq_pair.mp hab).2

/-- The index map swapping the first two digits: `pair i (pair j n) ↦ pair j (pair i n)`. -/
def flipIdx (m : ℕ) : ℕ :=
  Nat.pair (Nat.unpair (Nat.unpair m).2).1 (Nat.pair (Nat.unpair m).1 (Nat.unpair (Nat.unpair m).2).2)

theorem flipIdx_pair (i j n : ℕ) : flipIdx (Nat.pair i (Nat.pair j n)) = Nat.pair j (Nat.pair i n) := by
  simp [flipIdx]

theorem flipIdx_involutive : Function.Involutive flipIdx := by
  intro m
  simp [flipIdx]

/-- The bounded operators on `ℓ²(ℕ)`. -/
abbrev Bop : Type := Hil →L[ℂ] Hil

/-- The generating isometries: `gen i` sends `e n` to `e (pair i n)`. -/
noncomputable def gen (i : ℕ) : Bop := shiftOp (Nat.pair i) (pair_injective i)

/-- The permutation unitary implementing the flip. -/
noncomputable def flipOp : Bop := shiftOp flipIdx flipIdx_involutive.injective

theorem star_gen_mul_gen (i j : ℕ) : star (gen i) * gen j = if i = j then 1 else 0 := by
  by_cases h : i = j
  · subst h
    rw [if_pos rfl]
    exact star_shiftOp_mul_self _ _
  · rw [if_neg h]
    refine star_shiftOp_mul_of_disjoint _ _ _ _ (fun n m hnm => ?_)
    exact h (Nat.pair_eq_pair.mp hnm).1

theorem star_flipOp_mul_flipOp : star flipOp * flipOp = 1 := star_shiftOp_mul_self _ _

theorem flipOp_mul_flipOp : flipOp * flipOp = 1 := by
  refine hil_ext (fun n => ?_)
  simp [flipOp, shiftOp_basisVec, flipIdx_involutive n]

theorem flipOp_mul_gen_mul_gen (i j : ℕ) : flipOp * (gen i * gen j) = gen j * gen i := by
  refine hil_ext (fun n => ?_)
  simp [flipOp, gen, shiftOp_basisVec, flipIdx_pair]

theorem bop_one_ne_zero : (1 : Bop) ≠ 0 := by
  intro h
  have h1 : basisVec 0 = 0 := by simpa using DFunLike.congr_fun h (basisVec 0)
  have h2 := basisVec_orthonormal.1 0
  rw [h1, norm_zero] at h2
  exact zero_ne_one h2

/-- The closed star-subalgebra of operators generated by the `gen i`: our model of the algebra. -/
noncomputable def cuntzSub : StarSubalgebra ℂ Bop :=
  (StarAlgebra.adjoin ℂ (Set.range gen)).topologicalClosure

instance cuntzSub_isClosed : IsClosed (cuntzSub : Set Bop) :=
  StarSubalgebra.isClosed_topologicalClosure _

theorem gen_mem (i : ℕ) : gen i ∈ cuntzSub :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨i, rfl⟩)

/-- The generators, viewed inside the model algebra. -/
noncomputable def genA (i : ℕ) : cuntzSub := ⟨gen i, gen_mem i⟩

instance cuntzSub_nontrivial : Nontrivial cuntzSub :=
  ⟨⟨1, 0, fun h => bop_one_ne_zero (by simpa using congrArg Subtype.val h)⟩⟩

theorem genA_rel (i j : ℕ) : star (genA i) * genA j = if i = j then 1 else 0 := by
  apply Subtype.ext
  have h := star_gen_mul_gen i j
  by_cases hij : i = j
  · rw [if_pos hij] at h ⊢
    exact h
  · rw [if_neg hij] at h ⊢
    exact h

theorem genA_generates : (StarAlgebra.adjoin ℂ (Set.range genA)).topologicalClosure = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have himg : (Subtype.val '' ((StarAlgebra.adjoin ℂ (Set.range genA) :
      StarSubalgebra ℂ cuntzSub) : Set cuntzSub)) =
      ((StarAlgebra.adjoin ℂ (Set.range gen) : StarSubalgebra ℂ Bop) : Set Bop) := by
    have h := StarAlgHom.map_adjoin (StarSubalgebra.subtype cuntzSub) (Set.range genA)
    have h2 : (StarSubalgebra.subtype cuntzSub) '' Set.range genA = Set.range gen := by
      rw [← Set.range_comp]
      rfl
    rw [h2] at h
    rw [← h]
    rfl
  have hx : (x : Bop) ∈ closure ((StarAlgebra.adjoin ℂ (Set.range gen) :
      StarSubalgebra ℂ Bop) : Set Bop) := x.2
  rw [← himg] at hx
  have hx2 : x ∈ closure ((StarAlgebra.adjoin ℂ (Set.range genA) :
      StarSubalgebra ℂ cuntzSub) : Set cuntzSub) := by
    rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
    exact hx
  exact hx2

theorem genA_isCuntz : IsCuntzInfinityFamily genA := ⟨genA_rel, genA_generates⟩

/-- The closed span of the products `gen i * gen j` inside the bounded operators. -/
noncomputable def quadB : Submodule ℂ Bop :=
  (Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2)).topologicalClosure

theorem flipOp_mul_mem_span {z : Bop}
    (hz : z ∈ Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2)) :
    flipOp * z ∈ Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2) := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨⟨i, j⟩, rfl⟩ := hx
    exact Submodule.subset_span ⟨(j, i), (flipOp_mul_gen_mul_gen i j).symm⟩
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | smul c x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hx

theorem flipOp_mul_mem_quadB {y : Bop} (hy : y ∈ quadB) : flipOp * y ∈ quadB := by
  have hc : Continuous fun z : Bop => flipOp * z := continuous_const.mul continuous_id
  have hy' : y ∈ closure ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2) :
      Submodule ℂ Bop) : Set Bop) := hy
  exact map_mem_closure hc hy' (fun z hz => flipOp_mul_mem_span hz)

theorem quadB_le {y : Bop} (hy : y ∈ quadB) : y ∈ cuntzSub := by
  have h : quadB ≤ cuntzSub.toSubalgebra.toSubmodule := by
    refine Submodule.topologicalClosure_minimal _ ?_ cuntzSub_isClosed
    rw [Submodule.span_le]
    rintro _ ⟨⟨i, j⟩, rfl⟩
    show gen i * gen j ∈ cuntzSub
    exact mul_mem (gen_mem i) (gen_mem j)
  exact h hy

theorem mem_quadSpace_iff (a : cuntzSub) : a ∈ quadSpace genA ↔ (a : Bop) ∈ quadB := by
  have himg : Subtype.val '' ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2) :
      Submodule ℂ cuntzSub) : Set cuntzSub) =
      ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2) :
        Submodule ℂ Bop) : Set Bop) := by
    have h := Submodule.map_span (cuntzSub.subtype.toAlgHom.toLinearMap)
      (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2)
    have h2 : (cuntzSub.subtype.toAlgHom.toLinearMap) ''
        (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2) =
        Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2 := by
      rw [← Set.range_comp]
      rfl
    rw [h2] at h
    rw [← h]
    rfl
  have key : closure ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2) :
      Submodule ℂ cuntzSub) : Set cuntzSub) = Subtype.val ⁻¹' closure
      ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => gen p.1 * gen p.2) :
        Submodule ℂ Bop) : Set Bop) := by
    rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
    exact congrArg (fun s : Set Bop => (Subtype.val : cuntzSub → Bop) ⁻¹' closure s) himg
  constructor
  · intro h
    have h' : a ∈ closure ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2) :
        Submodule ℂ cuntzSub) : Set cuntzSub) := h
    rw [key] at h'
    exact h'
  · intro h
    have h' : a ∈ closure ((Submodule.span ℂ (Set.range fun p : ℕ × ℕ => genA p.1 * genA p.2) :
        Submodule ℂ cuntzSub) : Set cuntzSub) := by
      rw [key]
      exact h
    exact h'

/-- The flip on the quadratic space of the model: left multiplication by `flipOp`. -/
noncomputable def sigmaLin : quadSpace genA →ₗ[ℂ] quadSpace genA where
  toFun x := ⟨⟨flipOp * ((x : cuntzSub) : Bop),
      quadB_le (flipOp_mul_mem_quadB ((mem_quadSpace_iff _).mp x.2))⟩,
    (mem_quadSpace_iff _).mpr (flipOp_mul_mem_quadB ((mem_quadSpace_iff _).mp x.2))⟩
  map_add' x y := by
    apply Subtype.ext
    apply Subtype.ext
    simp [mul_add]
  map_smul' c x := by
    apply Subtype.ext
    apply Subtype.ext
    simp

theorem sigmaLin_involutive : Function.Involutive sigmaLin := by
  intro x
  apply Subtype.ext
  apply Subtype.ext
  show flipOp * (flipOp * ((x : cuntzSub) : Bop)) = _
  rw [← mul_assoc, flipOp_mul_flipOp, one_mul]

/-- The flip as a continuous linear map. -/
noncomputable def sigmaCLM : quadSpace genA →L[ℂ] quadSpace genA :=
  ⟨sigmaLin, by
    rw [Topology.IsInducing.subtypeVal.continuous_iff,
      Topology.IsInducing.subtypeVal.continuous_iff]
    exact continuous_const.mul (continuous_subtype_val.comp continuous_subtype_val)⟩

/-- The flip as a linear self-equivalence (it is an involution). -/
noncomputable def sigmaEquiv : quadSpace genA ≃ₗ[ℂ] quadSpace genA :=
  LinearEquiv.ofInvolutive sigmaLin sigmaLin_involutive

/-- **Answer to MathOverflow 236762: NO.** The statement that every flip-commuting unitary of the
quadratic space extends to an automorphism is false; the flip itself is a counterexample. -/
theorem not_main : ¬ (type_of% @OMA.S_mo_236762.main) := by
  refine not_main_of_model (↥cuntzSub) genA genA_isCuntz sigmaCLM ?_ sigmaEquiv (fun x => rfl) ?_
  · intro x i j hx
    apply Subtype.ext
    show flipOp * ((x : cuntzSub) : Bop) = gen j * gen i
    rw [hx]
    exact flipOp_mul_gen_mul_gen i j
  · intro u v
    apply Subtype.ext
    show star (flipOp * ((v : cuntzSub) : Bop)) * (flipOp * ((u : cuntzSub) : Bop)) =
      star ((v : cuntzSub) : Bop) * ((u : cuntzSub) : Bop)
    rw [star_mul, mul_assoc, ← mul_assoc (star flipOp), star_flipOp_mul_flipOp, one_mul]

end OMA.P_mo_236762


theorem OMA.disproof : ¬ (type_of% @OMA.S_mo_236762.main) := OMA.P_mo_236762.not_main
