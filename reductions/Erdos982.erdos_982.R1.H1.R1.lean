def H1 : Prop := ∀ a : ℕ → Bool,
  ((vs 10).filter (fun v => a (enc (acuteAtom v)))).length = 1 → (gen 10 4).eval a = false

/-- The ten-vertex Boolean table has two or three marked acute angles. -/
def H2 : Prop := ∀ a : ℕ → Bool,
  let k := ((vs 10).filter (fun v => a (enc (acuteAtom v)))).length
  2 ≤ k → k ≤ 3 → (gen 10 4).eval a = false

set_option maxHeartbeats 3000000 in
set_option maxRecDepth 80000 in
theorem main : H1 → H2 → OMA.R_Erdos982_erdos_982_R1.H1 := by
  intro single many
  have decagon : (gen 10 4).Unsat := by
    intro a
    cases he : (gen 10 4).eval a with
    | false => rfl
    | true =>
      exfalso
      let M := (vs 10).filter (fun v => a (enc (acuteAtom v)))
      have hk : M.length ≤ 3 := at_most_three he
      by_cases hz : M.length=0
      · have hm : M = [] := List.length_eq_zero_iff.mp hz
        have hn (v : Fin 10) : a (enc (acuteAtom v)) = false := by
          cases hv : a (enc (acuteAtom v)) with
          | false => rfl
          | true =>
            have hv' : v ∈ M := List.mem_filter.mpr ⟨by simp [vs],hv⟩
            simp [hm] at hv'
        exact Bool.noConfusion (he.symm.trans (no_mark a hn))
      by_cases h1 : M.length = 1
      · exact Bool.noConfusion (he.symm.trans (single a h1))
      exact Bool.noConfusion (he.symm.trans (many a (by change 2 ≤ M.length; omega) hk))
  change (parentCNF 8 3).Unsat ∧ (parentCNF 10 4).Unsat
  rw [sameCNF,sameCNF]
  exact ⟨octagon,decagon⟩
end OMA.R_Erdos982_erdos_982_R1_H1_R1

end
