open Std.Sat Std.Tactic.BVDecide
private lemma sublist_mem {α : Type} {S L : List α} (h : S.Sublist L) : S ∈ subsets S.length L := by
  induction h with
  | slnil => exact List.mem_singleton_self []
  | @cons s l x h ih =>
    cases s with
    | nil => exact List.mem_singleton_self []
    | cons a s => exact List.mem_append_right _ ih
  | cons_cons x h ih =>
    exact List.mem_append_left _ (List.mem_map.mpr ⟨_,ih,rfl⟩)

private lemma at_most_three {a : ℕ → Bool} (h : (gen 10 4).eval a = true) :
    ((vs 10).filter (fun i => a (enc (acuteAtom i)))).length ≤ 3 := by
  let marked := (vs 10).filter (fun i => a (enc (acuteAtom i)))
  change marked.length ≤ 3
  by_contra! hc
  let S := marked.take 4
  have hlen : S.length=4 := by simp [S,Nat.min_eq_left (show 4 ≤ marked.length by omega)] <;> omega
  have hsub : S.Sublist (vs 10) := (List.take_sublist _ _).trans (List.filter_sublist)
  have hm : S ∈ subsets 4 (vs 10) := hlen ▸ sublist_mem hsub
  have hfour : (S.map (fun v => (acuteAtom v,false))) ∈ (genA 10 4).clauses := by
    change _ ∈ (_ ++ _ ++ _ ++ _ ++ acuteCls 10).toArray
    simp only [List.mem_toArray,List.mem_append,acuteCls,List.mem_map]
    exact Or.inr (Or.inr ⟨_,hm,rfl⟩)
  rw [gen,CNF.eval_relabel] at h
  have hh := Array.all_eq_true_iff_forall_mem.mp h _ hfour
  simp only [CNF.Clause.eval,List.any_eq_true,List.mem_map] at hh
  obtain ⟨l,⟨v,hv,rfl⟩,hl⟩ := hh
  have hv' : v ∈ marked := (List.take_sublist _ _).subset hv
  have ht := (List.mem_filter.mp hv').2
  simpa [Function.comp_def,ht] using hl
end AngleCertificate


