import OMAReductions.R_Erdos982_erdos_982_R1
import Mathlib
/-! Certified finite comparison tables for Erdős 982. Adapted from
Arhan Canli's Quantavane, arhancanli/quantavane-lean at
76a54a6c728161e75e1b0275c0b32ffc311f1f6a, Apache-2.0. The clause support
and propagation traces are restricted to the dependencies of the final
contradiction. The checker validates them by kernel reduction. -/
/-
Erdős Problem #982, round 2: the finite check for a general number `n` of vertices, as a CNF over structured
atoms, with at most `K` distinct distances at every vertex.

Vertices are `Fin n`, in the cyclic order of the polygon. Atoms:
  `E P Q`  the vertex pairs `P` and `Q` (each stored as (min, max)) have equal length
  `L P Q`  the pair `P` is strictly shorter than the pair `Q`
  `A v`    the interior angle at `v` is acute
Clause families:
  `eqvCls`    equal length is transitive
  `ordCls`    strict order: irreflexive on equal lengths, total, transitive
  `classCls`  at most `K` distinct distances at each vertex (every `K + 1` other vertices contain an equidistant pair)
  `sideCls`   half-plane rule: if `z` is not farther from `u` than from `w`, every vertex strictly inside the boundary
              arc from `u` to `z` that avoids `w` is strictly nearer to `u` than to `w`
  `acuteCls`  the angle at `v` is acute if `|v-1, v+1| <= |v-1, v|` or `<= |v, v+1|`; no four angles are acute
`gen n K` is `genA n K` relabelled to `Nat` by an injective code `enc`.
-/




open Std.Sat Std.Tactic.BVDecide

noncomputable section
namespace AngleCertificate


private def decodedType {α : Type} {f : α → α} (_ : ∀ x, f x=x) := α
private abbrev Atom (n : ℕ) [NeZero n] : Type := decodedType (@E982C.dec_enc n _)
private def observed₂ {α β : Type} {f : α → Bool} {c : β → β → α} {q : β → β → Bool}
    (_ : ∀ x y, f (c x y)=q x y) := c
private def observed₁ {α β : Type} {f : α → Bool} {c : β → α} {q : β → Bool}
    (_ : ∀ x, f (c x)=q x) := c
private def encoding {α : Type} {f : α → ℕ} {g : ℕ → α} (_ : ∀ x, g (f x)=x) := f
private def enc {n : ℕ} [NeZero n] : Atom n → ℕ := encoding (@E982C.dec_enc n _)
private def Eq' {n : ℕ} [NeZero n] : Fin n × Fin n → Fin n × Fin n → Atom n :=
  observed₂ (@E982C.asg_Eq' n (fun _ => 0) _)
private def lessAtom {n : ℕ} [NeZero n] : Fin n × Fin n → Fin n × Fin n → Atom n :=
  observed₂ (@E982C.asg_L n (fun _ => 0) _)
private def acuteAtom {n : ℕ} [NeZero n] : Fin n → Atom n :=
  observed₁ (@E982C.asg_A n (fun _ => 0) _)
private def fm {n : ℕ} [NeZero n] (k : ℕ) : Fin n := ⟨k%n,Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne n))⟩



/-! Index combinatorics on the `n`-cycle. -/

section Comb

variable {n : Nat}

/-- `(a, b, c)` is in strict cyclic (counterclockwise index) order. -/
private def cycB (a b c : Fin n) : Bool :=
  (decide (a.val < b.val) && decide (b.val < c.val)) || (decide (b.val < c.val) && decide (c.val < a.val)) ||
    (decide (c.val < a.val) && decide (a.val < b.val))

/-- `y` lies strictly inside the boundary arc from `u` to `z` that avoids `w`. -/
private def btwB (u y z w : Fin n) : Bool := (cycB u y z && cycB u z w) || (cycB w z y && cycB w y u)

private def cp (u w : Fin n) : Fin n × Fin n := if u < w then (u, w) else (w, u)


private def pairGenerator {α : Type} {f : List α → List (α × α)} {q : List α → α → α → Prop}
    (_ : ∀ {L x y}, (x,y) ∈ f L → q L x y) := f
private def pairsOf {α : Type} : List α → List (α × α) := pairGenerator (@E982C.mem_pairsOf α)
private def subsetGenerator {α : Type} {f : ℕ → List α → List (List α)} {q : ℕ → List α → List α → Prop}
    (_ : ∀ {k L S}, S ∈ f k L → q k L S) := f
private def subsets {α : Type} : ℕ → List α → List (List α) := subsetGenerator (@E982C.mem_subsets α)

private def vs (n : Nat) : List (Fin n) := List.finRange n
private def prs (n : Nat) : List (Fin n × Fin n) := pairsOf (vs n)
private def others (v : Fin n) : List (Fin n) := (vs n).filter (· != v)

end Comb

/-! Clause families. -/

section Clauses

variable (n : Nat) [NeZero n]

private def eqvCls : List (CNF.Clause (Atom n)) :=
  (prs n).flatMap fun P => (prs n).flatMap fun Q => (prs n).flatMap fun R =>
    if P != Q && Q != R && P != R then [[(Eq' P Q, false), (Eq' Q R, false), (Eq' P R, true)]] else []

private def ordCls : List (CNF.Clause (Atom n)) :=
  ((prs n).flatMap fun P => (prs n).flatMap fun Q =>
    if P != Q then [[(Eq' P Q, false), (lessAtom P Q, false)], [(Eq' P Q, true), (lessAtom P Q, true), (lessAtom Q P, true)]]
    else []) ++
  ((prs n).flatMap fun P => (prs n).flatMap fun Q => (prs n).flatMap fun R =>
    if P != Q && Q != R && P != R then [[(lessAtom P Q, false), (lessAtom Q R, false), (lessAtom P R, true)]] else [])

private def classCls (K : Nat) : List (CNF.Clause (Atom n)) :=
  (vs n).flatMap fun v => (subsets (K + 1) (others v)).map fun S =>
    (pairsOf S).map fun (a, b) => (Eq' (cp v a) (cp v b), true)

private def sideCls : List (CNF.Clause (Atom n)) :=
  (vs n).flatMap fun u => (vs n).flatMap fun w => (vs n).flatMap fun z => (vs n).flatMap fun y =>
    if btwB u y z w then [[(lessAtom (cp z w) (cp z u), true), (lessAtom (cp y u) (cp y w), true)]] else []


private def nx (v : Fin n) : Fin n := fm (v.val + 1)
private def pv (v : Fin n) : Fin n := fm (v.val + n - 1)

private def acuteCls : List (CNF.Clause (Atom n)) :=
  ((vs n).flatMap fun v =>
    [cp (pv n v) v, cp v (nx n v)].flatMap fun s =>
      [[(Eq' (cp (pv n v) (nx n v)) s, false), (acuteAtom v, true)], [(lessAtom (cp (pv n v) (nx n v)) s, false), (acuteAtom v, true)]]) ++
  ((subsets 4 (vs n)).map fun S => S.map fun v => (acuteAtom v, false))

private def genA (K : Nat) : CNF (Atom n) :=
  ⟨(eqvCls n ++ ordCls n ++ classCls n K ++ sideCls n ++ acuteCls n).toArray⟩

private def gen (K : Nat) : CNF Nat := (genA n K).relabel enc

private def premiseCNF {F : CNF ℕ} {Q : Prop} (_ : F.Unsat → Q) := F
private def parentCNF (k : ℕ) : CNF ℕ := premiseCNF (@E982C.genA_unsat n k _)
set_option maxHeartbeats 800000 in
private theorem sameCNF (k : ℕ) : parentCNF n k = gen n k := by rfl
end Clauses

end AngleCertificate
namespace AngleCertificate
open Std.Sat Std.Tactic.BVDecide
private inductive Shape (n : ℕ) where
  | eqv (p q r : Fin n × Fin n)
  | ord (p q : Fin n × Fin n)
  | trans (p q r : Fin n × Fin n)
  | classes (v : Fin n) (s : List (Fin n))
  | side (u w z y : Fin n)
  | acute (v : Fin n) (s : Fin n × Fin n)
  | four (s : List (Fin n))

private def block {n : ℕ} [NeZero n] (K : ℕ) : Shape n → List (CNF.Clause (Atom n))
  | .eqv P Q R => if P ∈ prs n ∧ Q ∈ prs n ∧ R ∈ prs n then
      if P != Q && Q != R && P != R then [[(Eq' P Q, false), (Eq' Q R, false), (Eq' P R, true)]] else []
    else []
  | .ord P Q => if P ∈ prs n ∧ Q ∈ prs n then
      if P != Q then [[(Eq' P Q, false), (lessAtom P Q, false)], [(Eq' P Q, true), (lessAtom P Q, true), (lessAtom Q P, true)]] else []
    else []
  | .trans P Q R => if P ∈ prs n ∧ Q ∈ prs n ∧ R ∈ prs n then
      if P != Q && Q != R && P != R then [[(lessAtom P Q, false), (lessAtom Q R, false), (lessAtom P R, true)]] else []
    else []
  | .classes v S => if v ∈ vs n ∧ S ∈ subsets (K+1) (others v) then
      [(pairsOf S).map fun (a,b) => (Eq' (cp v a) (cp v b),true)] else []
  | .side u w z y => if u ∈ vs n ∧ w ∈ vs n ∧ z ∈ vs n ∧ y ∈ vs n then
      if btwB u y z w then [[(lessAtom (cp z w) (cp z u),true),(lessAtom (cp y u) (cp y w),true)]] else []
    else []
  | .acute v s => if v ∈ vs n ∧ s ∈ [cp (pv n v) v,cp v (nx n v)] then
      [[(Eq' (cp (pv n v) (nx n v)) s,false),(acuteAtom v,true)],[(lessAtom (cp (pv n v) (nx n v)) s,false),(acuteAtom v,true)]] else []
  | .four S => if S ∈ subsets 4 (vs n) then [S.map fun v => (acuteAtom v,false)] else []

private lemma block_sound {n : ℕ} [NeZero n] (K : ℕ) (w : Shape n) {c : CNF.Clause (Atom n)}
    (h : c ∈ block K w) : c ∈ (genA n K).clauses := by
  change c ∈ (eqvCls n ++ ordCls n ++ classCls n K ++ sideCls n ++ acuteCls n).toArray
  simp only [List.mem_toArray,List.mem_append]
  cases w with
  | eqv p q r =>
    simp only [block] at h
    split at h <;> rename_i a
    · left; left; left; left
      simp only [eqvCls,List.mem_flatMap]
      exact ⟨p,a.1,q,a.2.1,r,a.2.2,h⟩
    · contradiction
  | ord p q =>
    simp only [block] at h
    split at h <;> rename_i a
    · left; left; left; right
      simp only [ordCls,List.mem_append,List.mem_flatMap]
      exact Or.inl ⟨p,a.1,q,a.2,h⟩
    · contradiction
  | trans p q r =>
    simp only [block] at h
    split at h <;> rename_i a
    · left; left; left; right
      simp only [ordCls,List.mem_append,List.mem_flatMap]
      exact Or.inr ⟨p,a.1,q,a.2.1,r,a.2.2,h⟩
    · contradiction
  | classes v s =>
    simp only [block] at h
    split at h <;> rename_i a
    · left; left; right
      simp only [List.mem_singleton] at h
      simp only [classCls,List.mem_flatMap,List.mem_map]
      exact ⟨v,a.1,s,a.2,h.symm⟩
    · contradiction
  | side u w z y =>
    simp only [block] at h
    split at h <;> rename_i a
    · left; right
      simp only [sideCls,List.mem_flatMap]
      exact ⟨u,a.1,w,a.2.1,z,a.2.2.1,y,a.2.2.2,h⟩
    · contradiction
  | acute v s =>
    simp only [block] at h
    split at h <;> rename_i a
    · right
      simp only [acuteCls,List.mem_append,List.mem_flatMap]
      exact Or.inl ⟨v,a.1,s,a.2,h⟩
    · contradiction
  | four s =>
    simp only [block] at h
    split at h <;> rename_i a
    · right
      simp only [List.mem_singleton] at h
      simp only [acuteCls,List.mem_append,List.mem_map]
      exact Or.inr ⟨s,a,h.symm⟩
    · contradiction

end AngleCertificate
namespace AngleCertificate
open Std.Sat

private abbrev Lit := Nat × Bool
private def flipLit (u : Lit) : Lit := (u.1,!u.2)

private def propagate (trues : List Lit) : List (List Lit) → Bool
  | [] => false
  | c::cs =>
    match c.filter (fun u => !(trues.contains (flipLit u))) with
    | [] => true
    | [u] => propagate (u::trues) cs
    | _ => false

private lemma propagate_sound (a : Nat → Bool) (cs : List (List Lit)) (trues : List Lit)
    (ha : ∀ l ∈ trues, a l.1 = l.2) (hs : ∀ c ∈ cs, ∃ l ∈ c, a l.1 = l.2) :
    propagate trues cs = false := by
  induction cs generalizing trues with
  | nil => rfl
  | cons c cs ih =>
    obtain ⟨u,hu,he⟩ := hs c (.head _)
    have hnot : flipLit u ∉ trues := by
      intro h
      have h' := ha _ h
      simp [flipLit,he] at h'
    have H : u ∈ c.filter (fun l => !(trues.contains (flipLit l))) := by simpa using And.intro hu hnot
    unfold propagate
    split <;> rename_i hf
    · rw [hf] at H
      cases H
    · rw [hf,List.mem_singleton] at H
      subst u
      apply ih
      · intro l hl
        rcases List.mem_cons.mp hl with rfl | h
        · exact he
        · exact ha _ h
      · exact fun x hx => hs x (.tail _ hx)
    · rfl

end AngleCertificate

namespace AngleCertificate
open Std.Sat Std.Tactic.BVDecide
private def digits (bits w : ℕ) : List ℕ :=
  (List.range (w.log2 / bits)).map fun i => (w >>> (i*bits)) % (2^bits)
private def clause (w : ℕ) : List Lit := (digits 16 w).map fun k => (k/2,k%2==1)
private def trueClause (a : ℕ → Bool) (c : List Lit) := ∃ l ∈ c, a l.1=l.2
private def rangeValid (f : ℕ → Bool) (l u : ℕ) := ∀ i, l ≤ i → i < u → f i = true
private lemma range_valid {f : ℕ → Bool} {l u : ℕ}
    (h : ((List.range (u-l)).all fun j => f (l+j)) = true) : rangeValid f l u := by
  intro i hi hu
  have H := List.all_eq_true.mp h (i-l) (List.mem_range.mpr (by omega))
  simpa [Nat.add_sub_of_le hi] using H
private lemma join_valid {f : ℕ → Bool} {l m u : ℕ} (h : rangeValid f l m) (h' : rangeValid f m u) :
    rangeValid f l u := fun i hi hu => if hm : i < m then h i hi hm else h' i (by omega) hu
private def initial {n : ℕ} [NeZero n] (k units : ℕ) (src : ℕ → Shape n × ℕ)
    (raw : ℕ → ℕ) (i : ℕ) : Bool := if i < units then
      clause (raw i) == [(enc (acuteAtom (fm (n:=n) i)),false)]
    else
      let d := src i
      ((block k d.1)[d.2]?.map (List.map (fun l => (enc l.1,l.2)))) == some (clause (raw i))
private def derived (raw refs : ℕ → ℕ) (i : ℕ) : Bool :=
  let c := clause (raw i)
  let hs := digits 12 (refs i)
  hs.all (· < i) && propagate (c.map flipLit) (hs.map (fun j => clause (raw j)))
private lemma resolve {a : ℕ → Bool} {raw refs : ℕ → ℕ} {i : ℕ} (h : derived raw refs i)
    (prev : ∀ j, j < i → trueClause a (clause (raw j))) : trueClause a (clause (raw i)) := by
  by_contra hc
  obtain ⟨hlt,hp⟩ := Bool.and_eq_true_iff.mp h
  have hA : ∀ l ∈ (clause (raw i)).map flipLit, a l.1=l.2 := by
    intro l hl
    obtain ⟨u,hu,rfl⟩ := List.mem_map.mp hl
    have H : a u.1 ≠ u.2 := fun h => hc ⟨u,hu,h⟩
    change a u.1 = !u.2
    cases e : a u.1 <;> cases f : u.2 <;> simp_all
  have hB : ∀ c ∈ (digits 12 (refs i)).map (fun j => clause (raw j)), trueClause a c := by
    intro c hc
    obtain ⟨j,hj,rfl⟩ := List.mem_map.mp hc
    exact prev j (of_decide_eq_true (List.all_eq_true.mp hlt j hj))
  exact Bool.noConfusion ((propagate_sound a _ _ hA hB).symm.trans hp)
private lemma base_true {n : ℕ} [NeZero n] {a : ℕ → Bool} {k units : ℕ} {src : ℕ → Shape n × ℕ}
    {raw : ℕ → ℕ} {i : ℕ} (h : initial k units src raw i = true)
    (hu : ∀ j < units, a (enc (acuteAtom (fm (n:=n) j)))=false) (hf : (gen n k).eval a = true) :
    trueClause a (clause (raw i)) := by
  unfold initial at h
  split at h
  · rename_i hi
    rw [beq_iff_eq.mp h]
    exact ⟨_,List.mem_singleton_self _,hu i hi⟩
  · have hh := beq_iff_eq.mp h
    obtain ⟨c,hc,he⟩ : ∃ c, (block k (src i).1)[(src i).2]? = some c ∧
        c.map (fun l => (enc l.1,l.2)) = clause (raw i) := by
      cases hv : (block k (src i).1)[(src i).2]? with
      | none => simp [hv] at hh
      | some c => exact ⟨c,rfl,by simpa [hv] using hh⟩
    have hmem := block_sound k (src i).1 (List.mem_of_getElem? hc)
    rw [gen,CNF.eval_relabel] at hf
    have hc' := Array.all_eq_true_iff_forall_mem.mp hf c hmem
    obtain ⟨l,hl,ht⟩ := List.any_eq_true.mp hc'
    refine ⟨(enc l.1,l.2),he ▸ List.mem_map.mpr ⟨l,hl,rfl⟩,?_⟩
    simpa [Function.comp_def] using ht
private lemma certificate {n : ℕ} [NeZero n] {k units first last : ℕ} (src : ℕ → Shape n × ℕ)
    (raw refs : ℕ → ℕ) (base : rangeValid (initial k units src raw) 0 first)
    (steps : rangeValid (derived raw refs) first (last+1)) (empty : clause (raw last) = [])
    (a : ℕ → Bool) (hu : ∀ j < units, a (enc (acuteAtom (fm (n:=n) j)))=false) :
    (gen n k).eval a = false := by
  cases hf : (gen n k).eval a with
  | false => rfl
  | true =>
    exfalso
    have sat (j : ℕ) : j ≤ last → trueClause a (clause (raw j)) := by
      induction j using Nat.strong_induction_on with
      | h j ih =>
        intro hj
        by_cases h : j<first
        · exact base_true (base j (by omega) h) hu hf
        · exact resolve (steps j (by omega) (by omega)) (fun l hl => ih l hl (by omega))
    obtain ⟨l,hl,_⟩ := sat last le_rfl
    simpa [empty] using hl
end AngleCertificate

