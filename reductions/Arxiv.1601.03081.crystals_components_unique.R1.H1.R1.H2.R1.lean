import OMAReductions.R_Arxiv_1601_03081_crystals_components_unique_R1_H1_R1

/-!
# Odd crystal multipliers below 21

Subtracting the two quadratic equations eliminates the square of one
component. The resulting integer polynomial in the other component must
vanish. For the bounded quotient pairs, each table entry gives a modulus
for which the polynomial has no root. Lean verifies all residue checks. At multiplier 17, two eliminants
factor as a nonzero linear factor times a cubic with no root modulo a
small prime.
The remaining branches split the least possible quotient, four, from
larger quotients.
-/

namespace OMA.R_Arxiv_1601_03081_crystals_components_unique_R1_H1_R1_H2_R1

open Arxiv.«1601.03081»

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem small_multiplier {m a c p q : ℕ}
    (hm : 5 ≤ m) (hm15 : m ≤ 15) (ho : Odd m)
    (ha : 3 ≤ a) (hc : 5 ≤ c) (hac : a ≤ c) (hca : c ≤ m*a)
    (hf : (a + m*c)^2 = p*((a+1)*(m*c+1)))
    (hg : (c + m*a)^2 = q*((c+1)*(m*a+1))) :
    p = q := by
  let l (m p q a : ℤ) : ℤ := (m^3*q-2*m^3-m*p+2*m)*a+m*m*q-m*p

  let v (m p q a : ℤ) : ℤ := (1-m^4)*a^2+(m^3*q-p)*a+m*m*q-p

  let b (m q a : ℤ) : ℤ := (2*m-m*q)*a-q

  let d (m q a : ℤ) : ℤ := m*m*a^2-m*q*a-q

  let eliminant (m p q a : ℤ) : ℤ :=
    v m p q a ^ 2 - b m q a * v m p q a * l m p q a + d m q a * l m p q a ^ 2

  have eliminant_zero {m p q a c : ℤ}
      (hf : (a+m*c)^2=p*((a+1)*(m*c+1)))
      (hg : (c+m*a)^2=q*((c+1)*(m*a+1))) : eliminant m p q a = 0 := by
    have hb : c^2 + b m q a*c + d m q a = 0 := by
      dsimp [b, d]
      linear_combination hg
    have hl : l m p q a*c + v m p q a = 0 := by
      dsimp [l, v]
      linear_combination hf - m^2 * hg
    have hv : v m p q a = -(l m p q a*c) := by linarith
    dsimp [eliminant]
    rw [hv]
    linear_combination (l m p q a)^2 * hb

  have eliminant_modEq {m p q a a' r : ℤ} (h : a ≡ a' [ZMOD r]) :
      eliminant m p q a ≡ eliminant m p q a' [ZMOD r] := by
    have hl : l m p q a ≡ l m p q a' [ZMOD r] := by
      dsimp [l]
      exact (((h.mul_left _).add_right _).sub_right _)
    have hv : v m p q a ≡ v m p q a' [ZMOD r] := by
      dsimp [v]
      exact ((((h.pow 2).mul_left _).add (h.mul_left _)).add_right _).sub_right _
    have hb : b m q a ≡ b m q a' [ZMOD r] := by
      dsimp [b]
      exact (h.mul_left _).sub_right _
    have hd : d m q a ≡ d m q a' [ZMOD r] := by
      dsimp [d]
      exact ((((h.pow 2).mul_left _).sub (h.mul_left _)).sub_right _)
    dsimp [eliminant]
    exact ((hv.pow 2).sub ((hb.mul hv).mul hl)).add (hd.mul (hl.pow 2))

  let excludes (m p q r : ℕ) : Bool :=
    (List.range r).all fun a => decide (eliminant m p q a % (r : ℤ) ≠ 0)

  have excludes_sound {m p q r : ℕ} (hr : 0 < r)
      (h : excludes m p q r = true) (a : ℤ) : eliminant m p q a ≠ 0 := by
    let residue := (a % (r : ℤ)).toNat
    have hr' : 0 < (r : ℤ) := by exact_mod_cast hr
    have hcast : (residue : ℤ) = a % (r : ℤ) :=
      Int.toNat_of_nonneg (Int.emod_nonneg _ hr'.ne')
    have hlt : residue < r := by
      exact_mod_cast (show (residue : ℤ) < r from hcast ▸ Int.emod_lt_of_pos a hr')
    have hn := List.all_eq_true.mp h residue (List.mem_range.mpr hlt)
    have hne : eliminant m p q (residue : ℤ) % (r : ℤ) ≠ 0 :=
      of_decide_eq_true hn
    have hmod : a ≡ (residue : ℤ) [ZMOD r] := by
      rw [hcast]
      exact (Int.mod_modEq a r).symm
    intro hz
    have he := (eliminant_modEq (m := m) (p := p) (q := q) hmod).eq
    rw [hz, Int.zero_emod] at he
    exact hne he.symm




  have quotient_bounds {m a c p q : ℕ} (hm : 5 ≤ m) (ha : 3 ≤ a) (hc : 5 ≤ c)
      (hac : a ≤ c) (hca : c ≤ m*a)
      (hf : (a + m*c)^2 = p*((a+1)*(m*c+1)))
      (hg : (c + m*a)^2 = q*((c+1)*(m*a+1))) :
      4 ≤ q ∧ q < m+3 ∧ q ≤ p ∧ p < m*m+3 := by
    have ha' : (3 : ℤ) ≤ a := by exact_mod_cast ha
    have hc' : (5 : ℤ) ≤ c := by exact_mod_cast hc
    have hm' : (5 : ℤ) ≤ m := by exact_mod_cast hm
    have hac' : (a : ℤ) ≤ c := by exact_mod_cast hac
    have hca' : (c : ℤ) ≤ m*a := by exact_mod_cast hca
    have hf' : ((a : ℤ) + m*c)^2 = p*((a+1)*(m*c+1)) := by exact_mod_cast hf
    have hg' : ((c : ℤ) + m*a)^2 = q*((c+1)*(m*a+1)) := by exact_mod_cast hg
    have hp0 : 0 < ((a : ℤ)+1)*(m*c+1) := by positivity
    have hq0 : 0 < ((c : ℤ)+1)*(m*a+1) := by positivity
    have ma : (15 : ℤ) ≤ m*a := by
      nlinarith [mul_nonneg (show 0 ≤ (m : ℤ)-5 by omega) (show 0 ≤ (a : ℤ)-3 by omega)]
    have qlo : (3 : ℤ)*((c+1)*(m*a+1)) < ((c : ℤ)+m*a)^2 := by
      nlinarith [sq_nonneg ((c : ℤ)-m*a),
        mul_nonneg (show 0 ≤ (c : ℤ)-5 by omega) (show 0 ≤ (m : ℤ)*a-3 by omega)]
    have qhi : ((c : ℤ)+m*a)^2 < ((m : ℤ)+3)*((c+1)*(m*a+1)) := by
      have hc2 := mul_le_mul_of_nonneg_left hca' (show 0 ≤ (c : ℤ) by omega)
      have ha2 := mul_le_mul_of_nonneg_left hac' (show 0 ≤ (m : ℤ)^2*a by positivity)
      have hsum : ((c : ℤ)+m*a)^2 ≤ ((m : ℤ)+3)*(m*a*c) := by nlinarith only [hc2,ha2]
      exact hsum.trans_lt (mul_lt_mul_of_pos_left (by nlinarith : (m : ℤ)*a*c < (c+1)*(m*a+1))
        (by positivity))
    have phi : ((a : ℤ)+m*c)^2 < ((m : ℤ)^2+3)*((a+1)*(m*c+1)) := by
      have hacm : (a : ℤ) ≤ m*c := by
        nlinarith [mul_nonneg (show 0 ≤ (m : ℤ)-1 by omega) (show 0 ≤ (c : ℤ) by omega)]
      have ha2 := mul_le_mul_of_nonneg_left hacm (show 0 ≤ (a : ℤ) by omega)
      have hc2 := mul_le_mul_of_nonneg_left hca' (show 0 ≤ (m : ℤ)^2*c by positivity)
      have hsum : ((a : ℤ)+m*c)^2 ≤ ((m : ℤ)^2+3)*(m*a*c) := by nlinarith only [ha2,hc2]
      exact hsum.trans_lt (mul_lt_mul_of_pos_left (by nlinarith : (m : ℤ)*a*c < (a+1)*(m*c+1))
        (by positivity))
    rw [hg'] at qlo qhi
    rw [hf'] at phi
    have hqp : q ≤ p := by
      let x : ℤ := a + m*c
      let y : ℤ := c + m*a
      let z : ℤ := m*a*c+1
      have hx : 0 ≤ x := by dsimp [x]; positivity
      have hy : 0 ≤ y := by dsimp [y]; positivity
      have hz : 0 < z := by dsimp [z]; positivity
      have hxy : y ≤ x := by
        dsimp [x,y]
        nlinarith [mul_nonneg (show 0 ≤ (m : ℤ)-1 by omega) (sub_nonneg.mpr hac')]
      have h1 : x^2 = (p : ℤ)*(z+x) := by dsimp [x,z]; linear_combination hf'
      have h2 : y^2 = (q : ℤ)*(z+y) := by dsimp [y,z]; linear_combination hg'
      have h : 0 ≤ x^2*(z+y)-y^2*(z+x) := by
        rw [show x^2*(z+y)-y^2*(z+x) = (x-y)*((x+y)*z+x*y) by ring]
        exact mul_nonneg (sub_nonneg.mpr hxy) (by positivity)
      rw [h1,h2] at h
      have hh : (q : ℤ)*((z+x)*(z+y)) ≤ p*((z+x)*(z+y)) := by
        calc
          _ = q*(z+y)*(z+x) := by ring
          _ ≤ p*(z+x)*(z+y) := sub_nonneg.mp h
          _ = _ := by ring
      exact_mod_cast (le_of_mul_le_mul_right hh (by positivity) : (q : ℤ) ≤ p)
    have hqlo : 3 < q := by exact_mod_cast lt_of_mul_lt_mul_right qlo hq0.le
    have hqhi : q < m+3 := by exact_mod_cast lt_of_mul_lt_mul_right qhi hq0.le
    have hphi : p < m*m+3 := by
      have hp' := lt_of_mul_lt_mul_right phi hp0.le
      rw [pow_two] at hp'
      exact_mod_cast hp'
    exact ⟨by omega, hqhi, hqp, hphi⟩

