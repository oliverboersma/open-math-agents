private theorem multiplier_nineteen {a c p q : ℕ}
    (ha : 3 ≤ a) (hc : 5 ≤ c) (hac : a ≤ c) (hca : c ≤ 19*a)
    (hf : (a + 19*c)^2 = p*((a+1)*(19*c+1)))
    (hg : (c + 19*a)^2 = q*((c+1)*(19*a+1))) : p = q := by
  let l (m p q a : ℤ) : ℤ := (m^3*q-2*m^3-m*p+2*m)*a+m*m*q-m*p

  let v (m p q a : ℤ) : ℤ := (1-m^4)*a^2+(m^3*q-p)*a+m*m*q-p

  let b (m q a : ℤ) : ℤ := (2*m-m*q)*a-q

  let d (m q a : ℤ) : ℤ := m*m*a^2-m*q*a-q

  let eliminant (m p q a : ℤ) : ℤ :=
    v m p q a ^ 2 - b m q a * v m p q a * l m p q a + d m q a * l m p q a ^ 2

  have eliminant_zero {m p q a c : ℤ}
      (hf : (a+m*c)^2=p*((a+1)*(m*c+1)))
      (hg : (c+m*a)^2=q*((c+1)*(m*a+1))) : eliminant m p q a = 0 := by
    have hb : c^2 + b m q a*c + d m q a = 0 := by
      dsimp [b, d]
      linear_combination hg
    have hl : l m p q a*c + v m p q a = 0 := by
      dsimp [l, v]
      linear_combination hf - m^2 * hg
    have hv : v m p q a = -(l m p q a*c) := by linarith
    dsimp [eliminant]
    rw [hv]
    linear_combination (l m p q a)^2 * hb

  have eliminant_modEq {m p q a a' r : ℤ} (h : a ≡ a' [ZMOD r]) :
      eliminant m p q a ≡ eliminant m p q a' [ZMOD r] := by
    have hl : l m p q a ≡ l m p q a' [ZMOD r] := by
      dsimp [l]
      exact (((h.mul_left _).add_right _).sub_right _)
    have hv : v m p q a ≡ v m p q a' [ZMOD r] := by
      dsimp [v]
      exact ((((h.pow 2).mul_left _).add (h.mul_left _)).add_right _).sub_right _
    have hb : b m q a ≡ b m q a' [ZMOD r] := by
      dsimp [b]
      exact (h.mul_left _).sub_right _
    have hd : d m q a ≡ d m q a' [ZMOD r] := by
      dsimp [d]
      exact ((((h.pow 2).mul_left _).sub (h.mul_left _)).sub_right _)
    dsimp [eliminant]
    exact ((hv.pow 2).sub ((hb.mul hv).mul hl)).add (hd.mul (hl.pow 2))

  let excludes (m p q r : ℕ) : Bool :=
    (List.range r).all fun a => decide (eliminant m p q a % (r : ℤ) ≠ 0)

  have excludes_sound {m p q r : ℕ} (hr : 0 < r)
      (h : excludes m p q r = true) (a : ℤ) : eliminant m p q a ≠ 0 := by
    let residue := (a % (r : ℤ)).toNat
    have hr' : 0 < (r : ℤ) := by exact_mod_cast hr
    have hcast : (residue : ℤ) = a % (r : ℤ) :=
      Int.toNat_of_nonneg (Int.emod_nonneg _ hr'.ne')
    have hlt : residue < r := by
      exact_mod_cast (show (residue : ℤ) < r from hcast ▸ Int.emod_lt_of_pos a hr')
    have hn := List.all_eq_true.mp h residue (List.mem_range.mpr hlt)
    have hne : eliminant m p q (residue : ℤ) % (r : ℤ) ≠ 0 :=
      of_decide_eq_true hn
    have hmod : a ≡ (residue : ℤ) [ZMOD r] := by
      rw [hcast]
      exact (Int.mod_modEq a r).symm
    intro hz
    have he := (eliminant_modEq (m := m) (p := p) (q := q) hmod).eq
    rw [hz, Int.zero_emod] at he
    exact hne he.symm




