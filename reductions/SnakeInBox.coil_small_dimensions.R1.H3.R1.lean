/-- The even side of the explicit 48-cycle in the parent has forty
possible one-vertex extensions. Each has an even vertex with fewer than
two possible connectors, regardless of how the odd side is chosen. -/
theorem singleExtensions :
    let enc := fun m : ℕ => Finset.univ.filter (fun i : Fin 7 => m.testBit i.val)
    let K := ([0,65,72,40,10,15,45,111,99,39,63,57,24,60,126,90,95,85,113,48,18,86,102,36]
      : List ℕ).toFinset.image enc
    K.card = 24 ∧ ∀ z : Finset (Fin 7), Even z.card → z ∉ K →
      ∃ v ∈ insert z K, (Finset.univ.filter (fun w : Finset (Fin 7) =>
        (v ∆ w).card = 1 ∧ ((insert z K).filter (fun a => (w ∆ a).card = 1)).card=2)).card < 2 := by
  intro enc K
  let pairs : List (ℕ × ℕ) :=
    [(3,0),(5,0),(6,0),(9,0),(12,0),(17,0),(20,0),(23,39),(27,63),(29,45),
     (30,24),(33,0),(34,40),(43,40),(46,40),(51,39),(53,63),(54,63),(58,40),(66,102),
     (68,0),(71,71),(75,72),(77,45),(78,78),(80,48),(83,90),(89,72),(92,24),(96,72),
     (101,45),(105,72),(106,72),(108,40),(114,126),(116,60),(119,63),(120,72),(123,111),(125,45)]
  have cover : ∀ z : Finset (Fin 7), Even z.card → z ∉ K →
      ∃ p ∈ pairs, enc p.1=z := by decide +kernel
  have checked : ∀ p ∈ pairs,
      enc p.2 ∈ insert (enc p.1) K ∧
      (Finset.univ.filter (fun w : Finset (Fin 7) => (enc p.2 ∆ w).card=1 ∧
        ((insert (enc p.1) K).filter (fun a => (w ∆ a).card=1)).card=2)).card < 2 := by
    decide +kernel
  refine ⟨by decide +kernel,?_⟩
  intro z ze nz
  obtain ⟨p,hp,rfl⟩ := cover z ze nz
  exact ⟨enc p.2,checked p hp⟩

