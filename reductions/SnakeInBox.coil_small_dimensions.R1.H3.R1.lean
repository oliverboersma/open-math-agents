import OMAReductions.R_SnakeInBox_coil_small_dimensions_R1
import Mathlib

/-!
Project an induced cube cycle onto its even vertices. A selected odd vertex
joins its two even neighbors, and a proper nonempty cut of the even vertices
has at least two crossing odd vertices. Each parity class is encoded by
six-bit labels, one even label is translated to zero, and 18,720 candidate
sets near the known maximum witness are eliminated. This gives a finite subtour
formulation. Disconnected unions of squares satisfy the degree equations
but violate a cut. The chord condition is enforced by counting all cube
neighbors in the selected vertex sets.
-/
namespace OMA.R_SnakeInBox_coil_small_dimensions_R1_H3_R1

open Finset SimpleGraph SnakeInBox Classical
open scoped symmDiff

/-- The remaining finite enumeration. Odd vertices with two neighbors in E
act as available edges between those neighbors. A proposed selection O
must give degree two at every even vertex and cross every proper cut. -/
def H1 : Prop :=
  let R (a b : BitVec 6) := (a ^^^ b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)
  ∀ E O : Finset (BitVec 6), 0 ∈ E → 25 ≤ E.card →
    (∀ v ∈ E, (O.filter (R v)).card=2) →
    (∀ w ∈ O, (E.filter (R w)).card=2) →
    (∀ u ∈ ([0,1,8,10,15,18,21,22,24,26,31,35,36,38,39,40,45,47,48,49,57,60,62,63] : List ℕ), ∀ i < 40, ∀ j < i,
      E ≠ Finset.univ.filter (fun a : BitVec 6 =>
        let added : Array ℕ := #[2,3,4,5,6,7,9,11,12,13,14,16,17,19,20,23,25,27,28,29,30,32,33,34,37,41,42,43,44,46,50,51,52,53,54,55,56,58,59,61]
        (((0xd203a1d885648503 : ℕ) ^^^ (1 <<< u)) ||| (1 <<< added[i]!) ||| (1 <<< added[j]!)).testBit a.toNat)) →
    E ≠ univ.filter (fun a : BitVec 6 => (0xd223a15a85648581 : ℕ).testBit a.toNat) →
    ∃ A : Finset (BitVec 6), A ⊆ E ∧ A.Nonempty ∧ (E \ A).Nonempty ∧
      (O.filter (fun w => (A.filter (R w)).card=1)).card<2

/-- The number of selected connectors crossing each cut is even. -/
def H2 : Prop := ∀ E O : Finset (Finset (Fin 7)),
  (∀ v ∈ E, (O.filter (fun w => (Hypercube 7).Adj v w)).card = 2) →
  (∀ w ∈ O, (E.filter (fun v => (Hypercube 7).Adj w v)).card = 2) →
  ∀ A ⊆ E, Even ((O.filter (fun w =>
    (A.filter (fun a => (Hypercube 7).Adj w a)).card = 1)).card)

theorem countAcross {V : Type*} [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (E O : Finset V) :
    ∑ v ∈ E, (O.filter (fun w => G.Adj v w)).card =
      ∑ w ∈ O, (E.filter (fun v => G.Adj w v)).card := by
  simp only [Finset.card_filter]
  rw [Finset.sum_comm]
  exact sum_congr rfl fun w _ => sum_congr rfl fun v _ => by simp [adj_comm]

theorem evenCuts : H2 := by
  classical
  intro E O degE degO A hA
  let f (w : Finset (Fin 7)) := (A.filter (fun a => (Hypercube 7).Adj w a)).card
  have sumf : ∑ w ∈ O, f w = 2*A.card := calc
    _ = ∑ v ∈ A, (O.filter (fun w => (Hypercube 7).Adj v w)).card := (countAcross _ A O).symm
    _ = ∑ _v ∈ A, 2 := sum_congr rfl fun v hv => degE v (hA hv)
    _ = _ := by simp [Nat.mul_comm]
  have le2 (w : Finset (Fin 7)) (hw : w ∈ O) : f w ≤ 2 := by
    rw [← degO w hw]
    exact card_le_card (filter_subset_filter (fun a => (Hypercube 7).Adj w a) hA)
  have split : ∑ w ∈ O, f w =
      2*(O.filter (fun w => f w = 2)).card+(O.filter (fun w => f w = 1)).card := by
    calc
      _ = ∑ w ∈ O, ((if f w = 2 then 1 else 0)*2 + (if f w = 1 then 1 else 0)) := by
        apply sum_congr rfl
        intro w hw
        have small := le2 w hw
        rcases (show f w = 0 ∨ f w = 1 ∨ f w = 2 by omega) with h | h | h <;> simp [h]
      _ = _ := by rw [sum_add_distrib,← sum_mul]; simp [Nat.mul_comm]
  change Even ((O.filter (fun w => f w = 1)).card)
  exact ⟨A.card-(O.filter (fun w => f w=2)).card,by omega⟩

theorem walkClosed {V : Type*} {G : SimpleGraph V} (T : V → Prop)
    (closed : ∀ ⦃a b⦄, G.Adj a b → T a → T b) {u v : V} (w : G.Walk u v) :
    T u → T v := by
  induction w with
  | nil => exact id
  | cons ha _ ih => exact fun hu => ih (closed ha hu)

/-- A nonempty proper cut of the even vertices in a connected bipartite
support has at least one crossing connector. -/
theorem cutNonempty {V : Type*} [DecidableEq V] (G : SimpleGraph V) [DecidableRel G.Adj]
    (C E O A : Finset V) (conn : (G.induce (C : Set V)).Connected)
    (part : C = E ∪ O) (eo : ∀ {u v}, u ∈ E → G.Adj u v → v ∉ E)
    (oe : ∀ {u v}, u ∈ O → v ∈ C → G.Adj u v → v ∈ E)
    (deg : ∀ u ∈ O, (E.filter (fun v => G.Adj u v)).card = 2)
    (hA : A ⊆ E) (left : A.Nonempty) (right : (E \ A).Nonempty) :
    (O.filter (fun w => (A.filter (fun a => G.Adj w a)).card=1)).Nonempty := by
  classical
  by_contra empty
  have eC : E ⊆ C := part ▸ subset_union_left
  let T (v : ↥(C : Set V)) := v.val ∈ A ∨ ∃ a ∈ A, G.Adj v.val a
  have closed : ∀ ⦃u v : ↥(C : Set V)⦄, (G.induce (C : Set V)).Adj u v → T u → T v := by
    intro u v huv ht
    change G.Adj u.val v.val at huv
    rcases ht with hu | ⟨a,ha,ua⟩
    · exact Or.inr ⟨u.val,hu,huv.symm⟩
    · have uno : u.val ∉ E := eo (hA ha) ua.symm
      have uO : u.val ∈ O := by
        have uc : u.val ∈ C := u.property
        have inclusion : C ⊆ E ∪ O := part.le
        exact (mem_union.mp (inclusion uc)).resolve_left uno
      have vE := oe uO v.property huv
      have eqn : A.filter (G.Adj u.val) = E.filter (G.Adj u.val) := by
        apply eq_of_subset_of_card_le (filter_subset_filter _ hA)
        rw [deg u.val uO]
        have pos := card_pos.mpr (show (A.filter (G.Adj u.val)).Nonempty from
          ⟨a,mem_filter.mpr ⟨ha,ua⟩⟩)
        have one : (A.filter (G.Adj u.val)).card ≠ 1 :=
          fun he => empty ⟨u.val,mem_filter.mpr ⟨uO,he⟩⟩
        omega
      have vm : v.val ∈ E.filter (G.Adj u.val) := mem_filter.mpr ⟨vE,huv⟩
      rw [← eqn] at vm
      exact Or.inl (mem_filter.mp vm).1
  obtain ⟨a,ha⟩ := left
  obtain ⟨b,hb⟩ := right
  obtain ⟨be,ba⟩ := mem_sdiff.mp hb
  let u : ↥(C : Set V) := ⟨a,eC (hA ha)⟩
  let v : ↥(C : Set V) := ⟨b,eC be⟩
  obtain ⟨w⟩ := conn.preconnected u v
  obtain h | ⟨a',ha',edge⟩ := walkClosed T closed w (Or.inl ha)
  · exact ba h
  · exact eo be edge (hA ha')

theorem supportProps {V : Type*} [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]
    {u : V} (p : G.Walk u u) (cycle : p.IsCycle) (ind : p.toSubgraph.IsInduced) :
    p.support.toFinset.card=p.length ∧
    (G.induce (p.support.toFinset : Set V)).Connected ∧
    ∀ v ∈ p.support.toFinset, (p.support.toFinset.filter (G.Adj v)).card=2 := by
  classical
  have tail : p.support.toFinset=p.support.tail.toFinset := by
    ext v
    cases p with
    | nil => exact (cycle.ne_nil rfl).elim
    | @cons _ b _ h q =>
      simp only [Walk.support_cons,List.tail_cons,List.mem_toFinset,List.mem_cons]
      exact ⟨fun h => h.elim (fun eqn => eqn ▸ q.end_mem_support) id,Or.inr⟩
  refine ⟨?_,?_,?_⟩
  · rw [tail,List.toFinset_card_of_nodup cycle.support_nodup,List.length_tail,Walk.length_support]
    omega
  · have eqset : (p.support.toFinset : Set V) = {v | v ∈ p.support} := by ext v; simp
    rw [eqset]
    exact p.connected_induce_support
  · intro v hv
    have hv' := List.mem_toFinset.mp hv
    have cards := cycle.ncard_neighborSet_toSubgraph_eq_two hv'
    have seteq : p.toSubgraph.neighborSet v =
        ((p.support.toFinset.filter (G.Adj v) : Finset V) : Set V) := by
      ext w
      change p.toSubgraph.Adj v w ↔ w ∈ p.support.toFinset.filter (G.Adj v)
      rw [mem_filter,List.mem_toFinset]
      exact ⟨fun h => ⟨p.mem_verts_toSubgraph.mp h.snd_mem,p.toSubgraph.adj_sub h⟩,
        fun h => ind (p.mem_verts_toSubgraph.mpr hv') (p.mem_verts_toSubgraph.mpr h.1) h.2⟩
    rw [seteq,Set.ncard_coe_finset] at cards
    exact cards

theorem cubeParity {n : ℕ} {a b : Finset (Fin n)} (edge : (Hypercube n).Adj a b) :
    Even a.card ↔ Odd b.card := by
  have one : (a ∆ b).card = 1 := by
    obtain ⟨_,h|h⟩ := (SimpleGraph.fromRel_adj ..).mp edge
    · exact h
    · simpa only [symmDiff_comm b a] using h
  have dis : Disjoint (a \ b) (b \ a) := disjoint_left.mpr fun x ha hb =>
    (mem_sdiff.mp ha).2 (mem_sdiff.mp hb).1
  rw [symmDiff_def] at one
  change ((a \ b) ∪ (b \ a)).card=1 at one
  rw [card_union_of_disjoint dis] at one
  have h1 := card_sdiff_add_card_inter a b
  have h2 := card_sdiff_add_card_inter b a
  rw [inter_comm b a] at h2
  rw [Nat.even_iff,Nat.odd_iff]
  omega

theorem ofVertexObstruction : (∀ E O : Finset (Finset (Fin 7)),
  (∀ v ∈ E, Even v.card) → 25 ≤ E.card → (∀ w ∈ O, Odd w.card) →
  (∀ v ∈ E, (O.filter (fun w => (Hypercube 7).Adj v w)).card = 2) →
  (∀ w ∈ O, (E.filter (fun v => (Hypercube 7).Adj w v)).card = 2) →
  ∃ A : Finset (Finset (Fin 7)), A ⊆ E ∧ A.Nonempty ∧ (E \ A).Nonempty ∧
    (O.filter (fun w => (A.filter (fun a => (Hypercube 7).Adj w a)).card = 1)).card < 2) → H2 → OMA.R_SnakeInBox_coil_small_dimensions_R1.H3 := by
  classical
  intro obstruct parity
  apply csSup_le'
  rintro k ⟨S,ind,u,p,cycle,rfl,rfl⟩
  obtain ⟨size,conn,degree⟩ := supportProps p cycle ind
  let C := p.support.toFinset
  let E := C.filter (fun v => Even v.card)
  let O := C.filter (fun v => Odd v.card)
  have evenE {v} (hv : v ∈ E) : Even v.card := (mem_filter.mp hv).2
  have oddO {v} (hv : v ∈ O) : Odd v.card := (mem_filter.mp hv).2
  have part : C=E ∪ O := by
    ext v
    simp only [E,O,mem_union,mem_filter]
    exact ⟨fun hv => (Nat.even_or_odd v.card).imp (fun h => ⟨hv,h⟩) (fun h => ⟨hv,h⟩),
      fun h => h.elim And.left And.left⟩
  have dis : Disjoint E O := disjoint_left.mpr fun v he ho =>
    (Nat.not_even_iff_odd.mpr (oddO ho)) (evenE he)
  have dE (v) (hv : v ∈ E) : (O.filter (fun w => (Hypercube 7).Adj v w)).card = 2 := by
    have eqn : O.filter ((Hypercube 7).Adj v) = C.filter ((Hypercube 7).Adj v) := by
      ext w
      simp only [O,mem_filter]
      exact ⟨fun h => ⟨h.1.1,h.2⟩,fun h => ⟨⟨h.1,(cubeParity h.2).mp (evenE hv)⟩,h.2⟩⟩
    rw [eqn]
    exact degree v (mem_filter.mp hv).1
  have dO (w) (hw : w ∈ O) : (E.filter (fun v => (Hypercube 7).Adj w v)).card = 2 := by
    have eqn : E.filter ((Hypercube 7).Adj w) = C.filter ((Hypercube 7).Adj w) := by
      ext v
      simp only [E,mem_filter]
      exact ⟨fun h => ⟨h.1.1,h.2⟩,fun h => ⟨⟨h.1,(cubeParity h.2.symm).mpr (oddO hw)⟩,h.2⟩⟩
    rw [eqn]
    exact degree w (mem_filter.mp hw).1
  have same := countAcross (Hypercube 7) E O
  rw [sum_congr rfl dE,sum_congr rfl dO] at same
  simp only [sum_const,smul_eq_mul] at same
  have sizes : C.card = E.card+O.card := by
    calc C.card = (E ∪ O).card := congrArg Finset.card part
         _ = _ := card_union_of_disjoint dis
  change C.card = p.length at size
  by_contra! long
  obtain ⟨A,hA,left,right,few⟩ := obstruct E O (fun _ => evenE) (by omega) (fun _ => oddO) dE dO
  have ne := cutNonempty (Hypercube 7) C E O A conn part
    (fun e ed vE => (Nat.not_even_iff_odd.mpr ((cubeParity ed).mp (evenE e))) (evenE vE))
    (fun o vc ed => mem_filter.mpr ⟨vc,(cubeParity ed.symm).mpr (oddO o)⟩)
    dO hA left right
  obtain ⟨j,hj⟩ := parity E O dE dO A hA
  have positive := card_pos.mpr ne
  omega

/-- Every selected even vertex needs two distinct available odd neighbors.
All neighbors in E count, including possible chords. -/
theorem availableDegree {V : Type*} [DecidableEq V] [Fintype V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (E O : Finset V)
    (de : ∀ v ∈ E, (O.filter (G.Adj v)).card=2)
    (do' : ∀ w ∈ O, (E.filter (G.Adj w)).card=2) (v : V) (hv : v ∈ E) :
    2 ≤ (univ.filter (fun w => G.Adj v w ∧ (E.filter (G.Adj w)).card=2)).card := by
  apply le_trans (de v hv).ge
  apply card_le_card
  intro w hw
  obtain ⟨wo,edge⟩ := mem_filter.mp hw
  exact mem_filter.mpr ⟨mem_univ _,edge,do' w wo⟩

