/-- Finite degree-obstruction certificates for every replacement of one
reference even label by two other even labels. Indices j < i enumerate
each unordered pair once. Each six-bit witness is checked against all
seven possible odd neighbors and all seven of their possible even neighbors. -/
theorem twoForOneExtensions :
    let offsets : List ℕ := [0,1,2,4,8,16,32]
    let removed : List ℕ := [0,1,8,10,15,18,21,22,24,26,31,35,36,38,39,40,45,47,48,49,57,60,62,63]
    let added : Array ℕ := #[2,3,4,5,6,7,9,11,12,13,14,16,17,19,20,23,25,27,28,29,30,32,33,34,37,41,42,43,44,46,50,51,52,53,54,55,56,58,59,61]
    let mask := fun (u i j : ℕ) =>
      (0xd203a1d885648503 ^^^ (1 <<< u)) ||| (1 <<< added[i]!) ||| (1 <<< added[j]!)
    let deficient := fun (m v : ℕ) => m.testBit v && decide
      (offsets.countP (fun b => offsets.countP (fun c => m.testBit (v ^^^ b ^^^ c)) == 2) < 2)
    ∀ u ∈ removed, ∀ i < 40, ∀ j < i, ∃ v < 64, deficient (mask u i j) v = true := by
  intro offsets removed added mask deficient
  let witness (table i j : ℕ) := (table >>> (6*(i*(i-1)/2+j))) % 64
  let replay (u table : ℕ) := (List.range 40).all (fun i => (List.range i).all (fun j =>
    deficient (mask u i j) (witness table i j)))
  have rows : ∀ u ∈ removed, ∃ table, replay u table = true := by
    simp only [removed,List.forall_mem_cons]
    exact ⟨⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩,
      ⟨,by decide +kernel⟩, fun _ h => by cases h⟩
  intro u hu i hi j hj
  obtain ⟨table,checked⟩ := rows u hu
  have inner := List.all_eq_true.mp checked i (List.mem_range.mpr hi)
  exact ⟨witness table i j,Nat.mod_lt _ (by decide),
    List.all_eq_true.mp inner j (List.mem_range.mpr hj)⟩

/-- None of the 18,720 two-for-one replacements admits any odd side
with degree two on both sides. The replacement may change every odd
vertex of the original coil. -/
theorem excludedTwoForOne :
    let removed : List ℕ := [0,1,8,10,15,18,21,22,24,26,31,35,36,38,39,40,45,47,48,49,57,60,62,63]
    let added : Array ℕ := #[2,3,4,5,6,7,9,11,12,13,14,16,17,19,20,23,25,27,28,29,30,32,33,34,37,41,42,43,44,46,50,51,52,53,54,55,56,58,59,61]
    let mask := fun (u i j : ℕ) =>
      (0xd203a1d885648503 ^^^ (1 <<< u)) ||| (1 <<< added[i]!) ||| (1 <<< added[j]!)
    let R := fun a b : BitVec 6 => (a ^^^ b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)
    ∀ u ∈ removed, ∀ i < 40, ∀ j < i,
      let E := Finset.univ.filter (fun a : BitVec 6 => (mask u i j).testBit a.toNat)
      ¬ ∃ O : Finset (BitVec 6), (∀ a ∈ E, (O.filter (R a)).card=2) ∧
        (∀ b ∈ O, (E.filter (R b)).card=2) := by
  intro removed added mask R u hu i hi j hj
  obtain ⟨v,hv,verified⟩ := twoForOneExtensions u hu i hi j hj
  have proof := Bool.and_eq_true_iff.mp verified
  exact maskPrune (mask u i j) v hv proof.1 (of_decide_eq_true proof.2)

/-- The graph of all available opposite-parity connectors has
minimum available degree at least two. Three other degree-two vertices
force distinct connectors at label 21, so a degree-two selection cannot
exist. This case survives the single-vertex degree test. -/
theorem forcedConnectorConflict :
    let E := univ.filter (fun a : BitVec 6 => (0xd223a15a85648581 : ℕ).testBit a.toNat)
    let R := fun a b : BitVec 6 => (a ^^^ b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)
    let U := univ.filter (fun b => (E.filter (R b)).card=2)
    (∀ v ∈ E, 2 ≤ (U.filter (R v)).card) ∧
    ¬ ∃ O : Finset (BitVec 6), (∀ a ∈ E, (O.filter (R a)).card=2) ∧
      (∀ b ∈ O, (E.filter (R b)).card=2) := by
  intro E R U
  refine ⟨by decide +kernel,?_⟩
  rintro ⟨O,evenDeg,oddDeg⟩
  have sub : O ⊆ U := fun w hw => mem_filter.mpr ⟨mem_univ _,oddDeg w hw⟩
  have force (v w : BitVec 6) (hv : v ∈ E) (two : (U.filter (R v)).card=2)
      (hw : w ∈ U.filter (R v)) : w ∈ O := by
    have same := Finset.eq_of_subset_of_card_le (Finset.filter_subset_filter (R v) sub)
      (by rw [evenDeg v hv,two])
    exact (mem_filter.mp (same.symm ▸ hw)).1
  have a : (20 : BitVec 6) ∈ O := force 22 20 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have b : (21 : BitVec 6) ∈ O := force 53 21 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have c : (29 : BitVec 6) ∈ O := force 31 29 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have incl : ({20,21,29} : Finset (BitVec 6)) ⊆ O.filter (R 21) := by
    intro w hw
    simp only [mem_insert,mem_singleton] at hw
    rcases hw with rfl|rfl|rfl
    · exact mem_filter.mpr ⟨a,by decide⟩
    · exact mem_filter.mpr ⟨b,by decide⟩
    · exact mem_filter.mpr ⟨c,by decide⟩
  have h := card_le_card incl
  rw [evenDeg 21 (by decide +kernel)] at h
  exact (by decide : ¬ ({20,21,29} : Finset (BitVec 6)).card ≤ 2) h

theorem imageFilterCount {V W : Type*} [DecidableEq W] (s : Finset V) (f : V → W)
    (inj : (↑s : Set V).InjOn f) (P : V → Prop) (Q : W → Prop)
    [DecidablePred P] [DecidablePred Q] (matchPred : ∀ v ∈ s, Q (f v) ↔ P v) :
    ((s.image f).filter Q).card=(s.filter P).card := by
  rw [filter_image,card_image_of_injOn (inj.mono (filter_subset _ _))]
  exact congrArg Finset.card (filter_congr matchPred)

theorem fromLabels : H1 → (∀ E O : Finset (Finset (Fin 7)),
  (∀ v ∈ E, Even v.card) → 25 ≤ E.card → (∀ w ∈ O, Odd w.card) →
  (∀ v ∈ E, (O.filter (fun w => (Hypercube 7).Adj v w)).card = 2) →
  (∀ w ∈ O, (E.filter (fun v => (Hypercube 7).Adj w v)).card = 2) →
  ∃ A : Finset (Finset (Fin 7)), A ⊆ E ∧ A.Nonempty ∧ (E \ A).Nonempty ∧
    (O.filter (fun w => (A.filter (fun a => (Hypercube 7).Adj w a)).card = 1)).card < 2) := by
  classical
  intro search E O he many ho de do'
  obtain ⟨base,inje,injo,geometry⟩ := sixBitLabels
  obtain ⟨pivot,hpivot⟩ := card_pos.mp (show 0 < E.card by omega)
  let f := fun v => base v ^^^ base pivot
  let R (a b : BitVec 6) := (a ^^^ b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)
  have cancel (a b c : BitVec 6) : (a ^^^ c) ^^^ (b ^^^ c) = a ^^^ b := by
    calc
      _ = a ^^^ ((c ^^^ b) ^^^ c) := by simp only [BitVec.xor_assoc]
      _ = a ^^^ ((b ^^^ c) ^^^ c) := by rw [BitVec.xor_comm c b]
      _ = _ := by simp only [BitVec.xor_assoc,BitVec.xor_self,BitVec.xor_zero]
  have inject (a b c : BitVec 6) : a ^^^ c = b ^^^ c → a=b := by
    intro eqn
    have q := congrArg (fun t : BitVec 6 => t ^^^ c) eqn
    simpa only [BitVec.xor_assoc,BitVec.xor_self,BitVec.xor_zero] using q
  have ei : (↑E : Set (Finset (Fin 7))).InjOn f := fun a ha b hb hab =>
    inje a b (he a ha) (he b hb) (inject _ _ _ hab)
  have oi : (↑O : Set (Finset (Fin 7))).InjOn f := fun a ha b hb hab =>
    injo a b (ho a ha) (ho b hb) (inject _ _ _ hab)
  have geom {a b} (ha : a ∈ E) (hb : b ∈ O) :
      R (f a) (f b) ↔ (Hypercube 7).Adj a b := by
    change (((base a ^^^ base pivot) ^^^ (base b ^^^ base pivot)).toNat ∈ _) ↔ _
    rw [cancel,← geometry a b (he a ha) (ho b hb)]
    change _ ↔ a ≠ b ∧ ((a ∆ b).card=1 ∨ (b ∆ a).card=1)
    rw [symmDiff_comm b a,or_self]
    exact ⟨fun h => ⟨fun eqn => by simp [eqn] at h,h⟩,And.right⟩
  have geom' {w v} (hw : w ∈ O) (hv : v ∈ E) :
      R (f w) (f v) ↔ (Hypercube 7).Adj w v := by
    rw [adj_comm]
    have comm : R (f w) (f v) ↔ R (f v) (f w) := by simp only [R,BitVec.xor_comm (f w) (f v)]
    exact comm.trans (geom hv hw)
  have anchor : 0 ∈ E.image f := mem_image.mpr ⟨pivot,hpivot,by simp [f]⟩
  have dEven : ∀ v ∈ E.image f, ((O.image f).filter (R v)).card=2 := by
    intro v hv
    obtain ⟨a,ha,rfl⟩ := mem_image.mp hv
    exact (imageFilterCount O f oi ((Hypercube 7).Adj a) (R (f a)) (fun _ h => geom ha h)).trans (de a ha)
  have dOdd : ∀ w ∈ O.image f, ((E.image f).filter (R w)).card=2 := by
    intro v hv
    obtain ⟨w,hw,rfl⟩ := mem_image.mp hv
    exact (imageFilterCount E f ei ((Hypercube 7).Adj w) (R (f w)) (fun _ h => geom' hw h)).trans (do' w hw)
  obtain ⟨D,ds,dne,rest,small⟩ := search (E.image f) (O.image f) anchor
    (by rwa [card_image_of_injOn ei]) dEven dOdd (by
      intro u hu i hi j hj same
      apply excludedTwoForOne u hu i hi j hj
      refine ⟨O.image f,?_,?_⟩
      · rw [← same]; exact dEven
      · rw [← same]; exact dOdd) (by
      intro same
      apply forcedConnectorConflict.2
      refine ⟨O.image f,?_,?_⟩
      · rw [← same]; exact dEven
      · rw [← same]; exact dOdd)
  let A := E.filter (fun v => f v ∈ D)
  have sub : A ⊆ E := filter_subset _ _
  have imageA : A.image f = D := by
    ext b
    constructor
    · intro h
      obtain ⟨v,hv,rfl⟩ := mem_image.mp h
      exact (mem_filter.mp hv).2
    · intro hb
      obtain ⟨v,hv,rfl⟩ := mem_image.mp (ds hb)
      exact mem_image.mpr ⟨v,mem_filter.mpr ⟨hv,hb⟩,rfl⟩
  have non : A.Nonempty := by
    have h : (A.image f).Nonempty := imageA.symm ▸ dne
    exact image_nonempty.mp h
  have rem : (E \ A).Nonempty := by
    obtain ⟨b,hb⟩ := rest
    obtain ⟨v,hv,rfl⟩ := mem_image.mp (mem_sdiff.mp hb).1
    exact ⟨v,mem_sdiff.mpr ⟨hv,fun h => (mem_sdiff.mp hb).2 (mem_filter.mp h).2⟩⟩
  refine ⟨A,sub,non,rem,?_⟩
  change ((O.image f).filter (fun w => (D.filter (R w)).card=1)).card < 2 at small
  rw [← imageA] at small
  have eqn := imageFilterCount O f oi
    (fun w => (A.filter ((Hypercube 7).Adj w)).card=1)
    (fun w => ((A.image f).filter (R w)).card=1) (by
      intro w hw
      rw [imageFilterCount A f (ei.mono sub) ((Hypercube 7).Adj w) (R (f w))
        (fun v hv => geom' hw (sub hv))])
  simpa only [eqn] using small

theorem main : H1 → H2 → OMA.R_SnakeInBox_coil_small_dimensions_R1.H3 :=
  fun search parity => ofVertexObstruction (fromLabels search) parity

end OMA.R_SnakeInBox_coil_small_dimensions_R1_H3_R1
