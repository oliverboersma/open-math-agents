/-- The first six coordinates identify each parity class with 64 possible
labels. Opposite-parity vertices are cube neighbors exactly when their
labels agree or differ in one bit. -/
theorem sixBitLabels : ∃ f : Finset (Fin 7) → BitVec 6,
    (∀ a b, Even a.card → Even b.card → f a = f b → a=b) ∧
    (∀ a b, Odd a.card → Odd b.card → f a = f b → a=b) ∧
    ∀ a b, Even a.card → Odd b.card →
      ((a ∆ b).card = 1 ↔ (f a ^^^ f b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)) := by
  let f (a : Finset (Fin 7)) := BitVec.ofNat 6 (∑ i ∈ a, 2^i.val)
  exact ⟨f,by decide +kernel,by decide +kernel,by decide +kernel⟩

/-- Enumerate the seven neighbors of a packed label without scanning the
other 57 labels. The predicate can depend on the entire candidate set. -/
theorem countNeighbors (v : BitVec 6) (P : BitVec 6 → Prop) [DecidablePred P] :
    (Finset.univ.filter (fun w : BitVec 6 =>
      (v ^^^ w).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ) ∧ P w)).card =
    ([0,1,2,4,8,16,32] : List ℕ).countP (fun b => decide (P (BitVec.ofNat 6 (v.toNat ^^^ b)))) := by
  let D : List ℕ := [0,1,2,4,8,16,32]
  let N (v : BitVec 6) := D.map (fun b => BitVec.ofNat 6 (v.toNat ^^^ b))
  have all : ∀ a : BitVec 6, (N a).Nodup ∧ ∀ w : BitVec 6,
      w ∈ N a ↔ (a ^^^ w).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ) := by decide +kernel
  have eqn : Finset.univ.filter (fun w : BitVec 6 =>
        (v ^^^ w).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ) ∧ P w) =
      ((N v).filter (fun w => decide (P w))).toFinset := by
    ext w
    simp only [mem_filter,mem_univ,true_and,List.mem_toFinset,List.mem_filter,decide_eq_true_eq,(all v).2]
  rw [eqn,List.toFinset_card_of_nodup ((all v).1.filter _),← List.countP_eq_length_filter]
  simp only [N,List.countP_map,D,Function.comp_def]

/-- A deficient packed label rules out every odd side for this even mask.
This connects the numerical certificates to the finite search hypothesis. -/
theorem maskPrune (m v : ℕ) (bound : v<64) (bit : m.testBit v = true)
    (few : ([0,1,2,4,8,16,32] : List ℕ).countP (fun b =>
      ([0,1,2,4,8,16,32] : List ℕ).countP (fun c => m.testBit (v ^^^ b ^^^ c)) == 2) < 2) :
    let E := Finset.univ.filter (fun a : BitVec 6 => m.testBit a.toNat)
    let R := fun a b : BitVec 6 => (a ^^^ b).toNat ∈ ({0,1,2,4,8,16,32} : Finset ℕ)
    ¬ ∃ O : Finset (BitVec 6), (∀ a ∈ E, (O.filter (R a)).card=2) ∧
      (∀ b ∈ O, (E.filter (R b)).card=2) := by
  intro E R
  rintro ⟨O,dE,dO⟩
  let v' := BitVec.ofNat 6 v
  have val : v'.toNat=v := Nat.mod_eq_of_lt bound
  have vin : v' ∈ E := mem_filter.mpr ⟨mem_univ _,by simpa only [val] using bit⟩
  let D : List ℕ := [0,1,2,4,8,16,32]
  have mask (w : BitVec 6) :
      (E.filter (R w)).card = D.countP (fun c => m.testBit (w.toNat ^^^ c)) := by
    have exactBits : ∀ z : BitVec 6, ∀ c ∈ D,
        (BitVec.ofNat 6 (z.toNat ^^^ c)).toNat = z.toNat ^^^ c := by decide +kernel
    have eqn : E.filter (R w) = univ.filter (fun a : BitVec 6 => R w a ∧ m.testBit a.toNat) := by
      ext a
      simp only [E,mem_filter,mem_univ,true_and,and_comm]
    rw [eqn,countNeighbors w (fun a => m.testBit a.toNat)]
    apply List.countP_congr
    intro c hc
    simp only [exactBits w c hc,Bool.decide_coe]
  have allow : 2 ≤ (univ.filter (fun w : BitVec 6 => R v' w ∧ (E.filter (R w)).card=2)).card := by
    apply le_trans (dE v' vin).ge
    apply card_le_card
    intro w hw
    obtain ⟨wo,edge⟩ := mem_filter.mp hw
    exact mem_filter.mpr ⟨mem_univ _,edge,dO w wo⟩
  have count := countNeighbors v' (fun w => (E.filter (R w)).card=2)
  change (univ.filter (fun w => R v' w ∧ (E.filter (R w)).card=2)).card = _ at count
  rw [count] at allow
  have exactBits : ∀ z : BitVec 6, ∀ c ∈ D,
      (BitVec.ofNat 6 (z.toNat ^^^ c)).toNat = z.toNat ^^^ c := by decide +kernel
  have eqn : D.countP (fun b => decide ((E.filter (R (BitVec.ofNat 6 (v'.toNat ^^^ b)))).card=2)) =
      D.countP (fun b => D.countP (fun c => m.testBit (v ^^^ b ^^^ c)) == 2) := by
    apply List.countP_congr
    intro b hb
    rw [mask,exactBits v' b hb,val]
    simp
  exact (Nat.not_lt_of_ge (allow.trans_eq eqn)) few

