private theorem lower_witness : 159 ∉ mixedMonoAPGuaranteeSet 3 13 := by
  let q (i : ℕ) : Fin 2 := if (0x2040021800c08012100144802440400b04002084 : ℕ).testBit i then 0 else 1
  have red : ∀ a d : Fin 159, 0 < d.val → a.val + 2*d.val < 159 →
      ¬ ∀ i : Fin 3, q (a.val + i.val*d.val) = 0 := by decide +kernel
  have blue : ∀ a d : Fin 159, 0 < d.val → a.val + 12*d.val < 159 →
      ¬ ∀ i : Fin 13, q (a.val + i.val*d.val) = 1 := by decide +kernel
  intro h
  rcases h (fun x => q (x.val-1)) with hr | hb
  · obtain ⟨a,d,hd,hbound,hc⟩ := extract_progression (by decide : 2 ≤ 3) q 0 hr
    exact red a d hd hbound hc
  · obtain ⟨a,d,hd,hbound,hc⟩ := extract_progression (by decide : 2 ≤ 13) q 1 hb
    exact blue a d hd hbound hc

private lemma idx_val (i : ℕ) (hi : i < 160) : (Fin.ofNat 160 i).val = i :=
  Nat.mod_eq_of_lt hi

private lemma some_progression (h₁ : H1) (h₂ : H2) (r : Fin 160 → Bool) :
    ∃ (b : Bool) (a d : ℕ), 0 < d ∧ a + (if b then 2 else 12)*d < 160 ∧
      ∀ t ≤ (if b then 2 else 12), r (Fin.ofNat 160 (a+t*d)) = b := by
  by_contra bad
  let R (x : ℕ) := r (Fin.ofNat 160 x) = true
  apply no_coloring WindowShort.impossible WindowMiddle.impossible WindowLong.impossible h₁ h₂ (R:=R)
  · intro a d hd he hr hm hl
    apply bad
    refine ⟨true,a,d,hd,he,?_⟩
    intro t ht
    change t ≤ 2 at ht
    rcases (show t=0 ∨ t=1 ∨ t=2 by omega) with h|h|h
    · simpa [h,R] using hr
    · simpa [h,R] using hm
    · simpa [h,R] using hl
  · intro a d hd he
    by_contra! miss
    apply bad
    refine ⟨false,a,d,hd,he,?_⟩
    intro t ht
    change t ≤ 12 at ht
    exact Bool.eq_false_iff.mpr (miss ⟨t,by omega⟩)

theorem main : H1 → H2 → type_of% @Green14.W_3_13 := by
  intro h₁ h₂
  have upper : 160 ∈ mixedMonoAPGuaranteeSet 3 13 := by
    intro c
    let r (i : Fin 160) := decide (c ⟨i.val+1, by constructor <;> omega⟩ = 0)
    obtain ⟨b,a,d,hd,he,hm⟩ := some_progression h₁ h₂ r
    cases b
    · right
      apply progression_at (a := a) hd c 1
      · intro i
        have := Nat.mul_le_mul_right d (show i.val ≤ 12 by omega)
        simp only [Bool.false_eq_true,if_false] at he
        omega
      · intro i hi
        have hh := hm i.val (by change i.val ≤ 12; omega)
        have hx : Fin.ofNat 160 (a+i.val*d) = ⟨a+i.val*d,hi⟩ := Fin.ext (idx_val _ hi)
        rw [hx] at hh
        dsimp only [r] at hh
        have hv : c ⟨a+i.val*d+1,by constructor <;> omega⟩ ≠ 0 := of_decide_eq_false hh
        exact (show ∀ x : Fin 2, x ≠ 0 → x = 1 by decide) _ hv
    · left
      apply progression_at (a := a) hd c 0
      · intro i
        have := Nat.mul_le_mul_right d (show i.val ≤ 2 by omega)
        simp only [if_true] at he
        omega
      · intro i hi
        have hh := hm i.val (by change i.val ≤ 2; omega)
        have hx : Fin.ofNat 160 (a+i.val*d) = ⟨a+i.val*d,hi⟩ := Fin.ext (idx_val _ hi)
        rw [hx] at hh
        dsimp only [r] at hh
        exact of_decide_eq_true hh
  exact le_antisymm (Nat.sInf_le upper)
    (W_ge_succ_of_not_mem 3 13 159 ⟨160,upper⟩ lower_witness)

end OMA.R_Green14_W_3_13_R3
