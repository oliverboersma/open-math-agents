private lemma base_bit : ∀ d : Fin 14, 0 < d.val → ∀ t : Fin 13,
    bases[d.val-1]!.testBit (6*(t.val*d.val)) = true := by decide +kernel

private lemma short_bit : ∀ t : Fin 7, (0x1041041041 : Nat).testBit (6*t.val) = true := by decide +kernel

theorem impossible (R : Nat → Prop) (bound : ∀ x, R x → x < 113)
    (tr : ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False)
    (long : ∀ a d, 0 < d → a+12*d < 113 → ∃ t : Fin 13, R (a+t.val*d))
    (short : ∀ a, a+6 < 113 → ∃ t : Fin 7, R (a+t.val)) : False := by
  have get {a d : Nat} (hd : 0 < d) (he : a+12*d < 113) :
      ∃ z, (bases[d-1]! <<< (6*a)).testBit (6*z) = true ∧ R z := by
    obtain ⟨t,ht⟩ := long a d hd he
    refine ⟨a+t.val*d, ?_, ht⟩
    simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using
      base_bit ⟨d,by omega⟩ hd t
  have hit : Hits R := by
    intro i
    dsimp only [pattern]
    split
    · obtain ⟨t,ht⟩ := short (i%113-6) (by omega)
      refine ⟨i%113-6+t.val, ?_, ht⟩
      simpa [Nat.testBit_shiftLeft, Nat.mul_add, Nat.le_add_right] using short_bit t
    · split
      · apply get <;> omega
      · simpa using get (a:=0) (d:=1) (by decide) (by decide)
  have hc := c123
  have root : fromBits 0 0x1ffffffffffffffffffffffffffff = ((⟨0,0,0,0⟩,0x1041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041),0) := by decide +kernel
  rw [root] at hc
  apply hc R (fun x hx => by have := bound x hx; omega) tr hit
  · intro p t _ _ _
    simp [forbidden]
  · have bits : ∀ x : Fin 113, (0x1041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041041 : Nat).testBit (6*x.val) = true := by decide +kernel
    exact fun x hx => bits ⟨x,bound x hx⟩

end WindowLong

