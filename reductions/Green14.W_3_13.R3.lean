private def Free (R : ℕ → Prop) := ∀ a d, 0 < d → a+2*d < 160 →
  R a → R (a+d) → R (a+2*d) → False

private def Meets (R : ℕ → Prop) := ∀ a d, 0 < d → a+12*d < 160 →
  ∃ i : Fin 13, R (a+i.val*d)

private def Gap (R : ℕ → Prop) (p q : ℕ) :=
  R p ∧ R q ∧ ∀ x, p < x → x < q → ¬R x

private def Window (n g : ℕ) :=
  ∀ S : ℕ → Prop, (∀ x, S x → x < n) →
    (∀ a d, 0 < d → S a → S (a+d) → S (a+2*d) → False) →
    (∀ a d, 0 < d → a+12*d < n → ∃ t : Fin 13, S (a+t.val*d)) →
    (∀ a, a+(g-1) < n → ∃ t : Fin g, S (a+t.val)) → False

/-- Every 69-term progression in the board contains five successive blue terms. -/
private def Five (R : ℕ → Prop) := ∀ o h : ℕ, 0 < h → o+68*h < 160 →
  ∃ a, a+4 < 69 ∧ ∀ i : Fin 5, ¬R (o+(a+i.val)*h)

private def Widths (p q u v : ℕ) :=
  17 ≤ p ∧ p+8 ≤ q ∧ q ≤ p+13 ∧ p+q ≤ 159 ∧
  u+6 ≤ v ∧ v ≤ u+13 ∧ v < 160 ∧
  (q ≤ 62 → u+7 ≤ v) ∧ (q ≤ 41 → u+8 ≤ v)

/-- The two maximal blue runs share a red endpoint. -/
def H1 : Prop :=
  ∀ (R : ℕ → Prop) (p q v : ℕ), Widths p q q v →
    Gap R p q → Gap R q v → Five R → Free R → Meets R → False

/-- The two maximal blue runs have four distinct red endpoints. -/
def H2 : Prop :=
  ∀ (R : ℕ → Prop) (p q u v : ℕ), Widths p q u v → q < u →
    Gap R p q → Gap R u v → Five R → Free R → Meets R → False

section

private theorem run_in {R : ℕ → Prop} {n g o h : ℕ} (w : Window n g)
    (ng : 0 < n) (gg : 0 < g) (hd : 0 < h) (lim : o+(n-1)*h < 160)
    (tr : Free R) (hit : Meets R) :
    ∃ a, a+(g-1) < n ∧ ∀ i : Fin g, ¬R (o+(a+i.val)*h) := by
  classical
  by_contra neg
  let S (x : ℕ) := x < n ∧ R (o+x*h)
  have lim' (x : ℕ) (hx : x < n) : o+x*h < 160 := by
    have := Nat.mul_le_mul_right h (show x ≤ n-1 by omega)
    omega
  apply w S (fun _ h => h.1)
  · intro a d hp h₀ h₁ h₂
    have he : o+a*h+2*(d*h) = o+(a+2*d)*h := by ring
    apply tr (o+a*h) (d*h) (Nat.mul_pos hp hd) (he ▸ lim' _ h₂.1) h₀.2
    · simpa only [Nat.add_mul, Nat.add_assoc] using h₁.2
    · exact he ▸ h₂.2
  · intro a d hp hl
    have he : o+a*h+12*(d*h) = o+(a+12*d)*h := by ring
    obtain ⟨i,hi⟩ := hit (o+a*h) (d*h) (Nat.mul_pos hp hd) (he ▸ lim' _ hl)
    have := Nat.mul_le_mul_right d (show i.val ≤ 12 by omega)
    exact ⟨i, by omega, by simpa only [Nat.add_mul, Nat.mul_assoc, Nat.add_assoc] using hi⟩
  · intro a ha
    by_contra! no
    apply neg
    refine ⟨a,ha,fun i ri => no i ⟨?_,ri⟩⟩
    have := i.isLt
    omega

private lemma bracket {R : ℕ → Prop} (hit : Meets R) {s k : ℕ}
    (hk : 0 < k) (hk' : k ≤ 13) (hl : 13 ≤ s+k) (hr : s+12 < 160)
    (blue : ∀ x, s ≤ x → x < s+k → ¬R x) :
    ∃ p q, p < s ∧ s+k ≤ q ∧ q ≤ p+13 ∧ q < 160 ∧ Gap R p q := by
  classical
  obtain ⟨i,hi⟩ := hit (s+k-13) 1 (by decide) (by omega)
  obtain ⟨j,hj⟩ := hit s 1 (by decide) (by omega)
  simp only [Nat.mul_one] at hi hj
  have il := i.isLt
  have jl := j.isLt
  have before : s+k-13+i.val < s := by
    by_contra! h
    exact blue _ h (by omega) hi
  let p := Nat.findGreatest R s
  have hp : R p := Nat.findGreatest_spec (by omega : s+k-13+i.val ≤ s) hi
  have hps : p < s := by
    have hp' : p ≤ s := Nat.findGreatest_le s
    by_contra! h
    exact blue _ h (by omega) hp
  have existsR : ∃ y : ℕ, s ≤ y ∧ R y := ⟨s+j.val,by omega,hj⟩
  let q := Nat.find existsR
  obtain ⟨hqs,hq⟩ : s ≤ q ∧ R q := Nat.find_spec existsR
  have hq' : q ≤ s+j.val := Nat.find_min' existsR ⟨by omega,hj⟩
  have hsq : s+k ≤ q := by
    by_contra! h
    exact blue q hqs h hq
  have gap : Gap R p q := by
    refine ⟨hp,hq,fun x hx hy rx => ?_⟩
    by_cases h : x ≤ s
    · exact Nat.findGreatest_is_greatest hx h rx
    · exact Nat.find_min existsR hy ⟨by omega,rx⟩
  refine ⟨p,q,hps,hsq,?_,by omega,gap⟩
  by_contra! big
  obtain ⟨i,hi⟩ := hit (p+1) 1 (by decide) (by omega)
  simp only [Nat.mul_one] at hi
  exact gap.2.2 _ (by omega) (by have := i.isLt; omega) hi

private def Rev (R : ℕ → Prop) (x : ℕ) := R (159-x)

private lemma reverse_data {R : ℕ → Prop} (tr : Free R) (hit : Meets R) :
    Free (Rev R) ∧ Meets (Rev R) := by
  constructor
  · intro a d hd he h₀ h₁ h₂
    apply tr (159-(a+2*d)) d hd (by omega) h₂
    · change R (159-(a+d)) at h₁
      simpa only [show 159-(a+2*d)+d = 159-(a+d) by omega] using h₁
    · change R (159-a) at h₀
      simpa only [show 159-(a+2*d)+2*d = 159-a by omega] using h₀
  · intro a d hd he
    obtain ⟨i,hi⟩ := hit (159-(a+12*d)) d hd (by omega)
    have it : 12-i.val+i.val = 12 := by have := i.isLt; omega
    have eq := congrArg (fun z => z*d) it
    simp only [Nat.add_mul] at eq
    refine ⟨⟨12-i.val,by omega⟩,?_⟩
    change R (159-(a+(12-i.val)*d))
    rwa [show 159-(a+(12-i.val)*d) = 159-(a+12*d)+i.val*d by omega]

private lemma reverse_gap {R : ℕ → Prop} {p q : ℕ} (pq : p < q) (hq : q < 160)
    (g : Gap R p q) : Gap (Rev R) (159-q) (159-p) := by
  unfold Rev
  refine ⟨?_,?_,fun x hx hy => g.2.2 _ (by omega) (by omega)⟩
  · simpa only [show 159-(159-q)=q by omega] using g.2.1
  · simpa only [show 159-(159-p)=p by omega] using g.1

private lemma normalized {R : ℕ → Prop} (tr : Free R) (hit : Meets R)
    (w5 : Window 69 5) (w6 : Window 91 6) (w7 : Window 113 7)
    (h₁ : H1) (h₂ : H2) {p q : ℕ} (g : Gap R p q)
    (hp : 17 ≤ p) (dw : p+8 ≤ q) (dm : q ≤ p+13) (mid : p+q ≤ 159) : False := by
  have five : Five R := fun o d hd he => run_in w5 (by decide) (by decide) hd he tr hit
  have place {n k o : ℕ} (w : Window n k) (nn : 0 < n) (kk : 0 < k) (ku : k ≤ 13)
      (left : 13 ≤ o+k) (right : o+n-1 < 160) (cap : o+n+12 < 160+k)
      (near : q < o+k) :
      ∃ u v, q ≤ u ∧ u+k+1 ≤ v ∧ v ≤ u+13 ∧ v < 160 ∧ Gap R u v := by
    obtain ⟨a,ha,bl⟩ := run_in (o:=o) (h:=1) w nn kk (by decide)
      (by simp only [Nat.mul_one]; omega) tr hit
    simp only [Nat.mul_one] at bl
    have blue (x : ℕ) (lo : o+a ≤ x) (hi : x < o+a+k) : ¬ R x := by
      have h := bl ⟨x-(o+a),by omega⟩
      simpa only [show o+(a+(x-(o+a)))=x by omega] using h
    obtain ⟨u,v,hu,hv,di,hs,g'⟩ := bracket hit kk ku (by omega) (by omega) blue
    have qs : q < o+a := by
      by_contra! h
      exact blue q h (by omega) g.2.1
    have qu : q ≤ u := by
      by_contra! h
      exact g'.2.2 q h (by omega) g.2.1
    exact ⟨u,v,qu,by omega,di,hs,g'⟩
  have dispatch (u v : ℕ) (hu : q ≤ u) (ws : Widths p q u v) (g' : Gap R u v) : False := by
    rcases hu.eq_or_lt with h|h
    · subst u
      exact h₁ R p q v ws g g' five tr hit
    · exact h₂ R p q u v ws h g g' five tr hit
  by_cases early : q ≤ 41
  · obtain ⟨u,v,hu,hv,hv',lim,g'⟩ := place (o:=41) w7 (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by omega)
    exact dispatch u v hu ⟨hp,dw,dm,mid,by omega,hv',lim,by omega,by omega⟩ g'
  by_cases early' : q ≤ 62
  · obtain ⟨u,v,hu,hv,hv',lim,g'⟩ := place (o:=62) w6 (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by omega)
    exact dispatch u v hu ⟨hp,dw,dm,mid,by omega,hv',lim,by omega,by omega⟩ g'
  · obtain ⟨u,v,hu,hv,hv',lim,g'⟩ := place (o:=83) w5 (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by omega)
    exact dispatch u v hu ⟨hp,dw,dm,mid,by omega,hv',lim,by omega,by omega⟩ g'

private theorem no_coloring (w5 : Window 69 5) (w6 : Window 91 6) (w7 : Window 113 7)
    (h₁ : H1) (h₂ : H2) {R : ℕ → Prop} (tr : Free R) (hit : Meets R) : False := by
  obtain ⟨a,ha,bl⟩ := run_in (o:=23) (h:=1) w7 (by decide) (by decide) (by decide)
    (by decide) tr hit
  simp only [Nat.mul_one] at bl
  have blue (x : ℕ) (lo : 23+a ≤ x) (hi : x < 23+a+7) : ¬R x := by
    have h := bl ⟨x-(23+a),by omega⟩
    simpa only [show 23+(a+(x-(23+a)))=x by omega] using h
  obtain ⟨p,q,hp,hq,hm,he,g⟩ := bracket hit (by decide : 0<7) (by decide)
    (by omega) (by omega) blue
  by_cases mid : p+q ≤ 159
  · exact normalized tr hit w5 w6 w7 h₁ h₂ g (by omega) (by omega) hm mid
  · obtain ⟨tr',hit'⟩ := reverse_data tr hit
    exact normalized tr' hit' w5 w6 w7 h₁ h₂ (reverse_gap (by omega) he g)
      (by omega) (by omega) (by omega) (by omega)

end

private theorem mixedMonoAPGuaranteeSet_upward (k r : ℕ) {M N : ℕ} (hMN : M ≤ N)
    (hM : M ∈ mixedMonoAPGuaranteeSet k r) :
    N ∈ mixedMonoAPGuaranteeSet k r := by
  intro coloring
  let emb : Icc 1 M ↪ Icc 1 N :=
    ⟨fun x ↦ ⟨x, x.2.1, x.2.2.trans hMN⟩, by
      intro x y h
      apply Subtype.ext
      exact congrArg (fun z : Icc 1 N ↦ (z : Nat)) h⟩
  let restricted : Icc 1 M → Fin 2 := fun x ↦ coloring (emb x)
  rcases hM restricted with hzero | hone
  · left
    rcases hzero with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy
  · right
    rcases hone with ⟨s, hsAP, hsColor⟩
    let t : Finset (Icc 1 N) := s.map emb
    have hsets : ({(x : Nat) | x ∈ t} : Set Nat) = {(x : Nat) | x ∈ s} := by
      ext z
      constructor
      · rintro ⟨x,hx,rfl⟩
        obtain ⟨y,hy,rfl⟩ := Finset.mem_map.mp hx
        exact ⟨y,hy,rfl⟩
      · rintro ⟨y,hy,rfl⟩
        exact ⟨emb y,Finset.mem_map.mpr ⟨y,hy,rfl⟩,rfl⟩
    refine ⟨t, ?_, ?_⟩
    · rw [hsets]
      exact hsAP
    · intro x hx
      rcases Finset.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [restricted] using hsColor y hy

/-- One bad coloring of `{1, ..., N}` proves the numerical lower bound
`W(k,r) ≥ N+1`. -/
private theorem W_ge_succ_of_not_mem (k r N : ℕ)
    (hne : (mixedMonoAPGuaranteeSet k r).Nonempty) (hbad : N ∉ mixedMonoAPGuaranteeSet k r) :
    N + 1 ≤ W k r := by
  rw [W]
  apply le_csInf hne
  intro b hb
  by_contra hle
  have hbN : b ≤ N := Nat.lt_succ_iff.mp (Nat.lt_of_not_ge hle)
  exact hbad (mixedMonoAPGuaranteeSet_upward k r hbN hb)

private lemma progression_at {N k a d : Nat} (hd : 0 < d)
    (c : Icc 1 N → Fin 2) (color : Fin 2)
    (bound : ∀ i : Fin k, a+i.val*d < N)
    (mono : ∀ (i : Fin k) (hi : a+i.val*d < N), c ⟨a+i.val*d+1, by constructor <;> omega⟩ = color) :
    ∃ s : Finset (Icc 1 N), ({(z : Nat) | z ∈ s}).IsAPOfLength k ∧
      ∀ z ∈ s, c z = color := by
  classical
  let value (i : Fin k) := a + i.val*d + 1
  have inj : Function.Injective value := by
    intro i j h
    apply Fin.ext
    exact Nat.eq_of_mul_eq_mul_right hd (by simpa [value] using h)
  let point : Fin k ↪ Icc 1 N := ⟨fun i => ⟨value i, by
    have := bound i
    dsimp [value]
    constructor <;> omega⟩, fun i j h => inj (congrArg Subtype.val h)⟩
  let s := Finset.univ.map point
  have eqs : ({(z : Nat) | z ∈ s} : Set Nat) = range value := by
    ext z
    constructor
    · rintro ⟨y,hy,rfl⟩
      obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hy
      exact ⟨i,rfl⟩
    · rintro ⟨i,rfl⟩
      exact ⟨point i,Finset.mem_map.mpr ⟨i,Finset.mem_univ _,rfl⟩,rfl⟩
  refine ⟨s, ?_, ?_⟩
  · rw [eqs]
    refine ⟨a+1,d,?_,?_⟩
    · rw [ENat.card_coe_set_eq, ← Set.image_univ, inj.encard_image]
      simp
    · ext z
      constructor
      · rintro ⟨i,rfl⟩
        exact ⟨i.val,by exact_mod_cast i.isLt,by simp [value]; omega⟩
      · rintro ⟨i,hi,rfl⟩
        exact ⟨⟨i,by exact_mod_cast hi⟩,by simp [value]; omega⟩
  · intro z hz
    obtain ⟨i,_,rfl⟩ := Finset.mem_map.mp hz
    exact mono i (bound i)


private lemma extract_progression {N k : ℕ} (hk : 2 ≤ k) (q : ℕ → Fin 2) (col : Fin 2)
    (h : ∃ s : Finset (Icc 1 N), ({(x : ℕ) | x ∈ s}).IsAPOfLength k ∧
      ∀ x ∈ s, q (x.val-1) = col) :
    ∃ a d : Fin N, 0 < d.val ∧ a.val + (k-1)*d.val < N ∧
      ∀ i : Fin k, q (a.val + i.val*d.val) = col := by
  obtain ⟨s,⟨a,d,hcard,hset⟩,hc⟩ := h
  have term (i : ℕ) (hi : i < k) :
      ∃ x ∈ s, (x : ℕ) = a + i*d := by
    change a + i*d ∈ ({(x : ℕ) | x ∈ s} : Set ℕ)
    rw [hset]
    exact ⟨i, by exact_mod_cast hi, by simp⟩
  obtain ⟨x₀, -, hx₀⟩ := term 0 (by omega)
  simp only [Nat.zero_mul, Nat.add_zero] at hx₀
  obtain ⟨x₁, -, hx₁⟩ := term (k-1) (by omega)
  have ha : 1 ≤ a := hx₀ ▸ x₀.property.1
  have hb : a + (k-1)*d ≤ N := hx₁ ▸ x₁.property.2
  have hpos : 0 < d := by
    by_contra! hz
    have hd : d = 0 := by omega
    have heq : ({(x : ℕ) | x ∈ s} : Set ℕ) = {a} := by
      rw [hset]
      ext z
      simp only [hd, nsmul_zero, add_zero, Set.mem_ofPred_eq, Set.mem_singleton_iff]
      constructor
      · rintro ⟨i,hi,rfl⟩
        rfl
      · rintro rfl
        exact ⟨0, by exact_mod_cast (show 0 < k by omega), rfl⟩
    have hone : (k : ℕ∞) = 1 := by rw [← hcard, heq]; simp
    have : k = 1 := by exact_mod_cast hone
    omega
  have hd' : d ≤ (k-1)*d := by
    simpa using Nat.mul_le_mul_right d (show 1 ≤ k-1 by omega)
  refine ⟨⟨a-1,by omega⟩,⟨d,by omega⟩,hpos,by change a-1+(k-1)*d < N; omega,?_⟩
  intro i
  obtain ⟨x,hx,hval⟩ := term i.val i.isLt
  have he := hc x hx
  change q (a - 1 + i.val*d) = col
  convert he using 2 <;> omega

