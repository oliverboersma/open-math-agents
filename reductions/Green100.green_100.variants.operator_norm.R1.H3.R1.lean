import OMAReductions.R_Green100_green_100_variants_operator_norm_R1

/-! Eckhardt, Non-MF groups and non-finite full group C*-algebras, Theorems
3.1 and 4.3. The matrix model gives a factorization through a directly finite
C*-algebra. The Kazhdan projections for the two subgroups are conjugate and
nested. An algebraic cancellation argument identifies them. -/

namespace OMA.R_Green100_green_100_variants_operator_norm_R1_H3_R1
open Filter Finset Green100
open scoped Topology

/-- Factor the dominated representation through the C*-algebra generated by the matrix model modulo null sequences. -/
def H1 : Prop :=
  ∀ (G : Type) [Group G] [Countable G] (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (ρ : G →* E ≃ₗᵢ[ℂ] E),
    (∃ n : ℕ → ℕ, ∃ U : ∀ j, G → Matrix.unitaryGroup (Fin (n j)) ℂ,
      (∀ g h, Tendsto (fun j => opDist (U j (g*h)) (U j g*U j h)) atTop (𝓝 0)) ∧
      ∀ (A : Finset G) (z : G → ℂ) (b : ℝ),
        (∀ᶠ j in atTop, ‖Matrix.toEuclideanCLM (𝕜 := ℂ)
          (∑ g ∈ A, z g • (U j g : Matrix (Fin (n j)) (Fin (n j)) ℂ))‖ ≤ b) →
        ∀ v : E, ‖∑ g ∈ A, z g • ρ g v‖ ≤ b*‖v‖) →
    ∃ A : Type, ∃ _ : CStarAlgebra A, (∀ a b : A, a*b=1 → b*a=1) ∧
      ∃ σ : G →* unitary A, ∃ π : A →⋆ₐ[ℂ] (E →L[ℂ] E),
        ∀ g v, π (σ g : A) v = ρ g v

/-- The images of the two Kazhdan projections in an arbitrary unital C*-algebra. -/
def H2 : Prop :=
  ∀ (G : Type) [Group G] [Countable G] (Γ : Subgroup G),
    (∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (ρ : Γ →* E ≃ₗᵢ[ℂ] E) (c : Γ → E),
      (∀ g h, c (g*h) = c g + ρ g (c h)) → ∃ v : E, ∀ g, c g = ρ g v - v) →
    ∀ t : G, (∀ g ∈ Γ, t*g*t⁻¹ ∈ Γ) →
    ∀ (A : Type) [CStarAlgebra A] (σ : G →* unitary A),
    ∃ p q : A, p*p=p ∧ p*q=p ∧ q*p=p ∧ (∃ u : Aˣ, q=(u:A)*p*(↑u⁻¹:A)) ∧
      ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (π : A →⋆ₐ[ℂ] (E →L[ℂ] E)) (v : E),
        (π p v=v ↔ ∀ g ∈ Γ, π (σ g:A) v=v) ∧
        (π q v=v ↔ ∀ g ∈ Γ, π (σ (t*g*t⁻¹):A) v=v)

/-- Comparable conjugate idempotents coincide in a directly finite unital ring. -/
def H3 : Prop :=
  ∀ (A : Type) [Ring A], (∀ a b : A, a*b=1 → b*a=1) →
    ∀ (p q : A) (u : Aˣ), p*p=p → p*q=p → q*p=p → q=(u:A)*p*(↑u⁻¹:A) → p=q

theorem main : H1 → H2 → H3 → OMA.R_Green100_green_100_variants_operator_norm_R1.H3 := by
  intro factor proj cancel G _ _ Γ fh t sub E _ _ _ ρ model v fixed
  obtain ⟨A,algebra,finite,σ,π,action⟩ := factor G E ρ model
  letI := algebra
  obtain ⟨p,q,pp,pq,qp,⟨u,uq⟩,h⟩ := proj G Γ fh t sub A σ
  obtain ⟨hp,hq⟩ := h E π v
  have qv : π q v = v := hq.mpr (fun g hg => (action _ _).trans (fixed g hg))
  rw [← cancel A finite p q u pp pq qp uq] at qv
  intro g hg
  exact (action g v).symm.trans ((hp.mp qv) g hg)

end OMA.R_Green100_green_100_variants_operator_norm_R1_H3_R1
