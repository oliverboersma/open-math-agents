import OMAReductions.R_Erdos1160_erdos_1160_variants_sum_R3_H2_R1
import Mathlib.GroupTheory.Frattini

/-!
A fixed-cofactor extension is determined by normal 2-kernel, quotient, outer action
and central factor-set data. The template construction and the estimates for it
are adapted from @ahmeterdempmk's PR #6901. Instead of assuming an automorphism
moment for every 2-group, count automorphism tuples for three populations.

The rank strip is expressed through the index of the Frattini subgroup. Let F
denote the subgroup generated by squares, and let K be generated by squares of
elements of F and commutators of elements of F with elements of the group.
The first hypothesis counts central-strip roots (K trivial); the second counts
central-strip nonroots with large [F:K]. The third counts all remaining classes.
The fourth is the Higman bound proved in PR #393.
-/

open CategoryTheory Filter Erdos1160
open scoped commutatorElement

namespace OMA.R_Erdos1160_erdos_1160_variants_sum_R3_H2_R1_H2_R2

def H1 : Prop := ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
  let X := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = 2^b}
  let U := (x : X) × (Fin t → MulAut (x.property.choose : FiniteGrp.{0}))
  Nat.card {u : U // 
    let G : FiniteGrp.{0} := u.1.property.choose
    let d := Nat.log 2 (frattini G).index
    let strip := 1000*(2*b-3*d) ≤ 2*d ∧ 1000*(3*d-2*b) ≤ 2*d
    let F := Subgroup.closure (Set.range fun x : G => x*x)
    let K := Subgroup.closure (Set.range (fun x : F => x.val*x.val) ∪
      Set.range (fun z : F × G => ⁅z.1.val,z.2⁆))
    strip ∧ K=⊥}^27 * 2^(8*b^2) ≤ 2^(2*b^3+6*t*b^2+C*(b+1))

def H2 : Prop := ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
  let X := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = 2^b}
  let U := (x : X) × (Fin t → MulAut (x.property.choose : FiniteGrp.{0}))
  Nat.card {u : U // 
    let G : FiniteGrp.{0} := u.1.property.choose
    let d := Nat.log 2 (frattini G).index
    let strip := 1000*(2*b-3*d) ≤ 2*d ∧ 1000*(3*d-2*b) ≤ 2*d
    let F := Subgroup.closure (Set.range fun x : G => x*x)
    let K := Subgroup.closure (Set.range (fun x : F => x.val*x.val) ∪
      Set.range (fun z : F × G => ⁅z.1.val,z.2⁆))
    strip ∧ K≠⊥ ∧ 2^(192*((t+1)*1000)) * Nat.card K ≤ Nat.card F}^27 * 2^(8*b^2) ≤ 2^(2*b^3+6*t*b^2+C*(b+1))

def H3 : Prop := ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
  let X := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = 2^b}
  let U := (x : X) × (Fin t → MulAut (x.property.choose : FiniteGrp.{0}))
  Nat.card {u : U // 
    let G : FiniteGrp.{0} := u.1.property.choose
    let d := Nat.log 2 (frattini G).index
    let strip := 1000*(2*b-3*d) ≤ 2*d ∧ 1000*(3*d-2*b) ≤ 2*d
    let F := Subgroup.closure (Set.range fun x : G => x*x)
    let K := Subgroup.closure (Set.range (fun x : F => x.val*x.val) ∪
      Set.range (fun z : F × G => ⁅z.1.val,z.2⁆))
    ¬strip ∨ Nat.card F < 2^(192*((t+1)*1000)) * Nat.card K}^27 * 2^(8*b^2) ≤ 2^(2*b^3+6*t*b^2+C*(b+1))

def H4 : Prop := ∀ᶠ m : ℕ in atTop, 2^(2*m^3) ≤ g (2^m)^27 * 2^(13*m^2)

/-- An isomorphism in `FiniteGrp` gives a group isomorphism. -/
theorem nonempty_mulEquiv_of_iso {X Y : FiniteGrp.{0}} (i : X ≅ Y) : Nonempty (X ≃* Y) :=
  ⟨Iso.groupIsoToMulEquiv ((inducedFunctor FiniteGrp.toGrp).mapIso i)⟩

/-- The chosen representative of a class of groups of order `n` has order `n`. -/
theorem card_out {n : ℕ} {x : Quotient (isIsomorphicSetoid FiniteGrp.{0})}
    (hx : x ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = n}) :
    Nat.card (Quotient.out x : FiniteGrp.{0}) = n := by
  obtain ⟨G, hG, rfl⟩ := hx
  have h : Nonempty (Quotient.out (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) G) ≅ G) :=
    Quotient.mk_out (s := isIsomorphicSetoid FiniteGrp.{0}) G
  obtain ⟨i⟩ := h
  obtain ⟨e⟩ := nonempty_mulEquiv_of_iso i
  rw [Nat.card_congr e.toEquiv]
  exact hG

/-- There are finitely many classes of groups of order `n`: transporting the multiplication of a
representative to `Fin n` gives a table, and classes with equal tables are equal. -/
theorem classes_finite (n : ℕ) :
    (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = n}).Finite := by
  classical
  set S := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = n} with hS
  let e : ∀ x : S, (Quotient.out x.1 : FiniteGrp.{0}) ≃ Fin n := fun x =>
    (Finite.equivFin _).trans (finCongr (card_out x.2))
  let tab : S → Fin n → Fin n → Fin n := fun x a b => e x ((e x).symm a * (e x).symm b)
  have hinj : Function.Injective tab := by
    intro x y hxy
    let f : (Quotient.out x.1 : FiniteGrp.{0}) ≃* (Quotient.out y.1 : FiniteGrp.{0}) :=
      { toEquiv := (e x).trans (e y).symm
        map_mul' := fun a b => by
          have h := congrFun (congrFun hxy (e x a)) (e x b)
          simp only [tab, Equiv.symm_apply_apply] at h
          show (e y).symm (e x (a * b)) = (e y).symm (e x a) * (e y).symm (e x b)
          rw [h, Equiv.symm_apply_apply] }
    apply Subtype.ext
    calc x.1 = Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (Quotient.out x.1) :=
          (Quotient.out_eq _).symm
      _ = Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (Quotient.out y.1) :=
          Quotient.sound ⟨InducedCategory.isoMk (MulEquiv.toGrpIso
            (X := (Quotient.out x.1).toGrp) (Y := (Quotient.out y.1).toGrp) f)⟩
      _ = y.1 := Quotient.out_eq _
  have : Finite S := Finite.of_injective tab hinj
  exact Set.toFinite S

theorem card_le_three_subtypes {U : Type*} [Finite U] (A B D : U → Prop)
    (cover : ∀ u, A u ∨ B u ∨ D u) :
    Nat.card U ≤ Nat.card {u // A u} + Nat.card {u // B u} + Nat.card {u // D u} := by
  classical
  let label (u : U) : ({u // A u} ⊕ {u // B u}) ⊕ {u // D u} :=
    if ha : A u then .inl (.inl ⟨u,ha⟩) else if hb : B u then .inl (.inr ⟨u,hb⟩)
    else .inr ⟨u,(cover u).resolve_left ha |>.resolve_left hb⟩
  let forget : ({u // A u} ⊕ {u // B u}) ⊕ {u // D u} → U :=
    Sum.elim (Sum.elim Subtype.val Subtype.val) Subtype.val
  have hf : Function.LeftInverse forget label := by
    intro u
    dsimp [label]
    split_ifs <;> rfl
  simpa only [Nat.card_sum] using Nat.card_le_card_of_injective label hf.injective

theorem total_moment (h1 : H1) (h2 : H2) (h3 : H3) : ∀ t : ℕ, ∃ C : ℕ, ∀ b : ℕ,
    Nat.card (Σ x : (Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
      {G : FiniteGrp.{0} | Nat.card G = 2^b}), (Fin t → MulAut (Quotient.out x.1 : FiniteGrp.{0}))) ^ 27
      * 2^(8*b^2) ≤ 2^(2*b^3+6*t*b^2+C*(b+1)) := by
  classical
  intro t
  obtain ⟨C₁,h₁⟩ := h1 t
  obtain ⟨C₂,h₂⟩ := h2 t
  obtain ⟨C₃,h₃⟩ := h3 t
  let C := max (max C₁ C₂) C₃
  refine ⟨C+54, fun b => ?_⟩
  let X := Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
    {G : FiniteGrp.{0} | Nat.card G = 2^b}
  let G (x : X) : FiniteGrp.{0} := x.property.choose
  let U := (x : X) × (Fin t → MulAut (G x))
  let strip (u : U) := let d := Nat.log 2 (frattini (G u.1)).index
    1000*(2*b-3*d) ≤ 2*d ∧ 1000*(3*d-2*b) ≤ 2*d
  let F (x : X) := Subgroup.closure (Set.range fun v : G x => v*v)
  let K (x : X) := Subgroup.closure (Set.range (fun v : F x => v.val*v.val) ∪
    Set.range (fun z : F x × G x => ⁅z.1.val,z.2⁆))
  let w (u : U) := 2^(192*((t+1)*1000)) * Nat.card (K u.1)
  let A (u : U) := strip u ∧ K u.1 = ⊥
  let B (u : U) := strip u ∧ K u.1 ≠ ⊥ ∧ w u ≤ Nat.card (F u.1)
  let D (u : U) := ¬strip u ∨ Nat.card (F u.1) < w u
  let W := 2^(2*b^3+6*t*b^2+C*(b+1))
  let I₁ := Nat.card {u : U // A u}
  let I₂ := Nat.card {u : U // B u}
  let I₃ := Nat.card {u : U // D u}
  let M := max (max I₁ I₂) I₃
  letI : Finite X := classes_finite (2^b) |>.to_subtype
  letI (Y : FiniteGrp.{0}) : Finite (MulAut Y) :=
    Finite.of_injective (fun f : MulAut Y => (f : Y → Y)) DFunLike.coe_injective
  have cover : Nat.card U ≤ 4*M := by
    have bound := card_le_three_subtypes A B D (by
      intro u
      dsimp only [A,B,D]
      by_cases hs : strip u
      · by_cases hk : K u.1 = ⊥
        · exact .inl ⟨hs,hk⟩
        · by_cases hw : w u ≤ Nat.card (F u.1)
          · exact .inr (.inl ⟨hs,hk,hw⟩)
          · exact .inr (.inr (.inr (Nat.lt_of_not_ge hw)))
      · exact .inr (.inr (.inl hs)))
    change Nat.card U ≤ I₁ + I₂ + I₃ at bound
    dsimp only [M]; omega
  have raise (L : ℕ) (hl : L ≤ C) : 2^(2*b^3+6*t*b^2+L*(b+1)) ≤ W :=
    Nat.pow_le_pow_right (by decide) (Nat.add_le_add_left (Nat.mul_le_mul_right _ hl) _)
  have cap : M^27 * 2^(8*b^2) ≤ W := by
    have ha : I₁^27 * 2^(8*b^2) ≤ W := (h₁ b).trans (raise _ ((le_max_left ..).trans (le_max_left ..)))
    have hb : I₂^27 * 2^(8*b^2) ≤ W := (h₂ b).trans (raise _ ((le_max_right ..).trans (le_max_left ..)))
    have hd : I₃^27 * 2^(8*b^2) ≤ W := (h₃ b).trans (raise _ (le_max_right ..))
    have hf : M=I₁ ∨ M=I₂ ∨ M=I₃ := by dsimp only [M]; omega
    rcases hf with e|e|e <;> rw [e] <;> assumption
  have eq : Nat.card ((x : X) × (Fin t → MulAut (Quotient.out x.1 : FiniteGrp.{0}))) =
      Nat.card U := by
    apply Nat.card_congr
    apply Equiv.sigmaCongrRight
    intro x
    have hx : Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) x.val.out =
        Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) (G x) :=
      (Quotient.out_eq x.val).trans x.property.choose_spec.2.symm
    have i : Nonempty (x.val.out ≅ G x) := Quotient.exact hx
    let e := Iso.groupIsoToMulEquiv ((inducedFunctor FiniteGrp.toGrp).mapIso i.some)
    exact Equiv.arrowCongr (Equiv.refl (Fin t)) (MulAut.congr e).toEquiv
  rw [eq]
  apply (Nat.mul_le_mul_right _ (Nat.pow_le_pow_left cover 27)).trans
  rw [mul_pow,show (4:ℕ)^27=2^54 by decide, Nat.mul_assoc]
  apply (Nat.mul_le_mul_left (2^54) cap).trans
  dsimp only [W]
  rw [←pow_add]
  exact Nat.pow_le_pow_right (by decide) (by nlinarith only [Nat.zero_le b])

/-- A finite group is generated, over any subgroup `K`, by `log₂ [G : K]` elements. -/
theorem exists_gen_aux {H : Type*} [Group H] [Finite H] :
    ∀ (n : ℕ) (K : Subgroup H), K.index ≤ n → ∀ m : ℕ, Nat.log 2 K.index ≤ m →
      ∃ gen : Fin m → H, K ⊔ Subgroup.closure (Set.range gen) = ⊤ := by
  intro n
  induction n with
  | zero =>
    intro K hK
    exact absurd (Nat.le_zero.mp hK) Subgroup.index_ne_zero_of_finite
  | succ n ih =>
    intro K hK m hm
    by_cases hKt : K = ⊤
    · exact ⟨fun _ => 1, by rw [hKt]; exact top_sup_eq _⟩
    · obtain ⟨x, hx⟩ : ∃ x, x ∉ K := by
        by_contra h
        exact hKt (eq_top_iff.mpr fun y _ => by_contra fun hy => h ⟨y, hy⟩)
      have hle : K ≤ K ⊔ Subgroup.zpowers x := le_sup_left
      have hmul := Subgroup.relIndex_mul_index hle
      have hrel1 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 1 := by
        rw [Ne, Subgroup.relIndex_eq_one]
        intro h
        exact hx (h (le_sup_right (a := K) (Subgroup.mem_zpowers x)))
      have hK0 : K.index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have hrel0 : K.relIndex (K ⊔ Subgroup.zpowers x) ≠ 0 := by
        intro h
        rw [h, zero_mul] at hmul
        exact hK0 hmul.symm
      have hK'0 : (K ⊔ Subgroup.zpowers x).index ≠ 0 := Subgroup.index_ne_zero_of_finite
      have h2 : (K ⊔ Subgroup.zpowers x).index * 2 ≤ K.index := by
        rw [← hmul, mul_comm]
        exact Nat.mul_le_mul_right _ (by omega)
      have hlog : Nat.log 2 (K ⊔ Subgroup.zpowers x).index + 1 ≤ Nat.log 2 K.index := by
        rw [← Nat.log_mul_base (by norm_num) hK'0]
        exact Nat.log_mono_right h2
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
      obtain ⟨gen', hgen'⟩ := ih (K ⊔ Subgroup.zpowers x) (by omega) m' (by omega)
      refine ⟨Fin.cons x gen', ?_⟩
      rw [eq_top_iff, ← hgen']
      refine sup_le (sup_le le_sup_left ?_) ?_
      · rw [Subgroup.zpowers_le]
        exact le_sup_right (a := K) (Subgroup.subset_closure ⟨0, rfl⟩)
      · refine le_sup_of_le_right (Subgroup.closure_mono ?_)
        rintro _ ⟨i, rfl⟩
        exact ⟨i.succ, rfl⟩

/-- A finite group of order `h` is generated by `log₂ h` elements (padded to any larger length). -/
theorem exists_gen {H : Type*} [Group H] [Finite H] (m : ℕ)
    (hm : Nat.log 2 (Nat.card H) ≤ m) :
    ∃ gen : Fin m → H, Subgroup.closure (Set.range gen) = ⊤ := by
  obtain ⟨gen, h⟩ := exists_gen_aux _ (⊥ : Subgroup H) le_rfl m (by rwa [Subgroup.index_bot])
  exact ⟨gen, by rwa [bot_sup_eq] at h⟩

/-- In an extension of `H` by `N`, the conjugation action along words in lifts of generators
of `H` is a lift of the outer action. -/
theorem action_cover {N G H : Type*} [Group N] [Group G] [Group H] (S : GroupExtension N G H)
    {t : ℕ} (gen : Fin t → H) (w : H → FreeGroup (Fin t))
    (hw : ∀ h, FreeGroup.lift gen (w h) = h) :
    ∃ α : Fin t → MulAut N, ∀ h, ∃ e : G, ∃ n : N, S.rightHom e = h ∧
      MulAut.conj n * S.conjAct e = FreeGroup.lift α (w h) := by
  choose e he using fun i => S.rightHom_surjective (gen i)
  refine ⟨fun i => S.conjAct (e i), fun h => ⟨FreeGroup.lift e (w h), 1, ?_, ?_⟩⟩
  · have hc : S.rightHom.comp (FreeGroup.lift e) = FreeGroup.lift gen :=
      FreeGroup.ext_hom _ _ fun i => by simp [he]
    calc S.rightHom (FreeGroup.lift e (w h))
        = (S.rightHom.comp (FreeGroup.lift e)) (w h) := rfl
      _ = FreeGroup.lift gen (w h) := by rw [hc]
      _ = h := hw h
  · have hc : S.conjAct.comp (FreeGroup.lift e) = FreeGroup.lift (fun i => S.conjAct (e i)) :=
      FreeGroup.ext_hom _ _ fun i => by simp
    rw [map_one, one_mul]
    exact DFunLike.congr_fun hc (w h)

theorem generator_action_cover {N G H : Type*} [Group N] [Group G] [Group H]
    (S : GroupExtension N G H) {t : ℕ} (gen : Fin t → H)
    (surj : Function.Surjective (FreeGroup.lift gen)) :
    ∃ α : Fin t → MulAut N, ∀ h, ∃ e : G, ∃ n : N, S.rightHom e = h ∧
      MulAut.conj n * S.conjAct e = FreeGroup.lift α (Function.surjInv surj h) :=
  action_cover S gen (Function.surjInv surj) (Function.surjInv_eq surj)

/-- Counting a sigma type over a product whose fibres depend on the first factor only. -/
theorem card_sigma_prod_fst {α β : Type*} (F : α → Type*) :
    Nat.card (Σ x : α × β, F x.1) = Nat.card β * Nat.card (Σ a : α, F a) := by
  rw [← Nat.card_prod]
  exact Nat.card_congr
    { toFun := fun p => (p.1.2, ⟨p.1.1, p.2⟩)
      invFun := fun p => ⟨(p.2.1, p.1), p.2.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }

theorem self_le_two_pow (n : ℕ) : n ≤ 2 ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    have := Nat.one_le_two_pow (n := n)
    rw [pow_succ]
    omega

/-- The polynomial inequality behind the final count. -/
theorem poly_ineq (b s P : ℕ) (hs : 1 ≤ s) (hb : P + 31 ≤ b) :
    P * b + 2 * b ^ 3 + 6 * (s - 1) * b ^ 2 + 13 * (b + s) ^ 2 ≤
      2 * (b + s) ^ 3 + 8 * b ^ 2 := by
  have hbb : (P + 31) * b ≤ b * b := Nat.mul_le_mul_right b hb
  have key : P * b + 28 * b + 80 ≤ b ^ 2 := by nlinarith
  obtain ⟨s', rfl⟩ : ∃ s', s = s' + 1 := ⟨s - 1, by omega⟩
  rw [Nat.add_sub_cancel]
  rcases Nat.lt_or_ge s' 6 with h6 | h6
  · interval_cases s' <;> nlinarith [key]
  · obtain ⟨u, rfl⟩ : ∃ u, s' = u + 6 := ⟨s' - 6, by omega⟩
    nlinarith [key, Nat.zero_le (b * (u + 7) * (3 * u + 8)), Nat.zero_le ((u + 7) ^ 2 * (2 * u + 1))]

/-- A group of order `2^k * (2^j * q')` with `q'` odd is an extension, with kernel the normal
core of a given Sylow 2-subgroup, of a group of order `2^c * q'` by a group of order
`2^(k+j-c)`, where `c ≤ q'!` because the quotient acts faithfully on the `q'` cosets of the
Sylow subgroup. Both groups are replaced by the chosen representatives of their classes. -/
theorem cover {k j q' : ℕ} (hq' : Odd q') (G : FiniteGrp.{0}) (P : Sylow 2 G)
    (hG : Nat.card G = 2 ^ k * (2 ^ j * q')) :
    ∃ c : ℕ, c ≤ q'.factorial ∧ c ≤ k + j ∧
      ∃ xN ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
          {X : FiniteGrp.{0} | Nat.card X = 2 ^ (k + j - c)},
      ∃ xH ∈ Quotient.mk (isIsomorphicSetoid FiniteGrp.{0}) ''
          {X : FiniteGrp.{0} | Nat.card X = 2 ^ c * q'},
      ∃ S : GroupExtension (Quotient.out xN : FiniteGrp.{0}) G (Quotient.out xH : FiniteGrp.{0}),
        S.inl.range = P.normalCore := by
  classical
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hq0 : q' ≠ 0 := hq'.pos.ne'
  have h2q : ¬ 2 ∣ q' := by
    rcases hq' with ⟨m, rfl⟩
    omega
  have hfac : Nat.factorization (2 ^ k * (2 ^ j * q')) 2 = k + j := by
    rw [Nat.factorization_mul (by positivity) (by positivity),
      Nat.factorization_mul (by positivity) hq0]
    simp [Nat.Prime.factorization_self Nat.prime_two, Nat.factorization_eq_zero_of_not_dvd h2q]
  have hP : Nat.card P.toSubgroup = 2 ^ (k + j) := by
    have := Sylow.card_eq_multiplicity P
    rw [hG, hfac] at this
    exact this
  set K : Subgroup G := P.normalCore with hKdef
  haveI hKn : K.Normal := Subgroup.normalCore_normal _
  have hKdvd : Nat.card K ∣ 2 ^ (k + j) := by
    have := Subgroup.card_dvd_of_le (Subgroup.normalCore_le P.toSubgroup)
    rwa [hP] at this
  obtain ⟨e, he, hKe⟩ := (Nat.dvd_prime_pow Nat.prime_two).1 hKdvd
  have hGK := Subgroup.card_eq_card_quotient_mul_card_subgroup K
  have hGP := Subgroup.card_eq_card_quotient_mul_card_subgroup P.toSubgroup
  rw [hG, hKe] at hGK
  rw [hG, hP] at hGP
  have hpow : 2 ^ (k + j - e) * 2 ^ e = 2 ^ k * 2 ^ j := by
    rw [← pow_add, ← pow_add, Nat.sub_add_cancel he]
  have hQ : Nat.card (G ⧸ K) = 2 ^ (k + j - e) * q' := by
    apply Nat.eq_of_mul_eq_mul_right (show 0 < 2 ^ e by positivity)
    rw [← hGK]
    calc 2 ^ k * (2 ^ j * q') = (2 ^ (k + j - e) * 2 ^ e) * q' := by rw [hpow]; ring
      _ = 2 ^ (k + j - e) * q' * 2 ^ e := by ring
  have hQP : Nat.card (G ⧸ P.toSubgroup) = q' := by
    apply Nat.eq_of_mul_eq_mul_right (show 0 < 2 ^ (k + j) by positivity)
    rw [← hGP, pow_add]
    ring
  have hdvd : Nat.card (G ⧸ K) ∣ q'.factorial := by
    letI : Fintype (G ⧸ P.toSubgroup) := Fintype.ofFinite _
    have hker : K = (MulAction.toPermHom G (G ⧸ P.toSubgroup)).ker :=
      Subgroup.normalCore_eq_ker _
    have h1 := Subgroup.card_dvd_of_injective _
