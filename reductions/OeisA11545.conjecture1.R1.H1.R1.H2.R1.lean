import OMAReductions.R_OeisA11545_conjecture1_R1_H1_R1
import Mathlib

/-!
# Decimal blocks in the lower approximations to the square root of ten pi

A nonzero decimal digit between positions a+1 and b separates every lower
decimal fraction with denominator dividing 10^j, whenever j ≤ a ≤ b ≤ 2j.
The resulting scaled error is at least one.

Use Machin's identity to enclose 2060 decimal places of the square root of
ten pi. Each arctangent summand is rounded down after integer scaling, with
the rounding errors included in the upper and lower bounds. Six explicit
nonzero decimal blocks certify every scale from 255 through 2047.
At higher scales two tests per doubling suffice. The hypotheses each ask
for a nonzero digit in a specified block of the decimal expansion.
Independently of those hypotheses, irrationality gives arbitrarily long
intervals of consecutive scales satisfying the lower bound.

The alternating-series estimate follows the parent reduction by Deldor14.
-/

namespace OMA.R_OeisA11545_conjecture1_R1_H1_R1_H2_R1
open Real Finset Filter
open scoped Topology

private theorem atan_bounds {x : ℝ} (hx : 0 ≤ x) (hx1 : x < 1) (k : ℕ) :
    (∑ i ∈ range (2*k), (-1:ℝ)^i * (x^(2*i+1) / (2*i+1))) ≤ arctan x ∧
    arctan x ≤ ∑ i ∈ range (2*k+1), (-1:ℝ)^i * (x^(2*i+1) / (2*i+1)) := by
  let f (i : ℕ) := x^(2*i+1) / (2*i+1 : ℝ)
  have hanti : Antitone f := by
    intro i j hij
    exact div_le_div₀ (by positivity) (pow_le_pow_of_le_one hx hx1.le (by omega)) (by positivity)
      (by exact_mod_cast (show 2*i+1 ≤ 2*j+1 by omega))
  have hsum := (Real.hasSum_arctan (x:=x) (by simp [Real.norm_eq_abs,abs_of_nonneg hx,hx1])).tendsto_sum_nat
  have hlim : Tendsto (fun n => ∑ i ∈ range n, (-1:ℝ)^i * f i) atTop (𝓝 (arctan x)) := by
    simpa only [f, Nat.cast_add, Nat.cast_mul, Nat.cast_one, Nat.cast_ofNat, mul_div_assoc] using hsum
  exact ⟨hanti.alternating_series_le_tendsto hlim k, hanti.tendsto_le_alternating_series hlim k⟩

set_option maxRecDepth 20000 in
set_option maxHeartbeats 1600000 in
private theorem root_bounds :
    (:ℝ) ≤ √(π*10)*(10:ℝ)^2060 ∧ √(π*10)*(10:ℝ)^2060 < (:ℝ) := by
  let denom (c i : ℕ) := (2*i+1)*c^(2*i+1)
  let truncTerm (T c i : ℕ) := T/denom c i
  let term (c i : ℕ) : ℝ := (1/(c:ℝ))^(2*i+1)/(2*i+1)
  let posSum (T c k : ℕ) := ∑ i ∈ range k, truncTerm T c (2*i)
  let negSum (T c k : ℕ) := ∑ i ∈ range k, truncTerm T c (2*i+1)

  have point (T c i : ℕ) (hc : 0 < c) :
      (truncTerm T c i:ℝ) ≤ T*term c i ∧ T*term c i ≤ truncTerm T c i+1 := by
    let d := denom c i
    have dp : 0 < d := by dsimp [d,denom]; positivity
    have dl := Nat.div_mul_le_self T d
    have du : T ≤ (T/d+1)*d := by
      have e := Nat.div_add_mod' T d
      have h := Nat.mod_lt T dp
      rw [Nat.add_mul,one_mul]
      omega
    have dr : (0:ℝ) < d := by exact_mod_cast dp
    have eq : term c i = 1/(d:ℝ) := by
      dsimp [d,denom,term]
      push_cast
      simp only [one_div,div_eq_mul_inv,inv_pow,mul_inv_rev]
      ring
    rw [eq,←div_eq_mul_one_div]
    constructor
    · exact (le_div_iff₀ dr).mpr (by exact_mod_cast dl)
    · exact (div_le_iff₀ dr).mpr (by exact_mod_cast du)

  have pair_sum (c k : ℕ) :
      ∑ i ∈ range (2*k), (-1:ℝ)^i * term c i =
      ∑ i ∈ range k, (term c (2*i)-term c (2*i+1)) := by
    induction k with
    | zero => simp
    | succ k ih =>
      rw [show 2*(k+1)=2*k+1+1 by omega,sum_range_succ,sum_range_succ,ih,sum_range_succ]
      simp [pow_add,pow_mul]
      ring

  have fixed_atan (T c k : ℕ) (hc : 1 < c) :
      (posSum T c k:ℝ) - negSum T c k-k ≤ T*arctan (1/(c:ℝ)) ∧
      T*arctan (1/(c:ℝ)) ≤ posSum T c k-negSum T c k+(k:ℝ)+truncTerm T c (2*k)+1 := by
    have hcp : (0:ℝ)<c := by exact_mod_cast (by omega : 0<c)
    have bounds := atan_bounds (x:=1/(c:ℝ)) (by positivity) ((div_lt_one hcp).mpr (by exact_mod_cast hc)) k
    change (∑ i ∈ range (2*k), (-1:ℝ)^i*term c i) ≤ _ ∧ _ ≤ ∑ i ∈ range (2*k+1), (-1:ℝ)^i*term c i at bounds
    rw [sum_range_succ,pair_sum] at bounds
    simp only [pow_mul,neg_one_sq,one_pow,one_mul] at bounds
    have pairs := sum_le_sum (s:=range k) (fun i _ =>
      sub_le_sub (point T c (2*i) (by omega)).1 (point T c (2*i+1) (by omega)).2)
    have pairs' := sum_le_sum (s:=range k) (fun i _ =>
      sub_le_sub (point T c (2*i) (by omega)).2 (point T c (2*i+1) (by omega)).1)
    have last := (point T c (2*k) (by omega)).2
    have left := mul_le_mul_of_nonneg_left bounds.1 (by positivity : 0 ≤ (T:ℝ))
    have right := mul_le_mul_of_nonneg_left bounds.2 (by positivity : 0 ≤ (T:ℝ))
    simp only [posSum,negSum,Nat.cast_sum,sum_sub_distrib,sum_add_distrib,sum_const,card_range,
      nsmul_eq_mul,mul_one,mul_add,mul_sub,Finset.mul_sum] at *
    constructor <;> linarith only [left,right,pairs,pairs',last]



  have machin_integer_bounds :
      (:ℝ) ≤ (10:ℝ)^2076*π ∧ (10:ℝ)^2076*π ≤ (:ℝ) := by
    let T : ℕ := 10^2076
    have h5 := fixed_atan T 5 750 (by decide)
    have lo5 : (:ℤ) = (posSum T 5 750:ℤ) - negSum T 5 750 - 750 := by decide +kernel
    have hi5 : (:ℤ) = (posSum T 5 750:ℤ) - negSum T 5 750 + 750 + truncTerm T 5 1500 + 1 := by decide +kernel
    have bot5 : (:ℝ) ≤ (T:ℝ)*arctan (1/5) := by
      have h : (:ℝ) = (posSum T 5 750:ℝ) - negSum T 5 750 - 750 := by exact_mod_cast lo5
      rw [h]; exact h5.1
    have top5 : (T:ℝ)*arctan (1/5) ≤ (:ℝ) := by
      have h : (:ℝ) = (posSum T 5 750:ℝ) - negSum T 5 750 + 750 + truncTerm T 5 1500 + 1 := by exact_mod_cast hi5
      rw [h]; exact h5.2
    have h239 := fixed_atan T 239 222 (by decide)
    have lo239 : (:ℤ) = (posSum T 239 222:ℤ) - negSum T 239 222 - 222 := by decide +kernel
    have hi239 : (:ℤ) = (posSum T 239 222:ℤ) - negSum T 239 222 + 222 + truncTerm T 239 444 + 1 := by decide +kernel
    have bot239 : (:ℝ) ≤ (T:ℝ)*arctan (1/239) := by
      have h : (:ℝ) = (posSum T 239 222:ℝ) - negSum T 239 222 - 222 := by exact_mod_cast lo239
      rw [h]; exact h239.1
    have top239 : (T:ℝ)*arctan (1/239) ≤ (:ℝ) := by
      have h : (:ℝ) = (posSum T 239 222:ℝ) - negSum T 239 222 + 222 + truncTerm T 239 444 + 1 := by exact_mod_cast hi239
      rw [h]; exact h239.2
    have mach := Real.four_mul_arctan_inv_5_sub_arctan_inv_239
    have eq : (T:ℝ)*π = 16*((T:ℝ)*arctan (1/5))-4*((T:ℝ)*arctan (1/239)) := by
      norm_num only [one_div] at *
      linear_combination -4*(T:ℝ)*mach
    rw [← show (T:ℝ) = (10:ℝ)^2076 by simp [T]]
    constructor <;> linarith only [bot5,top5,bot239,top239,eq]
  obtain ⟨lower,upper⟩ := machin_integer_bounds
  have root := Real.sq_sqrt (show 0 ≤ π*10 by positivity)
  have Tpos : 0 < (10:ℝ)^2076 := by positivity
  have e : (√(π*10)*(10:ℝ)^2060)^2 * (10:ℝ)^2076 = ((10:ℝ)^2076*π)*(10*(10:ℝ)^4120) := by
    rw [mul_pow,root]; ring
  have lo : (:ℝ)^2*(10:ℝ)^2076 ≤ (:ℝ)*(10*10^4120) := by
    exact_mod_cast (show (:ℕ)^2*10^2076 ≤ *(10*10^4120) by decide +kernel)
  have hi : (:ℝ)*(10*10^4120) < (:ℝ)^2*(10:ℝ)^2076 := by
    exact_mod_cast (show (:ℕ)*(10*10^4120) < ^2*10^2076 by decide +kernel)
  have l := le_trans lo (mul_le_mul_of_nonneg_right lower (by positivity : 0 ≤ 10*(10:ℝ)^4120))
  have u := lt_of_le_of_lt (mul_le_mul_of_nonneg_right upper (by positivity : 0 ≤ 10*(10:ℝ)^4120)) hi
  rw [←e] at l u
  have sqlo := (mul_le_mul_iff_left₀ Tpos).mp l
  have squp := (mul_lt_mul_iff_left₀ Tpos).mp u
  exact ⟨(sq_le_sq₀ (by positivity) (by positivity)).mp sqlo,
    (sq_lt_sq₀ (by positivity) (by positivity)).mp squp⟩

theorem aligned (q : ℚ) (a : ℕ) (hd : q.den ∣ 10^a) :
    ∃ z : ℤ, (q:ℝ)*(10:ℝ)^a = z := by
  obtain ⟨u,hu⟩ := hd
  have e : (10:ℝ)^a = (q.den:ℝ)*u := by exact_mod_cast hu
  refine ⟨q.num*u,?_⟩
  rw [e,Rat.cast_def]
  push_cast
  field_simp

/-- A nonzero decimal block between a and b separates all lower grid
points on scale j whenever j ≤ a ≤ b ≤ 2j. -/
theorem block_bound {x : ℝ} (q : ℚ) {j a b : ℕ} (ja : j ≤ a) (ab : a ≤ b)
    (bj : b ≤ 2*j) (hd : q.den ∣ 10^j) (low : (q:ℝ) ≤ x)
    (block : ∃ z : ℤ, x*(10:ℝ)^a < z+1 ∧ (z:ℝ)*(10:ℝ)^(b-a)+1 ≤ x*(10:ℝ)^b) :
    1 ≤ ((10^j:ℕ):ℝ)^2 * (x-q) := by
  obtain ⟨t,ht⟩ := aligned q a (hd.trans (pow_dvd_pow 10 ja))
  obtain ⟨z,hz,hb⟩ := block
  have le : (t:ℝ) < z+1 := by
    rw [←ht]
    exact (mul_le_mul_of_nonneg_right low (by positivity)).trans_lt hz
  have tz : t ≤ z := by
    have h : t < z+1 := by exact_mod_cast le
    omega
  have expand : (10:ℝ)^b = (10:ℝ)^a * (10:ℝ)^(b-a) := by rw [←pow_add]; congr 1; omega
  have lower : 1 ≤ (10:ℝ)^b*(x-q) := by
    have h := mul_le_mul_of_nonneg_right (show (t:ℝ) ≤ z by exact_mod_cast tz) (show 0 ≤ (10:ℝ)^(b-a) by positivity)
    rw [←ht] at h
    rw [expand] at hb ⊢
    linarith only [hb,h]
  push_cast
  have scales : (10:ℝ)^b ≤ ((10:ℝ)^j)^2 := by
    rw [←pow_mul,Nat.mul_comm]
    exact pow_le_pow_right₀ (by norm_num) bj
  exact lower.trans (mul_le_mul_of_nonneg_right scales (sub_nonneg.mpr low))

theorem dyadic (j : ℕ) (hj : 2048 ≤ j) :
    ∃ k : ℕ, 2*(1024*2^k) ≤ j ∧ j < 4*(1024*2^k) := by
  induction j with
  | zero => omega
  | succ j ih =>
    by_cases base : j < 2048
    · exact ⟨0,by norm_num; omega,by norm_num; omega⟩
    obtain ⟨k,hlo,hhi⟩ := ih (by omega)
    by_cases h : j+1 < 4*(1024*2^k)
    · exact ⟨k,by omega,h⟩
    · refine ⟨k+1,?_,?_⟩ <;> rw [pow_succ] <;> omega


private theorem from_root {x : ℝ} (G D a b z : ℕ) (aD : a ≤ D) (bD : b ≤ D)
    (lower : (G:ℝ) ≤ x*(10:ℝ)^D) (upper : x*(10:ℝ)^D < (G+1:ℕ))
    (small : G+1 ≤ (z+1)*10^(D-a))
    (large : (z*10^(b-a)+1)*10^(D-b) ≤ G) :
    ∃ t : ℤ, x*(10:ℝ)^a < t+1 ∧ (t:ℝ)*(10:ℝ)^(b-a)+1 ≤ x*(10:ℝ)^b := by
  refine ⟨(z:ℤ),?_,?_⟩
  · push_cast
    have h : x*(10:ℝ)^D < ((z:ℝ)+1)*10^(D-a) :=
      upper.trans_le (by exact_mod_cast small)
    apply (mul_lt_mul_iff_left₀ (show 0 < (10:ℝ)^(D-a) by positivity)).mp
    simpa only [mul_assoc,←pow_add,Nat.add_sub_of_le aD] using h
  · push_cast
    have h : ((z:ℝ)*10^(b-a)+1)*10^(D-b) ≤ x*10^D :=
      le_trans (by exact_mod_cast large) lower
    apply (mul_le_mul_iff_left₀ (show 0 < (10:ℝ)^(D-b) by positivity)).mp
    simpa only [mul_assoc,←pow_add,Nat.add_sub_of_le bD] using h


private theorem finite_grid {x : ℝ} (bounds : (:ℝ) ≤ x*10^2060 ∧ x*10^2060 < (:ℝ))
    (q : ℚ) {j : ℕ} (start : 255 ≤ j) (stop : j < 2048) (dvd : q.den ∣ 10^j) (low : (q:ℝ) ≤ x) :
    1 ≤ ((10^j:ℕ):ℝ)^2 * (x-q) := by
  have upper : x*(10:ℝ)^2060 < (:ℕ) := by exact_mod_cast bounds.2
  have check (a b z : ℕ) (ja : j ≤ a) (ab : a ≤ b) (bj : b ≤ 2*j) (aD : a ≤ 2060) (bD : b ≤ 2060)
      (small :  ≤ (z+1)*10^(2060-a))
      (large : (z*10^(b-a)+1)*10^(2060-b) ≤ ) :=
    block_bound q ja ab bj dvd low (from_root _ _ _ _ _ aD bD bounds.1 upper small large)
  by_cases h384 : j ≤ 384
  · exact check 384 385  h384 (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
  by_cases h512 : j ≤ 512
  · exact check 512 513  h512 (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
  by_cases h768 : j ≤ 768
  · exact check 768 769  h768 (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
  by_cases h1024 : j ≤ 1024
  · exact check 1024 1025  h1024 (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
  by_cases h1536 : j ≤ 1536
  · exact check 1536 1537  h1536 (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)
  exact check 2048 2051  (by omega) (by decide) (by omega) (by decide) (by decide) (by decide +kernel) (by decide +kernel)


/-- Irrationality alone supplies nonzero decimal digits arbitrarily far out. -/
theorem unbounded_digits {x : ℝ} (irr : Irrational x) (A : ℕ) :
    ∃ a ≥ A, ∃ z : ℤ, x*(10:ℝ)^a < z+1 ∧ (z:ℝ)*10+1 ≤ x*(10:ℝ)^(a+1) := by
  by_contra! none
  let f (a : ℕ) := ⌊x*(10:ℝ)^a⌋
  have grows (a : ℕ) (ha : A ≤ a) : f (a+1) = f a*10 := by
    have low := Int.floor_le (x*(10:ℝ)^a)
    have high := none a ha (f a) (Int.lt_floor_add_one _)
    apply Int.floor_eq_iff.mpr
    constructor
    · rw [pow_succ,←mul_assoc]
      push_cast
      exact mul_le_mul_of_nonneg_right low (by norm_num)
    · push_cast
      exact high
  have iter (k : ℕ) : f (A+k) = f A*10^k := by
    induction k with
    | zero => simp
    | succ k ih => rw [show A+(k+1)=A+k+1 by omega,grows _ (by omega),ih,pow_succ,mul_assoc]
  have notint : x*(10:ℝ)^A ≠ f A := by
    intro eq
    apply irr
    refine ⟨(f A : ℚ)/(10:ℚ)^A,?_⟩
    push_cast
    exact (div_eq_iff (by positivity)).mpr eq.symm
  have pos : 0 < x*(10:ℝ)^A - f A := sub_pos.mpr (lt_of_le_of_ne (Int.floor_le _) (Ne.symm notint))
  obtain ⟨k,hk⟩ := pow_unbounded_of_one_lt (1/(x*(10:ℝ)^A-f A)) (by norm_num : (1:ℝ)<10)
  have gap := (div_lt_iff₀ pos).mp hk
  have upper : x*(10:ℝ)^(A+k) < (f (A+k):ℝ)+1 := Int.lt_floor_add_one _
  rw [iter,pow_add] at upper
  push_cast at upper
  nlinarith only [gap,upper]

/-- For arbitrarily large a, all grid scales in the full interval
ceil((a+1)/2) ≤ j ≤ a satisfy the stronger unit lower bound. -/
theorem unbounded_good_intervals (A : ℕ) :
    ∃ a ≥ A, ∀ j : ℕ, j ≤ a → a+1 ≤ 2*j → ∀ q : ℚ,
      q.den ∣ 10^j → (q:ℝ) ≤ √(π*10) → 1 ≤ ((10^j:ℕ):ℝ)^2*(√(π*10)-q) := by
  have irr : Irrational (√(π*10)) := by
    apply Irrational.of_pow 2
    rw [Real.sq_sqrt (by positivity)]
    simpa using irrational_pi.mul_ratCast (by norm_num : (10:ℚ)≠0)
  obtain ⟨a,ha,z,small,large⟩ := unbounded_digits irr A
  refine ⟨a,ha,?_⟩
  intro j ja jb q dq lo
  apply block_bound q ja (b:=a+1) (by omega) jb dq lo
  exact ⟨z,small,by simpa using large⟩

/-- A nonzero digit after position 3B and through 4B at the dyadic anchors. -/
def H1 : Prop := ∀ k : ℕ, let B := 1024*2^k
  let x := √(π*10)
  ∃ z : ℤ, x*(10:ℝ)^(3*B) < z+1 ∧ (z:ℝ)*(10:ℝ)^B+1 ≤ x*(10:ℝ)^(4*B)

/-- A nonzero digit after position 4B and through 6B at the same anchors. -/
def H2 : Prop := ∀ k : ℕ, let B := 1024*2^k
  let x := √(π*10)
  ∃ z : ℤ, x*(10:ℝ)^(4*B) < z+1 ∧ (z:ℝ)*(10:ℝ)^(2*B)+1 ≤ x*(10:ℝ)^(6*B)

theorem main : H1 → H2 → OMA.R_OeisA11545_conjecture1_R1_H1_R1.H2 := by
  intro first second j m start
  dsimp only
  intro _ dvd _ low
  let q := (√(π*10)).convergent m
  have strong : 1 ≤ ((10^j:ℕ):ℝ)^2 * (√(π*10)-q) := by
    by_cases stop : j < 2048
    · exact finite_grid root_bounds q start stop dvd low
    obtain ⟨k,hlo,hhi⟩ := dyadic j (by omega)
    let B := 1024*2^k
    change 2*B ≤ j at hlo
    change j < 4*B at hhi
    by_cases cut : j ≤ 3*B
    · apply block_bound q cut (b:=4*B) (by omega) (by omega) dvd low
      rw [show 4*B-3*B=B by omega]
      exact first k
    · apply block_bound q (a:=4*B) (b:=6*B) (by omega) (by omega) (by omega) dvd low
      rw [show 6*B-4*B=2*B by omega]
      exact second k
  exact lt_of_lt_of_le (by norm_num : (0.0892062:ℝ)<1) strong

end OMA.R_OeisA11545_conjecture1_R1_H1_R1_H2_R1
