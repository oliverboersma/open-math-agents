import OMAReductions.R_OeisA11545_conjecture1_R1
import Mathlib

/-! # Continued-fraction candidates for square prefixes of pi

Legendre's theorem forces every failure of the scaled lower decimal bound
to come from a convergent of sqrt(pi) or sqrt(10*pi). The reduced
denominator must divide a power of ten. For each such convergent only
its first admissible decimal scale needs to be considered, since its
one-sided error is fixed and the scale factor grows. Two rational approximations
certified using the Machin interval exclude every denominator through 10^254. Proof by @Deldor14.
-/
open Real
namespace OMA.DecimalConvergents
open Finset Filter
open scoped Topology
private theorem atan_bounds {x : ℝ} (hx : 0 ≤ x) (hx1 : x < 1) (k : ℕ) :
    (∑ i ∈ range (2*k), (-1:ℝ)^i * (x^(2*i+1) / (2*i+1))) ≤ arctan x ∧
    arctan x ≤ ∑ i ∈ range (2*k+1), (-1:ℝ)^i * (x^(2*i+1) / (2*i+1)) := by
  let f (i : ℕ) := x^(2*i+1) / (2*i+1 : ℝ)
  have hanti : Antitone f := by
    intro i j hij
    exact div_le_div₀ (by positivity) (pow_le_pow_of_le_one hx hx1.le (by omega)) (by positivity)
      (by exact_mod_cast (show 2*i+1 ≤ 2*j+1 by omega))
  have hsum := (Real.hasSum_arctan (x:=x) (by simp [Real.norm_eq_abs,abs_of_nonneg hx,hx1])).tendsto_sum_nat
  have hlim : Tendsto (fun n => ∑ i ∈ range n, (-1:ℝ)^i * f i) atTop (𝓝 (arctan x)) := by
    simpa only [f, Nat.cast_add, Nat.cast_mul, Nat.cast_one, Nat.cast_ofNat, mul_div_assoc] using hsum
  exact ⟨hanti.alternating_series_le_tendsto hlim k, hanti.tendsto_le_alternating_series hlim k⟩

private theorem rational_atan (x : ℚ) (hx : 0 ≤ x) (hx1 : x < 1) (k : ℕ) :
    ((∑ i ∈ range (2*k), (-1:ℚ)^i * (x^(2*i+1) / (2*i+1)) : ℚ) : ℝ) ≤ arctan x ∧
    arctan x ≤ ((∑ i ∈ range (2*k+1), (-1:ℚ)^i * (x^(2*i+1) / (2*i+1)) : ℚ) : ℝ) := by
  push_cast
  exact atan_bounds (by exact_mod_cast hx) (by exact_mod_cast hx1) k

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
private theorem pi_interval : ((( / 10^512) : ℚ) : ℝ) ≤ π ∧ π ≤ ((( / 10^512) : ℚ) : ℝ) := by
  let s (x : ℚ) (t : ℕ) : ℚ := ∑ i ∈ range t, (-1:ℚ)^i * (x^(2*i+1) / (2*i+1))
  have h5 := rational_atan (1/5) (by norm_num) (by norm_num) 190
  have h239 := rational_atan (1/239) (by norm_num) (by norm_num) 55
  change (s (1/5) 380 : ℝ) ≤ _ ∧ _ ≤ (s (1/5) 381 : ℝ) at h5
  change (s (1/239) 110 : ℝ) ≤ _ ∧ _ ≤ (s (1/239) 111 : ℝ) at h239
  have bot : (( / 10^512) : ℚ) ≤ 16*s (1/5) 380-4*s (1/239) 111 := by decide +kernel
  have top : 16*s (1/5) 381-4*s (1/239) 110 ≤ (( / 10^512) : ℚ) := by decide +kernel
  have bot' : ((( / 10^512) : ℚ):ℝ) ≤ ((16*s (1/5) 380-4*s (1/239) 111 : ℚ):ℝ) := Rat.cast_le.mpr bot
  have top' : ((16*s (1/5) 381-4*s (1/239) 110 : ℚ):ℝ) ≤ ((( / 10^512) : ℚ):ℝ) := Rat.cast_le.mpr top
  simp only [Rat.cast_mul, Rat.cast_sub, Rat.cast_ofNat] at bot' top'
  have mach := Real.four_mul_arctan_inv_5_sub_arctan_inv_239
  norm_num only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat, one_div] at h5 h239
  constructor <;> linarith only [h5.1,h5.2,h239.1,h239.2,mach,bot',top']


private theorem barrier {a : ℝ} (r q : ℚ) (B : ℕ) (hB : 0 < B)
    (hrD : 10^254 < r.den) (hrB : r.den ≤ B)
    (approx : |a-r| < 1/(2*(r.den:ℝ)^2))
    (close : |a-q| < 1/(2*(B:ℝ)^2)) : 10^254 < q.den := by
  have pos : (0:ℝ) < r.den := by exact_mod_cast r.pos
  have denLE : (r.den:ℝ) ≤ B := by exact_mod_cast hrB
  have err : 1/(2*(B:ℝ)^2) ≤ 1/(2*(r.den:ℝ)^2) :=
    one_div_le_one_div_of_le (by positivity) (by nlinarith [sq_nonneg ((B:ℝ)-r.den)])
  have triangle := abs_sub_le (q:ℝ) a (r:ℝ)
  rw [abs_sub_comm (q:ℝ) a] at triangle
  have bound : |(q:ℝ)-r| < 1/(r.den:ℝ)^2 := by
    have both := add_lt_add (close.trans_le err) approx
    calc
      _ < 1/(2*(r.den:ℝ)^2) + 1/(2*(r.den:ℝ)^2) := triangle.trans_lt both
      _ = _ := by ring
  have ratBound : |q-r| < 1/(r.den:ℚ)^2 := by
    apply (Rat.cast_lt (K:=ℝ)).mp
    simpa only [Rat.cast_abs,Rat.cast_sub,Rat.cast_div,Rat.cast_one,Rat.cast_pow,Rat.cast_natCast] using bound
  exact hrD.trans_le (Rat.den_le_and_le_num_le_of_sub_lt_one_div_den_sq ratBound).1

private theorem barrierEven : ∃ r : ℚ, 10^254 < r.den ∧ r.den ≤ 10^255 ∧
    |√π - (r:ℝ)| < 1/(2*(r.den:ℝ)^2) := by
  let r : ℚ := 
  let e : ℚ := 1/(2*(r.den:ℚ)^2)
  have bot : (r-e)^2 < ((^512 : ℚ)*1) := by decide +kernel
  have top : ((^512 : ℚ)*1) < (r+e)^2 := by decide +kernel
  have pos : 0 < r-e := by decide +kernel
  have pos' : (0:ℝ) < (r:ℝ)-e := by exact_mod_cast pos
  have lo' : ((r:ℝ)-e)^2 < ((^512 : ℚ):ℝ)*1 := by exact_mod_cast bot
  have hi' : ((^512 : ℚ):ℝ)*1 < ((r:ℝ)+e)^2 := by exact_mod_cast top
  have se := Real.sq_sqrt (show 0 ≤ π by positivity)
  have sn := Real.sqrt_nonneg π
  have ep : (0:ℝ)<e := by exact_mod_cast (show (0:ℚ)<e by decide +kernel)
  have l : (r:ℝ)-e < √π :=
    (sq_lt_sq₀ pos'.le sn).mp (by
      rw [se]
      simpa only [mul_one] using lo'.trans_le (mul_le_mul_of_nonneg_right pi_interval.1 (by norm_num : (0:ℝ) ≤ 1)))
  have u : √π < (r:ℝ)+e :=
    (sq_lt_sq₀ sn (by linarith : 0 ≤ (r:ℝ)+e)).mp (by
      rw [se]
      simpa only [mul_one] using (mul_le_mul_of_nonneg_right pi_interval.2 (by norm_num : (0:ℝ) ≤ 1)).trans_lt hi')
  refine ⟨r,by decide +kernel,by decide +kernel,?_⟩
  have er : (e:ℝ) = 1/(2*(r.den:ℝ)^2) := by simp [e]
  rw [← er,abs_lt]
  constructor <;> linarith

private theorem barrierOdd : ∃ r : ℚ, 10^254 < r.den ∧ r.den ≤ 10^255 ∧
    |√(π*10) - (r:ℝ)| < 1/(2*(r.den:ℝ)^2) := by
  let r : ℚ := 
  let e : ℚ := 1/(2*(r.den:ℚ)^2)
  have bot : (r-e)^2 < ((^512 : ℚ)*10) := by decide +kernel
  have top : ((^512 : ℚ)*10) < (r+e)^2 := by decide +kernel
  have pos : 0 < r-e := by decide +kernel
  have pos' : (0:ℝ) < (r:ℝ)-e := by exact_mod_cast pos
  have lo' : ((r:ℝ)-e)^2 < ((^512 : ℚ):ℝ)*10 := by exact_mod_cast bot
  have hi' : ((^512 : ℚ):ℝ)*10 < ((r:ℝ)+e)^2 := by exact_mod_cast top
  have se := Real.sq_sqrt (show 0 ≤ (π*10) by positivity)
  have sn := Real.sqrt_nonneg (π*10)
  have ep : (0:ℝ)<e := by exact_mod_cast (show (0:ℚ)<e by decide +kernel)
  have l : (r:ℝ)-e < √(π*10) :=
    (sq_lt_sq₀ pos'.le sn).mp (by
      rw [se]
      simpa only [mul_one] using lo'.trans_le (mul_le_mul_of_nonneg_right pi_interval.1 (by norm_num : (0:ℝ) ≤ 10)))
  have u : √(π*10) < (r:ℝ)+e :=
    (sq_lt_sq₀ sn (by linarith : 0 ≤ (r:ℝ)+e)).mp (by
      rw [se]
      simpa only [mul_one] using (mul_le_mul_of_nonneg_right pi_interval.2 (by norm_num : (0:ℝ) ≤ 10)).trans_lt hi')
  refine ⟨r,by decide +kernel,by decide +kernel,?_⟩
  have er : (e:ℝ) = 1/(2*(r.den:ℝ)^2) := by simp [e]
  rw [← er,abs_lt]
  constructor <;> linarith


/-- When the scaled lower decimal error is at most c<1/2, the prefix
fraction is a continued-fraction convergent. Its reduced denominator
divides the decimal scale. -/
private theorem witness (a c : ℝ) (ha : 0 ≤ a) (hc : c < 1/2) (B : ℕ) (hB : 0 < B)
    (bad : (B:ℝ)*(a*B - ⌊a*B⌋₊) ≤ c) :
    ∃ m, let q := a.convergent m
      q.den ∣ B ∧ (q:ℝ) ≤ a ∧ (B:ℝ)^2*(a-q) ≤ c := by
  let y := ⌊a*B⌋₊
  let q : ℚ := Rat.divInt (y:ℤ) (B:ℤ)
  have dvd : q.den ∣ B := by exact_mod_cast Rat.den_dvd (y:ℤ) (B:ℤ)
  have bp : (0:ℝ) < B := by exact_mod_cast hB
  have qeq : (q:ℝ) = (y:ℝ)/B := by simp [q,Rat.divInt_eq_div]
  have prod : (q:ℝ)*B = y := by rw [qeq,div_mul_cancel₀ _ bp.ne']
  have y_le : (y:ℝ) ≤ a*B := Nat.floor_le (mul_nonneg ha bp.le)
  have below : (q:ℝ) ≤ a := (mul_le_mul_iff_left₀ bp).mp (prod.trans_le y_le)
  have small : (B:ℝ)^2*(a-q) ≤ c := by
    calc
      _ = (B:ℝ)*(a*B - (q:ℝ)*B) := by ring
      _ ≤ c := by rw [prod]; exact bad
  have den : (q.den:ℝ) ≤ B := by exact_mod_cast Nat.le_of_dvd hB dvd
  have reduced : (q.den:ℝ)^2*(a-q) ≤ c :=
    (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) den 2) (sub_nonneg.mpr below)).trans small
  have leg : |a - q| < 1/(2*(q.den:ℝ)^2) := by
    rw [abs_of_nonneg (sub_nonneg.mpr below)]
    apply (lt_div_iff₀ (by have := q.pos; positivity)).mpr
    linarith only [reduced, hc]
  obtain ⟨m,hm⟩ := Real.exists_rat_eq_convergent leg
  exact ⟨m,hm ▸ dvd,hm ▸ below,hm ▸ small⟩

/-- A fixed reduced denominator is tested only at its first admissible
decimal scale. The lower approximation error then grows quadratically. -/
private theorem from_minimal (a c : ℝ) (b k : ℕ) (ha : 0 ≤ a) (hc : c < 1/2) (hb : b ≤ k)
    (cert : ∃ r : ℚ, 10^254 < r.den ∧ r.den ≤ 10^b ∧ |a-r| < 1/(2*(r.den:ℝ)^2))
    (hyp : ∀ j m : ℕ, b ≤ j → let q := a.convergent m
      10^254 < q.den → q.den ∣ 10^j → (j=b ∨ ¬ q.den ∣ 10^(j-1)) → (q:ℝ) ≤ a →
        c < (10^j:ℕ)^2 * (a-q)) :
    let B : ℕ := 10^k
    c < (B:ℝ)*(a*B-⌊a*B⌋₊) := by
  dsimp only
  by_contra! bad
  obtain ⟨m,hd,below,small⟩ := witness a c ha hc (10^k) (by positivity) bad
  let q := a.convergent m
  let P (j : ℕ) := b ≤ j ∧ q.den ∣ 10^j
  have ex : ∃ j, P j := ⟨k,hb,hd⟩
  let j := Nat.find ex
  have hj : P j := Nat.find_spec ex
  have jk : j ≤ k := Nat.find_min' ex ⟨hb,hd⟩
  have minimal : j = b ∨ ¬ q.den ∣ 10^(j-1) := by
    by_cases same : j=b
    · exact Or.inl same
    right
    intro h
    have bj := hj.1
    exact Nat.find_min ex (show j-1 < j by omega) ⟨by omega,h⟩
  obtain ⟨r, hr, hrb, approx⟩ := cert
  have hrB := hrb.trans (Nat.pow_le_pow_right (by decide : 0 < 10) hb)
  have close : |a-(q:ℝ)| < 1/(2*((10^k:ℕ):ℝ)^2) := by
    rw [abs_of_nonneg (sub_nonneg.mpr below)]
    apply (lt_div_iff₀ (by positivity)).mpr
    linarith only [small,hc]
  have large := barrier r q _ (by positivity) hr hrB approx close
  have base := hyp j m hj.1 large hj.2 minimal below
  have scale : ((10^j : ℕ):ℝ) ≤ (10^k : ℕ) := by exact_mod_cast (Nat.pow_le_pow_right (by decide : 0 < 10) jk)
  exact (not_lt_of_ge small) (base.trans_le (mul_le_mul_of_nonneg_right
    (pow_le_pow_left₀ (by positivity) scale 2) (sub_nonneg.mpr below)))
end OMA.DecimalConvergents

namespace OMA.R_OeisA11545_conjecture1_R1_H1_R1
open Real

/-- The lower convergents of sqrt(pi), at their first admissible decimal scale. -/
def H1 : Prop := ∀ j m : ℕ, 256 ≤ j → let q := (√π).convergent m
  10^254 < q.den → q.den ∣ 10^j → (j=256 ∨ ¬ q.den ∣ 10^(j-1)) → (q:ℝ) ≤ √π →
    (0.2820947:ℝ) < (10^j:ℕ)^2 * (√π-q)

/-- The corresponding lower convergents of sqrt(10*pi) for odd prefixes. -/
def H2 : Prop := ∀ j m : ℕ, 255 ≤ j → let q := (√(π*10)).convergent m
  10^254 < q.den → q.den ∣ 10^j → (j=255 ∨ ¬ q.den ∣ 10^(j-1)) → (q:ℝ) ≤ √(π*10) →
    (0.0892062:ℝ) < (10^j:ℕ)^2 * (√(π*10)-q)

theorem main : H1 → H2 → OMA.R_OeisA11545_conjecture1_R1.H1 := by
  intro even odd n hn
  dsimp only
  rcases (show n%2=0 ∨ n%2=1 by omega) with h | h
  · simp only [h,pow_zero,mul_one,if_true]
    exact OMA.DecimalConvergents.from_minimal (√π) _ 256 (n/2) (sqrt_nonneg _) (by norm_num) (by omega) (by
      obtain ⟨r,h,d,e⟩ := OMA.DecimalConvergents.barrierEven
      exact ⟨r,h,d.trans (Nat.pow_le_pow_right (by decide) (by decide : 255 ≤ 256)),e⟩) even
  · simp only [h,pow_one,one_ne_zero,if_false]
    exact OMA.DecimalConvergents.from_minimal (√(π*10)) _ 255 (n/2) (sqrt_nonneg _) (by norm_num) (by omega) OMA.DecimalConvergents.barrierOdd odd
end OMA.R_OeisA11545_conjecture1_R1_H1_R1
