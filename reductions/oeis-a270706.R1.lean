/-- A solitary positive pair for 8n+1 needs one representation on a different shift. -/
def H1 : Prop := ∀ n : ℕ, 32768<n → (∃! p : ℤ × ℤ, (0<p.1 ∧ 0<p.2 ∧ (8:ℤ)*n+1=p.1^2+2*p.2^2)) →
    ∃ w : ℤ × ℤ × ℤ, (w.1≠0 ∧ 0<w.2.1 ∧ 0<w.2.2 ∧
      (8:ℤ)*n+1-4*w.1^3*(w.1+1)=w.2.1^2+2*w.2.2^2) ∧ w.1≠-1

/-- If 8n+1 has no positive pair, two pairs must be supplied by the shifted forms. -/
def H2 : Prop := ∀ n : ℕ, 32768<n → (¬∃ p : ℤ × ℤ, (0<p.1 ∧ 0<p.2 ∧ (8:ℤ)*n+1=p.1^2+2*p.2^2)) →
    ∃ w v : ℤ × ℤ × ℤ, (w.1≠0 ∧ 0<w.2.1 ∧ 0<w.2.2 ∧
      (8:ℤ)*n+1-4*w.1^3*(w.1+1)=w.2.1^2+2*w.2.2^2) ∧ (v.1≠0 ∧ 0<v.2.1 ∧ 0<v.2.2 ∧
      (8:ℤ)*n+1-4*v.1^3*(v.1+1)=v.2.1^2+2*v.2.2^2) ∧ w≠v

lemma large_good (h1 : H1) (h2 : H2) {n : ℕ} (large : 32768<n) : (∃ t u, Represents n t ∧ Represents n u ∧
      (t≠u ∨ n=1 ∨ n=3 ∨ n=90 ∨ n=438 ∨ n=480 ∨ n=7108)) := by
  classical
  by_cases any : ∃ p : ℤ × ℤ, (0<p.1 ∧ 0<p.2 ∧ (8:ℤ)*n+1=p.1^2+2*p.2^2)
  · obtain ⟨p,hp⟩ := any
    by_cases other : ∃ q : ℤ × ℤ,(0<q.1 ∧ 0<q.2 ∧ (8:ℤ)*n+1=q.1^2+2*q.2^2) ∧ q≠p
    · obtain ⟨q,hq,ne⟩ := other
      exact two_norm (w := (-1,q)) (v := (-1,p)) (base_norm (p := q) hq) (base_norm (p := p) hp) (fun e => ne (congrArg Prod.snd e))
