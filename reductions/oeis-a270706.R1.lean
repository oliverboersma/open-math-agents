import OMAStatements.S_oeis_a270706
import Mathlib

/-!
Zhi-Wei Sun's A270706. Reduction by @physbuzz.
The positive norm equation at x=-1 settles n as soon as it has two
distinct pairs. The other two possibilities give disjoint obligations.
-/

namespace OMA.R_oeis_a270706_R1
open OMA.S_oeis_a270706

lemma twice_tri (x : ℤ) : 2*triangular x=x*(x+1) := by
  have dv : 2 ∣ x*(x+1) := by
    rcases Int.even_or_odd x with ⟨a,ha⟩ | ⟨a,ha⟩
    · exact ⟨a*(x+1),by rw [ha]; ring⟩
    · exact ⟨x*(a+1),by rw [ha]; ring⟩
  exact Int.mul_ediv_cancel' dv

lemma to_sound {n : ℕ} {v : ℤ × ℤ × ℤ} (h : Represents n v) : (v.1≠0 ∧ 0<(2*v.2.2+1) ∧ 0<(2*v.2.1) ∧
      (8:ℤ)*n+1-4*v.1^3*(v.1+1)=(2*v.2.2+1)^2+2*(2*v.2.1)^2) := by
  obtain ⟨x,y,z⟩ := v
  rcases h with ⟨xn,yp,zp,eq⟩
  change 0<y at yp
  change 0≤z at zp
  refine ⟨xn,by dsimp; omega,by dsimp; omega,?_⟩
  change 8*(n:ℤ)+1-4*x^3*(x+1)=(2*z+1)^2+2*(2*y)^2
  change x^2*triangular x+y^2+triangular z=n at eq
  linear_combination -8*eq + 4*x^2*(twice_tri x) + 4*(twice_tri z)

lemma back_sound {n : ℕ} {w : ℤ × ℤ × ℤ} (h : (w.1≠0 ∧ 0<w.2.1 ∧ 0<w.2.2 ∧
      (8:ℤ)*n+1-4*w.1^3*(w.1+1)=w.2.1^2+2*w.2.2^2)) :
    Represents n ((fun w : ℤ × ℤ × ℤ => (w.1,w.2.2/2,(w.2.1-1)/2)) w) ∧ (fun v : ℤ × ℤ × ℤ => (v.1,2*v.2.2+1,2*v.2.1)) ((fun w : ℤ × ℤ × ℤ => (w.1,w.2.2/2,(w.2.1-1)/2)) w)=w := by
  obtain ⟨x,a,b⟩ := w
  obtain ⟨xn,ap,bp,eq⟩ := h
  change 8*(n:ℤ)+1-4*x^3*(x+1)=a^2+2*b^2 at eq
  have oe : a%2=1 ∧ b%2=0 := by
    have a8 := Int.emod_add_mul_ediv a 8
    have b8 := Int.emod_add_mul_ediv b 8
    have small : (a%8)^2+2*(b%8)^2=8*((n:ℤ)-x^2*triangular x-(a/8)*(a+a%8)-2*(b/8)*(b+b%8))+1 := by
      linear_combination -eq + 4*x^2*(twice_tri x) + (a+a%8)*a8 + 2*(b+b%8)*b8
    have rem : ((a%8)^2+2*(b%8)^2)%8=1 := by rw [small]; omega
    let i : Fin 8 := ⟨(a%8).toNat,by omega⟩
    let j : Fin 8 := ⟨(b%8).toNat,by omega⟩
    have tab : ∀ i j : Fin 8, ((i.val:ℤ)^2+2*(j.val:ℤ)^2)%8=1 →
        (i.val:ℤ)%2=1 ∧ (j.val:ℤ)%2=0 := by decide +kernel
    have ii : (i.val:ℤ)=a%8 := by dsimp [i]; omega
    have jj : (j.val:ℤ)=b%8 := by dsimp [j]; omega
    have par := tab i j
    rw [ii,jj] at par
    obtain ⟨pa,pb⟩ := par rem
    omega
  let y:=b/2
  let z:=(a-1)/2
  have yy : b=2*y := by dsimp [y]; omega
  have zz : a=2*z+1 := by dsimp [z]; omega
  have bs : 0<y := by change 0<b at bp; omega
  have zs : 0≤z := by change 0<a at ap; omega
  refine ⟨⟨xn,bs,zs,?_⟩,?_⟩
  · change x^2*triangular x+y^2+triangular z=n
    rw [yy,zz] at eq
    have l := twice_tri x
    have m := twice_tri z
    nlinarith only [eq,congrArg (fun v : ℤ => x^2*v) l,m]
  · change (x,2*z+1,2*y)=(x,a,b)
    rw [←zz,←yy]
lemma base_norm {n : ℕ} {p : ℤ × ℤ} (h : (0<p.1 ∧ 0<p.2 ∧ (8:ℤ)*n+1=p.1^2+2*p.2^2)) : ((-1:ℤ)≠0 ∧ 0<p.1 ∧ 0<p.2 ∧
      (8:ℤ)*n+1-4*(-1:ℤ)^3*((-1:ℤ)+1)=p.1^2+2*p.2^2) := by
  obtain ⟨ap,bp,eq⟩ := h
  exact ⟨by change (-1:ℤ)≠0; decide,ap,bp,by simpa [sub_zero] using eq⟩

lemma two_norm {n : ℕ} {w v : ℤ × ℤ × ℤ} (h : (w.1≠0 ∧ 0<w.2.1 ∧ 0<w.2.2 ∧
      (8:ℤ)*n+1-4*w.1^3*(w.1+1)=w.2.1^2+2*w.2.2^2)) (j : (v.1≠0 ∧ 0<v.2.1 ∧ 0<v.2.2 ∧
      (8:ℤ)*n+1-4*v.1^3*(v.1+1)=v.2.1^2+2*v.2.2^2))
    (ne : w≠v) : (∃ t u, Represents n t ∧ Represents n u ∧
      (t≠u ∨ n=1 ∨ n=3 ∨ n=90 ∨ n=438 ∨ n=480 ∨ n=7108)) := by
  obtain ⟨rw,iw⟩ := back_sound h
  obtain ⟨rv,iv⟩ := back_sound j
  exact ⟨_,_,rw,rv,Or.inl (fun e => ne (iw.symm.trans ((congrArg (fun v : ℤ × ℤ × ℤ => (v.1,2*v.2.2+1,2*v.2.1)) e).trans iv)))⟩

/-- Every n = 66k²+33k+4 has two representations already in the x=-1 slice. -/
lemma family (k : ℕ) : ∃ t u : ℤ × ℤ × ℤ, Represents (66*k^2+33*k+4) t ∧
    Represents (66*k^2+33*k+4) u ∧ t≠u := by
  let r : ℤ := 4*(k:ℤ)+1
  have rp : 0<r := by dsimp [r]; positivity
  have h : (0<r ∧ 0<(4*r) ∧ (8:ℤ)*(66*k^2+33*k+4)+1=r^2+2*(4*r)^2) := by
    refine ⟨rp,by change 0<4*r; positivity,?_⟩
    dsimp [r]; ring
  have j : (0<(5*r) ∧ 0<(2*r) ∧ (8:ℤ)*(66*k^2+33*k+4)+1=(5*r)^2+2*(2*r)^2) := by
    refine ⟨by change 0<5*r; positivity,by change 0<2*r; positivity,?_⟩
    dsimp [r]; ring
  obtain ⟨hr,hi⟩ := back_sound (n := 66*k^2+33*k+4) (w := (-1,(r,4*r))) (base_norm (p := (r,4*r)) h)
  obtain ⟨jr,ji⟩ := back_sound (n := 66*k^2+33*k+4) (w := (-1,(5*r,2*r))) (base_norm (p := (5*r,2*r)) j)
  refine ⟨_,_,hr,jr,fun e => ?_⟩
  have eq := hi.symm.trans ((congrArg (fun v : ℤ × ℤ × ℤ => (v.1,2*v.2.2+1,2*v.2.1)) e).trans ji)
  have ab := congrArg (fun v : ℤ × ℤ × ℤ => v.2.1) eq
  change r=5*r at ab
  omega

lemma positive_of_rep {n : ℕ} {t : ℤ × ℤ × ℤ} (h : Represents n t) : 0<n := by
  obtain ⟨x,y,z⟩ := t
  obtain ⟨_,yp,_,eq⟩ := h
  change 0<y at yp
  change x^2*triangular x+y^2+triangular z=n at eq
  have nt (v : ℤ) : 0≤triangular v := by
    have h := twice_tri v
    by_cases pos : 0≤v
    · have := mul_nonneg pos (by omega : 0≤v+1); omega
    · have := mul_nonneg_of_nonpos_of_nonpos (by omega : v≤0) (by omega : v+1≤0); omega
  have p := mul_nonneg (sq_nonneg x) (nt x)
  have q := sq_pos_of_pos yp
  have s := nt z
  omega

/-- A square norm with arbitrarily many distinct positive first coordinates. -/
private lemma many_square (k : ℕ) (bound : ℤ) (pos : 0<bound) :
    ∃ L : ℤ, bound≤L ∧ Odd L ∧ ∃ s : Finset ℤ, k=s.card ∧
      ∀ a∈s, 0<a ∧ a<L ∧ ∃ b : ℤ, 0<b ∧ a^2+2*b^2=L^2 := by
  induction k with
  | zero =>
    exact ⟨2*bound+1,by omega,⟨bound,rfl⟩,∅,rfl,by simp⟩
  | succ k ih =>
    obtain ⟨L,lb,odd,s,card,prop⟩ := ih
    let d := 8*(L+1)^2+1
    let v := (d-2)*L
    have lp : 0<L := by omega
    have dl : 2*L<d := by dsimp [d]; nlinarith [sq_nonneg L]
    have dp : 0<d := by omega
    have inj : Function.Injective (fun a : ℤ => a*d) := by
      intro a c e
      exact (mul_left_inj' (by omega : d≠0)).mp e
    let scaled := s.image (fun a : ℤ => a*d)
    have fresh : v∉scaled := by
      intro mem
      obtain ⟨a,ha,eq⟩ := Finset.mem_image.mp mem
      obtain ⟨_,al,_,_,_⟩ := prop a ha
      have lt := mul_le_mul_of_nonneg_right (show a≤L-1 by omega) dp.le
      dsimp [v] at eq
      nlinarith
    have do' : Odd d := ⟨4*(L+1)^2,by dsimp [d]; ring⟩
    refine ⟨L*d,by nlinarith [mul_nonneg lp.le (show 0≤d-1 by omega)],odd.mul do',insert v scaled,?_,?_⟩
    · rw [Finset.card_insert_of_notMem fresh,Finset.card_image_of_injective s inj,card]
    · intro a ha
      rcases Finset.mem_insert.mp ha with rfl | mem
      · have vp : 0<(d-2)*L := mul_pos (by omega) lp
        refine ⟨vp,by dsimp [v]; nlinarith,4*(L+1)*L,by positivity,?_⟩
        dsimp [v,d]; ring
      · obtain ⟨a,member,rfl⟩ := Finset.mem_image.mp mem
        obtain ⟨ap,al,b,bp,eq⟩ := prop a member
        exact ⟨mul_pos ap dp,mul_lt_mul_of_pos_right al dp,b*d,mul_pos bp dp,by linear_combination d^2*eq⟩

/-- Even the x=-1 slice has arbitrarily large representation counts at unbounded n. -/
lemma many_base (k threshold : ℕ) : ∃ n : ℕ, threshold<n ∧
    ∃ s : Finset ℤ, k=s.card ∧ ∀ a∈s,∃ b : ℤ, (0<a ∧ 0<b ∧ (8:ℤ)*n+1=a^2+2*b^2) := by
  obtain ⟨L,lb,⟨u,eq⟩,s,card,prop⟩ :=
    many_square k (8*(threshold:ℤ)+9) (by positivity)
  have up : 0<u := by omega
  let n := (triangular u).toNat
  have tp : 0≤triangular u := by
    have hp := mul_nonneg up.le (show 0≤u+1 by omega)
    have := twice_tri u
    omega
  have en : (n:ℤ)=triangular u := Int.toNat_of_nonneg tp
  have norm : 8*(n:ℤ)+1=L^2 := by rw [en,eq]; linear_combination 4*(twice_tri u)
  refine ⟨n,?_,s,card,?_⟩
  · have h : (threshold:ℤ)<n := by nlinarith [sq_nonneg (L-1)]
    exact_mod_cast h
  · intro a ha
    obtain ⟨ap,_,b,bp,eq⟩ := prop a ha
    exact ⟨b,ap,bp,norm.trans eq.symm⟩
/-- Check all 64 entries in one block. Each entry stores two signed x indices,
two positive square roots and two nonnegative triangular indices. -/
private lemma block_good (start word : ℕ)
    (ok : ∀ i : Fin 64,
      let n := start+i.val
      let code := word / 2^(42*i.val)
      let decode := fun (w : ℕ) =>
        let m : ℤ := ((w%32)/2+1 : ℕ)
        let x := if w%2=1 then m else -m
        let y : ℤ := ((w/32)%256 : ℕ)
        let z : ℤ := ((w/8192)%256 : ℕ)
        (x,y,z)
      let t := decode code
      let u := decode (code/2097152)
      (t.1≠0 ∧ 0<t.2.1 ∧ 0≤t.2.2 ∧ t.1^2*triangular t.1+t.2.1^2+triangular t.2.2=(n:ℤ)) ∧
      (u.1≠0 ∧ 0<u.2.1 ∧ 0≤u.2.2 ∧ u.1^2*triangular u.1+u.2.1^2+triangular u.2.2=(n:ℤ)) ∧
      (t≠u ∨ n=1 ∨ n=3 ∨ n=90 ∨ n=438 ∨ n=480 ∨ n=7108))
    {n : ℕ} (lo : start≤n) (hi : n<start+64) :
    ∃ t u, Represents n t ∧ Represents n u ∧
      (t≠u ∨ n=1 ∨ n=3 ∨ n=90 ∨ n=438 ∨ n=480 ∨ n=7108) := by
  let i : Fin 64 := ⟨n-start,by omega⟩
  have e : start+i.val=n := by dsimp [i]; omega
  let decode := fun (w : ℕ) =>
    let m : ℤ := ((w%32)/2+1 : ℕ)
    let x := if w%2=1 then m else -m
    (x,(((w/32)%256 : ℕ):ℤ),(((w/8192)%256 : ℕ):ℤ))
  let c := word / 2^(42*i.val)
  refine ⟨decode c,decode (c/2097152),?_⟩
  exact e ▸ ok i
